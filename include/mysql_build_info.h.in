/* Build provenance of the mysqld binary.

   The values below change on every new commit, so they are kept out of
   mysql_version.h on purpose: only the few files that really print build
   info have to be recompiled after a branch switch.
*/

#ifndef _mysql_build_info_h
#define _mysql_build_info_h

#define BUILD_BRANCH                "@BUILD_BRANCH@"
#define BUILD_COMMIT                "@BUILD_COMMIT@"
#define BUILD_TYPE                  "@BUILD_TYPE@"
#define BUILD_DATE                  __DATE__
#define BUILD_TIME                  __TIME__

#endif /* _mysql_build_info_h */
