CREATE TABLE tv (
id INT NOT NULL,
v1 VARCHAR(50) NOT NULL,
v2 VARCHAR(50) NOT NULL,
nv VARCHAR(50) NULL,
a INT NOT NULL,
b INT NOT NULL,
c INT NOT NULL,
PRIMARY KEY(id),
UNIQUE KEY uk_v1_v2(v1, v2),
UNIQUE KEY uk_nv(nv),
KEY idx_a(a),
KEY idx_b(b)
) ENGINE=InnoDB;
INSERT INTO tv VALUES
(1, 'foo', 'bar', NULL, 1, 1, 0),
(2, 'foo', 'baz', NULL, 1, 1, 0),
(3, 'abc', 'xyz', 'hello', 0, 0, 0);
ANALYZE TABLE tv;
