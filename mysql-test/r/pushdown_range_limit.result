# Testing generated columns
CREATE TABLE `sbtest_mixed_virtual_cols` (
`id` int NOT NULL AUTO_INCREMENT,
`value1` int NOT NULL DEFAULT '0',
`value2` int NOT NULL DEFAULT '0',
`stored_col` int GENERATED ALWAYS AS ((`value1` * 2)) STORED,
`virtual_col` int GENERATED ALWAYS AS ((`value1` + `value2`)) VIRTUAL,
PRIMARY KEY (`id`),
KEY `idx_stored_col_value2` (`stored_col`,`value2`),
KEY `idx_virtual_col_value1` (`virtual_col`,`value1`)
) ENGINE=InnoDB AUTO_INCREMENT=14 DEFAULT CHARSET=utf8mb4;
INSERT INTO sbtest_mixed_virtual_cols (value1, value2) VALUES (10, 5), (2, 100), (15, 8), (4, 90), (12, 12), (6, 70), (18, 3), (8, 60), (20, 1), (1, 150), (10, 11), (5, 10), (7, 10);
# Testing stored column, limit can be pushed down
explain format = tree select id, value1, value2, stored_col from sbtest_mixed_virtual_cols force index(idx_stored_col_value2) where stored_col in (2,4,6) order by value2 limit 0, 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=2.11 rows=3)
    -> Sort: sbtest_mixed_virtual_cols.value2, limit input to 3 row(s) per chunk  (cost=2.11 rows=3)
        -> Index range scan on sbtest_mixed_virtual_cols using idx_stored_col_value2 over (stored_col = 2 pushed_limit 3) OR (stored_col = 4 pushed_limit 3) OR (stored_col = 6 pushed_limit 3), with index condition: (sbtest_mixed_virtual_cols.stored_col in (2,4,6))  (cost=2.11 rows=3)

select id, value1, value2, stored_col from sbtest_mixed_virtual_cols force index(idx_stored_col_value2) where stored_col in (2,4,6) order by value2 limit 0, 3;
id	value1	value2	stored_col
15	2	100	4
23	1	150	2
# Testing virtual column, limit cannot be pushed down
explain format=tree select id, value1, value2, virtual_col from sbtest_mixed_virtual_cols force index(idx_virtual_col_value1) where virtual_col in (21,15,24) order by value1 limit 2,1;
EXPLAIN
-> Limit/Offset: 1/2 row(s)  (cost=3.46 rows=1)
    -> Sort: sbtest_mixed_virtual_cols.value1, limit input to 3 row(s) per chunk  (cost=3.46 rows=6)
        -> Filter: (sbtest_mixed_virtual_cols.virtual_col in (21,15,24))  (cost=3.46 rows=6)
            -> Index range scan on sbtest_mixed_virtual_cols using idx_virtual_col_value1 over (virtual_col = 15) OR (virtual_col = 21) OR (virtual_col = 24)  (cost=3.46 rows=6)

select id, value1, value2, virtual_col from sbtest_mixed_virtual_cols force index(idx_virtual_col_value1) where virtual_col in (21,15,24) order by value1 limit 2,1;
id	value1	value2	virtual_col
24	10	11	21
drop table sbtest_mixed_virtual_cols;
set pushdown_range_limit=false;
