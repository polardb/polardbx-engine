insert into sbtest1 values (7, 111, 112, 'abc3');
insert into sbtest1 values (8, 114, 110, 'def3');
insert into sbtest1 values (9, 115, 112, 'ghi3');
insert into sbtest1 values (10, 116, 112, 'ghi4');
insert into sbtest1 values (100, 111, 110, 'ghi4');
insert into sbtest1 values (1000, 112, 110, 'ghi4');
insert into sbtest1 values (10000, 111, 110, 'abc5');
insert into sbtest1 values (10001, 112, 112, 'def5');
insert into sbtest1 values (10002, 114, 113, 'ghi5');
explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 = 112 order by id limit 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=0.86 rows=3)
    -> Sort: sbtest1.id, limit input to 3 row(s) per chunk  (cost=0.86 rows=3)
        -> Filter: ((sbtest1.k2 = 112) and (sbtest1.k in (110,111,112)))  (cost=0.86 rows=3)
            -> Covering index range scan on sbtest1 using k_1 over (k = 110 AND k2 = 112 pushed_limit 3) OR (k = 111 AND k2 = 112 pushed_limit 3) OR (k = 112 AND k2 = 112 pushed_limit 3)  (cost=0.86 rows=3)

