6
7
100
10000
explain format=tree select * from ( select id from sbtest1 where k = 111 and k2 in (110, 111, 112) and id > 3 order by id limit 2, 10) a where a.id < 100;
EXPLAIN
-> Filter: (a.id < 100)  (cost=2.52..3.18 rows=2)
    -> Table scan on a  (cost=2.50..4.41 rows=4)
        -> Materialize  (cost=1.86..1.86 rows=4)
            -> Limit/Offset: 10/2 row(s)  (cost=1.46 rows=4)
                -> Sort: sbtest1.id, limit input to 12 row(s) per chunk  (cost=1.46 rows=6)
                    -> Filter: ((sbtest1.k = 111) and (sbtest1.k2 in (110,111,112)) and (sbtest1.id > 3))  (cost=1.46 rows=6)
                        -> Covering index range scan on sbtest1 using k_1 over (k = 111 AND k2 = 110 AND 3 < id pushed_limit 12) OR (k = 111 AND k2 = 111 AND 3 < id pushed_limit 12) OR (k = 111 AND k2 = 112 AND 3 < id pushed_limit 12)  (cost=1.46 rows=6)

select * from ( select id from sbtest1 where k = 111 and k2 in (110, 111, 112) and id > 3 order by id limit 2, 10) a where a.id < 100;
id
6
7
# does not support join
explain format=tree select a.id from sbtest1 a force index(k_1) join (select * from sbtest1 where id > 0) b ON a.k=b.k and a.k2=b.k2 where a.k = 111 and a.k2 in (110, 111, 112) and a.id > 3 order by a.id limit 8, 5;
EXPLAIN
-> Limit/Offset: 5/8 row(s)
    -> Sort: a.id, limit input to 13 row(s) per chunk
        -> Stream results  (cost=7.48 rows=15)
            -> Nested loop inner join  (cost=7.48 rows=15)
                -> Filter: ((sbtest1.k = 111) and (sbtest1.k2 in (110,111,112)) and (sbtest1.id > 0) and (sbtest1.k2 is not null))  (cost=1.46 rows=6)
                    -> Covering index range scan on sbtest1 using k_1 over (k = 111 AND k2 = 110 AND 0 < id) OR (k = 111 AND k2 = 111 AND 0 < id) OR (k = 111 AND k2 = 112 AND 0 < id)  (cost=1.46 rows=6)
                -> Filter: (a.id > 3)  (cost=0.29 rows=2)
                    -> Covering index lookup on a using k_1 (k=111, k2=sbtest1.k2)  (cost=0.29 rows=8)

# does not support backwards scan
explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 = 112 order by id desc limit 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=0.86 rows=3)
    -> Sort: sbtest1.id DESC, limit input to 3 row(s) per chunk  (cost=0.86 rows=3)
        -> Filter: ((sbtest1.k2 = 112) and (sbtest1.k in (110,111,112)))  (cost=0.86 rows=3)
            -> Covering index range scan on sbtest1 using k_1 over (k = 110 AND k2 = 112) OR (k = 111 AND k2 = 112) OR (k = 112 AND k2 = 112)  (cost=0.86 rows=3)

explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 > 112 order by id limit 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=0.86 rows=3)
    -> Sort: sbtest1.id, limit input to 3 row(s) per chunk  (cost=0.86 rows=3)
        -> Filter: ((sbtest1.k in (110,111,112)) and (sbtest1.k2 > 112))  (cost=0.86 rows=3)
            -> Covering index range scan on sbtest1 using k_1 over (k = 110 AND 112 < k2) OR (k = 111 AND 112 < k2) OR (k = 112 AND 112 < k2)  (cost=0.86 rows=3)

explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 > 112 order by k2, id limit 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=0.86 rows=3)
    -> Sort: sbtest1.k2, sbtest1.id, limit input to 3 row(s) per chunk  (cost=0.86 rows=3)
        -> Filter: ((sbtest1.k in (110,111,112)) and (sbtest1.k2 > 112))  (cost=0.86 rows=3)
            -> Covering index range scan on sbtest1 using k_1 over (k = 110 AND 112 < k2 pushed_limit 3) OR (k = 111 AND 112 < k2 pushed_limit 3) OR (k = 112 AND 112 < k2 pushed_limit 3)  (cost=0.86 rows=3)

# cannot pushdown limit when it is not equal range
explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 between 112 and 120 order by id limit 3;
EXPLAIN
-> Limit: 3 row(s)  (cost=1.06 rows=3)
    -> Sort: sbtest1.id, limit input to 3 row(s) per chunk  (cost=1.06 rows=4)
        -> Filter: ((sbtest1.k in (110,111,112)) and (sbtest1.k2 between 112 and 120))  (cost=1.06 rows=4)
            -> Covering index range scan on sbtest1 using k_1 over (k = 110 AND 112 <= k2 <= 120) OR (k = 111 AND 112 <= k2 <= 120) OR (k = 112 AND 112 <= k2 <= 120)  (cost=1.06 rows=4)

drop table sbtest1;
drop table if exists sbtest2;
CREATE TABLE `sbtest2` (
`id1` int NOT NULL,
`id2` int NOT NULL,
`k1` int NOT NULL DEFAULT '0',
`k2` int DEFAULT NULL,
`k3` int DEFAULT NULL,
`k4` int DEFAULT NULL,
`k5` int DEFAULT NULL,
`k6` int DEFAULT NULL,
`k7` int DEFAULT NULL,
`k8` int DEFAULT NULL,
`k9` int DEFAULT NULL,
`k10` int DEFAULT NULL,
`k11` int DEFAULT NULL,
`k12` int DEFAULT NULL,
`k13` int DEFAULT NULL,
`k14` int DEFAULT NULL,
`k15` int DEFAULT NULL,
`k16` int DEFAULT NULL,
`k17` int DEFAULT NULL,
`c` char(60) NULL DEFAULT '',
PRIMARY KEY (`id1`,`id2`),
UNIQUE KEY `uk` (`k1`, `id1`, `k17`),
KEY `key1` (`k1`, `k2`, `id1`,`k3`),
KEY `key2` (`k1`, `k2`, `k3`, `k4`, `k5`, `k6`, `k7`, `k8`, `k9`, `k10`, `k11`, `k12`, `k13`, `k14`, `k15`)
);
