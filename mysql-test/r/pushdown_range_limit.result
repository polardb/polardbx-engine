# should push down limit
explain format=tree select id1, id2, c from sbtest2 force index(key1) where k1 in (10, 20) and k2 in (11, 21) order by id1 limit 1,1;
EXPLAIN
-> Limit/Offset: 1/1 row(s)  (cost=5.06 rows=1)
    -> Sort: sbtest2.id1, limit input to 2 row(s) per chunk  (cost=5.06 rows=9)
        -> Index range scan on sbtest2 using key1 over (k1 = 10 AND k2 = 11 pushed_limit 2) OR (k1 = 10 AND k2 = 21 pushed_limit 2) OR (2 more), with index condition: ((sbtest2.k1 in (10,20)) and (sbtest2.k2 in (11,21)))  (cost=5.06 rows=9)

select id1, id2, c from sbtest2 force index(key1) where k1 in (10, 20) and k2 in (11, 21) order by id1 limit 2,3;
id1	id2	c
2	3	Record 6
3	3	Record 9
3	1	Record 7
# cannot push down limit, order by column does not match
explain format=tree select id1, id2, c from sbtest2 force index(key1) where k1 in (10, 20) and k2 in (11, 21) order by id2 limit 1, 2;
EXPLAIN
-> Limit/Offset: 2/1 row(s)  (cost=5.06 rows=2)
    -> Sort: sbtest2.id2, limit input to 3 row(s) per chunk  (cost=5.06 rows=9)
        -> Index range scan on sbtest2 using key1 over (k1 = 10 AND k2 = 11) OR (k1 = 10 AND k2 = 21) OR (2 more), with index condition: ((sbtest2.k1 in (10,20)) and (sbtest2.k2 in (11,21)))  (cost=5.06 rows=9)

select id1, id2 ,c from sbtest2 force index(key1) where k1 in (10, 20) and k2 in (11, 21) order by id2 limit 1, 2;
id1	id2	c
1	2	Record 2
2	2	Record 5
# can push down limit with ICP
explain format=tree select id1, id2, c from sbtest2 force index(key1) where k1 in (10, 20) and k2 in (11, 21) and id1 in (1, 2, 5, 7) and k3 > 0 order by k3 limit 3, 2;
EXPLAIN
-> Limit/Offset: 2/3 row(s)  (cost=11.66 rows=2)
    -> Sort: sbtest2.k3, limit input to 5 row(s) per chunk  (cost=11.66 rows=17)
        -> Index range scan on sbtest2 using key1 over (k1 = 10 AND k2 = 11 AND id1 = 1 AND 0 < k3 pushed_limit 5) OR (k1 = 10 AND k2 = 11 AND id1 = 2 AND 0 < k3 pushed_limit 5) OR (14 more), with index condition: ((sbtest2.k1 in (10,20)) and (sbtest2.k2 in (11,21)) and (sbtest2.id1 in (1,2,5,7)) and (sbtest2.k3 > 0))  (cost=11.66 rows=17)

select id1, id2, c from sbtest2 force index(key1) where k1 in (10, 20) and k2 in (11, 21) and id1 in (1, 2, 5, 7) and k3 > 0 order by k3 limit 3, 2;
id1	id2	c
5	6	Record 16
# cannot push down limit, order by column does not match (missing k13)
explain format=tree select id1, id2, c from sbtest2 force index(key2) where k1 in (10, 20) and k2 in (11, 21) order by k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k14, k15 limit 2,3;
EXPLAIN
-> Limit/Offset: 3/2 row(s)  (cost=5.06 rows=3)
    -> Sort: sbtest2.k3, sbtest2.k4, sbtest2.k5, sbtest2.k6, sbtest2.k7, sbtest2.k8, sbtest2.k9, sbtest2.k10, sbtest2.k11, sbtest2.k12, sbtest2.k14, sbtest2.k15, limit input to 5 row(s) per chunk  (cost=5.06 rows=9)
        -> Index range scan on sbtest2 using key2 over (k1 = 10 AND k2 = 11) OR (k1 = 10 AND k2 = 21) OR (2 more), with index condition: ((sbtest2.k1 in (10,20)) and (sbtest2.k2 in (11,21)))  (cost=5.06 rows=9)

# reaches max key columns(16), it's OK
explain format=tree select id1, id2, c from sbtest2 force index(key2) where k1 in (10, 20) and k2 in (11, 21) order by k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, id1 limit 2,3;
EXPLAIN
-> Limit/Offset: 3/2 row(s)  (cost=5.06 rows=3)
    -> Sort: sbtest2.k3, sbtest2.k4, sbtest2.k5, sbtest2.k6, sbtest2.k7, sbtest2.k8, sbtest2.k9, sbtest2.k10, sbtest2.k11, sbtest2.k12, sbtest2.k13, sbtest2.k14, sbtest2.k15, sbtest2.id1, limit input to 5 row(s) per chunk  (cost=5.06 rows=9)
        -> Index range scan on sbtest2 using key2 over (k1 = 10 AND k2 = 11 pushed_limit 5) OR (k1 = 10 AND k2 = 21 pushed_limit 5) OR (2 more), with index condition: ((sbtest2.k1 in (10,20)) and (sbtest2.k2 in (11,21)))  (cost=5.06 rows=9)

select id1, id2, c from sbtest2 force index(key2) where k1 in (10, 20) and k2 in (11, 21) order by k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, id1 limit 2,3;
id1	id2	c
