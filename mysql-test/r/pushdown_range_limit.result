5	6	Record 16
3	1	Record 7
# exceeds max key columns, cannot push down limit
explain format=tree select id1, id2, c from sbtest2 force index(key2) where k1 in (10, 20) and k2 in (11, 21) order by k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, id1, id2 limit 2,3;
EXPLAIN
-> Limit/Offset: 3/2 row(s)  (cost=5.06 rows=3)
    -> Sort: sbtest2.k3, sbtest2.k4, sbtest2.k5, sbtest2.k6, sbtest2.k7, sbtest2.k8, sbtest2.k9, sbtest2.k10, sbtest2.k11, sbtest2.k12, sbtest2.k13, sbtest2.k14, sbtest2.k15, sbtest2.id1, sbtest2.id2, limit input to 5 row(s) per chunk  (cost=5.06 rows=9)
        -> Index range scan on sbtest2 using key2 over (k1 = 10 AND k2 = 11) OR (k1 = 10 AND k2 = 21) OR (2 more), with index condition: ((sbtest2.k1 in (10,20)) and (sbtest2.k2 in (11,21)))  (cost=5.06 rows=9)

select id1, id2, c from sbtest2 force index(key2) where k1 in (10, 20) and k2 in (11, 21) order by k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, id1, id2 limit 2,3;
id1	id2	c
2	3	Record 6
5	6	Record 16
3	1	Record 7
# this is a skip_sort on uk, cannot push down limit
explain format=tree select id1, id2, c,k17 from sbtest2 force index(uk) where k1 in (10, 20) and id1 in (1, 2, 5) and k17 = 17 order by k17 limit 1, 1;
EXPLAIN
-> Limit/Offset: 1/1 row(s)  (cost=4.21 rows=1)
    -> Index range scan on sbtest2 using uk over (k1 = 10 AND id1 = 1 AND k17 = 17) OR (k1 = 10 AND id1 = 2 AND k17 = 17) OR (4 more), with index condition: ((sbtest2.k17 = 17) and (sbtest2.k1 in (10,20)) and (sbtest2.id1 in (1,2,5)))  (cost=4.21 rows=6)

# push down limit on a uk, it's OK
explain format=tree select id1, id2, c,k17 from sbtest2 force index(uk) where k1 in (10, 20) and id1 in (1, 2, 5) and k17 in (17, 34) order by k17 limit 2, 2;
EXPLAIN
-> Limit/Offset: 2/2 row(s)  (cost=8.41 rows=2)
    -> Sort: sbtest2.k17, limit input to 4 row(s) per chunk  (cost=8.41 rows=12)
        -> Index range scan on sbtest2 using uk over (k1 = 10 AND id1 = 1 AND k17 = 17 pushed_limit 4) OR (k1 = 10 AND id1 = 1 AND k17 = 34 pushed_limit 4) OR (10 more), with index condition: ((sbtest2.k1 in (10,20)) and (sbtest2.id1 in (1,2,5)) and (sbtest2.k17 in (17,34)))  (cost=8.41 rows=12)

select id1, id2, c,k17 from sbtest2 force index(uk) where k1 in (10, 20) and id1 in (1, 2, 5) and k17 in (17, 34) order by k17 limit 2, 2;
id1	id2	c	k17
1	2	Record 2	34
