drop procedure if exists proc_test;
CREATE PROCEDURE proc_test(IN arg1 INT, IN arg2 INT, IN arg3 INT, IN arg4 INT)
BEGIN
set pushdown_range_limit=true;
explain format=tree select id1, id2, c from sbtest2 force index(key1) where k1 in (arg1, arg2) and k2 in (arg3, arg4) order by id1 limit 1,1;
select id1, id2, c from sbtest2 force index(key1) where k1 in (arg1, arg2) and k2 in (arg3, arg4) order by id1 limit 2,3;
explain format=tree select id1, id2, c from sbtest2 force index(key1) where k1 in (arg1, arg2) and k2 in (arg3, arg4) order by id2 limit 1, 2;
select id1, id2 ,c from sbtest2 force index(key1) where k1 in (arg1, arg2) and k2 in (arg3, arg4) order by id2 limit 1, 2;
explain format=tree select id1, id2, c from sbtest2 force index(key1) where k1 in (arg1, arg2) and k2 in (arg3, arg4) and id1 in (1, 2, 5, 7) and k3 > 0 order by k3 limit 3, 2;
select id1, id2, c from sbtest2 force index(key1) where k1 in (arg1, arg2) and k2 in (arg3, arg4) and id1 in (1, 2, 5, 7) and k3 > 0 order by k3 limit 3, 2;
explain format=tree select id1, id2, c from sbtest2 force index(key2) where k1 in (arg1, arg2) and k2 in (arg3, arg4) order by k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k14, k15 limit 2,3;
explain format=tree select id1, id2, c from sbtest2 force index(key2) where k1 in (arg1, arg2) and k2 in (arg3, arg4) order by k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, id1 limit 2,3;
select id1, id2, c from sbtest2 force index(key2) where k1 in (arg1, arg2) and k2 in (arg3, arg4) order by k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, id1 limit 2,3;
explain format=tree select id1, id2, c from sbtest2 force index(key2) where k1 in (arg1, arg2) and k2 in (arg3, arg4) order by k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, id1, id2 limit 2,3;
select id1, id2, c from sbtest2 force index(key2) where k1 in (arg1, arg2) and k2 in (arg3, arg4) order by k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, id1, id2 limit 2,3;
END //
call proc_test(10, 20, 11, 21);
EXPLAIN
