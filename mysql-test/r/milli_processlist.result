"Test INFORMATION_SCHEMA.MILLI_PROCESSLIST table exists"
SELECT TABLE_NAME, TABLE_SCHEMA 
FROM INFORMATION_SCHEMA.TABLES 
WHERE TABLE_NAME = 'MILLI_PROCESSLIST' 
AND TABLE_SCHEMA = 'INFORMATION_SCHEMA';
TABLE_NAME	TABLE_SCHEMA
"Test MILLI_PROCESSLIST column definitions"
SELECT COLUMN_NAME, DATA_TYPE, COLUMN_TYPE 
FROM INFORMATION_SCHEMA.COLUMNS 
WHERE TABLE_SCHEMA = 'INFORMATION_SCHEMA' 
AND TABLE_NAME = 'MILLI_PROCESSLIST' 
ORDER BY ORDINAL_POSITION;
COLUMN_NAME	DATA_TYPE	COLUMN_TYPE
"Test basic query from MILLI_PROCESSLIST"
SELECT ID, USER, HOST, DB, COMMAND, TIME, STATE, INFO 
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST 
WHERE ID = CONNECTION_ID();
ID	USER	HOST	DB	COMMAND	TIME	STATE	INFO
ID	root	HOST	test	Query	TIME	executing	SELECT ID, USER, HOST, DB, COMMAND, TIME, STATE, INFO 
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST 
WHERE ID = CONNECTION_ID()
