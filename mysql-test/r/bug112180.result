CREATE TABLE `foo_t` (
`id` bigint unsigned NOT NULL AUTO_INCREMENT,
`schema_id` bigint unsigned NOT NULL,
`name` varchar(64),
`type` enum('BASE TABLE','VIEW','SYSTEM VIEW'),
`engine` varchar(64),
PRIMARY KEY (`id`),
UNIQUE KEY `schema_id` (`schema_id`,`name`)
) ENGINE=InnoDB AUTO_INCREMENT=1 STATS_PERSISTENT=0;
