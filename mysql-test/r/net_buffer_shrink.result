#
# Test 5: Verify no repeated shrink when net_buffer_length is not 4KB aligned
#
# Reset compression algorithms to allow uncompressed connection
SET @@global.protocol_compression_algorithms = 'zlib,zstd,uncompressed';
# Set net_buffer_length to 3KB (3072), which is not 4KB aligned
SET @@global.net_buffer_length = 3072;
SET @@global.net_buff_shrink_enabled = 1;
SET @@global.net_buff_shrink_thresh = 5;
# Reconnect to apply new net_buffer_length setting
USE buf_test;
# Check initial buffer size
SELECT NET_BUFF_SIZE, BUFF_SHRINK_COUNT 
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST 
WHERE ID = CONNECTION_ID();
NET_BUFF_SIZE	BUFF_SHRINK_COUNT
3072	0
