USE buf_test;
#
# Test 6: Verify shrink_thresh=0 - shrink immediately without waiting for consecutive small packets
#
# Reset compression algorithms to allow uncompressed connection
SET @@global.protocol_compression_algorithms = 'zlib,zstd,uncompressed';
# Set net_buffer_length to initial value 16384
SET @@global.net_buffer_length = 16384;
# Enable buffer shrink with immediate mode (thresh=0)
SET @@global.net_buff_shrink_enabled = 1;
SET @@global.net_buff_shrink_thresh = 0;
# Reconnect to apply new settings
USE buf_test;
# Check initial buffer size and statistics
SELECT NET_BUFF_SIZE, BUFF_SHRINK_COUNT
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST
WHERE ID = CONNECTION_ID();
NET_BUFF_SIZE	BUFF_SHRINK_COUNT
16384	0
# Send large packet to expand buffer
# Verify buffer shrunk immediately
SELECT NET_BUFF_SIZE, BUFF_SHRINK_COUNT
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST
WHERE ID = CONNECTION_ID();
NET_BUFF_SIZE	BUFF_SHRINK_COUNT
16384	1
#
# Cleanup
#
DROP TABLE t1;
DROP DATABASE buf_test;
# Restore original settings
SET @@global.net_buff_shrink_enabled = 0;
SET @@global.net_buff_shrink_thresh = 5;
SET @@global.protocol_compression_algorithms = 'zlib,zstd,uncompressed';
SET @@global.net_buffer_length = 16384;
