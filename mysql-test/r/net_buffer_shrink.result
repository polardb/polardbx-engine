# Set net_buffer_length to initial value 16384
SET @@global.net_buffer_length = 16384;
#
# Test 1: Buffer expansion and shrink
#
# Enable buffer shrink feature
SET @@global.net_buff_shrink_enabled = 1;
SET @@global.net_buff_shrink_thresh = 5;
CREATE DATABASE IF NOT EXISTS buf_test;
USE buf_test;
DROP TABLE IF EXISTS t1;
Warnings:
Note	1051	Unknown table 'buf_test.t1'
CREATE TABLE t1 (id INT PRIMARY KEY, data1 LONGBLOB, data2 LONGBLOB);
# Check initial buffer size and statistics for current connection
SELECT NET_BUFF_SIZE, BUFF_SHRINK_COUNT
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST 
WHERE ID = CONNECTION_ID();
NET_BUFF_SIZE	BUFF_SHRINK_COUNT
16384	0
# Generate large data string (32KB) and send it to server via INSERT
# Note: net_buffer only expands when server RECEIVES data from client
# Verify buffer expanded - check buffer size increased and expand count incremented
SELECT NET_BUFF_SIZE, BUFF_SHRINK_COUNT 
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST 
WHERE ID = CONNECTION_ID();
NET_BUFF_SIZE	BUFF_SHRINK_COUNT
69632	0
# Send multiple small packets to trigger buffer shrink
# Send 10 small queries (threshold is 5, so should shrink after 5th consecutive small packet)
SELECT 'small query 1' AS test_query;
test_query
small query 1
SELECT 'small query 2' AS test_query;
test_query
small query 2
SELECT 'small query 3' AS test_query;
test_query
small query 3
SELECT 'small query 4' AS test_query;
test_query
small query 4
SELECT 'small query 5' AS test_query;
test_query
small query 5
# Verify buffer shrunk after consecutive small packets - check buffer size decreased and shrink count incremented
SELECT NET_BUFF_SIZE, BUFF_SHRINK_COUNT 
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST 
WHERE ID = CONNECTION_ID();
NET_BUFF_SIZE	BUFF_SHRINK_COUNT
16384	1
#
# Test 2: Verify buffer shrink is disabled when feature is off
#
SET @@global.net_buff_shrink_enabled = 0;
# Generate and send large data (32KB) to expand buffer
# Check buffer state before sending small packets
SELECT NET_BUFF_SIZE, BUFF_SHRINK_COUNT 
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST 
WHERE ID = CONNECTION_ID();
NET_BUFF_SIZE	BUFF_SHRINK_COUNT
69632	1
# Send small packets (should NOT trigger shrink when feature is disabled)
SELECT 'small query disabled 1' AS test_query;
test_query
small query disabled 1
SELECT 'small query disabled 2' AS test_query;
test_query
small query disabled 2
SELECT 'small query disabled 3' AS test_query;
test_query
small query disabled 3
SELECT 'small query disabled 4' AS test_query;
test_query
small query disabled 4
SELECT 'small query disabled 5' AS test_query;
test_query
small query disabled 5
# Verify no shrink happened when feature is disabled - shrink count should not increase
SELECT NET_BUFF_SIZE, BUFF_SHRINK_COUNT 
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST 
WHERE ID = CONNECTION_ID();
NET_BUFF_SIZE	BUFF_SHRINK_COUNT
69632	1
#
# Test 3: Buffer expansion and shrink with compression enabled
#
# Enable compression and buffer shrink feature
SET @@global.protocol_compression_algorithms = 'zlib';
SET @@global.net_buff_shrink_enabled = 1;
SET @@global.net_buff_shrink_thresh = 5;
# Reconnect with compression enabled
USE buf_test;
# Check initial buffer size and statistics for compressed connection
SELECT NET_BUFF_SIZE, BUFF_SHRINK_COUNT 
FROM INFORMATION_SCHEMA.MILLI_PROCESSLIST 
WHERE ID = CONNECTION_ID();
NET_BUFF_SIZE	BUFF_SHRINK_COUNT
16384	0
