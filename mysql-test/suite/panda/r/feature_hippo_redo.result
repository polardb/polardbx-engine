########################################################################
# Test 6: Page split scenario
# Trigger: MLOG_PAGE_CREATE_HIPPO via page split
########################################################################
## Testing page split with sequential inserts
SET opt_index_format_hippo_enabled=on;
# 1. Prepare: create table with HIPPO index
CREATE TABLE t_hippo_split (id INT PRIMARY KEY, val INT, padding VARCHAR(500), INDEX idx_val(val)) ENGINE=InnoDB;;
SET GLOBAL innodb_log_checkpoint_now=1;
# 2. Disable checkpoint and produce redo log
SET GLOBAL innodb_checkpoint_disabled=1;
INSERT INTO t_hippo_split SELECT seq, seq, REPEAT('p', 400) FROM (SELECT @rownum := @rownum + 1 AS seq FROM (SELECT @rownum := 0) r, information_schema.columns a LIMIT 200) t;;
Warnings:
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
# Kill the server
# 3.1 Apply redo log when restarting and crash (test redo apply idempotency)
# 3.2 Apply redo log when restarting and no crash
# restart: 
# 4. Clean up
SET DEBUG = '-d,crash_if_hippo_in_redo';
SET GLOBAL innodb_checkpoint_disabled=0;
SELECT COUNT(*) FROM t_hippo_split; SELECT COUNT(*) FROM t_hippo_split USE INDEX(idx_val) WHERE val > 0; DROP TABLE IF EXISTS t_hippo_split;;
