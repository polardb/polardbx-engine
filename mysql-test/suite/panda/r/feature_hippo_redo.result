########################################################################
# Test 2: MLOG_REC_SEC_TID_DELETE_MARK
# Trigger: DELETE operation on HIPPO secondary index
########################################################################
## Row format: DYNAMIC
SET opt_index_format_hippo_enabled=on;
# 1. Prepare: create table with HIPPO index
CREATE TABLE t_hippo_del (id INT PRIMARY KEY, val INT, INDEX idx_val(val)) ROW_FORMAT=DYNAMIC ENGINE=InnoDB; INSERT INTO t_hippo_del VALUES (1, 100), (2, 200), (3, 300), (4, 400), (5, 500);;
SET GLOBAL innodb_log_checkpoint_now=1;
# 2. Disable checkpoint and produce redo log
SET GLOBAL innodb_checkpoint_disabled=1;
DELETE FROM t_hippo_del WHERE id IN (2, 4);;
# Kill the server
# 3.1 Apply redo log when restarting and crash (test redo apply idempotency)
# 3.2 Apply redo log when restarting and no crash
# restart: 
# 4. Clean up
SET DEBUG = '-d,crash_if_hippo_in_redo';
SET GLOBAL innodb_checkpoint_disabled=0;
SELECT * FROM t_hippo_del ORDER BY id; SELECT * FROM t_hippo_del USE INDEX(idx_val) ORDER BY val; DROP TABLE IF EXISTS t_hippo_del;;
id	val
1	100
3	300
5	500
id	val
1	100
3	300
5	500
