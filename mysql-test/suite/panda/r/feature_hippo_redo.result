########################################################################
# Test 4: Mixed operations (INSERT + UPDATE + DELETE)
# Trigger: All HIPPO MLOG types in one transaction
########################################################################
## Row format: DYNAMIC
SET opt_index_format_hippo_enabled=on;
# 1. Prepare: create table with HIPPO index
CREATE TABLE t_hippo_mix (id INT PRIMARY KEY, val INT, data VARCHAR(100), INDEX idx_val(val)) ROW_FORMAT=DYNAMIC ENGINE=InnoDB; INSERT INTO t_hippo_mix VALUES (1, 100, 'a'), (2, 200, 'b'), (3, 300, 'c');;
SET GLOBAL innodb_log_checkpoint_now=1;
# 2. Disable checkpoint and produce redo log
SET GLOBAL innodb_checkpoint_disabled=1;
BEGIN; INSERT INTO t_hippo_mix VALUES (4, 400, 'd'), (5, 500, 'e'); UPDATE t_hippo_mix SET val = 999 WHERE id = 2; DELETE FROM t_hippo_mix WHERE id = 3; COMMIT;;
# Kill the server
# 3.1 Apply redo log when restarting and crash (test redo apply idempotency)
# 3.2 Apply redo log when restarting and no crash
# restart: 
# 4. Clean up
SET DEBUG = '-d,crash_if_hippo_in_redo';
SET GLOBAL innodb_checkpoint_disabled=0;
SELECT * FROM t_hippo_mix ORDER BY id; SELECT * FROM t_hippo_mix USE INDEX(idx_val) ORDER BY val; DROP TABLE IF EXISTS t_hippo_mix;;
id	val	data
1	100	a
2	999	b
4	400	d
5	500	e
id	val	data
1	100	a
4	400	d
5	500	e
2	999	b
