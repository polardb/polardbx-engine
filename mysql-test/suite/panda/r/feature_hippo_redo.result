########################################################################
# Test 1: MLOG_PAGE_CREATE_HIPPO / MLOG_COMP_PAGE_CREATE_HIPPO
# Trigger: Creating new HIPPO index pages via bulk INSERT
########################################################################
# Test 1.1: INSERT to trigger page creation (DYNAMIC format)
## Row format: DYNAMIC
SET opt_index_format_hippo_enabled=on;
# 1. Prepare: create table with HIPPO index
CREATE TABLE t_hippo_page (id INT PRIMARY KEY, val INT, data VARCHAR(200), INDEX idx_val(val)) ROW_FORMAT=DYNAMIC ENGINE=InnoDB;;
SET GLOBAL innodb_log_checkpoint_now=1;
# 2. Disable checkpoint and produce redo log
SET GLOBAL innodb_checkpoint_disabled=1;
INSERT INTO t_hippo_page SELECT seq, seq, REPEAT('x', 100) FROM (SELECT @rownum := @rownum + 1 AS seq FROM (SELECT @rownum := 0) r, information_schema.columns a, information_schema.columns b LIMIT 500) t;;
Warnings:
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
# Kill the server
# 3.1 Apply redo log when restarting and crash (test redo apply idempotency)
# 3.2 Apply redo log when restarting and no crash
# restart: 
# 4. Clean up
SET DEBUG = '-d,crash_if_hippo_in_redo';
SET GLOBAL innodb_checkpoint_disabled=0;
SELECT COUNT(*) FROM t_hippo_page; SELECT COUNT(*) FROM t_hippo_page USE INDEX(idx_val) WHERE val > 0; DROP TABLE IF EXISTS t_hippo_page;;
COUNT(*)
500
COUNT(*)
500
