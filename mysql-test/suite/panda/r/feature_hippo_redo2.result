########################################################################
# Test 3: uncommitted indexed UPDATE rolled back during recovery
# The committed DELETE must survive; the uncommitted UPDATE of the
# indexed column must be undone (secondary entry restored, tid reset).
########################################################################
## Row format: DYNAMIC
SET opt_index_format_hippo_enabled=on;
# 1. Prepare: create table with HIPPO index
CREATE TABLE t_hippo_urb (id INT PRIMARY KEY, val INT, INDEX idx_val(val)) ROW_FORMAT=DYNAMIC ENGINE=InnoDB; INSERT INTO t_hippo_urb VALUES (1,100),(2,200),(3,300),(4,400);;
SET GLOBAL innodb_log_checkpoint_now=1;
# 2. Disable checkpoint and produce redo log
SET GLOBAL innodb_checkpoint_disabled=1;
BEGIN; DELETE FROM t_hippo_urb WHERE id=4; COMMIT; BEGIN; UPDATE t_hippo_urb SET val=999 WHERE id=1;;
# Kill the server
# 3.1 Apply redo log when restarting and crash (test redo apply idempotency)
# 3.2 Apply redo log when restarting and no crash
# restart: 
# 4. Clean up
SET DEBUG = '-d,crash_if_hippo_in_redo';
SET GLOBAL innodb_checkpoint_disabled=0;
SELECT * FROM t_hippo_urb ORDER BY id; SELECT id FROM t_hippo_urb USE INDEX(idx_val) WHERE val=100; SELECT id FROM t_hippo_urb USE INDEX(idx_val) WHERE val=999; DROP TABLE IF EXISTS t_hippo_urb;;
id	val
1	100
2	200
3	300
id
1
id
