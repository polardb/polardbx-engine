########################################################################
# Test 1: delete-unmark (in-place Lotus update redo)
# Delete a row then re-insert the SAME (pk,value) in one transaction so
# the delete-marked secondary entry is revived in place, exercising the
# MLOG_REC_UPDATE_IN_PLACE redo path with Lotus tid fields.
########################################################################
## Row format: DYNAMIC
SET opt_index_format_hippo_enabled=on;
# 1. Prepare: create table with HIPPO index
CREATE TABLE t_hippo_unmark (id INT PRIMARY KEY, val INT, INDEX idx_val(val)) ROW_FORMAT=DYNAMIC ENGINE=InnoDB; INSERT INTO t_hippo_unmark VALUES (1, 100), (2, 200), (3, 300);;
SET GLOBAL innodb_log_checkpoint_now=1;
# 2. Disable checkpoint and produce redo log
SET GLOBAL innodb_checkpoint_disabled=1;
BEGIN; DELETE FROM t_hippo_unmark WHERE id = 2; INSERT INTO t_hippo_unmark VALUES (2, 200); COMMIT;;
# Kill the server
# 3.1 Apply redo log when restarting and crash (test redo apply idempotency)
# 3.2 Apply redo log when restarting and no crash
# restart: 
# 4. Clean up
SET DEBUG = '-d,crash_if_hippo_in_redo';
SET GLOBAL innodb_checkpoint_disabled=0;
SELECT * FROM t_hippo_unmark ORDER BY id; SELECT * FROM t_hippo_unmark USE INDEX(idx_val) ORDER BY val; DROP TABLE IF EXISTS t_hippo_unmark;;
id	val
1	100
2	200
3	300
id	val
1	100
2	200
3	300
## Row format: REDUNDANT
