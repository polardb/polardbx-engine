########################################################################
# Test 2: crash recovery with MULTIPLE hippo indexes
########################################################################
## Row format: DYNAMIC
SET opt_index_format_hippo_enabled=on;
# 1. Prepare: create table with HIPPO index
CREATE TABLE t_hippo_multi (id INT PRIMARY KEY, a INT, b INT, INDEX idx_a(a), INDEX idx_b(b)) ROW_FORMAT=DYNAMIC ENGINE=InnoDB; INSERT INTO t_hippo_multi VALUES (1,10,20),(2,10,30),(3,20,40),(4,30,50);;
SET GLOBAL innodb_log_checkpoint_now=1;
# 2. Disable checkpoint and produce redo log
SET GLOBAL innodb_checkpoint_disabled=1;
BEGIN; UPDATE t_hippo_multi SET a=15, b=25 WHERE id=1; DELETE FROM t_hippo_multi WHERE id=3; INSERT INTO t_hippo_multi VALUES (5,10,20); COMMIT;;
# Kill the server
# 3.1 Apply redo log when restarting and crash (test redo apply idempotency)
# 3.2 Apply redo log when restarting and no crash
# restart: 
# 4. Clean up
SET DEBUG = '-d,crash_if_hippo_in_redo';
SET GLOBAL innodb_checkpoint_disabled=0;
SELECT * FROM t_hippo_multi ORDER BY id; SELECT id FROM t_hippo_multi USE INDEX(idx_a) WHERE a=10 ORDER BY id; SELECT id FROM t_hippo_multi USE INDEX(idx_b) WHERE b=20 ORDER BY id; DROP TABLE IF EXISTS t_hippo_multi;;
id	a	b
1	15	25
2	10	30
4	30	50
5	10	20
id
2
5
id
5
