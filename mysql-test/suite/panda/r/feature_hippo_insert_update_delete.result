# Test 3.2c.5: Empty string to spaces - Path 4A (optimistic non-in-place update)
# Strategy: Use sparse page (not near threshold) to allow optimistic update
# Field size changes but page has enough space for delete+insert
# This triggers optimistic non-in-place update (not pessimistic)
DROP TABLE IF EXISTS t_space_opt;
Warnings:
Note	1051	Unknown table 'test.t_space_opt'
CREATE TABLE t_space_opt (
id BIGINT PRIMARY KEY,
unit_id BIGINT NOT NULL,
nick_name VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
KEY auto_shard_key_nick_name (nick_name) COMMENT 'hippo_index'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci ROW_FORMAT=DYNAMIC;
# Insert only a few records to keep page sparse
BEGIN;
INSERT INTO t_space_opt VALUES (1, 100, ''), (2, 100, ''), (3, 100, ''), (4, 100, ''), (5, 100, '');
COMMIT;
# Step 1: Insert target record with empty string and delete it
BEGIN;
INSERT INTO t_space_opt VALUES (100, 100, '');
DELETE FROM t_space_opt WHERE id=100;
COMMIT;
# Step 2: Insert with spaces - page has enough space
# This triggers optimistic non-in-place update (Path 4A)
# btr_cur_optimistic_update succeeds, delete+insert within same page
BEGIN;
INSERT INTO t_space_opt VALUES (100, 100, '  ');
SELECT * FROM t_space_opt FORCE INDEX(auto_shard_key_nick_name) WHERE nick_name='  ';
id	unit_id	nick_name
1	100	
2	100	
3	100	
4	100	
5	100	
100	100	  
COMMIT;
# Test 3.2c.6: Single space to multiple spaces - Path 4A (optimistic non-in-place)
BEGIN;
INSERT INTO t_space_opt VALUES (200, 200, ' ');
DELETE FROM t_space_opt WHERE id=200;
# Insert with more spaces - optimistic update succeeds
INSERT INTO t_space_opt VALUES (200, 200, '   ');
SELECT * FROM t_space_opt FORCE INDEX(auto_shard_key_nick_name) WHERE nick_name='   ';
id	unit_id	nick_name
1	100	
2	100	
3	100	
4	100	
5	100	
100	100	  
200	200	   
COMMIT;
# Test 3.2c.7: Verify all records are correctly stored
SELECT id, unit_id, LENGTH(nick_name) as nick_name_len, 
CASE WHEN nick_name = '' THEN '(empty)' 
WHEN nick_name = ' ' THEN '(1 space)' 
WHEN nick_name = '  ' THEN '(2 spaces)'
            WHEN nick_name = '   ' THEN '(3 spaces)'
            WHEN nick_name = '    ' THEN '(4 spaces)'
            ELSE nick_name END as nick_name_display
FROM t_space FORCE INDEX(auto_shard_key_nick_name) ORDER BY id;
