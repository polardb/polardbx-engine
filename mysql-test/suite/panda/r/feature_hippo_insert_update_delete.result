# Step 1: Insert target record with empty string and delete it
# This creates a delete-marked record that will be found by row_ins_must_modify_rec()
BEGIN;
INSERT INTO t_space VALUES (1392684638434107392, 1250056650086289408, '');
DELETE FROM t_space WHERE id=1392684638434107392;
COMMIT;
# Step 2: Insert with spaces - search finds '' (collation treats as equal)
# but binary comparison shows length difference (0 vs 2)
# With page near threshold, deleting small record and inserting larger one
# may cause page data size to drop below BTR_CUR_PAGE_COMPRESS_LIMIT (50% of page)
# This triggers DB_UNDERFLOW -> pessimistic update path
BEGIN;
INSERT INTO t_space VALUES (1392684638434107392, 1250056650086289408, '  ');
