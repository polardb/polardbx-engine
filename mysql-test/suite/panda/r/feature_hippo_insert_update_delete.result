########################################################################
# Test 4: DELETE - Trigger row_sec_assert_tid_in_rec()
########################################################################
# Test 4.1: Delete by primary key
# Triggers delete-mark on HIPPO index at lizard0btr0cur.cc:382
BEGIN;
DELETE FROM t1 WHERE id=9;
# Verify deleted record not visible via HIPPO index
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=1100 ORDER BY id;
id	val	data
1	1100	data1_updated
3	1100	data3
5	1100	data5
7	1100	data7
8	1100	data8
COMMIT;
# Test 4.2: Delete by indexed column
BEGIN;
DELETE FROM t1 WHERE val=1100;
SELECT COUNT(*) FROM t1;
COUNT(*)
5
COMMIT;
########################################################################
# Test 5: REPEATABLE READ - Stricter MVCC test with FORCE INDEX
########################################################################
DROP TABLE IF EXISTS t2;
Warnings:
Note	1051	Unknown table 'test.t2'
CREATE TABLE t2 (
id INT PRIMARY KEY,
val INT,
KEY idx_val (val) COMMENT 'hippo_index'
) ENGINE=InnoDB;
INSERT INTO t2 VALUES (1,10), (2,20), (3,30), (4,40), (5,50);
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
BEGIN;
# con1: Establish snapshot with FORCE INDEX
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val >= 20 ORDER BY id;
id	val
2	20
3	30
4	40
5	50
BEGIN;
INSERT INTO t2 VALUES (6, 25);
UPDATE t2 SET val=35 WHERE id=3;
DELETE FROM t2 WHERE id=5;
COMMIT;
# con1: Should still see old snapshot via HIPPO index
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val >= 20 ORDER BY id;
id	val
2	20
3	30
4	40
5	50
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val=25;
id	val
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val=30;
id	val
3	30
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val=50;
id	val
5	50
COMMIT;
# con1: New transaction sees new data
BEGIN;
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val >= 20 ORDER BY id;
id	val
2	20
3	35
4	40
6	25
COMMIT;
########################################################################
# Test 6: Multiple HIPPO indexes - All trigger assertions
########################################################################
DROP TABLE IF EXISTS t3;
Warnings:
Note	1051	Unknown table 'test.t3'
CREATE TABLE t3 (
pk INT PRIMARY KEY,
a INT,
b INT,
c VARCHAR(50),
KEY idx_a (a) COMMENT 'hippo_index',
KEY idx_b (b) COMMENT 'hippo_index'
) ENGINE=InnoDB;
# Test 6.1: INSERT into table with multiple HIPPO indexes
INSERT INTO t3 VALUES 
(1, 10, 20, 'data1'),
(2, 10, 30, 'data2'),
(3, 20, 20, 'data3'),
(4, 20, 40, 'data4'),
(5, 30, 50, 'data5');
# Verify both HIPPO indexes
SELECT index_name, index_page_type FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS 
WHERE table_name='t3' AND index_page_type='HIPPO_INDEX' ORDER BY index_name;
index_name	index_page_type
idx_a	HIPPO_INDEX
idx_b	HIPPO_INDEX
# Test 6.2: Query using different HIPPO indexes
SELECT * FROM t3 FORCE INDEX(idx_a) WHERE a=10 ORDER BY pk;
pk	a	b	c
1	10	20	data1
2	10	30	data2
SELECT * FROM t3 FORCE INDEX(idx_b) WHERE b=20 ORDER BY pk;
pk	a	b	c
1	10	20	data1
3	20	20	data3
# Test 6.3: UPDATE affects both HIPPO indexes
BEGIN;
UPDATE t3 SET a=15, b=25 WHERE pk=1;
SELECT * FROM t3 FORCE INDEX(idx_a) WHERE a=15;
pk	a	b	c
1	15	25	data1
SELECT * FROM t3 FORCE INDEX(idx_b) WHERE b=25;
pk	a	b	c
1	15	25	data1
COMMIT;
# Test 6.4: DELETE removes from both HIPPO indexes
BEGIN;
DELETE FROM t3 WHERE pk=5;
SELECT * FROM t3 FORCE INDEX(idx_a) WHERE a=30;
pk	a	b	c
SELECT * FROM t3 FORCE INDEX(idx_b) WHERE b=50;
pk	a	b	c
COMMIT;
########################################################################
# Test 7: Mixed DML in single transaction
########################################################################
DROP TABLE IF EXISTS t4;
Warnings:
Note	1051	Unknown table 'test.t4'
CREATE TABLE t4 (
id INT PRIMARY KEY,
val INT,
KEY idx_val (val) COMMENT 'hippo_index'
) ENGINE=InnoDB;
INSERT INTO t4 VALUES (1,10), (2,20), (3,30), (4,40), (5,50);
# Test 7.1: Mix INSERT/UPDATE/DELETE in one transaction
BEGIN;
INSERT INTO t4 VALUES (6, 15);
UPDATE t4 SET val=25 WHERE id=2;
DELETE FROM t4 WHERE id=4;
INSERT INTO t4 VALUES (7, 35);
UPDATE t4 SET val=55 WHERE id=5;
# Verify changes via HIPPO index
SELECT * FROM t4 FORCE INDEX(idx_val) WHERE val >= 15 ORDER BY id;
id	val
2	25
3	30
5	55
6	15
7	35
COMMIT;
# Test 7.2: Verify final state
SELECT * FROM t4 FORCE INDEX(idx_val) WHERE val < 30 ORDER BY id;
id	val
1	10
2	25
6	15
SELECT * FROM t4 FORCE INDEX(idx_val) WHERE val >= 30 ORDER BY id;
id	val
3	30
5	55
7	35
########################################################################
# Test 8: UPDATE edge cases - additional scenarios
########################################################################
DROP TABLE IF EXISTS t5;
Warnings:
Note	1051	Unknown table 'test.t5'
CREATE TABLE t5 (
id INT PRIMARY KEY,
idx_col INT,
non_idx_col VARCHAR(100),
KEY idx_col (idx_col) COMMENT 'hippo_index'
) ENGINE=InnoDB;
INSERT INTO t5 VALUES (1, 100, 'data1'), (2, 200, 'data2'), (3, 300, 'data3');
# Test 8.1: Update indexed column to new value (Path 1: DELETE+INSERT)
BEGIN;
UPDATE t5 SET idx_col=150 WHERE id=1;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=150;
id	idx_col	non_idx_col
1	150	data1
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=100;
id	idx_col	non_idx_col
COMMIT;
# Test 8.2: Update non-indexed column only
# Note: For HIPPO index, this still goes through secondary index update
BEGIN;
UPDATE t5 SET non_idx_col='data2_modified' WHERE id=2;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=200;
id	idx_col	non_idx_col
2	200	data2_modified
COMMIT;
# Test 8.3: Update both indexed and non-indexed columns
BEGIN;
UPDATE t5 SET idx_col=350, non_idx_col='data3_both_modified' WHERE id=3;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=350;
id	idx_col	non_idx_col
3	350	data3_both_modified
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=300;
id	idx_col	non_idx_col
COMMIT;
# Test 8.4: Update with same value (optimization may skip)
BEGIN;
UPDATE t5 SET idx_col=150 WHERE id=1;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=150;
id	idx_col	non_idx_col
1	150	data1
COMMIT;
# Test 8.5: Multiple consecutive updates on same record
BEGIN;
UPDATE t5 SET non_idx_col='update1' WHERE id=2;
UPDATE t5 SET non_idx_col='update2' WHERE id=2;
UPDATE t5 SET non_idx_col='update3' WHERE id=2;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=200;
id	idx_col	non_idx_col
2	200	update3
COMMIT;
########################################################################
# Test 9: Concurrent UPDATE scenarios
########################################################################
DROP TABLE IF EXISTS t6;
Warnings:
Note	1051	Unknown table 'test.t6'
CREATE TABLE t6 (
id INT PRIMARY KEY,
val INT,
KEY idx_val (val) COMMENT 'hippo_index'
) ENGINE=InnoDB;
INSERT INTO t6 VALUES (1,10), (2,20), (3,30);
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
BEGIN;
SELECT * FROM t6 FORCE INDEX(idx_val) WHERE val >= 10 ORDER BY id;
id	val
1	10
2	20
3	30
BEGIN;
UPDATE t6 SET val=15 WHERE id=1;
INSERT INTO t6 VALUES (4, 25);
COMMIT;
# con1: Should see old snapshot via HIPPO index
SELECT * FROM t6 FORCE INDEX(idx_val) WHERE val >= 10 ORDER BY id;
id	val
1	10
2	20
3	30
SELECT * FROM t6 FORCE INDEX(idx_val) WHERE val=15;
id	val
SELECT * FROM t6 FORCE INDEX(idx_val) WHERE val=25;
id	val
COMMIT;
########################################################################
# Test 10: Verify all assertions were triggered (summary)
########################################################################
# If test reaches here without crash, all assertions passed:
#
# DELETE assertion:
#   - row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
#
# INSERT assertions (four paths):
#
#   Path 1: Normal INSERT (most common)
#      - row_sec_assert_tid_in_entry() at row0ins.cc:3108
#
#   Path 2: INSERT by unmark delete-marked record
#      - Condition: same ordering keys, n_fields=0
#      - row_sec_assert_tid_in_rec() at btr0cur.cc:3559
#
#   Path 3: INSERT by in-place update (charset/case)
#      - Condition: same ordering keys, n_fields>0 (case diff)
#      - row_sec_assert_tid_in_rec() at btr0cur.cc:3559
#
#   Path 4: INSERT by non-in-place update (field size change)
#      - Condition: same ordering keys, n_fields>0, old_len != new_len
#      - Path 4A: btr_cur_optimistic_update() succeeds (non-in-place)
#      - Path 4B: btr_cur_optimistic_update() fails -> btr_cur_pessimistic_update()
#      - row_sec_assert_tid_in_rec() at btr0cur.cc:3559
#
# UPDATE = DELETE + INSERT (INSERT uses one of four paths above)
#
# TRX_ID is correctly written in all scenarios!
SELECT 'All TRX_ID assertions passed!' as result;
result
All TRX_ID assertions passed!
########################################################################
# Cleanup
########################################################################
DROP TABLE t1, t2, t3, t4, t5, t6;
SET GLOBAL innodb_purge_run_now = ON;
SET opt_index_format_hippo_enabled=default;
