SET GLOBAL innodb_purge_stop_now = ON;
SET opt_index_format_hippo_enabled=on;
########################################################################
# Test 1: INSERT - Trigger row_sec_assert_tid_in_entry()
########################################################################
DROP TABLE IF EXISTS t1;
Warnings:
Note	1051	Unknown table 'test.t1'
CREATE TABLE t1 (
id INT PRIMARY KEY,
val INT,
data VARCHAR(100),
KEY idx_val (val) COMMENT 'hippo_index'
) ENGINE=InnoDB;
# Verify HIPPO index created
SELECT index_name, index_page_type FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS 
WHERE table_name='t1' AND index_name='idx_val';
index_name	index_page_type
idx_val	HIPPO_INDEX
# Test 1.1: Simple INSERT - triggers assert at row0ins.cc:3108
BEGIN;
INSERT INTO t1 VALUES (1, 100, 'data1');
INSERT INTO t1 VALUES (2, 200, 'data2');
INSERT INTO t1 VALUES (3, 100, 'data3');
COMMIT;
# Test 1.2: Batch INSERT
INSERT INTO t1 VALUES 
(4, 300, 'data4'),
(5, 100, 'data5'),
(6, 200, 'data6');
# Test 1.3: INSERT with duplicates (non-unique index)
INSERT INTO t1 VALUES (7, 100, 'data7'), (8, 100, 'data8');
SELECT COUNT(*) FROM t1;
COUNT(*)
8
########################################################################
# Test 2: MVCC Visibility - FORCE INDEX to use HIPPO index
########################################################################
# Test 2.1: Concurrent transactions with FORCE INDEX
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
BEGIN;
# con1: Query using HIPPO index (not PK)
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=100 ORDER BY id;
id	val	data
1	100	data1
3	100	data3
5	100	data5
7	100	data7
8	100	data8
BEGIN;
# con2: INSERT new row with val=100
INSERT INTO t1 VALUES (9, 100, 'data9_con2');
# con2: UPDATE existing row
UPDATE t1 SET data='data1_updated' WHERE id=1;
# con1: Should NOT see con2's uncommitted changes
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=100 ORDER BY id;
id	val	data
1	100	data1
3	100	data3
5	100	data5
7	100	data7
8	100	data8
# con2: Commit
COMMIT;
# con1: Now should see con2's committed changes (READ COMMITTED)
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=100 ORDER BY id;
id	val	data
1	100	data1_updated
3	100	data3
5	100	data5
7	100	data7
8	100	data8
9	100	data9_con2
COMMIT;
########################################################################
# Test 3: UPDATE = DELETE old entry + INSERT new entry
# INSERT phase has three different paths (see file header)
########################################################################
########################################################################
# Test 3 INSERT Path 1: Normal INSERT (most common)
# Condition: row_ins_must_modify_rec() returns false
#            (no record with same ordering keys in index)
# Assertions triggered:
#   - DELETE: row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
#   - INSERT: row_sec_assert_tid_in_entry() at row0ins.cc:3108
########################################################################
# Test 3.1.1: Update indexed column to new value (no existing record)
BEGIN;
UPDATE t1 SET val=150 WHERE id=2;
# Verify: old value (200) gone, new value (150) exists
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=150;
id	val	data
2	150	data2
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=200;
id	val	data
6	200	data6
COMMIT;
# Test 3.1.2: Batch update indexed column
BEGIN;
UPDATE t1 SET val=val+1000 WHERE val < 200;
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val >= 1000 ORDER BY id;
id	val	data
1	1100	data1_updated
2	1150	data2
3	1100	data3
5	1100	data5
7	1100	data7
8	1100	data8
9	1100	data9_con2
COMMIT;
# Test 3.1.3: Update that changes index key ordering
BEGIN;
UPDATE t1 SET val=50 WHERE id=4;
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=50;
id	val	data
4	50	data4
COMMIT;
########################################################################
# Test 3 INSERT Path 2: INSERT by unmark delete-marked record
# Condition: row_ins_must_modify_rec() returns true
#            (found delete-marked record with same ordering keys)
#            AND row_upd_build_sec_rec_difference_binary() -> n_fields=0
# This happens when we delete a row and insert same index key value
# Assertions triggered:
#   - DELETE: row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
#   - INSERT(unmark): row_sec_assert_tid_in_rec() at btr0cur.cc:3559
########################################################################
# Test 3.2a.1: Delete then insert same key value (triggers unmark path)
# Step 1: Insert and delete to create delete-marked record
BEGIN;
INSERT INTO t1 VALUES (100, 9999, 'temp_row');
DELETE FROM t1 WHERE id=100;
# Now index has delete-marked record with val=9999
# Step 2: Insert same key value - triggers row_ins_must_modify_rec()
INSERT INTO t1 VALUES (100, 9999, 'reuse_key');
# This should find the delete-marked record and unmark it
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=9999;
id	val	data
100	9999	reuse_key
COMMIT;
# Test 3.2a.2: Same pattern in separate transactions
BEGIN;
INSERT INTO t1 VALUES (102, 8888, 'will_delete');
COMMIT;
BEGIN;
DELETE FROM t1 WHERE id=102;
COMMIT;
BEGIN;
# Insert with same key - finds delete-marked record, unmarks it
INSERT INTO t1 VALUES (102, 8888, 'reuse_again');
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=8888;
id	val	data
102	8888	reuse_again
COMMIT;
########################################################################
# Test 3 INSERT Path 3: INSERT by in-place update (rare, charset/case)
# Condition: row_ins_must_modify_rec() returns true
#            (found delete-marked record with same ordering keys)
#            BUT row_upd_build_sec_rec_difference_binary() -> n_fields>0
# This happens due to case-insensitive collation in search
# but case-sensitive memcmp in row_upd_build_sec_rec_difference_binary()
# Example: 'ABC' and 'abc' match in search but differ in memcmp
# Assertions triggered:
#   - DELETE: row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
#   - INSERT(in-place): row_sec_assert_tid_in_rec() at btr0cur.cc:3559
########################################################################
# Create table with case-insensitive collation for this test
DROP TABLE IF EXISTS t_case;
Warnings:
Note	1051	Unknown table 'test.t_case'
CREATE TABLE t_case (
id INT PRIMARY KEY,
name VARCHAR(100) COLLATE utf8mb4_general_ci,
KEY idx_name (name) COMMENT 'hippo_index'
) ENGINE=InnoDB;
# Test 3.2b.1: Case change triggers in-place update
# Step 1: Insert and delete uppercase
BEGIN;
INSERT INTO t_case VALUES (1, 'HELLO');
DELETE FROM t_case WHERE id=1;
# Now index has delete-marked record with name='HELLO'
# Step 2: Insert lowercase - search finds 'HELLO' (case-insensitive match)
# but memcmp sees difference -> triggers in-place update
INSERT INTO t_case VALUES (1, 'hello');
SELECT * FROM t_case FORCE INDEX(idx_name) WHERE name='hello';
id	name
1	hello
COMMIT;
# Test 3.2b.2: Another case change scenario
BEGIN;
INSERT INTO t_case VALUES (3, 'World');
DELETE FROM t_case WHERE id=3;
# Insert with different case
INSERT INTO t_case VALUES (3, 'WORLD');
SELECT * FROM t_case FORCE INDEX(idx_name) WHERE name='WORLD';
id	name
3	WORLD
COMMIT;
# Test 3.2b.3: Mixed case changes
BEGIN;
INSERT INTO t_case VALUES (5, 'MixedCase');
DELETE FROM t_case WHERE id=5;
INSERT INTO t_case VALUES (5, 'MIXEDCASE');
SELECT * FROM t_case FORCE INDEX(idx_name) WHERE name='MIXEDCASE';
id	name
5	MIXEDCASE
COMMIT;
# Cleanup case test table
DROP TABLE t_case;
########################################################################
# Test 3 INSERT Path 4: INSERT by non-in-place update (field size change)
# Condition: row_ins_must_modify_rec() returns true
#            (found delete-marked record with same ordering keys)
#            AND row_upd_build_sec_rec_difference_binary() -> n_fields>0
#            AND row_upd_changes_field_size_or_external() -> true
# This happens when collation treats strings as equal but binary
# comparison shows different lengths (e.g., '' vs '  ' in utf8mb4_general_ci)
# Two sub-paths:
#   4A: Optimistic non-in-place update (btr_cur_optimistic_update succeeds)
#       - Field size changes but page has enough space
#       - Delete old record and insert new record within same page
#       - Assertion: row_sec_assert_tid_in_rec() at btr0cur.cc:3559
#   4B: Pessimistic update (btr_cur_optimistic_update fails)
#       - btr_cur_optimistic_update() fails (DB_OVERFLOW/DB_UNDERFLOW) because
#         record size change requires delete+insert, which may cause page
#         to become too empty or not have enough space
#       - Falls back to btr_cur_pessimistic_update() with BTR_MODIFY_TREE
#       - Assertion: row_sec_assert_tid_in_rec() at btr0cur.cc:3559
# Assertions triggered:
#   - DELETE: row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
########################################################################
# Create table with case-insensitive collation for this test
DROP TABLE IF EXISTS t_space;
Warnings:
Note	1051	Unknown table 'test.t_space'
CREATE TABLE t_space (
id BIGINT PRIMARY KEY,
unit_id BIGINT NOT NULL,
nick_name VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
KEY auto_shard_key_nick_name (nick_name) COMMENT 'hippo_index'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci ROW_FORMAT=DYNAMIC;
# Test 3.2c.1: Empty string to spaces - Path 4B (pessimistic update)
# Strategy: Fill page to near merge threshold, then delete+insert with size change
# Step 0: Pre-fill page with many records using empty string
# This ensures page data size is close to merge threshold (50% of page size)
# When we delete small record (empty string) and insert larger one (spaces),
# page data size may drop below threshold, triggering DB_UNDERFLOW -> pessimistic update
BEGIN;
# Insert ~200 records with empty string to fill the page
# Each record: id (8 bytes) + unit_id (8 bytes) + nick_name (empty, ~1 byte) = ~17 bytes
# Plus index entry overhead, ~200 records should fill ~4-5KB, close to 8KB threshold
