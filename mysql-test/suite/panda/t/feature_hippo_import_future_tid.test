########################################################################
# HIPPO Index - IMPORT with "future" transaction id (regression)
#
# When a tablespace is imported from another instance, the DB_TRX_ID /
# hippo TID stored in a record can be larger than this instance's next
# trx id ("in the future"). The clustered/panda import path tolerates
# this by using lizard::ROLL_PTR_IMPORT, which makes
# row_upd_rec_sys_fields() skip the trx-id sanity assertion.
#
# The hippo (TL_LOTUS) import path calls row_upd_rec_lotus_fields_low(),
# which used to run ut_ad(lock_check_trx_id_sanity(...)) unconditionally.
# Importing a hippo tablespace whose records carry a future TID therefore
# tripped that debug assertion (crash in debug builds).
#
# This test uses the debug injection "hippo_import_future_tid" to force
# the on-disk TID of every hippo record to a value in the future during
# IMPORT, and verifies the import succeeds and the data is correct.
########################################################################

--source include/have_debug.inc

SET opt_index_format_hippo_enabled = ON;
SET opt_index_format_panda_enabled = OFF;

LET $MYSQLD_DATADIR = `SELECT @@datadir`;

CREATE TABLE t1 (
  id INT NOT NULL PRIMARY KEY,
  c1 INT NOT NULL,
  c2 VARCHAR(100),
  INDEX idx_c1 (c1) COMMENT 'hippo_index'
) ENGINE=InnoDB;

INSERT INTO t1 VALUES (1, 100, 'aaa'), (2, 200, 'bbb'), (3, 300, 'ccc');

--echo # Source index must be HIPPO.
SELECT INDEX_NAME, INDEX_PAGE_TYPE FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS
WHERE TABLE_NAME='t1' AND SCHEMA_NAME='test' AND INDEX_NAME='idx_c1';

FLUSH TABLE t1 FOR EXPORT;
--copy_file $MYSQLD_DATADIR/test/t1.ibd $MYSQLTEST_VARDIR/tmp/t1.ibd
--copy_file $MYSQLD_DATADIR/test/t1.cfg $MYSQLTEST_VARDIR/tmp/t1.cfg
UNLOCK TABLES;

DROP TABLE t1;

CREATE TABLE t1 (
  id INT NOT NULL PRIMARY KEY,
  c1 INT NOT NULL,
  c2 VARCHAR(100),
  INDEX idx_c1 (c1) COMMENT 'hippo_index'
) ENGINE=InnoDB;

ALTER TABLE t1 DISCARD TABLESPACE;

--copy_file $MYSQLTEST_VARDIR/tmp/t1.ibd $MYSQLD_DATADIR/test/t1.ibd
--copy_file $MYSQLTEST_VARDIR/tmp/t1.cfg $MYSQLD_DATADIR/test/t1.cfg

--echo # Force every imported hippo record to carry a future TID.
SET SESSION debug = '+d,hippo_import_future_tid';

--echo # Must succeed (previously tripped the trx-id sanity assertion).
ALTER TABLE t1 IMPORT TABLESPACE;

SET SESSION debug = '-d,hippo_import_future_tid';

--echo # Data must be intact and readable via the HIPPO index.
SELECT * FROM t1 ORDER BY id;
SELECT c1 FROM t1 FORCE INDEX(idx_c1) WHERE c1 = 200;

--echo # DML after import still works (TRX_ID reset to a normal value).
INSERT INTO t1 VALUES (4, 400, 'ddd');
UPDATE t1 SET c1 = 101 WHERE id = 1;
DELETE FROM t1 WHERE id = 2;
SELECT c1 FROM t1 FORCE INDEX(idx_c1) ORDER BY c1;

DROP TABLE t1;
--remove_file $MYSQLTEST_VARDIR/tmp/t1.ibd
--remove_file $MYSQLTEST_VARDIR/tmp/t1.cfg

SET opt_index_format_hippo_enabled = default;
SET opt_index_format_panda_enabled = default;

--echo # Test completed successfully
