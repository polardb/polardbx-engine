####### Hippo Index - Row Log (Rebuild Index) ###########
#
# Test row_log_online_op() call paths during online index creation
# Focus: Verify TRX_ID correctness in HIPPO index entries
#
# ============================================================
# Call Paths:
# ============================================================
#
# Path 1: INSERT
#   row_ins_sec_index_entry_low -> row_log_online_op(trx_id)
#
# Path 2: UPDATE indexed column (DELETE old + INSERT new)
#   row_upd_sec_index_entry -> btr_cur_rlog_delete(0) + btr_cur_rlog_insert(trx_id)
#
# Path 3: UPDATE non-indexed column
#   Only clustered index updated, secondary index unchanged
#
# Path 4: DELETE
#   row_upd_sec_index_entry (is_delete) -> btr_cur_rlog_delete(0)
#
# Path 5: ROLLBACK INSERT
# Path 6: ROLLBACK DELETE
# Path 7: ROLLBACK UPDATE
#
# ============================================================

--source include/have_debug.inc

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

SET GLOBAL innodb_purge_stop_now = ON;
SET opt_index_format_hippo_enabled=on;


--echo ##################################################################
--echo # Path 1: INSERT during online DDL
--echo ##################################################################

connection default;
CREATE TABLE t_insert (
  id INT PRIMARY KEY,
  val INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO t_insert VALUES (1, 100), (2, 200);

connection con1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'row_log_apply_before SIGNAL bulk_done WAIT_FOR continue_apply';
--send ALTER TABLE t_insert ADD KEY idx_val (val) COMMENT 'hippo_index', ALGORITHM=INPLACE, LOCK=NONE

connection con2;
SET DEBUG_SYNC = 'now WAIT_FOR bulk_done';

--echo # INSERT during DDL - logged to row_log with trx_id
INSERT INTO t_insert VALUES (3, 300);
INSERT INTO t_insert VALUES (4, 400);

SET DEBUG_SYNC = 'now SIGNAL continue_apply';

connection con1;
--reap

--echo # Verify INSERT applied correctly
connection default;
SELECT * FROM t_insert ORDER BY id;
SELECT * FROM t_insert FORCE INDEX(idx_val) WHERE val IN (300, 400) ORDER BY val;

DROP TABLE t_insert;


--echo ##################################################################
--echo # Path 2: UPDATE indexed column (DELETE old + INSERT new)
--echo ##################################################################

connection default;
CREATE TABLE t_update_idx (
  id INT PRIMARY KEY,
  val INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO t_update_idx VALUES (1, 100), (2, 200), (3, 300);

connection con1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'row_log_apply_before SIGNAL bulk_done WAIT_FOR continue_apply';
--send ALTER TABLE t_update_idx ADD KEY idx_val (val) COMMENT 'hippo_index', ALGORITHM=INPLACE, LOCK=NONE

connection con2;
SET DEBUG_SYNC = 'now WAIT_FOR bulk_done';

--echo # UPDATE indexed column: triggers DELETE(100) + INSERT(150)
UPDATE t_update_idx SET val=150 WHERE id=1;
UPDATE t_update_idx SET val=250 WHERE id=2;

SET DEBUG_SYNC = 'now SIGNAL continue_apply';

connection con1;
--reap

--echo # Verify UPDATE applied correctly
connection default;
SELECT * FROM t_update_idx ORDER BY id;
SELECT * FROM t_update_idx FORCE INDEX(idx_val) WHERE val=150;
SELECT * FROM t_update_idx FORCE INDEX(idx_val) WHERE val=100;  # empty

DROP TABLE t_update_idx;


--echo ##################################################################
--echo # Path 3: UPDATE non-indexed column
--echo ##################################################################

connection default;
CREATE TABLE t_update_nonidx (
  id INT PRIMARY KEY,
  val INT NOT NULL,
  data VARCHAR(100)
) ENGINE=InnoDB;

INSERT INTO t_update_nonidx VALUES (1, 100, 'old');

connection con1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'row_log_apply_before SIGNAL bulk_done WAIT_FOR continue_apply';
--send ALTER TABLE t_update_nonidx ADD KEY idx_val (val) COMMENT 'hippo_index', ALGORITHM=INPLACE, LOCK=NONE

connection con2;
SET DEBUG_SYNC = 'now WAIT_FOR bulk_done';

--echo # UPDATE non-indexed column: only clustered index changes
UPDATE t_update_nonidx SET data='new' WHERE id=1;

SET DEBUG_SYNC = 'now SIGNAL continue_apply';

connection con1;
--reap

--echo # Verify data updated, index still works
connection default;
SELECT * FROM t_update_nonidx;
SELECT * FROM t_update_nonidx FORCE INDEX(idx_val) WHERE val=100;

DROP TABLE t_update_nonidx;


--echo ##################################################################
--echo # Path 4: DELETE during online DDL
--echo ##################################################################

connection default;
CREATE TABLE t_delete (
  id INT PRIMARY KEY,
  val INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO t_delete VALUES (1, 100), (2, 200), (3, 300);

connection con1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'row_log_apply_before SIGNAL bulk_done WAIT_FOR continue_apply';
--send ALTER TABLE t_delete ADD KEY idx_val (val) COMMENT 'hippo_index', ALGORITHM=INPLACE, LOCK=NONE

connection con2;
SET DEBUG_SYNC = 'now WAIT_FOR bulk_done';

--echo # DELETE during DDL
DELETE FROM t_delete WHERE id=2;

SET DEBUG_SYNC = 'now SIGNAL continue_apply';

connection con1;
--reap

--echo # Verify DELETE applied correctly
connection default;
SELECT * FROM t_delete ORDER BY id;
SELECT * FROM t_delete FORCE INDEX(idx_val) WHERE val=200;  # empty

DROP TABLE t_delete;


--echo ##################################################################
--echo # Path 5: ROLLBACK INSERT during online DDL
--echo ##################################################################

connection default;
CREATE TABLE t_rollback_ins (
  id INT PRIMARY KEY,
  val INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO t_rollback_ins VALUES (1, 100);

connection con1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'row_log_apply_before SIGNAL bulk_done WAIT_FOR continue_apply';
--send ALTER TABLE t_rollback_ins ADD KEY idx_val (val) COMMENT 'hippo_index', ALGORITHM=INPLACE, LOCK=NONE

connection con2;
SET DEBUG_SYNC = 'now WAIT_FOR bulk_done';

--echo # INSERT then ROLLBACK
BEGIN;
INSERT INTO t_rollback_ins VALUES (10, 1000);
ROLLBACK;

SET DEBUG_SYNC = 'now SIGNAL continue_apply';

connection con1;
--reap

--echo # Verify rolled back INSERT does not exist
connection default;
SELECT * FROM t_rollback_ins;
SELECT * FROM t_rollback_ins FORCE INDEX(idx_val) WHERE val=1000;  # empty

DROP TABLE t_rollback_ins;


--echo ##################################################################
--echo # Path 6: ROLLBACK DELETE during online DDL
--echo ##################################################################

connection default;
CREATE TABLE t_rollback_del (
  id INT PRIMARY KEY,
  val INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO t_rollback_del VALUES (1, 100);

connection con1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'row_log_apply_before SIGNAL bulk_done WAIT_FOR continue_apply';
--send ALTER TABLE t_rollback_del ADD KEY idx_val (val) COMMENT 'hippo_index', ALGORITHM=INPLACE, LOCK=NONE

connection con2;
SET DEBUG_SYNC = 'now WAIT_FOR bulk_done';

--echo # DELETE then ROLLBACK
BEGIN;
DELETE FROM t_rollback_del WHERE id=1;
ROLLBACK;

SET DEBUG_SYNC = 'now SIGNAL continue_apply';

connection con1;
--reap

--echo # Verify rolled back DELETE is restored
connection default;
SELECT * FROM t_rollback_del;
SELECT * FROM t_rollback_del FORCE INDEX(idx_val) WHERE val=100;

DROP TABLE t_rollback_del;


--echo ##################################################################
--echo # Path 7: ROLLBACK UPDATE during online DDL
--echo ##################################################################

connection default;
CREATE TABLE t_rollback_upd (
  id INT PRIMARY KEY,
  val INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO t_rollback_upd VALUES (1, 100);

connection con1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'row_log_apply_before SIGNAL bulk_done WAIT_FOR continue_apply';
--send ALTER TABLE t_rollback_upd ADD KEY idx_val (val) COMMENT 'hippo_index', ALGORITHM=INPLACE, LOCK=NONE

connection con2;
SET DEBUG_SYNC = 'now WAIT_FOR bulk_done';

--echo # UPDATE indexed column then ROLLBACK
BEGIN;
UPDATE t_rollback_upd SET val=999 WHERE id=1;
ROLLBACK;

SET DEBUG_SYNC = 'now SIGNAL continue_apply';

connection con1;
--reap

--echo # Verify rolled back UPDATE shows original value
connection default;
SELECT * FROM t_rollback_upd;
SELECT * FROM t_rollback_upd FORCE INDEX(idx_val) WHERE val=100;
SELECT * FROM t_rollback_upd FORCE INDEX(idx_val) WHERE val=999;  # empty

DROP TABLE t_rollback_upd;


--echo ##################################################################
--echo # Mixed: Committed and rolled back transactions
--echo ##################################################################

connection default;
CREATE TABLE t_mixed (
  id INT PRIMARY KEY,
  val INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO t_mixed VALUES (1, 10), (2, 20), (3, 30);

connection con1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'row_log_apply_before SIGNAL bulk_done WAIT_FOR continue_apply';
--send ALTER TABLE t_mixed ADD KEY idx_val (val) COMMENT 'hippo_index', ALGORITHM=INPLACE, LOCK=NONE

connection con2;
SET DEBUG_SYNC = 'now WAIT_FOR bulk_done';

--echo # Committed transaction
BEGIN;
INSERT INTO t_mixed VALUES (100, 100);
UPDATE t_mixed SET val=11 WHERE id=1;
DELETE FROM t_mixed WHERE id=2;
COMMIT;

--echo # Rolled back transaction
BEGIN;
INSERT INTO t_mixed VALUES (200, 200);
UPDATE t_mixed SET val=999 WHERE id=3;
ROLLBACK;

SET DEBUG_SYNC = 'now SIGNAL continue_apply';

connection con1;
--reap

--echo # Verify final state
connection default;
SELECT * FROM t_mixed ORDER BY id;

--echo # Via hippo index
SELECT * FROM t_mixed FORCE INDEX(idx_val) WHERE val=11;   # committed update
SELECT * FROM t_mixed FORCE INDEX(idx_val) WHERE val=20;   # deleted, empty
SELECT * FROM t_mixed FORCE INDEX(idx_val) WHERE val=30;   # rollback, exists
SELECT * FROM t_mixed FORCE INDEX(idx_val) WHERE val=100;  # committed insert
SELECT * FROM t_mixed FORCE INDEX(idx_val) WHERE val=200;  # rollback, empty

DROP TABLE t_mixed;


--echo ##################################################################
--echo # Cleanup
--echo ##################################################################

connection default;
SET DEBUG_SYNC = 'RESET';

disconnect con1;
disconnect con2;

SET GLOBAL innodb_purge_run_now = ON;
SET opt_index_format_hippo_enabled=default;
