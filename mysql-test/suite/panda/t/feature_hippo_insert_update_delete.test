########################################################################
# HIPPO Index - INSERT/UPDATE/DELETE with TRX_ID Verification
# 
# Test Strategy:
# 1. Rely on DEBUG assertions in code to verify TRX_ID correctness:
#
#    - DELETE: row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
#
#    - INSERT has three different paths:
#      - Triggers: row_sec_assert_tid_in_entry() at row0ins.cc:2867
#
#      Path 1: Normal INSERT (most common)
#        - Condition: row_ins_must_modify_rec() returns false
#          (no record with same ordering keys exists in index)
#        - Triggers: row_sec_assert_tid_in_entry() at row0ins.cc:3109
#
#      Path 2: INSERT by unmark delete-marked record
#        - Condition: row_ins_must_modify_rec() returns true
#          (found delete-marked record with same ordering keys)
#        - row_upd_build_sec_rec_difference_binary() returns n_fields=0
#        - Delete unmark via row_upd_rec_in_place() setting info_bits=0
#          which clears REC_INFO_DELETED_FLAG (row0upd.cc:503)
#        - Triggers: row_sec_assert_tid_in_rec() at btr0cur.cc:3559
#
#      Path 3: INSERT by in-place update (rare, charset/case related)
#        - Condition: row_ins_must_modify_rec() returns true
#          (found delete-marked record with same ordering keys)
#        - row_upd_build_sec_rec_difference_binary() returns n_fields>0
#          (due to case-insensitive search but case-sensitive memcmp)
#        - Example: 'ABC' -> 'abc' when charset ignores case in search
#        - Triggers: row_sec_assert_tid_in_rec() at btr0cur.cc:3559
#
#      Path 4: INSERT by non-in-place update (field size change)
#        - Condition: row_ins_must_modify_rec() returns true
#          (found delete-marked record with same ordering keys)
#        - row_upd_build_sec_rec_difference_binary() returns n_fields>0
#          AND row_upd_changes_field_size_or_external() returns true
#          (field length differs: old_len != new_len)
#        - Two sub-paths:
#          4A: Optimistic non-in-place update
#              - btr_cur_optimistic_update() succeeds
#              - Field size changes but page has enough space
#              - Delete old record and insert new record within same page
#              - Triggers: row_sec_assert_tid_in_rec() at btr0cur.cc:3559
#          4B: Pessimistic update
#              - btr_cur_optimistic_update() fails with DB_OVERFLOW/DB_UNDERFLOW
#                due to record size change requiring delete+insert
#              - Falls back to btr_cur_pessimistic_update() with BTR_MODIFY_TREE
#              - Triggers: row_sec_assert_tid_in_rec() at btr0cur.cc:3559
#        - Example: '' -> '  ' (empty string to spaces) when collation
#          treats them as equal but binary comparison shows length difference
#
#    - UPDATE = DELETE old entry + INSERT new entry
#        (INSERT uses one of the four paths above)
#
# 2. Use FORCE INDEX to ensure MVCC reads from HIPPO index (not PK)
#
# 3. If TRX_ID is incorrect, DEBUG assertions will fail and crash
#
########################################################################

--source include/have_debug.inc

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

SET GLOBAL innodb_purge_stop_now = ON;
SET opt_index_format_hippo_enabled=on;

--echo ########################################################################
--echo # Test 1: INSERT - Trigger row_sec_assert_tid_in_entry()
--echo ########################################################################

connection default;
DROP TABLE IF EXISTS t1;

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  val INT,
  data VARCHAR(100),
  KEY idx_val (val) COMMENT 'hippo_index'
) ENGINE=InnoDB;

--echo # Verify HIPPO index created
SELECT index_name, index_page_type FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS 
  WHERE table_name='t1' AND index_name='idx_val';

--echo # Test 1.1: Simple INSERT - triggers assert at row0ins.cc:3108
BEGIN;
INSERT INTO t1 VALUES (1, 100, 'data1');
INSERT INTO t1 VALUES (2, 200, 'data2');
INSERT INTO t1 VALUES (3, 100, 'data3');
COMMIT;

--echo # Test 1.2: Batch INSERT
INSERT INTO t1 VALUES 
  (4, 300, 'data4'),
  (5, 100, 'data5'),
  (6, 200, 'data6');

--echo # Test 1.3: INSERT with duplicates (non-unique index)
INSERT INTO t1 VALUES (7, 100, 'data7'), (8, 100, 'data8');

SELECT COUNT(*) FROM t1;


--echo ########################################################################
--echo # Test 2: MVCC Visibility - FORCE INDEX to use HIPPO index
--echo ########################################################################

--echo # Test 2.1: Concurrent transactions with FORCE INDEX
connection con1;
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
BEGIN;
--echo # con1: Query using HIPPO index (not PK)
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=100 ORDER BY id;

connection con2;
BEGIN;
--echo # con2: INSERT new row with val=100
INSERT INTO t1 VALUES (9, 100, 'data9_con2');
--echo # con2: UPDATE existing row
UPDATE t1 SET data='data1_updated' WHERE id=1;

--echo # con1: Should NOT see con2's uncommitted changes
connection con1;
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=100 ORDER BY id;

--echo # con2: Commit
connection con2;
COMMIT;

--echo # con1: Now should see con2's committed changes (READ COMMITTED)
connection con1;
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=100 ORDER BY id;
COMMIT;


--echo ########################################################################
--echo # Test 3: UPDATE = DELETE old entry + INSERT new entry
--echo # INSERT phase has three different paths (see file header)
--echo ########################################################################

connection default;

--echo ########################################################################
--echo # Test 3 INSERT Path 1: Normal INSERT (most common)
--echo # Condition: row_ins_must_modify_rec() returns false
--echo #            (no record with same ordering keys in index)
--echo # Assertions triggered:
--echo #   - DELETE: row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
--echo #   - INSERT: row_sec_assert_tid_in_entry() at row0ins.cc:3108
--echo ########################################################################

--echo # Test 3.1.1: Update indexed column to new value (no existing record)
BEGIN;
UPDATE t1 SET val=150 WHERE id=2;
--echo # Verify: old value (200) gone, new value (150) exists
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=150;
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=200;
COMMIT;

--echo # Test 3.1.2: Batch update indexed column
BEGIN;
UPDATE t1 SET val=val+1000 WHERE val < 200;
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val >= 1000 ORDER BY id;
COMMIT;

--echo # Test 3.1.3: Update that changes index key ordering
BEGIN;
UPDATE t1 SET val=50 WHERE id=4;
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=50;
COMMIT;

--echo ########################################################################
--echo # Test 3 INSERT Path 2: INSERT by unmark delete-marked record
--echo # Condition: row_ins_must_modify_rec() returns true
--echo #            (found delete-marked record with same ordering keys)
--echo #            AND row_upd_build_sec_rec_difference_binary() -> n_fields=0
--echo # This happens when we delete a row and insert same index key value
--echo # Assertions triggered:
--echo #   - DELETE: row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
--echo #   - INSERT(unmark): row_sec_assert_tid_in_rec() at btr0cur.cc:3559
--echo ########################################################################

--echo # Test 3.2a.1: Delete then insert same key value (triggers unmark path)
--echo # Step 1: Insert and delete to create delete-marked record
BEGIN;
INSERT INTO t1 VALUES (100, 9999, 'temp_row');
DELETE FROM t1 WHERE id=100;
--echo # Now index has delete-marked record with val=9999
--echo # Step 2: Insert same key value - triggers row_ins_must_modify_rec()
INSERT INTO t1 VALUES (100, 9999, 'reuse_key');
--echo # This should find the delete-marked record and unmark it
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=9999;
COMMIT;

--echo # Test 3.2a.2: Same pattern in separate transactions
BEGIN;
INSERT INTO t1 VALUES (102, 8888, 'will_delete');
COMMIT;

BEGIN;
DELETE FROM t1 WHERE id=102;
COMMIT;

BEGIN;
--echo # Insert with same key - finds delete-marked record, unmarks it
INSERT INTO t1 VALUES (102, 8888, 'reuse_again');
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=8888;
COMMIT;

--echo ########################################################################
--echo # Test 3 INSERT Path 3: INSERT by in-place update (rare, charset/case)
--echo # Condition: row_ins_must_modify_rec() returns true
--echo #            (found delete-marked record with same ordering keys)
--echo #            BUT row_upd_build_sec_rec_difference_binary() -> n_fields>0
--echo # This happens due to case-insensitive collation in search
--echo # but case-sensitive memcmp in row_upd_build_sec_rec_difference_binary()
--echo # Example: 'ABC' and 'abc' match in search but differ in memcmp
--echo # Assertions triggered:
--echo #   - DELETE: row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
--echo #   - INSERT(in-place): row_sec_assert_tid_in_rec() at btr0cur.cc:3559
--echo ########################################################################

--echo # Create table with case-insensitive collation for this test
DROP TABLE IF EXISTS t_case;
CREATE TABLE t_case (
  id INT PRIMARY KEY,
  name VARCHAR(100) COLLATE utf8mb4_general_ci,
  KEY idx_name (name) COMMENT 'hippo_index'
) ENGINE=InnoDB;

--echo # Test 3.2b.1: Case change triggers in-place update
--echo # Step 1: Insert and delete uppercase
BEGIN;
INSERT INTO t_case VALUES (1, 'HELLO');
DELETE FROM t_case WHERE id=1;
--echo # Now index has delete-marked record with name='HELLO'
--echo # Step 2: Insert lowercase - search finds 'HELLO' (case-insensitive match)
--echo # but memcmp sees difference -> triggers in-place update
INSERT INTO t_case VALUES (1, 'hello');
SELECT * FROM t_case FORCE INDEX(idx_name) WHERE name='hello';
COMMIT;

--echo # Test 3.2b.2: Another case change scenario
BEGIN;
INSERT INTO t_case VALUES (3, 'World');
DELETE FROM t_case WHERE id=3;
--echo # Insert with different case
INSERT INTO t_case VALUES (3, 'WORLD');
SELECT * FROM t_case FORCE INDEX(idx_name) WHERE name='WORLD';
COMMIT;

--echo # Test 3.2b.3: Mixed case changes
BEGIN;
INSERT INTO t_case VALUES (5, 'MixedCase');
DELETE FROM t_case WHERE id=5;
INSERT INTO t_case VALUES (5, 'MIXEDCASE');
SELECT * FROM t_case FORCE INDEX(idx_name) WHERE name='MIXEDCASE';
COMMIT;

--echo # Cleanup case test table
DROP TABLE t_case;


--echo ########################################################################
--echo # Test 3 INSERT Path 4: INSERT by non-in-place update (field size change)
--echo # Condition: row_ins_must_modify_rec() returns true
--echo #            (found delete-marked record with same ordering keys)
--echo #            AND row_upd_build_sec_rec_difference_binary() -> n_fields>0
--echo #            AND row_upd_changes_field_size_or_external() -> true
--echo # This happens when collation treats strings as equal but binary
--echo # comparison shows different lengths (e.g., '' vs '  ' in utf8mb4_general_ci)
--echo # Two sub-paths:
--echo #   4A: Optimistic non-in-place update (btr_cur_optimistic_update succeeds)
--echo #       - Field size changes but page has enough space
--echo #       - Delete old record and insert new record within same page
--echo #       - Assertion: row_sec_assert_tid_in_rec() at btr0cur.cc:3559
--echo #   4B: Pessimistic update (btr_cur_optimistic_update fails)
--echo #       - btr_cur_optimistic_update() fails (DB_OVERFLOW/DB_UNDERFLOW) because
--echo #         record size change requires delete+insert, which may cause page
--echo #         to become too empty or not have enough space
--echo #       - Falls back to btr_cur_pessimistic_update() with BTR_MODIFY_TREE
--echo #       - Assertion: row_sec_assert_tid_in_rec() at btr0cur.cc:3559
--echo # Assertions triggered:
--echo #   - DELETE: row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
--echo ########################################################################

--echo # Create table with case-insensitive collation for this test
DROP TABLE IF EXISTS t_space;
CREATE TABLE t_space (
  id BIGINT PRIMARY KEY,
  unit_id BIGINT NOT NULL,
  nick_name VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  KEY auto_shard_key_nick_name (nick_name) COMMENT 'hippo_index'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci ROW_FORMAT=DYNAMIC;

--echo # Test 3.2c.1: Empty string to spaces - Path 4B (pessimistic update)
--echo # Strategy: Fill page to near merge threshold, then delete+insert with size change
--echo # Step 0: Pre-fill page with many records using empty string
--echo # This ensures page data size is close to merge threshold (50% of page size)
--echo # When we delete small record (empty string) and insert larger one (spaces),
--echo # page data size may drop below threshold, triggering DB_UNDERFLOW -> pessimistic update
BEGIN;
--echo # Insert ~200 records with empty string to fill the page
--echo # Each record: id (8 bytes) + unit_id (8 bytes) + nick_name (empty, ~1 byte) = ~17 bytes
--echo # Plus index entry overhead, ~200 records should fill ~4-5KB, close to 8KB threshold
INSERT INTO t_space VALUES 
  (1001, 100, ''), (1002, 100, ''), (1003, 100, ''), (1004, 100, ''), (1005, 100, ''),
  (1006, 100, ''), (1007, 100, ''), (1008, 100, ''), (1009, 100, ''), (1010, 100, ''),
  (1011, 100, ''), (1012, 100, ''), (1013, 100, ''), (1014, 100, ''), (1015, 100, ''),
  (1016, 100, ''), (1017, 100, ''), (1018, 100, ''), (1019, 100, ''), (1020, 100, ''),
  (1021, 100, ''), (1022, 100, ''), (1023, 100, ''), (1024, 100, ''), (1025, 100, ''),
  (1026, 100, ''), (1027, 100, ''), (1028, 100, ''), (1029, 100, ''), (1030, 100, ''),
  (1031, 100, ''), (1032, 100, ''), (1033, 100, ''), (1034, 100, ''), (1035, 100, ''),
  (1036, 100, ''), (1037, 100, ''), (1038, 100, ''), (1039, 100, ''), (1040, 100, ''),
  (1041, 100, ''), (1042, 100, ''), (1043, 100, ''), (1044, 100, ''), (1045, 100, ''),
  (1046, 100, ''), (1047, 100, ''), (1048, 100, ''), (1049, 100, ''), (1050, 100, ''),
  (1051, 100, ''), (1052, 100, ''), (1053, 100, ''), (1054, 100, ''), (1055, 100, ''),
  (1056, 100, ''), (1057, 100, ''), (1058, 100, ''), (1059, 100, ''), (1060, 100, ''),
  (1061, 100, ''), (1062, 100, ''), (1063, 100, ''), (1064, 100, ''), (1065, 100, ''),
  (1066, 100, ''), (1067, 100, ''), (1068, 100, ''), (1069, 100, ''), (1070, 100, ''),
  (1071, 100, ''), (1072, 100, ''), (1073, 100, ''), (1074, 100, ''), (1075, 100, ''),
  (1076, 100, ''), (1077, 100, ''), (1078, 100, ''), (1079, 100, ''), (1080, 100, ''),
  (1081, 100, ''), (1082, 100, ''), (1083, 100, ''), (1084, 100, ''), (1085, 100, ''),
  (1086, 100, ''), (1087, 100, ''), (1088, 100, ''), (1089, 100, ''), (1090, 100, ''),
  (1091, 100, ''), (1092, 100, ''), (1093, 100, ''), (1094, 100, ''), (1095, 100, ''),
  (1096, 100, ''), (1097, 100, ''), (1098, 100, ''), (1099, 100, ''), (1100, 100, ''),
  (1101, 100, ''), (1102, 100, ''), (1103, 100, ''), (1104, 100, ''), (1105, 100, ''),
  (1106, 100, ''), (1107, 100, ''), (1108, 100, ''), (1109, 100, ''), (1110, 100, ''),
  (1111, 100, ''), (1112, 100, ''), (1113, 100, ''), (1114, 100, ''), (1115, 100, ''),
  (1116, 100, ''), (1117, 100, ''), (1118, 100, ''), (1119, 100, ''), (1120, 100, ''),
  (1121, 100, ''), (1122, 100, ''), (1123, 100, ''), (1124, 100, ''), (1125, 100, ''),
  (1126, 100, ''), (1127, 100, ''), (1128, 100, ''), (1129, 100, ''), (1130, 100, ''),
  (1131, 100, ''), (1132, 100, ''), (1133, 100, ''), (1134, 100, ''), (1135, 100, ''),
  (1136, 100, ''), (1137, 100, ''), (1138, 100, ''), (1139, 100, ''), (1140, 100, ''),
  (1141, 100, ''), (1142, 100, ''), (1143, 100, ''), (1144, 100, ''), (1145, 100, ''),
  (1146, 100, ''), (1147, 100, ''), (1148, 100, ''), (1149, 100, ''), (1150, 100, ''),
  (1151, 100, ''), (1152, 100, ''), (1153, 100, ''), (1154, 100, ''), (1155, 100, ''),
  (1156, 100, ''), (1157, 100, ''), (1158, 100, ''), (1159, 100, ''), (1160, 100, ''),
  (1161, 100, ''), (1162, 100, ''), (1163, 100, ''), (1164, 100, ''), (1165, 100, ''),
  (1166, 100, ''), (1167, 100, ''), (1168, 100, ''), (1169, 100, ''), (1170, 100, ''),
  (1171, 100, ''), (1172, 100, ''), (1173, 100, ''), (1174, 100, ''), (1175, 100, ''),
  (1176, 100, ''), (1177, 100, ''), (1178, 100, ''), (1179, 100, ''), (1180, 100, ''),
  (1181, 100, ''), (1182, 100, ''), (1183, 100, ''), (1184, 100, ''), (1185, 100, ''),
  (1186, 100, ''), (1187, 100, ''), (1188, 100, ''), (1189, 100, ''), (1190, 100, ''),
  (1191, 100, ''), (1192, 100, ''), (1193, 100, ''), (1194, 100, ''), (1195, 100, ''),
  (1196, 100, ''), (1197, 100, ''), (1198, 100, ''), (1199, 100, ''), (1200, 100, '');
COMMIT;

--echo # Step 1: Insert target record with empty string and delete it
--echo # This creates a delete-marked record that will be found by row_ins_must_modify_rec()
BEGIN;
INSERT INTO t_space VALUES (1392684638434107392, 1250056650086289408, '');
DELETE FROM t_space WHERE id=1392684638434107392;
COMMIT;

--echo # Step 2: Insert with spaces - search finds '' (collation treats as equal)
--echo # but binary comparison shows length difference (0 vs 2)
--echo # With page near threshold, deleting small record and inserting larger one
--echo # may cause page data size to drop below BTR_CUR_PAGE_COMPRESS_LIMIT (50% of page)
--echo # This triggers DB_UNDERFLOW -> pessimistic update path
BEGIN;
INSERT INTO t_space VALUES (1392684638434107392, 1250056650086289408, '  ');
COMMIT;

--echo # Test 3.2c.2: Empty string to single space - Path 4B (pessimistic update)
--echo # Pre-fill page again to ensure pessimistic update
BEGIN;
INSERT INTO t_space VALUES 
  (2001, 200, ''), (2002, 200, ''), (2003, 200, ''), (2004, 200, ''), (2005, 200, ''),
  (2006, 200, ''), (2007, 200, ''), (2008, 200, ''), (2009, 200, ''), (2010, 200, ''),
  (2011, 200, ''), (2012, 200, ''), (2013, 200, ''), (2014, 200, ''), (2015, 200, ''),
  (2016, 200, ''), (2017, 200, ''), (2018, 200, ''), (2019, 200, ''), (2020, 200, ''),
  (2021, 200, ''), (2022, 200, ''), (2023, 200, ''), (2024, 200, ''), (2025, 200, ''),
  (2026, 200, ''), (2027, 200, ''), (2028, 200, ''), (2029, 200, ''), (2030, 200, ''),
  (2031, 200, ''), (2032, 200, ''), (2033, 200, ''), (2034, 200, ''), (2035, 200, ''),
  (2036, 200, ''), (2037, 200, ''), (2038, 200, ''), (2039, 200, ''), (2040, 200, ''),
  (2041, 200, ''), (2042, 200, ''), (2043, 200, ''), (2044, 200, ''), (2045, 200, ''),
  (2046, 200, ''), (2047, 200, ''), (2048, 200, ''), (2049, 200, ''), (2050, 200, '');
COMMIT;

BEGIN;
INSERT INTO t_space VALUES (3001, 200, '');
DELETE FROM t_space WHERE id=3001;
--echo # Insert with single space - triggers pessimistic update
INSERT INTO t_space VALUES (3002, 200, ' ');
SELECT * FROM t_space FORCE INDEX(auto_shard_key_nick_name) WHERE nick_name=' ';
COMMIT;

--echo # Test 3.2c.3: Spaces to empty string - Path 4B (pessimistic update, reverse direction)
BEGIN;
INSERT INTO t_space VALUES 
  (4001, 300, '   '), (4002, 300, '   '), (4003, 300, '   '), (4004, 300, '   '), (4005, 300, '   '),
  (4006, 300, '   '), (4007, 300, '   '), (4008, 300, '   '), (4009, 300, '   '), (4010, 300, '   '),
  (4011, 300, '   '), (4012, 300, '   '), (4013, 300, '   '), (4014, 300, '   '), (4015, 300, '   '),
  (4016, 300, '   '), (4017, 300, '   '), (4018, 300, '   '), (4019, 300, '   '), (4020, 300, '   '),
  (4021, 300, '   '), (4022, 300, '   '), (4023, 300, '   '), (4024, 300, '   '), (4025, 300, '   '),
  (4026, 300, '   '), (4027, 300, '   '), (4028, 300, '   '), (4029, 300, '   '), (4030, 300, '   '),
  (4031, 300, '   '), (4032, 300, '   '), (4033, 300, '   '), (4034, 300, '   '), (4035, 300, '   '),
  (4036, 300, '   '), (4037, 300, '   '), (4038, 300, '   '), (4039, 300, '   '), (4040, 300, '   '),
  (4041, 300, '   '), (4042, 300, '   '), (4043, 300, '   '), (4044, 300, '   '), (4045, 300, '   '),
  (4046, 300, '   '), (4047, 300, '   '), (4048, 300, '   '), (4049, 300, '   '), (4050, 300, '   ');
COMMIT;

BEGIN;
INSERT INTO t_space VALUES (5001, 300, '   ');
DELETE FROM t_space WHERE id=5001;
--echo # Insert with empty string - length changes from 3 to 0, triggers pessimistic update
INSERT INTO t_space VALUES (5002, 300, '');
SELECT * FROM t_space FORCE INDEX(auto_shard_key_nick_name) WHERE nick_name='';
COMMIT;

--echo # Test 3.2c.4: Two spaces to four spaces - Path 4B (pessimistic update)
BEGIN;
INSERT INTO t_space VALUES 
  (6001, 400, '  '), (6002, 400, '  '), (6003, 400, '  '), (6004, 400, '  '), (6005, 400, '  '),
  (6006, 400, '  '), (6007, 400, '  '), (6008, 400, '  '), (6009, 400, '  '), (6010, 400, '  '),
