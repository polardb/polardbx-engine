  (6046, 400, '  '), (6047, 400, '  '), (6048, 400, '  '), (6049, 400, '  '), (6050, 400, '  ');
COMMIT;

BEGIN;
INSERT INTO t_space VALUES (7001, 400, '  ');
DELETE FROM t_space WHERE id=7001;
--echo # Insert with different number of spaces - triggers pessimistic update
INSERT INTO t_space VALUES (7002, 400, '    ');
SELECT * FROM t_space FORCE INDEX(auto_shard_key_nick_name) WHERE nick_name='    ';
COMMIT;

--echo # Test 3.2c.5: Empty string to spaces - Path 4A (optimistic non-in-place update)
--echo # Strategy: Use sparse page (not near threshold) to allow optimistic update
--echo # Field size changes but page has enough space for delete+insert
--echo # This triggers optimistic non-in-place update (not pessimistic)
DROP TABLE IF EXISTS t_space_opt;
CREATE TABLE t_space_opt (
  id BIGINT PRIMARY KEY,
  unit_id BIGINT NOT NULL,
  nick_name VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL,
  KEY auto_shard_key_nick_name (nick_name) COMMENT 'hippo_index'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci ROW_FORMAT=DYNAMIC;

--echo # Insert only a few records to keep page sparse
BEGIN;
INSERT INTO t_space_opt VALUES (1, 100, ''), (2, 100, ''), (3, 100, ''), (4, 100, ''), (5, 100, '');
COMMIT;

--echo # Step 1: Insert target record with empty string and delete it
BEGIN;
INSERT INTO t_space_opt VALUES (100, 100, '');
DELETE FROM t_space_opt WHERE id=100;
COMMIT;

--echo # Step 2: Insert with spaces - page has enough space
--echo # This triggers optimistic non-in-place update (Path 4A)
--echo # btr_cur_optimistic_update succeeds, delete+insert within same page
BEGIN;
INSERT INTO t_space_opt VALUES (100, 100, '  ');
SELECT * FROM t_space_opt FORCE INDEX(auto_shard_key_nick_name) WHERE nick_name='  ';
COMMIT;

--echo # Test 3.2c.6: Single space to multiple spaces - Path 4A (optimistic non-in-place)
BEGIN;
INSERT INTO t_space_opt VALUES (200, 200, ' ');
DELETE FROM t_space_opt WHERE id=200;
--echo # Insert with more spaces - optimistic update succeeds
INSERT INTO t_space_opt VALUES (200, 200, '   ');
SELECT * FROM t_space_opt FORCE INDEX(auto_shard_key_nick_name) WHERE nick_name='   ';
COMMIT;

--echo # Test 3.2c.7: Verify all records are correctly stored
SELECT id, unit_id, LENGTH(nick_name) as nick_name_len, 
       CASE WHEN nick_name = '' THEN '(empty)' 
            WHEN nick_name = ' ' THEN '(1 space)' 
            WHEN nick_name = '  ' THEN '(2 spaces)'
            WHEN nick_name = '   ' THEN '(3 spaces)'
            WHEN nick_name = '    ' THEN '(4 spaces)'
            ELSE nick_name END as nick_name_display
FROM t_space FORCE INDEX(auto_shard_key_nick_name) ORDER BY id;

--echo # Cleanup space test tables
DROP TABLE t_space;
DROP TABLE t_space_opt;


--echo ########################################################################
--echo # Test 4: DELETE - Trigger row_sec_assert_tid_in_rec()
--echo ########################################################################

--echo # Test 4.1: Delete by primary key
--echo # Triggers delete-mark on HIPPO index at lizard0btr0cur.cc:382
BEGIN;
DELETE FROM t1 WHERE id=9;
--echo # Verify deleted record not visible via HIPPO index
SELECT * FROM t1 FORCE INDEX(idx_val) WHERE val=1100 ORDER BY id;
COMMIT;

--echo # Test 4.2: Delete by indexed column
BEGIN;
DELETE FROM t1 WHERE val=1100;
SELECT COUNT(*) FROM t1;
COMMIT;


--echo ########################################################################
--echo # Test 5: REPEATABLE READ - Stricter MVCC test with FORCE INDEX
--echo ########################################################################

connection default;
DROP TABLE IF EXISTS t2;

CREATE TABLE t2 (
  id INT PRIMARY KEY,
  val INT,
  KEY idx_val (val) COMMENT 'hippo_index'
) ENGINE=InnoDB;

INSERT INTO t2 VALUES (1,10), (2,20), (3,30), (4,40), (5,50);

connection con1;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
BEGIN;
--echo # con1: Establish snapshot with FORCE INDEX
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val >= 20 ORDER BY id;

connection con2;
BEGIN;
INSERT INTO t2 VALUES (6, 25);
UPDATE t2 SET val=35 WHERE id=3;
DELETE FROM t2 WHERE id=5;
COMMIT;

connection con1;
--echo # con1: Should still see old snapshot via HIPPO index
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val >= 20 ORDER BY id;
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val=25;
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val=30;
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val=50;
COMMIT;

--echo # con1: New transaction sees new data
BEGIN;
SELECT * FROM t2 FORCE INDEX(idx_val) WHERE val >= 20 ORDER BY id;
COMMIT;


--echo ########################################################################
--echo # Test 6: Multiple HIPPO indexes - All trigger assertions
--echo ########################################################################

connection default;
DROP TABLE IF EXISTS t3;

CREATE TABLE t3 (
  pk INT PRIMARY KEY,
  a INT,
  b INT,
  c VARCHAR(50),
  KEY idx_a (a) COMMENT 'hippo_index',
  KEY idx_b (b) COMMENT 'hippo_index'
) ENGINE=InnoDB;

--echo # Test 6.1: INSERT into table with multiple HIPPO indexes
INSERT INTO t3 VALUES 
  (1, 10, 20, 'data1'),
  (2, 10, 30, 'data2'),
  (3, 20, 20, 'data3'),
  (4, 20, 40, 'data4'),
  (5, 30, 50, 'data5');

--echo # Verify both HIPPO indexes
SELECT index_name, index_page_type FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS 
  WHERE table_name='t3' AND index_page_type='HIPPO_INDEX' ORDER BY index_name;

--echo # Test 6.2: Query using different HIPPO indexes
SELECT * FROM t3 FORCE INDEX(idx_a) WHERE a=10 ORDER BY pk;
SELECT * FROM t3 FORCE INDEX(idx_b) WHERE b=20 ORDER BY pk;

--echo # Test 6.3: UPDATE affects both HIPPO indexes
BEGIN;
UPDATE t3 SET a=15, b=25 WHERE pk=1;
SELECT * FROM t3 FORCE INDEX(idx_a) WHERE a=15;
SELECT * FROM t3 FORCE INDEX(idx_b) WHERE b=25;
COMMIT;

--echo # Test 6.4: DELETE removes from both HIPPO indexes
BEGIN;
DELETE FROM t3 WHERE pk=5;
SELECT * FROM t3 FORCE INDEX(idx_a) WHERE a=30;
SELECT * FROM t3 FORCE INDEX(idx_b) WHERE b=50;
COMMIT;


--echo ########################################################################
--echo # Test 7: Mixed DML in single transaction
--echo ########################################################################

connection default;
DROP TABLE IF EXISTS t4;

CREATE TABLE t4 (
  id INT PRIMARY KEY,
  val INT,
  KEY idx_val (val) COMMENT 'hippo_index'
) ENGINE=InnoDB;

INSERT INTO t4 VALUES (1,10), (2,20), (3,30), (4,40), (5,50);

--echo # Test 7.1: Mix INSERT/UPDATE/DELETE in one transaction
BEGIN;
INSERT INTO t4 VALUES (6, 15);
UPDATE t4 SET val=25 WHERE id=2;
DELETE FROM t4 WHERE id=4;
INSERT INTO t4 VALUES (7, 35);
UPDATE t4 SET val=55 WHERE id=5;
--echo # Verify changes via HIPPO index
SELECT * FROM t4 FORCE INDEX(idx_val) WHERE val >= 15 ORDER BY id;
COMMIT;

--echo # Test 7.2: Verify final state
SELECT * FROM t4 FORCE INDEX(idx_val) WHERE val < 30 ORDER BY id;
SELECT * FROM t4 FORCE INDEX(idx_val) WHERE val >= 30 ORDER BY id;


--echo ########################################################################
--echo # Test 8: UPDATE edge cases - additional scenarios
--echo ########################################################################

connection default;
DROP TABLE IF EXISTS t5;

CREATE TABLE t5 (
  id INT PRIMARY KEY,
  idx_col INT,
  non_idx_col VARCHAR(100),
  KEY idx_col (idx_col) COMMENT 'hippo_index'
) ENGINE=InnoDB;

INSERT INTO t5 VALUES (1, 100, 'data1'), (2, 200, 'data2'), (3, 300, 'data3');

--echo # Test 8.1: Update indexed column to new value (Path 1: DELETE+INSERT)
BEGIN;
UPDATE t5 SET idx_col=150 WHERE id=1;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=150;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=100;
COMMIT;

--echo # Test 8.2: Update non-indexed column only
--echo # Note: For HIPPO index, this still goes through secondary index update
BEGIN;
UPDATE t5 SET non_idx_col='data2_modified' WHERE id=2;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=200;
COMMIT;

--echo # Test 8.3: Update both indexed and non-indexed columns
BEGIN;
UPDATE t5 SET idx_col=350, non_idx_col='data3_both_modified' WHERE id=3;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=350;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=300;
COMMIT;

--echo # Test 8.4: Update with same value (optimization may skip)
BEGIN;
UPDATE t5 SET idx_col=150 WHERE id=1;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=150;
COMMIT;

--echo # Test 8.5: Multiple consecutive updates on same record
BEGIN;
UPDATE t5 SET non_idx_col='update1' WHERE id=2;
UPDATE t5 SET non_idx_col='update2' WHERE id=2;
UPDATE t5 SET non_idx_col='update3' WHERE id=2;
SELECT * FROM t5 FORCE INDEX(idx_col) WHERE idx_col=200;
COMMIT;


--echo ########################################################################
--echo # Test 9: Concurrent UPDATE scenarios
--echo ########################################################################

connection default;
DROP TABLE IF EXISTS t6;

CREATE TABLE t6 (
  id INT PRIMARY KEY,
  val INT,
  KEY idx_val (val) COMMENT 'hippo_index'
) ENGINE=InnoDB;

INSERT INTO t6 VALUES (1,10), (2,20), (3,30);

connection con1;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
BEGIN;
SELECT * FROM t6 FORCE INDEX(idx_val) WHERE val >= 10 ORDER BY id;

connection con2;
BEGIN;
UPDATE t6 SET val=15 WHERE id=1;
INSERT INTO t6 VALUES (4, 25);
COMMIT;

connection con1;
--echo # con1: Should see old snapshot via HIPPO index
SELECT * FROM t6 FORCE INDEX(idx_val) WHERE val >= 10 ORDER BY id;
SELECT * FROM t6 FORCE INDEX(idx_val) WHERE val=15;
SELECT * FROM t6 FORCE INDEX(idx_val) WHERE val=25;
COMMIT;


--echo ########################################################################
--echo # Test 10: Verify all assertions were triggered (summary)
--echo ########################################################################

connection default;

--echo # If test reaches here without crash, all assertions passed:
--echo #
--echo # DELETE assertion:
--echo #   - row_sec_assert_tid_in_rec() at lizard0btr0cur.cc:382
--echo #
--echo # INSERT assertions (four paths):
--echo #
--echo #   Path 1: Normal INSERT (most common)
--echo #      - row_sec_assert_tid_in_entry() at row0ins.cc:3108
--echo #
--echo #   Path 2: INSERT by unmark delete-marked record
--echo #      - Condition: same ordering keys, n_fields=0
--echo #      - row_sec_assert_tid_in_rec() at btr0cur.cc:3559
--echo #
--echo #   Path 3: INSERT by in-place update (charset/case)
--echo #      - Condition: same ordering keys, n_fields>0 (case diff)
--echo #      - row_sec_assert_tid_in_rec() at btr0cur.cc:3559
--echo #
--echo #   Path 4: INSERT by non-in-place update (field size change)
--echo #      - Condition: same ordering keys, n_fields>0, old_len != new_len
--echo #      - Path 4A: btr_cur_optimistic_update() succeeds (non-in-place)
--echo #      - Path 4B: btr_cur_optimistic_update() fails -> btr_cur_pessimistic_update()
--echo #      - row_sec_assert_tid_in_rec() at btr0cur.cc:3559
--echo #
--echo # UPDATE = DELETE + INSERT (INSERT uses one of four paths above)
--echo #
--echo # TRX_ID is correctly written in all scenarios!

SELECT 'All TRX_ID assertions passed!' as result;


--echo ########################################################################
--echo # Cleanup
--echo ########################################################################

DROP TABLE t1, t2, t3, t4, t5, t6;

disconnect con1;
disconnect con2;

SET GLOBAL innodb_purge_run_now = ON;

SET opt_index_format_hippo_enabled=default;

