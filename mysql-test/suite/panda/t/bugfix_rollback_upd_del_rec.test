--source include/have_debug.inc

SET @transaction_isolation_global_orig = @@global.transaction_isolation;
SET GLOBAL transaction_isolation= 'READ-COMMITTED';
SET @transaction_isolation_session_orig = @@global.transaction_isolation;
SET SESSION transaction_isolation= 'READ-COMMITTED';

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

--echo ###
--echo # First Test: restore position failed.
--echo ###

connection default;
create table t1 (id int primary key, c1 int, unique key (c1) secondary_engine_attribute '{"gpp":"1","panda index":"1"}');
insert into t1 values (1, 1);
set global innodb_purge_stop_now=1;
delete from t1 where id=1;

connection con1;
begin;
insert into t1 values (2,1);
set debug_sync='before_row_undo_mod_remove_panda_rec SIGNAL s1 wait_for s2';
--send rollback

connection con2;
set debug_sync='now wait_for s1';
set global innodb_purge_run_now=1;
--source include/wait_innodb_all_purged.inc
set debug_sync='now SIGNAL s2';

connection con1;
--reap

#Cleanup
DROP TABLE t1;


--echo ###
--echo # Second Test: restore position succeed, but trx id not equal.
--echo ###

connection default;
create table t1 (id int primary key, c1 int, unique key (c1) secondary_engine_attribute '{"gpp":"1","panda index":"1"}');
insert into t1 values (1, 1);
set global innodb_purge_stop_now=1;
delete from t1 where id=1;

connection con1;
begin;
insert into t1 values (2,1);
set debug_sync='before_row_undo_mod_remove_panda_rec SIGNAL s3 wait_for s4';
--send rollback

connection con2;
set debug_sync='now wait_for s3';
set global innodb_purge_run_now=1;
--source include/wait_innodb_all_purged.inc
insert into t1 values(3,1);
set debug_sync='now SIGNAL s4';

connection con1;
--reap

#Cleanup
DROP TABLE t1;

connection default;
SET GLOBAL transaction_isolation= @transaction_isolation_global_orig;
SET SESSION transaction_isolation= @transaction_isolation_session_orig;
