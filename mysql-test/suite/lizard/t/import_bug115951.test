--source include/have_debug.inc

--echo ########################
--echo # case 1
--echo ########################
connect (con1,localhost,root,,);

connection default;

create table t1 (c1 int, c2 int, primary key(c1));
insert into t1 values (1, 100);
insert into t1 values (2, 200);

create table t2 like t1;
create table t3 like t1;
insert into t2 select * from t1;
insert into t3 select * from t1;

SET SESSION debug='+d,skip_dd_table_access_check';
# SELECT tbl.name as table_name, idx.* FROM mysql.tables tbl JOIN mysql.indexes idx ON tbl.id = idx.table_id WHERE tbl.name = 't2';

connection con1;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
start transaction;
select * from t1;

connection default;
ALTER TABLE t2 DISCARD TABLESPACE;

FLUSH TABLES t3 FOR EXPORT;
LET $MYSQLD_DATADIR = `SELECT @@datadir`;
--copy_file $MYSQLD_DATADIR/test/t3.ibd $MYSQLTEST_VARDIR/tmp/t2.ibd
--copy_file $MYSQLD_DATADIR/test/t3.cfg $MYSQLTEST_VARDIR/tmp/t2.cfg
UNLOCK TABLES;
--copy_file $MYSQLTEST_VARDIR/tmp/t2.ibd $MYSQLD_DATADIR/test/t2.ibd
--copy_file $MYSQLTEST_VARDIR/tmp/t2.cfg $MYSQLD_DATADIR/test/t2.cfg

ALTER TABLE t2 IMPORT TABLESPACE;

--remove_file $MYSQLTEST_VARDIR/tmp/t2.ibd
--remove_file $MYSQLTEST_VARDIR/tmp/t2.cfg

# SELECT tbl.name as table_name, idx.* FROM mysql.tables tbl JOIN mysql.indexes idx ON tbl.id = idx.table_id WHERE tbl.name = 't2';

connection con1;
select * from t2;

connection default;

disconnect con1;
drop table t1;
drop table t2;
drop table t3;

--echo ########################
--echo # case 2
--echo ########################
set global innodb_undo_retention = 90000;

create table t1 (id int primary key, c1 int, key(c1));
insert into t1 values (3, 30);

flush table t1 for export;
--copy_file $MYSQLD_DATADIR/test/t1.ibd $MYSQLTEST_VARDIR/tmp/t1.ibd
--copy_file $MYSQLD_DATADIR/test/t1.cfg $MYSQLTEST_VARDIR/tmp/t1.cfg
unlock tables;

drop table t1;

create table t1 (id int primary key, c1 int, key(c1));

alter table t1 discard tablespace;
--move_file $MYSQLTEST_VARDIR/tmp/t1.ibd $MYSQLD_DATADIR/test/t1.ibd
--move_file $MYSQLTEST_VARDIR/tmp/t1.cfg $MYSQLD_DATADIR/test/t1.cfg
alter table t1 import tablespace;

begin;
delete from t1 where id = 3;
insert into t1 values (3, 40);
rollback;

drop table t1;
set global innodb_undo_retention = default;


--echo ########################
--echo # case 3: Handle the tables in question that already exists in old version.
--echo ########################
set global innodb_undo_retention = 90000;

create table t1 (id int primary key, c1 int, key(c1));
insert into t1 values (3, 30);

flush table t1 for export;
--copy_file $MYSQLD_DATADIR/test/t1.ibd $MYSQLTEST_VARDIR/tmp/t1.ibd
--copy_file $MYSQLD_DATADIR/test/t1.cfg $MYSQLTEST_VARDIR/tmp/t1.cfg
unlock tables;

drop table t1;

create table t1 (id int primary key, c1 int, key(c1));

alter table t1 discard tablespace;
--move_file $MYSQLTEST_VARDIR/tmp/t1.ibd $MYSQLD_DATADIR/test/t1.ibd
--move_file $MYSQLTEST_VARDIR/tmp/t1.cfg $MYSQLD_DATADIR/test/t1.cfg
set session debug="+d, simulate_old_ver_import_roll_ptr";
alter table t1 import tablespace;

begin;
delete from t1 where id = 3;
insert into t1 values (3, 40);
rollback;

drop table t1;
set global innodb_undo_retention = default;
