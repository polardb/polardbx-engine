SET autocommit = 0;
set global innodb_commit_cleanout_max_rows=0;
set global innodb_lizard_stat_enabled=true;
set global innodb_inject_stress_test_for_panda=false;

CREATE TABLE large_table4 (
    id INT  PRIMARY KEY,
    name VARCHAR(50),
    age INT,
    city VARCHAR(50)
);
DELIMITER |;
CREATE PROCEDURE insert_data1()
BEGIN
    DECLARE i INT DEFAULT 0;
    WHILE i < 12000 DO
        INSERT INTO large_table4(id, name, age, city) 
        VALUES (
            i,
            CONCAT('Name', i),
            FLOOR(18 + (i * 62)),
            'New York'
        );
        SET i = i + 1;
    END WHILE;
END |
DELIMITER ;|
CALL insert_data1();

#show status like '%cleaned%';

ALTER TABLE large_table4 ADD INDEX idx_name (name);

--let $var_value=query_get_value(show status like "lizard_ddl_cleanout_clean", Value, 1)
--let $assert_text= ddl_cleanout should make sense.
--let $assert_cond= $var_value > 0
--source include/assert.inc

#show status like '%cleaned%';


set global innodb_commit_cleanout_max_rows=3;
set global innodb_lizard_stat_enabled=false;
SET autocommit = 1;
set global innodb_inject_stress_test_for_panda=true;
DROP PROCEDURE insert_data1;
DROP TABLE large_table4;