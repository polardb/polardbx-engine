--source include/have_debug.inc
--echo #
--echo # Test GPP (Guess Primary Page) for MRR (Multi-Range Read) on
--echo # HASH-partitioned tables. MRR hint forces multi-range read path;
--echo # GPP should accelerate clustered index lookups when reading back
--echo # rows from sorted rowid ranges across all partitions.
--echo #

# Save original values
--let $orig_innodb_lizard_stat_enabled = `SELECT @@GLOBAL.innodb_lizard_stat_enabled`
--let $orig_innodb_index_purge_guess_clust_enabled = `SELECT @@GLOBAL.innodb_index_purge_guess_clust_enabled`
--let $orig_innodb_index_scan_guess_clust_enabled = `SELECT @@GLOBAL.innodb_index_scan_guess_clust_enabled`
--let $orig_innodb_adaptive_hash_index = `SELECT @@GLOBAL.innodb_adaptive_hash_index`
--let $orig_innodb_polarx_btree_search_mode = `SELECT @@GLOBAL.innodb_polarx_btree_search_mode`

# Enable GPP mode
SET GLOBAL innodb_lizard_stat_enabled=on;
SET GLOBAL innodb_index_purge_guess_clust_enabled=on;
SET GLOBAL innodb_index_scan_guess_clust_enabled=on;
SET GLOBAL innodb_adaptive_hash_index = OFF;
SET GLOBAL innodb_polarx_btree_search_mode = OFF;

--echo # -----------------------------------------------------------------------
--echo # Create a HASH-partitioned table with multiple secondary indexes.
--echo # -----------------------------------------------------------------------

CREATE TABLE tp (
    id  INT AUTO_INCREMENT,
    a   VARCHAR(10) NOT NULL,
    b   INT         NOT NULL,
    c   INT         NOT NULL,
    d   CHAR(1)     NOT NULL DEFAULT 'A',
    PRIMARY KEY (id),
    KEY idx_a (a),
    KEY idx_b (b),
    KEY idx_cd (c, d)
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC
PARTITION BY HASH(id) PARTITIONS 4;

--echo # -----------------------------------------------------------------------
--echo # Insert 1000 rows distributed across 4 partitions.
--echo # -----------------------------------------------------------------------

--delimiter //
CREATE PROCEDURE insert_tp_data(IN num_rows INT)
BEGIN
    DECLARE i INT DEFAULT 1;
    START TRANSACTION;
    WHILE i <= num_rows DO
        INSERT INTO tp (id, a, b, c, d) VALUES (
            i,
            CONCAT('NO', LPAD(i, 4, '0')),
            i * 10,
            i * 50,
            ELT(((i - 1) % 3) + 1, 'A', 'B', 'C')
        );
        SET i = i + 1;
    END WHILE;
    COMMIT;
END//
--delimiter ;

CALL insert_tp_data(1000);
SELECT COUNT(*) AS row_count FROM tp;

--echo # ===================================================================
--echo # Test 1: Range scan without MRR hint (baseline)
--echo # ===================================================================

EXPLAIN SELECT * FROM tp WHERE a < 'NO0101';

--disable_result_log
SELECT * FROM tp WHERE a < 'NO0101';
--enable_result_log

SHOW status LIKE "%multi_range%";

--echo # ===================================================================
--echo # Test 2: Range scan WITH MRR hint — forces multi-range read path
--echo # GPP should be used for clustered index lookups.
--echo # ===================================================================

call dbms_stat.flush_gpp();

EXPLAIN SELECT /*+ MRR(tp) */ * FROM tp WHERE a < 'NO0101';

--disable_result_log
SELECT /*+ MRR(tp) */ * FROM tp WHERE a < 'NO0101';
--enable_result_log

--let $mrr_hit = query_get_value(show global status like "Lizard_multi_range_read_gpp_hit", Value, 1)
--let $mrr_miss = query_get_value(show global status like "Lizard_multi_range_read_gpp_miss", Value, 1)

--let $assert_text = [partition MRR] gpp total (hit+miss) should be > 0
--let $assert_cond = $mrr_hit + $mrr_miss > 0
--source include/assert.inc

--echo # ===================================================================
--echo # Test 3: MRR with additional filter condition (a < ... AND b > ...)
--echo # ===================================================================

call dbms_stat.flush_gpp();

EXPLAIN SELECT /*+ MRR(tp) */ * FROM tp WHERE a < "NO0101" AND b > 20;

--disable_result_log
SELECT /*+ MRR(tp) */ * FROM tp WHERE a < "NO0101" AND b > 20;
--enable_result_log

--let $mrr_hit = query_get_value(show global status like "Lizard_multi_range_read_gpp_hit", Value, 1)
--let $mrr_miss = query_get_value(show global status like "Lizard_multi_range_read_gpp_miss", Value, 1)

--let $assert_text = [partition MRR with filter] gpp total (hit+miss) should be > 0
--let $assert_cond = $mrr_hit + $mrr_miss > 0
--source include/assert.inc

--echo # ===================================================================
--echo # Test 4: MRR on idx_b with range scan
--echo # ===================================================================

call dbms_stat.flush_gpp();

EXPLAIN SELECT /*+ MRR(tp) */ * FROM tp WHERE b < 200;

--disable_result_log
SELECT /*+ MRR(tp) */ * FROM tp WHERE b < 200;
--enable_result_log

--let $mrr_hit = query_get_value(show global status like "Lizard_multi_range_read_gpp_hit", Value, 1)
--let $mrr_miss = query_get_value(show global status like "Lizard_multi_range_read_gpp_miss", Value, 1)

--let $assert_text = [partition MRR idx_b] gpp total (hit+miss) should be > 0
--let $assert_cond = $mrr_hit + $mrr_miss > 0
--source include/assert.inc

--echo # -----------------------------------------------------------------------
--echo # Clean up
--echo # -----------------------------------------------------------------------

DROP PROCEDURE insert_tp_data;
DROP TABLE tp;

SET GLOBAL innodb_purge_stop_now = default;
SET GLOBAL innodb_dbug_gpp_no = default;

--eval SET GLOBAL innodb_lizard_stat_enabled = $orig_innodb_lizard_stat_enabled
--eval SET GLOBAL innodb_index_purge_guess_clust_enabled = $orig_innodb_index_purge_guess_clust_enabled
--eval SET GLOBAL innodb_index_scan_guess_clust_enabled = $orig_innodb_index_scan_guess_clust_enabled
--eval SET GLOBAL innodb_adaptive_hash_index = $orig_innodb_adaptive_hash_index
--eval SET GLOBAL innodb_polarx_btree_search_mode = $orig_innodb_polarx_btree_search_mode
SET DEBUG_SYNC = 'RESET';
SET DEBUG = '';
