# This test is to verify that the number of pages pre-allocate is correct.
# The rules of pages pre-allocate is defined by calc_lob_pages_needed() in lizard0lob0lob.cc.

--source include/have_binlog_format_row.inc
--source include/have_innodb_max_16k.inc

--echo ####################################################################################
--echo # 1. prepare
--echo ####################################################################################

set @old_innodb_lob_prealloc = @@innodb_lob_prealloc;

# first page size. See calc_lob_pages_needed() for details.
set @size_0 = 15680;
set @size_1 = 162623;
set @size_2 = 4603567;

CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `data` mediumblob NOT NULL,
  PRIMARY KEY (`id`)
) ;

SET @fails_before = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_fail_no_space');
SET @under_before = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_underestimate_pages');

--echo ####################################################################################
--echo # 2. innodb_lob_prealloc is off
--echo ####################################################################################

SET global innodb_lob_prealloc = off;

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

insert into t1 values(1, repeat('1', 16384));

update t1 set data = repeat('2', 16384) where id = 1;

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# innodb_lob_prealloc is off, so Lizard_lob_prealloc_pages should not be increased.
if (`SELECT CONVERT(@alloc_pages_after, SIGNED) > CONVERT(@alloc_pages_bofore, SIGNED)`)
{
  --echo "Unexpected: Lizard_lob_prealloc_pages should not be increased."
  --die
}

SET global innodb_lob_prealloc = on;

--echo ####################################################################################
--echo # 3. write blob with size <= first page size (15680, size_0)
--echo ####################################################################################

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

insert into t1 values(2, repeat('1', 10000));

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# 1 first page is needed
if (`SELECT CONVERT(@alloc_pages_after, SIGNED) != CONVERT(@alloc_pages_bofore, SIGNED) + 1`)
{
  --echo "Unexpected: Lizard_lob_prealloc_pages should be increased by 1."
  --die
}

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# write blob with @size_0
update t1 set data = repeat('2', @size_0) where id = 2;

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# 1 first page is needed
if (`SELECT CONVERT(@alloc_pages_after, SIGNED) != CONVERT(@alloc_pages_bofore, SIGNED) + 1`)
{
  --echo "Unexpected: Lizard_lob_prealloc_pages should be increased by 1."
  --die
}

--echo ####################################################################################
--echo # 4. write blob with size <= size_1 (162623, defined in lizard0lob0lob.cc)
--echo ####################################################################################

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# blob size is first page size + 1
insert into t1 values(3, repeat('1', @size_0 + 1));

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# 1 first page and 1 data page are needed
if (`SELECT CONVERT(@alloc_pages_after, SIGNED) != CONVERT(@alloc_pages_bofore, SIGNED) + 2`)
{
  --echo "Unexpected: Lizard_lob_prealloc_pages should be increased by 2."
  --die
}

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# blob size is size_1
update t1 set data = repeat('2', @size_1) where id = 3;

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# 1 first page and 9 data pages are needed
if (`SELECT CONVERT(@alloc_pages_after, SIGNED) != CONVERT(@alloc_pages_bofore, SIGNED) + 10`)
{
  --echo "Unexpected: Lizard_lob_prealloc_pages should be increased by 10."
  --die
}

--echo ####################################################################################
--echo # 5. write blob with size <= size_2 (4603567, defined in lizard0lob0lob.cc)
--echo ####################################################################################

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# blob size is size_1 + 1
insert into t1 values(4, repeat('1', @size_1 + 1));

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# 1 first page , 1 node page and 10 data pages are needed
if (`SELECT CONVERT(@alloc_pages_after, SIGNED) != CONVERT(@alloc_pages_bofore, SIGNED) + 12`)
{
  --echo "Unexpected: Lizard_lob_prealloc_pages should be increased by 12."
  --die
}

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# blob size is size_2
update t1 set data = repeat('2', @size_2) where id = 4;

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# 1 first page , 1 node page and 281 data pages are needed
if (`SELECT CONVERT(@alloc_pages_after, SIGNED) != CONVERT(@alloc_pages_bofore, SIGNED) + 283`){
  --echo "Unexpected: Lizard_lob_prealloc_pages should be increased by 283."
  --die
}

--echo ####################################################################################
--echo # 6. write blob with size > size_2 (4603567, defined in lizard0lob0lob.cc)
--echo ####################################################################################

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# blob size is size_2 + 1
insert into t1 values(5, repeat('1', @size_2 + 1));

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# prealloc continues for size > size_2 (multi-node-page path)
if (`SELECT CONVERT(@alloc_pages_after, SIGNED) <= CONVERT(@alloc_pages_bofore, SIGNED)`)
{
  --echo "Unexpected: Lizard_lob_prealloc_pages should be increased for size > size_2."
  --die
}

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# blob size is size_2 + 5
update t1 set data = repeat('2', @size_2 + 5) where id = 5;

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# prealloc continues for size > size_2 (multi-node-page path)
if (`SELECT CONVERT(@alloc_pages_after, SIGNED) <= CONVERT(@alloc_pages_bofore, SIGNED)`)
{
  --echo "Unexpected: Lizard_lob_prealloc_pages should be increased for size > size_2."
  --die
}

# verify data correctness: fallback-path UPDATE (BTR_MODIFY_TREE) must not corrupt data.
check table t1;

--echo ####################################################################################
--echo # 7. write blob with random size in (10k, @size_2]
--echo ####################################################################################

truncate table t1;

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

DELIMITER |;

CREATE PROCEDURE InsertRandomData()
BEGIN
    DECLARE i INT DEFAULT 1;
    DECLARE loop_count INT DEFAULT 100;
    DECLARE size INT;

    WHILE i <= loop_count DO
        -- size is random in (8129, @size_2]
        SET size = FLOOR(RAND() * (@size_2 - 8129 + 1)) + 8192;

        INSERT INTO t1 (id, data) VALUES (0, REPEAT('1', size));

        SET i = i + 1;
    END WHILE;
END |

CREATE PROCEDURE UpdateRandomData()
BEGIN
    DECLARE i INT DEFAULT 1;
    DECLARE loop_count INT DEFAULT 100;
    DECLARE size INT;

    WHILE i <= loop_count DO
        -- size is random in (8129, @size_2]
        SET size = FLOOR(RAND() * (100 - 8 + 1)) + 8;

        update t1 set data = repeat('2', @size_2) where id = i;

        SET i = i + 1;
    END WHILE;
END |

DELIMITER ;|

call InsertRandomData();
call UpdateRandomData();

select count(*) from t1;

SET @fails_after     = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_fail_no_space');
SET @under_after     = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_underestimate_pages');

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# Neither counter should have grown during this test run
if (`SELECT CONVERT(@fails_after, SIGNED) != CONVERT(@fails_before, SIGNED)`)
{
  --echo "Unexpected: Lizard_lob_prealloc_fail_no_space increased during this test."
  --die
}

if (`SELECT CONVERT(@under_after, SIGNED) != CONVERT(@under_before, SIGNED)`)
{
  --echo "Unexpected: Lizard_lob_prealloc_underestimate_pages increased during this test."
  --die
}

if (`SELECT CONVERT(@alloc_pages_after, SIGNED) < CONVERT(@alloc_pages_bofore, SIGNED) + 2000`)
{
  --echo "Unexpected: Lizard_lob_prealloc_pages should be increased at least 2000."
  --die
}

--echo ####################################################################################
--echo # 8. temporary table BLOB UPDATE falls back to BTR_MODIFY_TREE
--echo ####################################################################################

# lob prealloc is always disabled for temporary tables (see can_lob_prealloc()),
# so any BLOB UPDATE on a temp table must use the BTR_MODIFY_TREE path.
CREATE TEMPORARY TABLE `t_tmp` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `data` mediumblob NOT NULL,
  PRIMARY KEY (`id`)
);

SET @alloc_pages_bofore = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

insert into t_tmp values(1, repeat('1', 16384));
update t_tmp set data = repeat('2', 16384) where id = 1;

SET @alloc_pages_after = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME ='Lizard_lob_prealloc_pages');

# lob prealloc must not trigger for temp tables; counter must stay unchanged.
if (`SELECT CONVERT(@alloc_pages_after, SIGNED) > CONVERT(@alloc_pages_bofore, SIGNED)`)
{
  --echo "Unexpected: Lizard_lob_prealloc_pages should not be increased for temp table."
  --die
}

check table t_tmp;

drop temporary table t_tmp;

--echo ####################################################################################
--echo # 9. cleanup
--echo ####################################################################################

set global innodb_lob_prealloc = @old_innodb_lob_prealloc;

drop table t1;

drop PROCEDURE InsertRandomData;
drop PROCEDURE UpdateRandomData;
