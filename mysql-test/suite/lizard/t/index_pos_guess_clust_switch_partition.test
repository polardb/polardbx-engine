--echo # ============================================================
--echo # Test 4: Multi-Range Read (MRR) with switch ON/OFF
--echo # ============================================================

SET GLOBAL innodb_index_pos_guess_clust_enabled=on;

--echo # Test MRR with range scan (switch ON)
SELECT /*+ MRR(t) */ * FROM t WHERE a BETWEEN 'VAL00001' AND 'VAL00050' ORDER BY a;
SHOW status LIKE "%multi_range%";

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)
--let $assert_text= [MRR ON range] index_merge gpp total should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc

--echo # Test MRR with multiple ranges
SELECT /*+ MRR(t) */ * FROM t 
WHERE a IN ('VAL00010', 'VAL00020', 'VAL00030', 'VAL00040', 'VAL00050') 
ORDER BY a;
SHOW status LIKE "%multi_range%";

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)
--let $assert_text= [MRR ON multi-range] index_merge gpp total should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc

--echo # Test MRR with filter condition
SELECT /*+ MRR(t) */ * FROM t 
WHERE a BETWEEN 'VAL00001' AND 'VAL00050' AND b > 100 ORDER BY a;
SHOW status LIKE "%multi_range%";

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)
