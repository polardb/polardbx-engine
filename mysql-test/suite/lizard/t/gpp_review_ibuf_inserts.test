--source include/have_debug.inc

--echo #
--echo # P1-4: innodb_change_buffering=inserts writes the legacy ibuf record
--echo # format (no_counter=true) which cannot carry the functional-field
--echo # flags. At merge time the rebuilt dummy index treats the stored GPP
--echo # column as an ordered field, so re-inserting an ordered key whose
--echo # delete-marked record carries a stale GPP inserts a second physical
--echo # record instead of reviving the old one.
--echo #
--echo # Expected (fixed) behaviour: the merge revives the delete-marked
--echo # record, so a subsequent index scan reads no delete-marked rows.
--echo #

--disable_query_log
--let $saved_change_buffering = `SELECT @@GLOBAL.innodb_change_buffering`

SET GLOBAL innodb_purge_stop_now = ON;
SET GLOBAL innodb_disable_background_merge = ON;

# Pin the secondary index to the plain GPP format: hippo would add a TID
# column which also loses its layout flag in the legacy ibuf format and
# would blur the attribution of the failure.
SET SESSION opt_index_format_hippo_enabled = OFF;
SET SESSION opt_index_format_panda_enabled = OFF;

CREATE TABLE t1 (
  id INT NOT NULL PRIMARY KEY,
  k INT NOT NULL,
  pad VARCHAR(700) NOT NULL,
  KEY idx_k (k, pad)
) ENGINE = InnoDB STATS_PERSISTENT = 0;

# Single-page clustered index: the secondary record for (k=1, 'x', id=1)
# stores the clustered root page number as its GPP.
INSERT INTO t1 VALUES (1, 1, 'x');

# Delete-mark the secondary record. Purge is stopped, so it stays with
# its (soon to be) stale GPP.
DELETE FROM t1 WHERE id = 1;

# Grow both trees to several levels/leaves:
# - the clustered index root becomes an internal page, so the later
#   re-insert of id=1 lands on a leaf whose page number differs from the
#   stale GPP for sure;
# - the secondary leaf holding k=1 is no longer the root, so change
#   buffering applies to it.
INSERT INTO t1 VALUES (1000, 1000, REPEAT('a', 700));
--let $i = 0
while ($i < 10)
{
  eval INSERT INTO t1 SELECT id + POWER(2, $i), k + POWER(2, $i), pad FROM t1 WHERE id >= 1000;
  inc $i;
}

# Clean all pages so that change_buffering_debug can evict them.
SET GLOBAL innodb_buf_flush_list_now = ON;

SET GLOBAL innodb_change_buffering = 'inserts';
SET GLOBAL innodb_change_buffering_debug = 1;

--let $ins_merged_before = query_get_value(SELECT COUNT FROM INFORMATION_SCHEMA.INNODB_METRICS WHERE NAME='ibuf_merges_insert', COUNT, 1)

# Same ordered key (k=1, 'x'), same PK: correct merge behaviour is to
# revive the delete-marked record. The buffered entry carries the new
# clustered leaf page number as GPP, differing from the stale one.
INSERT INTO t1 VALUES (1, 1, 'x');

SET GLOBAL innodb_change_buffering_debug = 0;

TRUNCATE TABLE performance_schema.events_statements_summary_by_digest;
--enable_query_log

SELECT COUNT(*) AS visible_rows FROM t1 FORCE INDEX (idx_k) WHERE k = 1;

--disable_query_log
--let $ins_merged_after = query_get_value(SELECT COUNT FROM INFORMATION_SCHEMA.INNODB_METRICS WHERE NAME='ibuf_merges_insert', COUNT, 1)

--let $assert_text = the re-insert must have gone through the change buffer
--let $assert_cond = $ins_merged_after > $ins_merged_before
--source include/assert.inc

--let $delete_mark_reads = query_get_value(SELECT SUM(ROWS_READ_DELETE_MARK) AS dmr FROM performance_schema.events_statements_summary_by_digest_supplement WHERE DIGEST_TEXT LIKE 'SELECT COUNT%FORCE INDEX%', dmr, 1)

--let $assert_text = ibuf insert merge must revive the delete-marked secondary record
--let $assert_cond = $delete_mark_reads = 0
--source include/assert.inc

SET GLOBAL innodb_change_buffering_debug = DEFAULT;
SET GLOBAL innodb_disable_background_merge = DEFAULT;
eval SET GLOBAL innodb_change_buffering = '$saved_change_buffering';
SET GLOBAL innodb_purge_run_now = ON;
DROP TABLE t1;
--enable_query_log
