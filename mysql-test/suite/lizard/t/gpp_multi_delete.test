--echo #
--echo # Test GPP (Guess Primary Page) support for multi-table DELETE.
--echo # When multi-table DELETE uses the delayed delete path (buffering rowids
--echo # in a Unique object then calling ha_rnd_pos to position on each row),
--echo # GPP should be used to speed up clustered index lookups.
--echo #

--source include/have_debug.inc

# Save original values
--let $orig_opt_index_format_gpp_enabled = `SELECT @@global.opt_index_format_gpp_enabled`
--let $orig_innodb_lizard_stat_enabled = `SELECT @@global.innodb_lizard_stat_enabled`
--let $orig_innodb_index_pos_guess_clust_enabled = `SELECT @@global.innodb_index_pos_guess_clust_enabled`

# Enable GPP and statistics
set global innodb_lizard_stat_enabled=on;
set global innodb_index_pos_guess_clust_enabled=on;
set opt_index_format_gpp_enabled=true;

--echo # -----------------------------------------------------------------------
--echo # Create two tables. t1 is the "driver" table, t2 is the table to be
--echo # deleted from via the delayed path (non-immediate, buffered rowids).
--echo # t2 has a LONGTEXT column and a composite PK.
--echo # -----------------------------------------------------------------------

CREATE TABLE t1 (
  id INT NOT NULL PRIMARY KEY,
  val INT NOT NULL
) ENGINE=InnoDB;

CREATE TABLE t2 (
  id INT NOT NULL,
  name VARCHAR(50) NOT NULL,
  c INT NOT NULL,
  data LONGTEXT,
  PRIMARY KEY (id, name),
  KEY idx_c (c)
) ENGINE=InnoDB;

--echo # -----------------------------------------------------------------------
--echo # Helper: populate both tables with 100 rows each.
--echo # -----------------------------------------------------------------------

--delimiter //
CREATE PROCEDURE populate_tables()
BEGIN
  TRUNCATE TABLE t1;
  TRUNCATE TABLE t2;

  INSERT INTO t1 (id, val)
  WITH RECURSIVE seq AS (
    SELECT 1 AS i
    UNION ALL
    SELECT i + 1 FROM seq WHERE i < 100
  )
  SELECT i, i * 10 FROM seq;

  INSERT INTO t2 (id, name, c, data)
  WITH RECURSIVE seq AS (
    SELECT 1 AS i
    UNION ALL
    SELECT i + 1 FROM seq WHERE i < 100
  )
  SELECT
    i,
    CONCAT('user_', LPAD(i, 5, '0')),
    100 - i,
    REPEAT(CHAR(65 + (i MOD 26) USING ascii), 1500)
  FROM seq;
END//
--delimiter ;

CALL populate_tables();
SELECT COUNT(*) AS t1_rows FROM t1;
SELECT COUNT(*) AS t2_rows FROM t2;

--echo # -----------------------------------------------------------------------
--echo # Test 1: Multi-table DELETE — delete from t2 via JOIN with t1.
--echo # This triggers the delayed delete path: rowids of t2 are buffered in
--echo # a Unique, then ha_rnd_pos is called with GM_MULTI_DELETE to read back.
--echo # -----------------------------------------------------------------------

call dbms_stat.flush_gpp();

DELETE t2 FROM t1 JOIN t2 ON t1.id = t2.id;

--let $md_hit = query_get_value(show global status like "Lizard_multi_delete_gpp_hit", Value, 1)
--let $md_miss = query_get_value(show global status like "Lizard_multi_delete_gpp_miss", Value, 1)

--let $assert_text = multi_delete gpp total (hit+miss) should be 100
--let $assert_cond = $md_hit + $md_miss = 100
--source include/assert.inc

--let $assert_text = multi_delete gpp hit should be greater than 0
--let $assert_cond = $md_hit > 0
--source include/assert.inc

--echo # -----------------------------------------------------------------------
--echo # Verify result correctness after the multi-table DELETE.
--echo # All 100 rows in t2 should have been deleted.
--echo # -----------------------------------------------------------------------

SELECT COUNT(*) AS remaining_rows FROM t2;

--echo # -----------------------------------------------------------------------
--echo # Test 2: Multi-table DELETE with a WHERE clause (partial delete).
--echo # Re-populate and delete only rows where t1.val <= 500 (50 rows).
--echo # -----------------------------------------------------------------------

CALL populate_tables();
call dbms_stat.flush_gpp();

DELETE t2 FROM t1 JOIN t2 ON t1.id = t2.id
WHERE t1.val <= 500;

--let $md_hit = query_get_value(show global status like "Lizard_multi_delete_gpp_hit", Value, 1)
--let $md_miss = query_get_value(show global status like "Lizard_multi_delete_gpp_miss", Value, 1)

--let $assert_text = multi_delete gpp total (hit+miss) should be 50 with WHERE
--let $assert_cond = $md_hit + $md_miss = 50
--source include/assert.inc

SELECT COUNT(*) AS remaining_rows FROM t2;

--echo # -----------------------------------------------------------------------
--echo # Test 3: Verify no multi_delete GPP stat when GPP is disabled.
--echo # -----------------------------------------------------------------------

CALL populate_tables();
set global innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();

DELETE t2 FROM t1 JOIN t2 ON t1.id = t2.id;

--let $md_hit = query_get_value(show global status like "Lizard_multi_delete_gpp_hit", Value, 1)
--let $md_miss = query_get_value(show global status like "Lizard_multi_delete_gpp_miss", Value, 1)

--let $assert_text = multi_delete gpp hit should be 0 when GPP disabled
--let $assert_cond = $md_hit = 0
--source include/assert.inc

--let $assert_text = multi_delete gpp miss should be 0 when GPP disabled
--let $assert_cond = $md_miss = 0
--source include/assert.inc

set global innodb_index_pos_guess_clust_enabled=on;

--echo # -----------------------------------------------------------------------
--echo # Clean up
--echo # -----------------------------------------------------------------------

DROP PROCEDURE populate_tables;
DROP TABLE t1, t2;

--eval SET opt_index_format_gpp_enabled = $orig_opt_index_format_gpp_enabled
--eval SET GLOBAL innodb_lizard_stat_enabled = $orig_innodb_lizard_stat_enabled
--eval SET GLOBAL innodb_index_pos_guess_clust_enabled = $orig_innodb_index_pos_guess_clust_enabled
