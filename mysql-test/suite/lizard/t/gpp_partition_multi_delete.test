--echo #
--echo # Test GPP (Guess Primary Page) support for multi-table DELETE on
--echo # partitioned tables. When multi-table DELETE uses the delayed delete
--echo # path (buffering rowids in Unique then calling ha_rnd_pos), GPP should
--echo # speed up clustered index lookups across all partitions.
--echo #

--source include/have_debug.inc

# Save original values
--let $orig_opt_index_format_gpp_enabled = `SELECT @@global.opt_index_format_gpp_enabled`
--let $orig_innodb_lizard_stat_enabled = `SELECT @@global.innodb_lizard_stat_enabled`
--let $orig_innodb_index_pos_guess_clust_enabled = `SELECT @@global.innodb_index_pos_guess_clust_enabled`

# Enable GPP and statistics
set global innodb_lizard_stat_enabled=on;
set global innodb_index_pos_guess_clust_enabled=on;
set opt_index_format_gpp_enabled=true;

--echo # -----------------------------------------------------------------------
--echo # Create a driver table t_drv and a HASH-partitioned target table tp.
--echo # tp has LONGTEXT and composite PK.
--echo # -----------------------------------------------------------------------

CREATE TABLE t_drv (
  id INT NOT NULL PRIMARY KEY,
  val INT NOT NULL
) ENGINE=InnoDB;

CREATE TABLE tp (
  id INT NOT NULL,
  name VARCHAR(50) NOT NULL,
  c INT NOT NULL,
  data LONGTEXT,
  PRIMARY KEY (id, name),
  KEY idx_c (c)
) ENGINE=InnoDB
PARTITION BY HASH(id) PARTITIONS 4;

--echo # -----------------------------------------------------------------------
--echo # Helper: populate both tables with 100 rows each.
--echo # -----------------------------------------------------------------------

--delimiter //
CREATE PROCEDURE populate_tables()
BEGIN
  TRUNCATE TABLE t_drv;
  TRUNCATE TABLE tp;

  INSERT INTO t_drv (id, val)
  WITH RECURSIVE seq AS (
    SELECT 1 AS i
    UNION ALL
    SELECT i + 1 FROM seq WHERE i < 100
  )
  SELECT i, i * 10 FROM seq;

  INSERT INTO tp (id, name, c, data)
  WITH RECURSIVE seq AS (
    SELECT 1 AS i
    UNION ALL
    SELECT i + 1 FROM seq WHERE i < 100
  )
  SELECT
    i,
    CONCAT('user_', LPAD(i, 5, '0')),
    100 - i,
    REPEAT(CHAR(65 + (i MOD 26) USING ascii), 1500)
  FROM seq;
END//
--delimiter ;

CALL populate_tables();
SELECT COUNT(*) AS drv_rows FROM t_drv;
SELECT COUNT(*) AS tp_rows FROM tp;

--echo # -----------------------------------------------------------------------
--echo # Test 1: Multi-table DELETE — delete from tp via JOIN with t_drv.
--echo # This triggers the delayed delete path: rowids of tp are buffered in
--echo # a Unique, then ha_rnd_pos is called with GM_MULTI_DELETE to read back.
--echo # -----------------------------------------------------------------------

call dbms_stat.flush_gpp();

DELETE tp FROM t_drv JOIN tp ON t_drv.id = tp.id;

--let $md_hit = query_get_value(show global status like "Lizard_multi_delete_gpp_hit", Value, 1)
--let $md_miss = query_get_value(show global status like "Lizard_multi_delete_gpp_miss", Value, 1)

--let $assert_text = [partition multi_delete] gpp total (hit+miss) should be 100
--let $assert_cond = $md_hit + $md_miss = 100
--source include/assert.inc

--let $assert_text = [partition multi_delete] gpp hit should be > 0
--let $assert_cond = $md_hit > 0
--source include/assert.inc

# Verify rows are actually deleted
SELECT COUNT(*) AS remaining_rows FROM tp;

--echo # -----------------------------------------------------------------------
--echo # Test 2: Multi-table DELETE with WHERE clause (partial: 50 rows).
--echo # -----------------------------------------------------------------------

CALL populate_tables();
call dbms_stat.flush_gpp();

DELETE tp FROM t_drv JOIN tp ON t_drv.id = tp.id
WHERE t_drv.val <= 500;

--let $md_hit = query_get_value(show global status like "Lizard_multi_delete_gpp_hit", Value, 1)
--let $md_miss = query_get_value(show global status like "Lizard_multi_delete_gpp_miss", Value, 1)

--let $assert_text = [partition multi_delete] gpp total (hit+miss) should be 50 with WHERE
--let $assert_cond = $md_hit + $md_miss = 50
--source include/assert.inc

SELECT COUNT(*) AS remaining_rows FROM tp;

--echo # -----------------------------------------------------------------------
--echo # Test 3: Verify no multi_delete GPP stat when GPP is disabled.
--echo # -----------------------------------------------------------------------

CALL populate_tables();
set global innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();

DELETE tp FROM t_drv JOIN tp ON t_drv.id = tp.id;

--let $md_hit = query_get_value(show global status like "Lizard_multi_delete_gpp_hit", Value, 1)
--let $md_miss = query_get_value(show global status like "Lizard_multi_delete_gpp_miss", Value, 1)

--let $assert_text = [partition multi_delete GPP disabled] gpp hit should be 0
--let $assert_cond = $md_hit = 0
--source include/assert.inc

--let $assert_text = [partition multi_delete GPP disabled] gpp miss should be 0
--let $assert_cond = $md_miss = 0
--source include/assert.inc

set global innodb_index_pos_guess_clust_enabled=on;

--echo # -----------------------------------------------------------------------
--echo # Clean up
--echo # -----------------------------------------------------------------------

DROP PROCEDURE populate_tables;
DROP TABLE t_drv, tp;

--eval SET opt_index_format_gpp_enabled = $orig_opt_index_format_gpp_enabled
--eval SET GLOBAL innodb_lizard_stat_enabled = $orig_innodb_lizard_stat_enabled
--eval SET GLOBAL innodb_index_pos_guess_clust_enabled = $orig_innodb_index_pos_guess_clust_enabled
