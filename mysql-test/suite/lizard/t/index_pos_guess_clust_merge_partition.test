--echo # BEGIN TEST FOR SORT-UNION MERGE ---------------------------------------------------------------
--echo # Check the condition of UNION MERGE
# YES
EXPLAIN SELECT /*+INDEX_MERGE(t idx_b,PRIMARY) */ * FROM t WHERE id < 10 OR b < 20 ;
# YES
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a = "NO0101" OR b < 20;
# YES
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a < "NO0101" OR b < 20;
# YES
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c = 10;
# YES
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c < 10;
# YES
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b,idx_cd) */ * FROM t WHERE a = "NO0001" OR b < 10 OR (c = 5000 AND d = "A");
# -------------------------------------------------------------------------------------------------
# No, conditions should be connected using OR operators
EXPLAIN SELECT /*+INDEX_MERGE(t idx_b,PRIMARY) */ * FROM t WHERE id < 10 AND b < 20;
# No, there should be at least two indexes to merge
EXPLAIN SELECT /*+INDEX_MERGE(t idx_cd) */ * FROM t WHERE c < 10 AND d < 'b';
 
