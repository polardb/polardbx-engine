--echo # BEGIN TEST FOR UNION MERGE ---------------------------------------------------------------
 
--echo # Check the condition of UNION MERGE
# Yes
EXPLAIN SELECT /*+INDEX_MERGE(t idx_b,PRIMARY) */ * FROM t WHERE b = 1000 OR id < 100;
# Yes
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a = "NO0011" OR b = 200;
# Yes
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0100" OR (c = 50 AND d = "A");
# Yes, trigger union merge and intersection merge at the same time
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b,idx_cd) */ * FROM t WHERE (a = "NO0100" and b =100 )OR (c = 50 AND d = "A");
# -------------------------------------------------------------------------------------------------
# No, secondary index contains range query, with trigger sort-union merge
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a = "NO0111" OR b < 100;
# No, does not include all columns of composite index idx_cd, with trigger sort-union merge
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c = 10;
# No, uses AND to connect query conditions, will trigger intersection merge 
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a = "NO0001" AND b = 100;
# No, conditions on columns within a composite index should be connected using AND operators
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b,idx_cd) */ * FROM t WHERE (a = "NO0100" and b =100 ) OR (c = 50 OR d = "A");
 
--echo # Check whether the union index merge with valid gpp hits
SELECT /*+INDEX_MERGE(t idx_b,PRIMARY) */ * FROM t WHERE b = 1000 OR id < 100;

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)
--let $assert_text= [union idx_b,PRIMARY valid] gpp total (hit+miss) should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc
