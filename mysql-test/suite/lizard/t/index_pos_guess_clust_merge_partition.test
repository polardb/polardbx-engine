--echo # Check whether the intersection index merge with gpp can hit when one of the secondary index's gpp info is invalid
# Use Optimize_Table to make all the gpp infos of t invalid
OPTIMIZE TABLE t;
# Drop and re-create the index on b to make one of the secondary index's gpp info valid
DROP INDEX idx_b ON t;
CREATE INDEX idx_b ON t(b);
# Check whether the index merge with gpp can still hit
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a = "NO0001" AND b = 10;
SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a = "NO0001" AND b = 10;

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
