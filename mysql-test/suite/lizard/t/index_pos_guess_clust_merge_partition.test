# Make all the gpp infos of t invalid
SET DEBUG='+d,set_gpp_null';
EXPLAIN SELECT /*+INDEX_MERGE(t idx_b,PRIMARY) */ * FROM t WHERE id > 999 OR b < 20 ;
SELECT /*+INDEX_MERGE(t idx_b,PRIMARY) */ * FROM t WHERE id > 999 OR b < 20 ;

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)
--let $assert_text= [sort-union idx_b,PRIMARY invalid] gpp total (hit+miss) should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc
# ------------------------------------------------
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a = "NO0101" OR b < 20;
SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a = "NO0101" OR b < 20;

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)
--let $assert_text= [sort-union idx_a,idx_b invalid 1] gpp total (hit+miss) should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc
# ------------------------------------------------
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a < "NO0101" OR b < 20;
SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a < "NO0101" OR b < 20;

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)
--let $assert_text= [sort-union idx_a,idx_b invalid 2] gpp total (hit+miss) should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc
# ------------------------------------------------
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c = 50;
SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c = 50;

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)
--let $assert_text= [sort-union idx_a,idx_cd invalid 1] gpp total (hit+miss) should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc
# ------------------------------------------------
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c < 150;
SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c < 150;

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)
--let $assert_text= [sort-union idx_a,idx_cd invalid 2] gpp total (hit+miss) should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc
# ------------------------------------------------
EXPLAIN SELECT /*+INDEX_MERGE(t idx_a,idx_b,idx_cd) */ * FROM t WHERE a = "NO0001" OR b < 30 OR (c = 5000 AND d = "A");
SELECT /*+INDEX_MERGE(t idx_a,idx_b,idx_cd) */ * FROM t WHERE a = "NO0001" OR b < 30 OR (c = 5000 AND d = "A");

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)
--let $assert_text= [sort-union idx_a,idx_b,idx_cd invalid] gpp total (hit+miss) should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc
# ------------------------------------------------
SET DEBUG='-d,set_gpp_null';
 
--echo # END TEST FOR SORT-UNION MERGE ---------------------------------------------------------------
 
 
--echo --echo # END ALL TEST ---------------------------------------------------------------
DROP TABLE t;
SET GLOBAL innodb_purge_stop_now = default;
SET GLOBAL innodb_dbug_gpp_no = default;
DROP PROCEDURE insert_t_data;

--echo # Restore original values
--eval SET GLOBAL innodb_lizard_stat_enabled = $innodb_lizard_stat_enabled_original
--eval SET GLOBAL innodb_index_purge_guess_clust_enabled = $innodb_index_purge_guess_clust_enabled_original
--eval SET GLOBAL innodb_index_scan_guess_clust_enabled = $innodb_index_scan_guess_clust_enabled_original
--eval SET GLOBAL innodb_adaptive_hash_index = $innodb_adaptive_hash_index_original
--eval SET GLOBAL innodb_polarx_btree_search_mode = $innodb_polarx_btree_search_mode_original
SET DEBUG_SYNC = 'RESET';
SET DEBUG = '';



