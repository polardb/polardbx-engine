--source include/have_debug.inc 

connect (con1,localhost,root,,);

connection con1;


set global max_trx_affected_rows = 0;
create table test1(a int);

begin;
insert into test1 values(1);
insert into test1 select * from test1 limit 1;
insert into test1 select * from test1 limit 2;
insert into test1 select * from test1 limit 3;
commit;

insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;
insert into test1 select * from test1;

set global polarx_slow_query_block_exec_timeout=5;
set global polarx_slow_query_block_cpu_percent_threshold=60;
set global polarx_slow_query_block_exec_timeout_for_cpu_exceed=2;
set global polarx_slow_query_pushdown_username = 'root';

SET global DEBUG='+d,sleep_pushdown_username';

--send set polarx_slow_query_pushdown_username = 'test_user';
--reap

disconnect con1;

connect (con2,localhost,root,,);
connection con2;

--error ER_SLOW_QUERY_TIME_FOR_CPU_EXECEED
insert into test1 select * from test1;

show variables like 'polarx_slow_query_pushdown_username';

# 清理
SET GLOBAL polarx_slow_query_block_exec_timeout = 0;
SET GLOBAL polarx_slow_query_block_cpu_percent_threshold = 0;
SET GLOBAL polarx_slow_query_block_exec_timeout_for_cpu_exceed = 0;
SET global DEBUG='-d,sleep_pushdown_username';
set global polarx_slow_query_pushdown_username='';
drop table test1;
disconnect con2;

