--source include/have_debug.inc
--echo #
--echo # Test row_search_mvcc and row_search_no_mvcc with GPP paths
--echo # This test covers prefetch cache, ICP, and various code paths
--echo #

SET GLOBAL innodb_lizard_stat_enabled=on;
SET GLOBAL innodb_index_purge_guess_clust_enabled=on;
SET GLOBAL innodb_index_scan_guess_clust_enabled=on;
SET GLOBAL innodb_adaptive_hash_index = OFF;

--echo # Create table for testing
CREATE TABLE t1 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    a VARCHAR(20) NOT NULL,
    b INT NOT NULL,
    c INT NOT NULL,
    d CHAR(1) NOT NULL DEFAULT 'X',
    e TEXT
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;

--echo # Insert test data
delimiter |;
CREATE PROCEDURE insert_t1_data(IN num_rows INT)
BEGIN
    DECLARE i INT DEFAULT 1;
    DECLARE val_a VARCHAR(20);
    DECLARE val_b INT;
    DECLARE val_c INT;
    DECLARE val_d CHAR(1);
    START TRANSACTION;
    WHILE i <= num_rows DO
        SET val_a = CONCAT('VAL', LPAD(i, 5, '0'));
        SET val_b = i * 10;
        SET val_c = val_b * 5;
        SET val_d = ELT(((i - 1) % 3) + 1, 'A', 'B', 'C');
        INSERT INTO t1 (id, a, b, c, d) VALUES (i, val_a, val_b, val_c, val_d);
        SET i = i + 1;
    END WHILE;
    COMMIT;
END|
delimiter ;|

CALL insert_t1_data(500);

CREATE INDEX idx_a on t1(a);
CREATE INDEX idx_b on t1(b);
CREATE INDEX idx_cd on t1(c, d);

--echo # Warm up GPP info by accessing records
SELECT * FROM t1 WHERE a = 'VAL00001' LIMIT 1;
SELECT * FROM t1 WHERE b = 10 LIMIT 1;
SELECT * FROM t1 WHERE c = 50 AND d = 'A' LIMIT 1;

--echo # ============================================================
--echo # Test 1: Prefetch cache path without ICP (clustered index)
--echo # ============================================================
--echo # This should trigger prefetch cache and test GPP storage/retrieval
explain SELECT * FROM t1 WHERE id BETWEEN 1 AND 50 ORDER BY id;
SELECT * FROM t1 WHERE id BETWEEN 1 AND 50 ORDER BY id;

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)

--let $assert_text= [scan cluster] gpp total (hit+miss) should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc

--echo # ============================================================
--echo # Test 2: Prefetch cache path without ICP (secondary index)
--echo # ============================================================
explain SELECT * FROM t1 WHERE a BETWEEN 'VAL00001' AND 'VAL00050' ORDER BY a;
SELECT * FROM t1 WHERE a BETWEEN 'VAL00001' AND 'VAL00050' ORDER BY a;

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)

--let $assert_text= [scan secondary] gpp total (hit+miss) should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc

--echo # ============================================================
--echo # Test 3: Prefetch cache path with ICP (secondary index)
--echo # ============================================================
--echo # Test ICP path where records are enqueued to cache
--echo # Use index condition that can be pushed down
explain SELECT * FROM t1 WHERE a BETWEEN 'VAL00001' AND 'VAL00050' AND b > 5 AND b < 500 ORDER BY a;
SELECT * FROM t1 WHERE a BETWEEN 'VAL00001' AND 'VAL00050' AND b > 5 AND b < 500 ORDER BY a;

--let $scan_hit= query_get_value(show global status like "Lizard_index_scan_guess_clust_hit", Value, 1)
--let $scan_miss= query_get_value(show global status like "Lizard_index_scan_guess_clust_miss", Value, 1)

--let $assert_text= [scan ICP] gpp total (hit+miss) should be > 0
--let $assert_cond= $scan_hit + $scan_miss > 0
--source include/assert.inc

