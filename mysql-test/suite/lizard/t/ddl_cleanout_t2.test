DROP PROCEDURE populate_t1;
DROP TABLE t1;


CREATE TABLE large_table (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(50),
    age INT,
    city VARCHAR(50),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
DELIMITER |;
CREATE PROCEDURE insert_data()
BEGIN
    DECLARE i INT DEFAULT 0;
    WHILE i < 1000 DO
        INSERT INTO large_table (name, age, city) 
        VALUES (
            CONCAT('Name', i),
            FLOOR(18 + (i * 62)),
            'New York'
        );
        SET i = i + 1;
    END WHILE;
END |
DELIMITER ;|
CALL insert_data();

#show status like '%ddl_cleanout_clust_cleaned%';
ALTER TABLE large_table ADD INDEX idx_name (name);
#show status like '%ddl_cleanout_clust_cleaned%';


