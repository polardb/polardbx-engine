--source include/have_debug.inc
--echo #
--echo # Test index_pos_guess_clust_enabled switch
--echo # This test verifies the switch works correctly for:
--echo # - Index Intersection
--echo # - Index Union
--echo # - Index Merge (Sort-Union)
--echo # - Multi-Range Read (MRR)
--echo #

--echo # Save original values
--let $innodb_lizard_stat_enabled_original = `SELECT @@GLOBAL.innodb_lizard_stat_enabled`
--let $innodb_index_purge_guess_clust_enabled_original = `SELECT @@GLOBAL.innodb_index_purge_guess_clust_enabled`
--let $innodb_index_scan_guess_clust_enabled_original = `SELECT @@GLOBAL.innodb_index_scan_guess_clust_enabled`
--let $innodb_adaptive_hash_index_original = `SELECT @@GLOBAL.innodb_adaptive_hash_index`
--let $innodb_polarx_btree_search_mode_original = `SELECT @@GLOBAL.innodb_polarx_btree_search_mode`

--echo # enable gpp mode
SET GLOBAL innodb_lizard_stat_enabled=on;
SET GLOBAL innodb_index_purge_guess_clust_enabled=on;
SET GLOBAL innodb_index_scan_guess_clust_enabled=on;
SET GLOBAL innodb_adaptive_hash_index = OFF;
SET GLOBAL innodb_polarx_btree_search_mode = OFF;

--echo # ============================================================
--echo # Setup: Create test table and data
--echo # ============================================================

CREATE TABLE t (
    id INT AUTO_INCREMENT PRIMARY KEY,
    a VARCHAR(20) NOT NULL,
    b INT NOT NULL,
    c INT NOT NULL,
    d CHAR(1) NOT NULL DEFAULT 'A'
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;

--echo # Insert test data
delimiter |;
CREATE PROCEDURE insert_t_data(IN num_rows INT)
BEGIN
    DECLARE i INT DEFAULT 1;
    DECLARE val_a VARCHAR(20);
    DECLARE val_b INT;
    DECLARE val_c INT;
    DECLARE val_d CHAR(1);
    START TRANSACTION;
    WHILE i <= num_rows DO
        SET val_a = CONCAT('VAL', LPAD(i, 5, '0'));
        SET val_b = i * 10;
        SET val_c = val_b * 5;
        SET val_d = ELT(((i - 1) % 3) + 1, 'A', 'B', 'C');
        INSERT INTO t (id, a, b, c, d) VALUES (i, val_a, val_b, val_c, val_d);
        SET i = i + 1;
    END WHILE;
    COMMIT;
END|
delimiter ;|

CALL insert_t_data(1000);
CREATE INDEX idx_a on t(a);
CREATE INDEX idx_b on t(b);
CREATE INDEX idx_cd on t(c, d);

--echo # Warm up GPP info by accessing records
SELECT * FROM t WHERE a = 'VAL00001' LIMIT 1;
SELECT * FROM t WHERE b = 10 LIMIT 1;
SELECT * FROM t WHERE c = 50 AND d = 'A' LIMIT 1;

--echo # ============================================================
--echo # Test 1: Index Intersection with switch ON/OFF
--echo # ============================================================

--echo # --- Switch ON: intersection GPP path should be exercised
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
call dbms_stat.flush_gpp();

SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00050' AND b = 500;

SELECT /*+ INDEX_MERGE(t idx_a, PRIMARY) */ * FROM t 
WHERE a = 'VAL00020' AND id < 10;

SELECT /*+ INDEX_MERGE(t idx_a, idx_cd) */ * FROM t 
WHERE a = 'VAL00050' AND c = 2500 AND d = 'A';

--let $ri_hit = query_get_value(show global status like "Lizard_rowid_intersection_gpp_hit", Value, 1)
--let $ri_miss = query_get_value(show global status like "Lizard_rowid_intersection_gpp_miss", Value, 1)
--let $assert_text = [Test 1 switch ON] rowid intersection gpp hit+miss should be > 0
--let $assert_cond = $ri_hit + $ri_miss > 0
--source include/assert.inc

--echo # --- Switch OFF: intersection GPP path should NOT be exercised
SET GLOBAL innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();

SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00050' AND b = 500;

SELECT /*+ INDEX_MERGE(t idx_a, PRIMARY) */ * FROM t 
WHERE a = 'VAL00050' AND id < 10;

SELECT /*+ INDEX_MERGE(t idx_a, idx_cd) */ * FROM t 
WHERE a = 'VAL00050' AND c = 2500 AND d = 'A';

--let $ri_hit = query_get_value(show global status like "Lizard_rowid_intersection_gpp_hit", Value, 1)
--let $ri_miss = query_get_value(show global status like "Lizard_rowid_intersection_gpp_miss", Value, 1)
--let $assert_text = [Test 1 switch OFF] rowid intersection gpp hit+miss should be 0
--let $assert_cond = $ri_hit + $ri_miss = 0
--source include/assert.inc

--echo # Restore switch
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;

--echo # ============================================================
--echo # Test 2: Index Union with switch ON/OFF
--echo # ============================================================

--echo # --- Switch ON: union GPP path should be exercised
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
call dbms_stat.flush_gpp();

SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00050' OR b = 500 LIMIT 10;

explain SELECT /*+ INDEX_MERGE(t idx_b, PRIMARY) */ * FROM t 
WHERE b = 500 OR id < 10 LIMIT 10;

SELECT /*+ INDEX_MERGE(t idx_b, PRIMARY) */ * FROM t 
WHERE b = 500 OR id < 10 LIMIT 10;

SELECT /*+ INDEX_MERGE(t idx_a, idx_cd) */ * FROM t 
WHERE a = 'VAL00050' OR (c = 2500 AND d = 'A') LIMIT 10;

SELECT /*+ INDEX_MERGE(t idx_a, idx_b, idx_cd) */ * FROM t 
WHERE (a = 'VAL00050' AND b = 500) OR (c = 2500 AND d = 'A') LIMIT 10;

--let $ru_hit = query_get_value(show global status like "Lizard_rowid_union_gpp_hit", Value, 1)
--let $ru_miss = query_get_value(show global status like "Lizard_rowid_union_gpp_miss", Value, 1)
--let $assert_text = [Test 2 switch ON] rowid union gpp hit+miss should be > 0
--let $assert_cond = $ru_hit + $ru_miss > 0
--source include/assert.inc

--echo # --- Switch OFF: union GPP path should NOT be exercised
SET GLOBAL innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();

SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00050' OR b = 500 LIMIT 10;

SELECT /*+ INDEX_MERGE(t idx_b, PRIMARY) */ * FROM t 
WHERE b = 500 OR id < 10 LIMIT 10;

SELECT /*+ INDEX_MERGE(t idx_a, idx_cd) */ * FROM t 
WHERE a = 'VAL00050' OR (c = 2500 AND d = 'A') LIMIT 10;

--let $ru_hit = query_get_value(show global status like "Lizard_rowid_union_gpp_hit", Value, 1)
--let $ru_miss = query_get_value(show global status like "Lizard_rowid_union_gpp_miss", Value, 1)
--let $assert_text = [Test 2 switch OFF] rowid union gpp hit+miss should be 0
--let $assert_cond = $ru_hit + $ru_miss = 0
--source include/assert.inc

--echo # Restore switch
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;

--echo # ============================================================
--echo # Test 3: Index Merge Sort-Union with switch ON/OFF
--echo # ============================================================

--echo # --- Switch ON: sort-union GPP path should be exercised
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
call dbms_stat.flush_gpp();

explain SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a < 'VAL00050' OR b < 50 LIMIT 20;
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a < 'VAL00050' OR b < 50 LIMIT 20;

SELECT /*+ INDEX_MERGE(t idx_b, PRIMARY) */ * FROM t 
WHERE id < 10 OR b < 50 LIMIT 20;

SELECT /*+ INDEX_MERGE(t idx_a, idx_cd) */ * FROM t 
WHERE a = 'VAL00050' OR c < 2500 LIMIT 20;

SELECT /*+ INDEX_MERGE(t idx_a, idx_b, idx_cd) */ * FROM t 
WHERE a = 'VAL00050' OR b < 50 OR (c = 2500 AND d = 'A') LIMIT 20;

--let $im_hit = query_get_value(show global status like "Lizard_index_merge_gpp_hit", Value, 1)
--let $im_miss = query_get_value(show global status like "Lizard_index_merge_gpp_miss", Value, 1)
--let $assert_text = [Test 3 switch ON] index merge gpp hit+miss should be > 0
--let $assert_cond = $im_hit + $im_miss > 0
--source include/assert.inc

--echo # --- Switch OFF: sort-union GPP path should NOT be exercised
SET GLOBAL innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();

SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a < 'VAL00050' OR b < 50 LIMIT 20;

SELECT /*+ INDEX_MERGE(t idx_b, PRIMARY) */ * FROM t 
WHERE id < 10 OR b < 50 LIMIT 20;

SELECT /*+ INDEX_MERGE(t idx_a, idx_cd) */ * FROM t 
WHERE a = 'VAL00050' OR c < 2500 LIMIT 20;

--let $im_hit = query_get_value(show global status like "Lizard_index_merge_gpp_hit", Value, 1)
--let $im_miss = query_get_value(show global status like "Lizard_index_merge_gpp_miss", Value, 1)
--let $assert_text = [Test 3 switch OFF] index merge gpp hit+miss should be 0
--let $assert_cond = $im_hit + $im_miss = 0
--source include/assert.inc

--echo # Restore switch
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;

--echo # ============================================================
--echo # Test 4: Multi-Range Read (MRR) with switch ON/OFF
--echo # ============================================================

--echo # --- Switch ON
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
call dbms_stat.flush_gpp();

--disable_result_log
SELECT /*+ MRR(t) */ * FROM t WHERE a BETWEEN 'VAL00001' AND 'VAL00050' ORDER BY a;
SELECT /*+ MRR(t) */ * FROM t 
WHERE a IN ('VAL00010', 'VAL00020', 'VAL00030', 'VAL00040', 'VAL00050') 
ORDER BY a;
SELECT /*+ MRR(t) */ * FROM t 
WHERE a BETWEEN 'VAL00001' AND 'VAL00050' AND b > 100 ORDER BY a;
--enable_result_log

# MRR may or may not trigger GPP path depending on plan; just verify counters are non-negative.
--let $mrr_hit = query_get_value(show global status like "Lizard_multi_range_read_gpp_hit", Value, 1)
--let $mrr_miss = query_get_value(show global status like "Lizard_multi_range_read_gpp_miss", Value, 1)
--let $assert_text = [Test 4 switch ON] multi range read gpp hit+miss should be >= 0
--let $assert_cond = $mrr_hit + $mrr_miss >= 0
--source include/assert.inc

--echo # --- Switch OFF: MRR GPP path should NOT be exercised
SET GLOBAL innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();

--disable_result_log
SELECT /*+ MRR(t) */ * FROM t WHERE a BETWEEN 'VAL00001' AND 'VAL00050' ORDER BY a;
SELECT /*+ MRR(t) */ * FROM t 
WHERE a IN ('VAL00010', 'VAL00020', 'VAL00030', 'VAL00040', 'VAL00050') 
ORDER BY a;
SELECT /*+ MRR(t) */ * FROM t 
WHERE a BETWEEN 'VAL00001' AND 'VAL00050' AND b > 100 ORDER BY a;
--enable_result_log

--let $mrr_hit = query_get_value(show global status like "Lizard_multi_range_read_gpp_hit", Value, 1)
--let $mrr_miss = query_get_value(show global status like "Lizard_multi_range_read_gpp_miss", Value, 1)
--let $assert_text = [Test 4 switch OFF] multi range read gpp hit+miss should be 0
--let $assert_cond = $mrr_hit + $mrr_miss = 0
--source include/assert.inc

--echo # Restore switch
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;

--echo # ============================================================
--echo # Test 5: Combined scenarios with switch toggle
--echo # ============================================================

--echo # --- Switch ON: combined intersection / union / sort-union / MRR
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
call dbms_stat.flush_gpp();

SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00100' AND b = 1000 LIMIT 1;
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00100' OR b = 1000 LIMIT 5;
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a < 'VAL00100' OR b < 1000 LIMIT 10;
--disable_result_log
SELECT /*+ MRR(t) */ * FROM t WHERE a BETWEEN 'VAL00090' AND 'VAL00110' ORDER BY a LIMIT 10;
--enable_result_log

--let $ri_hit = query_get_value(show global status like "Lizard_rowid_intersection_gpp_hit", Value, 1)
--let $ri_miss = query_get_value(show global status like "Lizard_rowid_intersection_gpp_miss", Value, 1)
--let $ru_hit = query_get_value(show global status like "Lizard_rowid_union_gpp_hit", Value, 1)
--let $ru_miss = query_get_value(show global status like "Lizard_rowid_union_gpp_miss", Value, 1)
--let $assert_text = [Test 5 switch ON] rowid intersection gpp hit+miss should be > 0
--let $assert_cond = $ri_hit + $ri_miss > 0
--source include/assert.inc
--let $assert_text = [Test 5 switch ON] rowid union gpp hit+miss should be > 0
--let $assert_cond = $ru_hit + $ru_miss > 0
--source include/assert.inc

--echo # --- Switch OFF: no GPP counters should advance
SET GLOBAL innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();

SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00100' AND b = 1000 LIMIT 1;
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00100' OR b = 1000 LIMIT 5;
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a < 'VAL00100' OR b < 1000 LIMIT 10;
--disable_result_log
SELECT /*+ MRR(t) */ * FROM t WHERE a BETWEEN 'VAL00090' AND 'VAL00110' ORDER BY a LIMIT 10;
--enable_result_log

--let $ri_hit = query_get_value(show global status like "Lizard_rowid_intersection_gpp_hit", Value, 1)
--let $ri_miss = query_get_value(show global status like "Lizard_rowid_intersection_gpp_miss", Value, 1)
--let $ru_hit = query_get_value(show global status like "Lizard_rowid_union_gpp_hit", Value, 1)
--let $ru_miss = query_get_value(show global status like "Lizard_rowid_union_gpp_miss", Value, 1)
--let $im_hit = query_get_value(show global status like "Lizard_index_merge_gpp_hit", Value, 1)
--let $im_miss = query_get_value(show global status like "Lizard_index_merge_gpp_miss", Value, 1)
--let $mrr_hit = query_get_value(show global status like "Lizard_multi_range_read_gpp_hit", Value, 1)
--let $mrr_miss = query_get_value(show global status like "Lizard_multi_range_read_gpp_miss", Value, 1)
--let $assert_text = [Test 5 switch OFF] all gpp counters should be 0
--let $assert_cond = $ri_hit + $ri_miss + $ru_hit + $ru_miss + $im_hit + $im_miss + $mrr_hit + $mrr_miss = 0
--source include/assert.inc

--echo # Restore switch
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;

--echo # ============================================================
--echo # Test 6: Verify switch value can be set and read
--echo # ============================================================

SHOW VARIABLES LIKE 'innodb_index_pos_guess_clust_enabled';

SET GLOBAL innodb_index_pos_guess_clust_enabled=off;
SHOW VARIABLES LIKE 'innodb_index_pos_guess_clust_enabled';

SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
SHOW VARIABLES LIKE 'innodb_index_pos_guess_clust_enabled';

--echo # ============================================================
--echo # Cleanup
--echo # ============================================================
DROP TABLE t;
DROP PROCEDURE insert_t_data;
SET GLOBAL innodb_purge_stop_now = default;
SET GLOBAL innodb_dbug_gpp_no = default;
--echo # Restore original values
--eval SET GLOBAL innodb_lizard_stat_enabled = $innodb_lizard_stat_enabled_original
--eval SET GLOBAL innodb_index_purge_guess_clust_enabled = $innodb_index_purge_guess_clust_enabled_original
--eval SET GLOBAL innodb_index_scan_guess_clust_enabled = $innodb_index_scan_guess_clust_enabled_original
--eval SET GLOBAL innodb_adaptive_hash_index = $innodb_adaptive_hash_index_original
--eval SET GLOBAL innodb_polarx_btree_search_mode = $innodb_polarx_btree_search_mode_original
