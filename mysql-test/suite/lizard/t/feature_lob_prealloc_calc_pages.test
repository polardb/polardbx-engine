# Verify calc_lob_pages_needed() in storage/innobase/lob/lizard0lob0lob.cc
# produces the exact page count described by its own documentation table.
#
# Constants (uncompressed, 16K page size):
#   A = first_page_size    = 15680   (first page payload)
#   B = data_page_size     = 16327   (data page payload)
#   K = first_page nodes   = 10      (inline node entries in first page)
#   M = node_page nodes    = 272     (node entries per node page)
#   size_0 = A             = 15680
#   size_1 = A + 9*B       = 162623  (tier 1 upper: K data pages, 0 node pages)
#   size_2 = A + 281*B     = 4603567 (tier 2 upper: K+M-1 data pages, 1 node page)
#   size_3 = A + 553*B     = 9044511 (tier 3 upper: K+2M-1 data pages, 2 node pages)
#
# Formula under test (n_node_pages grows as needed, no upper-bound rejection):
#   tier 0:  len <= A                   -> 1
#   tier 1:  A < len <= A+9B            -> (len - A - 1) / B + 2
#   tier 2:  A+9B < len <= A+281B       -> (len - A - 1) / B + 3
#   tier 3:  A+281B < len <= A+553B     -> (len - A - 1) / B + 4
#   tier N:  each new node page adds 2 pages at transition boundary
#
# Integer-division boundary trick: n_pages transitions at len = A + k*B + 1,
# NOT at len = A + k*B.  This test exercises both sides.

--source include/have_binlog_format_row.inc
--source include/have_innodb_max_16k.inc

set @old_innodb_lob_prealloc = @@innodb_lob_prealloc;

set @A = 15680;
set @B = 16327;
set @size_1 = @A + 9 * @B;
set @size_2 = @A + 281 * @B;
set @size_3 = @A + 553 * @B;

SET global innodb_lob_prealloc = on;

CREATE TABLE t1 (
  id bigint unsigned NOT NULL AUTO_INCREMENT,
  data mediumblob NOT NULL,
  PRIMARY KEY (id)
);

SET @fails_before = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Lizard_lob_prealloc_fail_no_space');
SET @under_before = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Lizard_lob_prealloc_underestimate_pages');

# --- Helper macro --------------------------------------------------------
# $blob_len / $expected_pages must be set before --source.
# The macro performs: INSERT a row with blob of $blob_len bytes, then check
# that Lizard_lob_prealloc_pages advanced by exactly $expected_pages.

--disable_query_log

let $rowid = 100;

--echo ####################################################################################
--echo # tier 0: len = size_0 = A -> 1 page
--echo #
--echo # Smaller values (e.g. len=1) cannot be probed from SQL: InnoDB stores
--echo # them inline and never calls calc_lob_pages_needed(). tier 0 has no
--echo # internal branch (n = 1 constant), so the upper edge is sufficient.
--echo ####################################################################################
--let $blob_len = `SELECT @A`
--let $expected_pages = 1
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 1: A+1 -> 2, A+B -> 2, A+B+1 -> 3 (integer-division boundary)
--echo ####################################################################################
--let $blob_len = `SELECT @A + 1`
--let $expected_pages = 2
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @A + @B`
--let $expected_pages = 2
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @A + @B + 1`
--let $expected_pages = 3
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 1: A+2B -> 3, A+2B+1 -> 4 (mid-tier boundary)
--echo ####################################################################################
--let $blob_len = `SELECT @A + 2 * @B`
--let $expected_pages = 3
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @A + 2 * @B + 1`
--let $expected_pages = 4
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 1 upper edge: A+8B -> 9, A+8B+1 -> 10, A+9B=size_1 -> 10
--echo ####################################################################################
--let $blob_len = `SELECT @A + 8 * @B`
--let $expected_pages = 9
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @A + 8 * @B + 1`
--let $expected_pages = 10
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @size_1`
--let $expected_pages = 10
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 1 -> tier 2 transition: size_1+1 -> 12 (NOT 11, node page inserted)
--echo ####################################################################################
--let $blob_len = `SELECT @size_1 + 1`
--let $expected_pages = 12
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 2: A+10B -> 12, A+10B+1 -> 13 (integer-division boundary inside tier 2)
--echo ####################################################################################
--let $blob_len = `SELECT @A + 10 * @B`
--let $expected_pages = 12
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @A + 10 * @B + 1`
--let $expected_pages = 13
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 2 mid-range: A+20B -> 22, A+20B+1 -> 23
--echo ####################################################################################
--let $blob_len = `SELECT @A + 20 * @B`
--let $expected_pages = 22
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @A + 20 * @B + 1`
--let $expected_pages = 23
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 2 upper edge: A+280B -> 282, A+280B+1 -> 283, A+281B=size_2 -> 283
--echo ####################################################################################
--let $blob_len = `SELECT @A + 280 * @B`
--let $expected_pages = 282
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @A + 280 * @B + 1`
--let $expected_pages = 283
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @size_2`
--let $expected_pages = 283
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 2 -> tier 3 transition: size_2+1 -> 285 (NOT 284, new node page added)
--echo ####################################################################################
--let $blob_len = `SELECT @size_2 + 1`
--let $expected_pages = 285
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 3 mid-range: A+300B -> 303, A+300B+1 -> 304
--echo ####################################################################################
--let $blob_len = `SELECT @A + 300 * @B`
--let $expected_pages = 303
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @A + 300 * @B + 1`
--let $expected_pages = 304
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 3 upper edge: A+552B -> 555, A+552B+1 -> 556, A+553B=size_3 -> 556
--echo ####################################################################################
--let $blob_len = `SELECT @A + 552 * @B`
--let $expected_pages = 555
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @A + 552 * @B + 1`
--let $expected_pages = 556
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--let $blob_len = `SELECT @size_3`
--let $expected_pages = 556
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--echo ####################################################################################
--echo # tier 3 -> tier 4 transition: size_3+1 -> 558 (NOT 557, new node page added)
--echo ####################################################################################
--let $blob_len = `SELECT @size_3 + 1`
--let $expected_pages = 558
--source suite/lizard/include/lob_prealloc_calc_pages_check.inc

--enable_query_log

# verify no page was leaked or errored across the whole run
SET @fails_after      = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Lizard_lob_prealloc_fail_no_space');
SET @under_after      = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Lizard_lob_prealloc_underestimate_pages');

if (`SELECT CONVERT(@fails_after, SIGNED) != CONVERT(@fails_before, SIGNED)`)
{
  --echo "Unexpected: Lizard_lob_prealloc_fail_no_space increased during this test."
  --die
}

if (`SELECT CONVERT(@under_after, SIGNED) != CONVERT(@under_before, SIGNED)`)
{
  --echo "Unexpected: Lizard_lob_prealloc_underestimate_pages increased during this test."
  --die
}

check table t1;

drop table t1;

set global innodb_lob_prealloc = @old_innodb_lob_prealloc;
