#
# Test GPP (Guess Primary Page) for MRR (Multi-Range Read) on
# HASH-partitioned tables. MRR hint forces multi-range read path;
# GPP should accelerate clustered index lookups when reading back
# rows from sorted rowid ranges across all partitions.
#
SET GLOBAL innodb_lizard_stat_enabled=on;
SET GLOBAL innodb_index_purge_guess_clust_enabled=on;
SET GLOBAL innodb_index_scan_guess_clust_enabled=on;
SET GLOBAL innodb_adaptive_hash_index = OFF;
SET GLOBAL innodb_polarx_btree_search_mode = OFF;
# -----------------------------------------------------------------------
# Create a HASH-partitioned table with multiple secondary indexes.
# -----------------------------------------------------------------------
CREATE TABLE tp (
id  INT AUTO_INCREMENT,
a   VARCHAR(10) NOT NULL,
b   INT         NOT NULL,
c   INT         NOT NULL,
d   CHAR(1)     NOT NULL DEFAULT 'A',
PRIMARY KEY (id),
KEY idx_a (a),
KEY idx_b (b),
KEY idx_cd (c, d)
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC
PARTITION BY HASH(id) PARTITIONS 4;
# -----------------------------------------------------------------------
# Insert 1000 rows distributed across 4 partitions.
# -----------------------------------------------------------------------
CREATE PROCEDURE insert_tp_data(IN num_rows INT)
BEGIN
DECLARE i INT DEFAULT 1;
START TRANSACTION;
WHILE i <= num_rows DO
INSERT INTO tp (id, a, b, c, d) VALUES (
i,
CONCAT('NO', LPAD(i, 4, '0')),
i * 10,
i * 50,
ELT(((i - 1) % 3) + 1, 'A', 'B', 'C')
);
SET i = i + 1;
END WHILE;
COMMIT;
END//
CALL insert_tp_data(1000);
SELECT COUNT(*) AS row_count FROM tp;
row_count
1000
# ===================================================================
# Test 1: Range scan without MRR hint (baseline)
# ===================================================================
EXPLAIN SELECT * FROM tp WHERE a < 'NO0101';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	tp	p0,p1,p2,p3	range	idx_a	idx_a	42	NULL	100	100.00	Using index condition
Warnings:
Note	1003	/* select#1 */ select `test`.`tp`.`id` AS `id`,`test`.`tp`.`a` AS `a`,`test`.`tp`.`b` AS `b`,`test`.`tp`.`c` AS `c`,`test`.`tp`.`d` AS `d` from `test`.`tp` where (`test`.`tp`.`a` < 'NO0101')
SELECT * FROM tp WHERE a < 'NO0101';
SHOW status LIKE "%multi_range%";
Variable_name	Value
Lizard_multi_range_read_gpp_hit	0
Lizard_multi_range_read_gpp_miss	0
# ===================================================================
# Test 2: Range scan WITH MRR hint — forces multi-range read path
# GPP should be used for clustered index lookups.
# ===================================================================
call dbms_stat.flush_gpp();
EXPLAIN SELECT /*+ MRR(tp) */ * FROM tp WHERE a < 'NO0101';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	tp	p0,p1,p2,p3	range	idx_a	idx_a	42	NULL	100	100.00	Using index condition; Using MRR
Warnings:
Note	1003	/* select#1 */ select /*+ MRR(`tp`@`select#1`) */ `test`.`tp`.`id` AS `id`,`test`.`tp`.`a` AS `a`,`test`.`tp`.`b` AS `b`,`test`.`tp`.`c` AS `c`,`test`.`tp`.`d` AS `d` from `test`.`tp` where (`test`.`tp`.`a` < 'NO0101')
SELECT /*+ MRR(tp) */ * FROM tp WHERE a < 'NO0101';
include/assert.inc [[partition MRR] gpp total (hit+miss) should be > 0]
# ===================================================================
# Test 3: MRR with additional filter condition (a < ... AND b > ...)
# ===================================================================
call dbms_stat.flush_gpp();
EXPLAIN SELECT /*+ MRR(tp) */ * FROM tp WHERE a < "NO0101" AND b > 20;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	tp	p0,p1,p2,p3	range	idx_a,idx_b	idx_a	42	NULL	100	99.80	Using index condition; Using where; Using MRR
Warnings:
Note	1003	/* select#1 */ select /*+ MRR(`tp`@`select#1`) */ `test`.`tp`.`id` AS `id`,`test`.`tp`.`a` AS `a`,`test`.`tp`.`b` AS `b`,`test`.`tp`.`c` AS `c`,`test`.`tp`.`d` AS `d` from `test`.`tp` where ((`test`.`tp`.`a` < 'NO0101') and (`test`.`tp`.`b` > 20))
SELECT /*+ MRR(tp) */ * FROM tp WHERE a < "NO0101" AND b > 20;
include/assert.inc [[partition MRR with filter] gpp total (hit+miss) should be > 0]
# ===================================================================
# Test 4: MRR on idx_b with range scan
# ===================================================================
call dbms_stat.flush_gpp();
EXPLAIN SELECT /*+ MRR(tp) */ * FROM tp WHERE b < 200;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	tp	p0,p1,p2,p3	range	idx_b	idx_b	4	NULL	19	100.00	Using index condition; Using MRR
Warnings:
Note	1003	/* select#1 */ select /*+ MRR(`tp`@`select#1`) */ `test`.`tp`.`id` AS `id`,`test`.`tp`.`a` AS `a`,`test`.`tp`.`b` AS `b`,`test`.`tp`.`c` AS `c`,`test`.`tp`.`d` AS `d` from `test`.`tp` where (`test`.`tp`.`b` < 200)
SELECT /*+ MRR(tp) */ * FROM tp WHERE b < 200;
include/assert.inc [[partition MRR idx_b] gpp total (hit+miss) should be > 0]
# -----------------------------------------------------------------------
# Clean up
# -----------------------------------------------------------------------
DROP PROCEDURE insert_tp_data;
DROP TABLE tp;
SET GLOBAL innodb_purge_stop_now = default;
SET GLOBAL innodb_dbug_gpp_no = default;
SET GLOBAL innodb_lizard_stat_enabled = 0;
SET GLOBAL innodb_index_purge_guess_clust_enabled = 1;
SET GLOBAL innodb_index_scan_guess_clust_enabled = 1;
SET GLOBAL innodb_adaptive_hash_index = 0;
SET GLOBAL innodb_polarx_btree_search_mode = 1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG = '';
