# ============================================================
# Test 4: Multi-Range Read (MRR) with switch ON/OFF
# ============================================================
# --- Switch ON
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
call dbms_stat.flush_gpp();
SELECT /*+ MRR(t) */ * FROM t WHERE a BETWEEN 'VAL00001' AND 'VAL00050' ORDER BY a;
SELECT /*+ MRR(t) */ * FROM t 
WHERE a IN ('VAL00010', 'VAL00020', 'VAL00030', 'VAL00040', 'VAL00050') 
ORDER BY a;
SELECT /*+ MRR(t) */ * FROM t 
WHERE a BETWEEN 'VAL00001' AND 'VAL00050' AND b > 100 ORDER BY a;
include/assert.inc [[Test 4 switch ON] multi range read gpp hit+miss should be >= 0]
# --- Switch OFF: MRR GPP path should NOT be exercised
SET GLOBAL innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();
SELECT /*+ MRR(t) */ * FROM t WHERE a BETWEEN 'VAL00001' AND 'VAL00050' ORDER BY a;
SELECT /*+ MRR(t) */ * FROM t 
WHERE a IN ('VAL00010', 'VAL00020', 'VAL00030', 'VAL00040', 'VAL00050') 
ORDER BY a;
SELECT /*+ MRR(t) */ * FROM t 
WHERE a BETWEEN 'VAL00001' AND 'VAL00050' AND b > 100 ORDER BY a;
include/assert.inc [[Test 4 switch OFF] multi range read gpp hit+miss should be 0]
# Restore switch
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
# ============================================================
# Test 5: Combined scenarios with switch toggle
# ============================================================
# --- Switch ON: combined intersection / union / sort-union / MRR
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
call dbms_stat.flush_gpp();
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00100' AND b = 1000 LIMIT 1;
id	a	b	c	d
100	VAL00100	1000	5000	A
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00100' OR b = 1000 LIMIT 5;
id	a	b	c	d
100	VAL00100	1000	5000	A
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a < 'VAL00100' OR b < 1000 LIMIT 10;
id	a	b	c	d
1	VAL00001	10	50	A
2	VAL00002	20	100	B
3	VAL00003	30	150	C
4	VAL00004	40	200	A
5	VAL00005	50	250	B
6	VAL00006	60	300	C
7	VAL00007	70	350	A
8	VAL00008	80	400	B
9	VAL00009	90	450	C
10	VAL00010	100	500	A
SELECT /*+ MRR(t) */ * FROM t WHERE a BETWEEN 'VAL00090' AND 'VAL00110' ORDER BY a LIMIT 10;
include/assert.inc [[Test 5 switch ON] rowid intersection gpp hit+miss should be > 0]
include/assert.inc [[Test 5 switch ON] rowid union gpp hit+miss should be > 0]
# --- Switch OFF: no GPP counters should advance
SET GLOBAL innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00100' AND b = 1000 LIMIT 1;
id	a	b	c	d
100	VAL00100	1000	5000	A
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a = 'VAL00100' OR b = 1000 LIMIT 5;
id	a	b	c	d
100	VAL00100	1000	5000	A
SELECT /*+ INDEX_MERGE(t idx_a, idx_b) */ * FROM t 
WHERE a < 'VAL00100' OR b < 1000 LIMIT 10;
id	a	b	c	d
1	VAL00001	10	50	A
2	VAL00002	20	100	B
3	VAL00003	30	150	C
4	VAL00004	40	200	A
5	VAL00005	50	250	B
6	VAL00006	60	300	C
7	VAL00007	70	350	A
8	VAL00008	80	400	B
9	VAL00009	90	450	C
10	VAL00010	100	500	A
SELECT /*+ MRR(t) */ * FROM t WHERE a BETWEEN 'VAL00090' AND 'VAL00110' ORDER BY a LIMIT 10;
include/assert.inc [[Test 5 switch OFF] all gpp counters should be 0]
# Restore switch
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
# ============================================================
# Test 6: Verify switch value can be set and read
# ============================================================
SHOW VARIABLES LIKE 'innodb_index_pos_guess_clust_enabled';
Variable_name	Value
innodb_index_pos_guess_clust_enabled	ON
SET GLOBAL innodb_index_pos_guess_clust_enabled=off;
SHOW VARIABLES LIKE 'innodb_index_pos_guess_clust_enabled';
Variable_name	Value
innodb_index_pos_guess_clust_enabled	OFF
SET GLOBAL innodb_index_pos_guess_clust_enabled=on;
SHOW VARIABLES LIKE 'innodb_index_pos_guess_clust_enabled';
Variable_name	Value
innodb_index_pos_guess_clust_enabled	ON
# ============================================================
# Cleanup
# ============================================================
DROP TABLE t;
DROP PROCEDURE insert_t_data;
SET GLOBAL innodb_purge_stop_now = default;
SET GLOBAL innodb_dbug_gpp_no = default;
# Restore original values
SET GLOBAL innodb_lizard_stat_enabled = 0;
SET GLOBAL innodb_index_purge_guess_clust_enabled = 1;
SET GLOBAL innodb_index_scan_guess_clust_enabled = 1;
SET GLOBAL innodb_adaptive_hash_index = 0;
SET GLOBAL innodb_polarx_btree_search_mode = 1;
