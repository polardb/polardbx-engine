include/assert.inc [[partition union idx_b,PK] gpp total (hit+miss) should be > 0]
# ===================================================================
# Test 2: Union merge (idx_a OR idx_b) — equality on both
# ===================================================================
call dbms_stat.flush_gpp();
SELECT /*+INDEX_MERGE(tp idx_a,idx_b) */ * FROM tp WHERE a = "NO0011" OR b = 200;
id	a	b	c	d
11	NO0011	110	550	B
20	NO0020	200	1000	B
include/assert.inc [[partition union idx_a,idx_b] gpp total (hit+miss) should be > 0]
# ===================================================================
# Test 3: Union merge (idx_a OR idx_cd) — equality on both
# ===================================================================
call dbms_stat.flush_gpp();
SELECT /*+INDEX_MERGE(tp idx_a,idx_cd) */ * FROM tp WHERE a = "NO0100" OR (c = 50 AND d = "A");
id	a	b	c	d
1	NO0001	10	50	A
100	NO0100	1000	5000	A
include/assert.inc [[partition union idx_a,idx_cd] gpp total (hit+miss) should be > 0]
# ===================================================================
# Test 4: Union + Intersection combined
# (a = ... AND b = ...) OR (c = ... AND d = ...)
# ===================================================================
call dbms_stat.flush_gpp();
SELECT /*+INDEX_MERGE(tp idx_a,idx_b,idx_cd) */ * FROM tp
WHERE (a = "NO0001" AND b = 10) OR (c = 5000 AND d = "A");
id	a	b	c	d
1	NO0001	10	50	A
100	NO0100	1000	5000	A
include/assert.inc [[partition union+intersection] gpp total (hit+miss) should be > 0]
# -----------------------------------------------------------------------
# Clean up
# -----------------------------------------------------------------------
DROP PROCEDURE insert_tp_data;
DROP TABLE tp;
SET GLOBAL innodb_purge_stop_now = default;
SET GLOBAL innodb_dbug_gpp_no = default;
SET GLOBAL innodb_lizard_stat_enabled = 0;
SET GLOBAL innodb_index_purge_guess_clust_enabled = 1;
SET GLOBAL innodb_index_scan_guess_clust_enabled = 1;
SET GLOBAL innodb_adaptive_hash_index = 0;
SET GLOBAL innodb_polarx_btree_search_mode = 1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG = '';
