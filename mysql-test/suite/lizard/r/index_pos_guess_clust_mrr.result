DROP TABLE t;
SET GLOBAL innodb_purge_stop_now = default;
SET GLOBAL innodb_dbug_gpp_no = default;
# Restore original values
SET GLOBAL innodb_lizard_stat_enabled = 0;
SET GLOBAL innodb_index_purge_guess_clust_enabled = 1;
SET GLOBAL innodb_index_scan_guess_clust_enabled = 1;
SET GLOBAL innodb_adaptive_hash_index = 0;
SET GLOBAL innodb_polarx_btree_search_mode = 1;
DROP PROCEDURE insert_t_data;
SET DEBUG_SYNC = 'RESET';
SET DEBUG = '';
