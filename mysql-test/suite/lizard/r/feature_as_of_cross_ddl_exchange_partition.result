# Verify current AS OF behavior after EXCHANGE PARTITION.
SET GLOBAL innodb_undo_retention = 9000;
SET SESSION as_of_cross_ddl_enabled = ON;
DROP TABLE IF EXISTS pt_exchange_asof;
DROP TABLE IF EXISTS st_exchange_asof;
CREATE TABLE pt_exchange_asof (
id INT,
name VARCHAR(64),
PRIMARY KEY(id),
INDEX idx_name(name)
) ENGINE=InnoDB
PARTITION BY RANGE(id) (
PARTITION p0 VALUES LESS THAN (10),
PARTITION p1 VALUES LESS THAN MAXVALUE
);
CREATE TABLE st_exchange_asof (
id INT,
name VARCHAR(64),
PRIMARY KEY(id),
INDEX idx_name(name)
) ENGINE=InnoDB;
INSERT INTO pt_exchange_asof VALUES (1, "pt_old"), (11, "pt_p1");
INSERT INTO st_exchange_asof VALUES (2, "st_old");
# State before EXCHANGE.
SELECT id, name FROM pt_exchange_asof ORDER BY id;
id	name
1	pt_old
11	pt_p1
SELECT id, name FROM st_exchange_asof ORDER BY id;
id	name
2	st_old
SET @ts_before_exchange = NOW(6);
ALTER TABLE pt_exchange_asof EXCHANGE PARTITION p0 WITH TABLE st_exchange_asof
WITHOUT VALIDATION;
# Current state after EXCHANGE.
SELECT id, name FROM pt_exchange_asof ORDER BY id;
id	name
2	st_old
11	pt_p1
SELECT id, name FROM st_exchange_asof ORDER BY id;
id	name
1	pt_old
# AS OF before EXCHANGE through PRIMARY follows current physical mapping.
SELECT id, name FROM pt_exchange_asof AS OF TIMESTAMP @ts_before_exchange
FORCE INDEX(PRIMARY) ORDER BY id;
id	name
2	st_old
11	pt_p1
SELECT id, name FROM st_exchange_asof AS OF TIMESTAMP @ts_before_exchange
FORCE INDEX(PRIMARY) ORDER BY id;
id	name
1	pt_old
# AS OF before EXCHANGE through secondary index follows the same mapping.
SELECT id, name FROM pt_exchange_asof AS OF TIMESTAMP @ts_before_exchange
FORCE INDEX(idx_name) WHERE name IN ("pt_old", "st_old", "pt_p1") ORDER BY id;
id	name
2	st_old
11	pt_p1
SELECT id, name FROM st_exchange_asof AS OF TIMESTAMP @ts_before_exchange
FORCE INDEX(idx_name) WHERE name IN ("pt_old", "st_old") ORDER BY id;
id	name
1	pt_old
DROP TABLE pt_exchange_asof;
DROP TABLE st_exchange_asof;
# Verify current AS OF behavior after atomic RENAME TABLE name swap.
DROP TABLE IF EXISTS rn_a_asof;
DROP TABLE IF EXISTS rn_b_asof;
DROP TABLE IF EXISTS rn_tmp_asof;
CREATE TABLE rn_a_asof (
id INT,
name VARCHAR(64),
PRIMARY KEY(id),
INDEX idx_name(name)
) ENGINE=InnoDB;
CREATE TABLE rn_b_asof (
id INT,
name VARCHAR(64),
PRIMARY KEY(id),
INDEX idx_name(name)
) ENGINE=InnoDB;
INSERT INTO rn_a_asof VALUES (1, "rn_a_old");
INSERT INTO rn_b_asof VALUES (2, "rn_b_old");
# State before RENAME TABLE name swap.
SELECT id, name FROM rn_a_asof ORDER BY id;
id	name
1	rn_a_old
SELECT id, name FROM rn_b_asof ORDER BY id;
id	name
2	rn_b_old
SET @ts_before_rename_swap = NOW(6);
RENAME TABLE rn_a_asof TO rn_tmp_asof,
rn_b_asof TO rn_a_asof,
rn_tmp_asof TO rn_b_asof;
# Current state after RENAME TABLE name swap.
SELECT id, name FROM rn_a_asof ORDER BY id;
id	name
2	rn_b_old
SELECT id, name FROM rn_b_asof ORDER BY id;
id	name
1	rn_a_old
# AS OF before RENAME resolves current names, so it follows swapped objects.
SELECT id, name FROM rn_a_asof AS OF TIMESTAMP @ts_before_rename_swap
FORCE INDEX(PRIMARY) ORDER BY id;
id	name
2	rn_b_old
SELECT id, name FROM rn_b_asof AS OF TIMESTAMP @ts_before_rename_swap
FORCE INDEX(PRIMARY) ORDER BY id;
id	name
1	rn_a_old
# Secondary index path follows the same current-name mapping.
SELECT id, name FROM rn_a_asof AS OF TIMESTAMP @ts_before_rename_swap
FORCE INDEX(idx_name) WHERE name IN ("rn_a_old", "rn_b_old") ORDER BY id;
id	name
2	rn_b_old
SELECT id, name FROM rn_b_asof AS OF TIMESTAMP @ts_before_rename_swap
FORCE INDEX(idx_name) WHERE name IN ("rn_a_old", "rn_b_old") ORDER BY id;
id	name
1	rn_a_old
DROP TABLE rn_a_asof;
DROP TABLE rn_b_asof;
SET GLOBAL innodb_undo_retention = DEFAULT;
SET SESSION as_of_cross_ddl_enabled = DEFAULT;
