# Verify AS OF before IMPORT TABLESPACE does not expose imported source rows.
SET GLOBAL innodb_undo_retention = 9000;
SET SESSION as_of_cross_ddl_enabled = ON;
DROP TABLE IF EXISTS dst_import_asof;
DROP TABLE IF EXISTS src_import_asof;
CREATE TABLE dst_import_asof (
id INT PRIMARY KEY,
name VARCHAR(64),
INDEX idx_name(name)
) ENGINE=InnoDB;
CREATE TABLE src_import_asof LIKE dst_import_asof;
INSERT INTO dst_import_asof VALUES (1, "dst_old"), (2, "dst_keep");
INSERT INTO src_import_asof VALUES (9, "src_old");
SET @ts_before_import = NOW(6);
ALTER TABLE dst_import_asof DISCARD TABLESPACE;
FLUSH TABLES src_import_asof FOR EXPORT;
UNLOCK TABLES;
ALTER TABLE dst_import_asof IMPORT TABLESPACE;
# Current table uses the imported source tablespace.
SELECT id, name FROM dst_import_asof ORDER BY id;
id	name
9	src_old
# AS OF before import returns empty through PRIMARY, not imported source rows.
SELECT id, name FROM dst_import_asof AS OF TIMESTAMP @ts_before_import
FORCE INDEX(PRIMARY) ORDER BY id;
id	name
# AS OF before import also returns empty through secondary access.
SELECT id, name FROM dst_import_asof AS OF TIMESTAMP @ts_before_import
FORCE INDEX(idx_name) WHERE name IN ("dst_old", "dst_keep", "src_old") ORDER BY id;
id	name
DROP TABLE dst_import_asof;
DROP TABLE src_import_asof;
SET GLOBAL innodb_undo_retention = DEFAULT;
SET SESSION as_of_cross_ddl_enabled = DEFAULT;
