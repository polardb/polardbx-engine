# ============================================================
# Test 28: Rowid ordered retrieval with GPP
# ============================================================
call dbms_stat.flush_gpp();
explain SELECT /*+ INDEX_MERGE(t1 idx_a, idx_b) */ * FROM t1 
WHERE a = 'VAL00025' AND b = 250;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	p0,p1,p2,p3,p4	index_merge	idx_a,idx_b	idx_a,idx_b	82,4	NULL	1	100.00	Using intersect(idx_a,idx_b); Using where
Warnings:
Note	1003	/* select#1 */ select /*+ INDEX_MERGE(`t1`@`select#1` `idx_a`, `idx_b`) */ `test`.`t1`.`id` AS `id`,`test`.`t1`.`a` AS `a`,`test`.`t1`.`b` AS `b`,`test`.`t1`.`c` AS `c`,`test`.`t1`.`d` AS `d`,`test`.`t1`.`e` AS `e` from `test`.`t1` where ((`test`.`t1`.`b` = 250) and (`test`.`t1`.`a` = 'VAL00025'))
SELECT /*+ INDEX_MERGE(t1 idx_a, idx_b) */ * FROM t1 
WHERE a = 'VAL00025' AND b = 250;
id	a	b	c	d	e
25	VAL00025	250	1250	A	NULL
include/assert.inc [[rowid intersection] gpp hit should be > 0]
