include/assert.inc [[temporary table] no gpp guess on a temporary table]
DROP TEMPORARY TABLE t2;
# ============================================================
# Test 13: GPP invalidation scenario
# ============================================================
# Invalidate GPP info and test fallback
SET DEBUG='+d,set_gpp_null';
call dbms_stat.flush_gpp();
SELECT * FROM t1 WHERE a = 'VAL00050';
id	a	b	c	d	e
50	VAL00050	500	2500	B	NULL
include/assert.inc [[GPP invalidation] gpp hit should be 0]
