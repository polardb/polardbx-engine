include/assert.inc [[large result set] a clustered scan must not consume any gpp guess]
# ============================================================
# Test 12: Temporary table (row_search_no_mvcc path)
# ============================================================
# Note: Temporary tables cannot be partitioned in MySQL
CREATE TEMPORARY TABLE t2 (
id INT AUTO_INCREMENT PRIMARY KEY,
a VARCHAR(20) NOT NULL,
b INT NOT NULL,
c INT NOT NULL,
d CHAR(1) NOT NULL DEFAULT 'X',
e TEXT
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
INSERT INTO t2 SELECT * FROM t1 WHERE id <= 100;
call dbms_stat.flush_gpp();
SELECT * FROM t2 WHERE id BETWEEN 1 AND 50 ORDER BY id;
