####################################################################################
# 1. prepare
####################################################################################
set @old_innodb_lob_prealloc = @@innodb_lob_prealloc;
SET global innodb_lob_prealloc = on;
DROP TABLE IF EXISTS t1;
CREATE TABLE `t1` (
`id` bigint unsigned NOT NULL AUTO_INCREMENT,
`data` mediumblob NOT NULL,
PRIMARY KEY (`id`)
) ;
CREATE PROCEDURE InsertData()
BEGIN
DECLARE i INT DEFAULT 1;
DECLARE loop_count INT DEFAULT 10;
WHILE i <= loop_count DO
START TRANSACTION;
INSERT INTO t1 (id, data) VALUES (0, REPEAT('1', 16384));
COMMIT;
SET i = i + 1;
END WHILE;
END |
CREATE PROCEDURE UpdateData()
BEGIN
DECLARE i INT DEFAULT 1;
DECLARE loop_count INT DEFAULT 160;
WHILE i <= loop_count DO
START TRANSACTION;
UPDATE t1 set data = repeat(md5(rand()),512 ) where id = i;
COMMIT;
SET i = i + 1;
END WHILE;
END |
CREATE PROCEDURE InsertAndUpdateData()
BEGIN
DECLARE i INT DEFAULT 1;
DECLARE loop_count INT DEFAULT 10;
WHILE i <= loop_count DO
START TRANSACTION;
INSERT INTO t1 (id, data) VALUES (0, REPEAT('1', 16384));
UPDATE t1 set data = repeat(md5(rand()),512 ) where id = i;
COMMIT;
SET i = i + 1;
END WHILE;
END |
####################################################################################
# 2. concurrently insert
####################################################################################
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
call InsertData();
select count(*) from t1;
count(*)
160
select count(*) from t1 where data = REPEAT('1', 16384);
count(*)
160
check table t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
####################################################################################
# 3. concurrently update
####################################################################################
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
call UpdateData();
select count(*) from t1;
count(*)
160
select count(*) from t1 where data = REPEAT('1', 16384);
count(*)
0
check table t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
####################################################################################
# 4. concurrently insert and update
####################################################################################
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
call InsertAndUpdateData();
select count(*) from t1;
count(*)
320
select count(*) from t1 where data = REPEAT('1', 16384);
count(*)
160
check table t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
####################################################################################
# 5. cleanup
####################################################################################
set global innodb_lob_prealloc = @old_innodb_lob_prealloc;
drop table t1;
drop PROCEDURE InsertData;
drop PROCEDURE UpdateData;
drop PROCEDURE InsertAndUpdateData;
