#
# Test GPP (Guess Primary Page) support for multi-table UPDATE on
# partitioned tables. When multi-table UPDATE uses the delayed update
# path (buffering rowids then calling ha_rnd_pos), GPP should speed up
# clustered index lookups across all partitions.
#
set global innodb_lizard_stat_enabled=on;
set global innodb_index_pos_guess_clust_enabled=on;
set opt_index_format_gpp_enabled=true;
# -----------------------------------------------------------------------
# Create a driver table t_drv and a HASH-partitioned target table tp.
# tp has LONGTEXT and composite PK to ensure rowid + gpp_no handling.
# -----------------------------------------------------------------------
CREATE TABLE t_drv (
id INT NOT NULL PRIMARY KEY,
val INT NOT NULL
) ENGINE=InnoDB;
CREATE TABLE tp (
id INT NOT NULL,
name VARCHAR(50) NOT NULL,
c INT NOT NULL,
data LONGTEXT,
PRIMARY KEY (id, name),
KEY idx_c (c)
) ENGINE=InnoDB
PARTITION BY HASH(id) PARTITIONS 4;
# -----------------------------------------------------------------------
# Insert 100 rows into each table.
# -----------------------------------------------------------------------
INSERT INTO t_drv (id, val)
WITH RECURSIVE seq AS (
SELECT 1 AS i
UNION ALL
SELECT i + 1 FROM seq WHERE i < 100
)
SELECT i, i * 10 FROM seq;
INSERT INTO tp (id, name, c, data)
WITH RECURSIVE seq AS (
SELECT 1 AS i
UNION ALL
SELECT i + 1 FROM seq WHERE i < 100
)
SELECT
i,
CONCAT('user_', LPAD(i, 5, '0')),
100 - i,
REPEAT(CHAR(65 + (i MOD 26) USING ascii), 1500)
FROM seq;
SELECT COUNT(*) AS drv_rows FROM t_drv;
drv_rows
100
SELECT COUNT(*) AS tp_rows FROM tp;
tp_rows
100
# -----------------------------------------------------------------------
# Test 1: Multi-table UPDATE — update tp via JOIN with t_drv.
# This triggers the delayed update path: rowids of tp are buffered,
# then ha_rnd_pos is called with GM_MULTI_UPDATE to read back.
# -----------------------------------------------------------------------
call dbms_stat.flush_gpp();
UPDATE t_drv JOIN tp ON t_drv.id = tp.id
SET tp.c = tp.c + 1;
include/assert.inc [[partition multi_update] gpp total (hit+miss) should be 100]
include/assert.inc [[partition multi_update] gpp hit should be > 0]
# -----------------------------------------------------------------------
# Verify result correctness: original c = 100 - i, after +1 => 101 - i
# -----------------------------------------------------------------------
SELECT id, name, c FROM tp ORDER BY id LIMIT 5;
id	name	c
1	user_00001	100
2	user_00002	99
3	user_00003	98
4	user_00004	97
5	user_00005	96
# -----------------------------------------------------------------------
# Test 2: Multi-table UPDATE with WHERE clause (partial: 50 rows).
# -----------------------------------------------------------------------
call dbms_stat.flush_gpp();
UPDATE t_drv JOIN tp ON t_drv.id = tp.id
SET tp.c = tp.c + 1
WHERE t_drv.val <= 500;
include/assert.inc [[partition multi_update] gpp total (hit+miss) should be 50 with WHERE]
# -----------------------------------------------------------------------
# Test 3: Verify no multi_update GPP stat when GPP is disabled.
# -----------------------------------------------------------------------
set global innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();
UPDATE t_drv JOIN tp ON t_drv.id = tp.id
SET tp.c = tp.c + 1;
include/assert.inc [[partition multi_update GPP disabled] gpp hit should be 0]
include/assert.inc [[partition multi_update GPP disabled] gpp miss should be 0]
set global innodb_index_pos_guess_clust_enabled=on;
# -----------------------------------------------------------------------
# Clean up
# -----------------------------------------------------------------------
DROP TABLE t_drv, tp;
SET opt_index_format_gpp_enabled = 1;
SET GLOBAL innodb_lizard_stat_enabled = 0;
SET GLOBAL innodb_index_pos_guess_clust_enabled = 1;
