SET autocommit = 0;
set global innodb_commit_cleanout_max_rows=0;
set global innodb_lizard_stat_enabled=true;
CREATE TABLE t1 (c1 INT, c2 int default 10);
# Create big enough table to ensure another call to Builder::insert_direct
CREATE PROCEDURE populate_t1(IN BASE INT, IN SIZE INT)
BEGIN
DECLARE i INT DEFAULT BASE;
WHILE (i + 10 <= SIZE) DO
INSERT INTO t1 values (i, i), (i+1, i+1), (i+2, i+2), (i+3, i+3), (i+4, i+4), (i+5, i+5), (i+6, i+6), (i+7, i+7), (i+8, i+8), (i+9, i+9);
SET i = i + 10;
END WHILE;
END|
CALL populate_t1(0, 11000);
set global innodb_inject_stress_test_for_panda=false;
ALTER TABLE t1 add index idx_c(c2);
include/assert.inc [ddl_cleanout should make sense.]
DROP PROCEDURE populate_t1;
DROP TABLE t1;
CREATE TABLE large_table (
id INT AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(50),
age INT,
city VARCHAR(50),
created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE PROCEDURE insert_data()
BEGIN
DECLARE i INT DEFAULT 0;
WHILE i < 1000 DO
INSERT INTO large_table (name, age, city) 
VALUES (
CONCAT('Name', i),
FLOOR(18 + (i * 62)),
'New York'
        );
SET i = i + 1;
END WHILE;
END |
CALL insert_data();
ALTER TABLE large_table ADD INDEX idx_name (name);
include/assert.inc [ddl_cleanout should make sense.]
set global innodb_commit_cleanout_max_rows=3;
set global innodb_lizard_stat_enabled=false;
set global innodb_inject_stress_test_for_panda=true;
DROP PROCEDURE insert_data;
DROP TABLE large_table;
