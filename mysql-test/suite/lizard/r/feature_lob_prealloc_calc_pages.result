set @old_innodb_lob_prealloc = @@innodb_lob_prealloc;
set @A = 15680;
set @B = 16327;
set @size_1 = @A + 9 * @B;
set @size_2 = @A + 281 * @B;
set @size_3 = @A + 553 * @B;
SET global innodb_lob_prealloc = on;
CREATE TABLE t1 (
id bigint unsigned NOT NULL AUTO_INCREMENT,
data mediumblob NOT NULL,
PRIMARY KEY (id)
);
SET @fails_before = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Lizard_lob_prealloc_fail_no_space');
SET @under_before = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Lizard_lob_prealloc_underestimate_pages');
####################################################################################
# tier 0: len = size_0 = A -> 1 page
#
# Smaller values (e.g. len=1) cannot be probed from SQL: InnoDB stores
# them inline and never calls calc_lob_pages_needed(). tier 0 has no
# internal branch (n = 1 constant), so the upper edge is sufficient.
####################################################################################
####################################################################################
# tier 1: A+1 -> 2, A+B -> 2, A+B+1 -> 3 (integer-division boundary)
####################################################################################
####################################################################################
# tier 1: A+2B -> 3, A+2B+1 -> 4 (mid-tier boundary)
####################################################################################
####################################################################################
# tier 1 upper edge: A+8B -> 9, A+8B+1 -> 10, A+9B=size_1 -> 10
####################################################################################
####################################################################################
# tier 1 -> tier 2 transition: size_1+1 -> 12 (NOT 11, node page inserted)
####################################################################################
####################################################################################
# tier 2: A+10B -> 12, A+10B+1 -> 13 (integer-division boundary inside tier 2)
####################################################################################
####################################################################################
# tier 2 mid-range: A+20B -> 22, A+20B+1 -> 23
####################################################################################
####################################################################################
# tier 2 upper edge: A+280B -> 282, A+280B+1 -> 283, A+281B=size_2 -> 283
####################################################################################
####################################################################################
# tier 2 -> tier 3 transition: size_2+1 -> 285 (NOT 284, new node page added)
####################################################################################
####################################################################################
# tier 3 mid-range: A+300B -> 303, A+300B+1 -> 304
####################################################################################
####################################################################################
# tier 3 upper edge: A+552B -> 555, A+552B+1 -> 556, A+553B=size_3 -> 556
####################################################################################
####################################################################################
# tier 3 -> tier 4 transition: size_3+1 -> 558 (NOT 557, new node page added)
####################################################################################
SET @fails_after      = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Lizard_lob_prealloc_fail_no_space');
SET @under_after      = (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Lizard_lob_prealloc_underestimate_pages');
check table t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
drop table t1;
set global innodb_lob_prealloc = @old_innodb_lob_prealloc;
