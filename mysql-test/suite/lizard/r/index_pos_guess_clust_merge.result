id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	range	PRIMARY,idx_b	idx_b	4	NULL	1	5.00	Using index condition
Warnings:
Note	1003	/* select#1 */ select /*+ INDEX_MERGE(`t`@`select#1` `idx_b`, `PRIMARY`) */ `test`.`t`.`id` AS `id`,`test`.`t`.`a` AS `a`,`test`.`t`.`b` AS `b`,`test`.`t`.`c` AS `c`,`test`.`t`.`d` AS `d` from `test`.`t` where ((`test`.`t`.`id` < 10) and (`test`.`t`.`b` < 20))
EXPLAIN SELECT /*+INDEX_MERGE(t idx_cd) */ * FROM t WHERE c < 10 AND d < 'b';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	range	idx_cd	idx_cd	4	NULL	1	33.33	Using index condition
Warnings:
Warning	3614	Invalid number of arguments for hint INDEX_MERGE(`t`  `idx_cd`)
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id`,`test`.`t`.`a` AS `a`,`test`.`t`.`b` AS `b`,`test`.`t`.`c` AS `c`,`test`.`t`.`d` AS `d` from `test`.`t` where ((`test`.`t`.`c` < 10) and (`test`.`t`.`d` < 'b'))
# Check whether the sort-union index merge with valid gpp hits
call dbms_stat.flush_gpp();
SELECT /*+INDEX_MERGE(t idx_b,PRIMARY) */ * FROM t WHERE id > 999 OR b < 20 ;
SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a = "NO0101" OR b < 20;
SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a < "NO0101" OR b < 20;
SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c = 50;
SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c < 150;
SELECT /*+INDEX_MERGE(t idx_a,idx_b,idx_cd) */ * FROM t WHERE a = "NO0001" OR b < 30 OR (c = 5000 AND d = "A");
include/assert.inc [[sort-union merge valid gpp] index_merge hit+miss should be > 0]
#  Check whether the sort-union index merge with gpp will miss when all of the secondary index's gpp info is invalid
SET DEBUG='+d,set_gpp_null';
call dbms_stat.flush_gpp();
SELECT /*+INDEX_MERGE(t idx_b,PRIMARY) */ * FROM t WHERE id > 999 OR b < 20 ;
SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a = "NO0101" OR b < 20;
SELECT /*+INDEX_MERGE(t idx_a,idx_b) */ * FROM t WHERE a < "NO0101" OR b < 20;
SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c = 50;
SELECT /*+INDEX_MERGE(t idx_a,idx_cd) */ * FROM t WHERE a = "NO0101" OR c < 150;
SELECT /*+INDEX_MERGE(t idx_a,idx_b,idx_cd) */ * FROM t WHERE a = "NO0001" OR b < 30 OR (c = 5000 AND d = "A");
include/assert.inc [[sort-union merge invalid gpp] index_merge miss should be > 0]
SET DEBUG='-d,set_gpp_null';
# END TEST FOR SORT-UNION MERGE -------------------------------
# END ALL TEST -------------------------------
DROP TABLE t;
SET GLOBAL innodb_purge_stop_now = default;
SET GLOBAL innodb_dbug_gpp_no = default;
DROP PROCEDURE insert_t_data;
# Restore original values
SET GLOBAL innodb_lizard_stat_enabled = 0;
SET GLOBAL innodb_index_purge_guess_clust_enabled = 1;
SET GLOBAL innodb_index_scan_guess_clust_enabled = 1;
SET GLOBAL innodb_adaptive_hash_index = 0;
SET GLOBAL innodb_polarx_btree_search_mode = 1;
SET DEBUG_SYNC = 'RESET';
SET DEBUG = '';
