# ============================================================
# redo recovery, ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=4
# ============================================================
SET @base_seq = (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status WHERE variable_name = 'Lizard_current_gcn');
CREATE TABLE t1 (
id INT PRIMARY KEY,
c1 INT,
c2 VARCHAR(200),
KEY k_c1 (c1)
) ENGINE=InnoDB ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=4;
# Insert committed rows that are intentionally left un-cleaned.
SET GLOBAL innodb_commit_cleanout_max_rows = 0;
SET GLOBAL innodb_txn_cleanout_disable = 1;
SET GLOBAL innodb_lizard_stat_enabled = ON;
SET GLOBAL innodb_cleanout_write_redo = TRUE;
XA START 'zip_redo';
INSERT INTO t1 VALUES
(1, 10,  REPEAT('a', 180)),
(2, 20,  REPEAT('b', 180)),
(3, 30,  REPEAT('c', 180)),
(4, 40,  REPEAT('d', 180)),
(5, 50,  REPEAT('e', 180)),
(6, 60,  REPEAT('f', 180)),
(7, 70,  REPEAT('g', 180)),
(8, 80,  REPEAT('h', 180)),
(9, 90,  REPEAT('i', 180)),
(10, 100, REPEAT('j', 180));
XA END 'zip_redo';
XA PREPARE 'zip_redo';
SET innodb_commit_seq = @base_seq + 100;
XA COMMIT 'zip_redo';
# Persist the inserts, then disable checkpointing so the cleanout change
# can only be recovered from redo.
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_checkpoint_disabled = 1;
# Commit cleanout deterministically back-fills scn/uba/gcn on the zip page
# and writes MLOG_REC_CLUST_CLOVER_UPDATE redo.
SET GLOBAL innodb_commit_cleanout_max_rows = 1000;
call dbms_stat.flush_cleanout();
UPDATE t1 SET c1 = c1 + 1 WHERE id <= 6;
include/assert.inc [commit cleanout must produce redo on the compressed page (kbs=4)]
# Crash recovery: dirty pages are not flushed, redo must be replayed.
SET GLOBAL innodb_fast_shutdown = 2;
# restart:
# After recovery: data reflects the recovered update.
SELECT id, c1 FROM t1 ORDER BY id;
id	c1
1	11
2	21
3	31
4	41
5	51
6	61
7	70
8	80
9	90
10	100
# After recovery: the recovered gcn on the compressed record is correct.
# (@base_seq is re-bound from the saved value; the connection was reset
#  by the restart.)
SELECT COUNT(*) AS visible_cnt FROM t1 AS OF GCN @base_seq + 200;
visible_cnt
10
SELECT COUNT(*) AS invisible_cnt FROM t1 AS OF GCN @base_seq + 50;
invisible_cnt
0
# pre-update snapshot reconstructed via undo on the compressed table
SELECT id, c1 FROM t1 AS OF GCN @base_seq + 100 ORDER BY id;
id	c1
1	10
2	20
3	30
4	40
5	50
6	60
7	70
8	80
9	90
10	100
# Page integrity after redo replay on the compressed page.
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
SET GLOBAL innodb_commit_cleanout_max_rows = default;
SET GLOBAL innodb_txn_cleanout_disable = default;
SET GLOBAL innodb_cleanout_write_redo = default;
SET GLOBAL innodb_checkpoint_disabled = default;
SET GLOBAL innodb_fast_shutdown = default;
SET GLOBAL innodb_purge_run_now = ON;
# ============================================================
# redo recovery, ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=8
# ============================================================
SET @base_seq = (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status WHERE variable_name = 'Lizard_current_gcn');
CREATE TABLE t1 (
id INT PRIMARY KEY,
c1 INT,
c2 VARCHAR(200),
KEY k_c1 (c1)
) ENGINE=InnoDB ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=8;
# Insert committed rows that are intentionally left un-cleaned.
SET GLOBAL innodb_commit_cleanout_max_rows = 0;
SET GLOBAL innodb_txn_cleanout_disable = 1;
SET GLOBAL innodb_lizard_stat_enabled = ON;
SET GLOBAL innodb_cleanout_write_redo = TRUE;
XA START 'zip_redo';
INSERT INTO t1 VALUES
(1, 10,  REPEAT('a', 180)),
(2, 20,  REPEAT('b', 180)),
(3, 30,  REPEAT('c', 180)),
(4, 40,  REPEAT('d', 180)),
(5, 50,  REPEAT('e', 180)),
(6, 60,  REPEAT('f', 180)),
(7, 70,  REPEAT('g', 180)),
(8, 80,  REPEAT('h', 180)),
(9, 90,  REPEAT('i', 180)),
(10, 100, REPEAT('j', 180));
XA END 'zip_redo';
XA PREPARE 'zip_redo';
SET innodb_commit_seq = @base_seq + 100;
XA COMMIT 'zip_redo';
# Persist the inserts, then disable checkpointing so the cleanout change
# can only be recovered from redo.
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_checkpoint_disabled = 1;
# Commit cleanout deterministically back-fills scn/uba/gcn on the zip page
# and writes MLOG_REC_CLUST_CLOVER_UPDATE redo.
SET GLOBAL innodb_commit_cleanout_max_rows = 1000;
call dbms_stat.flush_cleanout();
UPDATE t1 SET c1 = c1 + 1 WHERE id <= 6;
include/assert.inc [commit cleanout must produce redo on the compressed page (kbs=8)]
# Crash recovery: dirty pages are not flushed, redo must be replayed.
SET GLOBAL innodb_fast_shutdown = 2;
# restart:
# After recovery: data reflects the recovered update.
SELECT id, c1 FROM t1 ORDER BY id;
id	c1
1	11
2	21
3	31
4	41
5	51
6	61
7	70
8	80
9	90
10	100
# After recovery: the recovered gcn on the compressed record is correct.
# (@base_seq is re-bound from the saved value; the connection was reset
#  by the restart.)
SELECT COUNT(*) AS visible_cnt FROM t1 AS OF GCN @base_seq + 200;
visible_cnt
10
SELECT COUNT(*) AS invisible_cnt FROM t1 AS OF GCN @base_seq + 50;
invisible_cnt
0
# pre-update snapshot reconstructed via undo on the compressed table
SELECT id, c1 FROM t1 AS OF GCN @base_seq + 100 ORDER BY id;
id	c1
1	10
2	20
3	30
4	40
5	50
6	60
7	70
8	80
9	90
10	100
# Page integrity after redo replay on the compressed page.
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
SET GLOBAL innodb_commit_cleanout_max_rows = default;
SET GLOBAL innodb_txn_cleanout_disable = default;
SET GLOBAL innodb_cleanout_write_redo = default;
SET GLOBAL innodb_checkpoint_disabled = default;
SET GLOBAL innodb_fast_shutdown = default;
SET GLOBAL innodb_purge_run_now = ON;
