#
# Test GPP (Guess Primary Page) support for filesort on partitioned tables.
# When filesort uses rowid mode (e.g., due to LONGTEXT columns) on a
# HASH-partitioned table, ha_rnd_pos callback should leverage GPP to
# speed up clustered index lookups across all partitions.
#
set global innodb_lizard_stat_enabled=on;
set global innodb_index_pos_guess_clust_enabled=on;
set opt_index_format_gpp_enabled=true;
# -----------------------------------------------------------------------
# Create a HASH-partitioned table with composite PK, secondary index,
# and LONGTEXT column to force filesort rowid mode.
# -----------------------------------------------------------------------
CREATE TABLE tp (
id INT NOT NULL,
name VARCHAR(50) NOT NULL,
k INT NOT NULL,
c INT NOT NULL,
data LONGTEXT,
PRIMARY KEY (id, name),
KEY idx_k (k)
) ENGINE=InnoDB
PARTITION BY HASH(id) PARTITIONS 4;
# -----------------------------------------------------------------------
# Insert 100 rows distributed across 4 partitions.
# -----------------------------------------------------------------------
INSERT INTO tp (id, name, k, c, data)
WITH RECURSIVE seq AS (
SELECT 1 AS i
UNION ALL
SELECT i + 1 FROM seq WHERE i < 100
)
SELECT
i,
CONCAT('user_', LPAD(i, 5, '0')),
(i * 3) MOD 97,
100 - i,
REPEAT(CHAR(65 + (i MOD 26) USING ascii), 1500)
FROM seq;
SELECT COUNT(*) AS row_count FROM tp;
row_count
100
# -----------------------------------------------------------------------
# Test 1: ORDER BY c ASC - full filesort with GPP on partition table
# Verify that filesort GPP attempts = 100 (one per row) and hit > 0
# -----------------------------------------------------------------------
call dbms_stat.flush_gpp();
SELECT * FROM tp ORDER BY c;
include/assert.inc [[partition filesort] gpp total (hit+miss) should be 100 for ORDER BY c ASC]
include/assert.inc [[partition filesort] gpp hit should be > 0 for ORDER BY c ASC]
# -----------------------------------------------------------------------
# Test 2: ORDER BY c DESC - full filesort with GPP on partition table
# Verify that filesort GPP attempts = 100 and hit > 0
# -----------------------------------------------------------------------
call dbms_stat.flush_gpp();
SELECT * FROM tp ORDER BY c DESC;
include/assert.inc [[partition filesort] gpp total (hit+miss) should be 100 for ORDER BY c DESC]
include/assert.inc [[partition filesort] gpp hit should be > 0 for ORDER BY c DESC]
# -----------------------------------------------------------------------
# Test 3: Verify result correctness - ORDER BY c ASC LIMIT 5
# c = 100 - i, so smallest c values correspond to largest i values:
#   c=0 (i=100), c=1 (i=99), c=2 (i=98), c=3 (i=97), c=4 (i=96)
# -----------------------------------------------------------------------
SELECT id, name, k, c, LEFT(data, 5) AS data_prefix
FROM tp ORDER BY c LIMIT 5;
id	name	k	c	data_prefix
100	user_00100	9	0	WWWWW
99	user_00099	6	1	VVVVV
98	user_00098	3	2	UUUUU
97	user_00097	0	3	TTTTT
96	user_00096	94	4	SSSSS
# -----------------------------------------------------------------------
# Test 4: Verify result correctness - ORDER BY c DESC LIMIT 5
# Largest c values correspond to smallest i values:
#   c=99 (i=1), c=98 (i=2), c=97 (i=3), c=96 (i=4), c=95 (i=5)
# -----------------------------------------------------------------------
SELECT id, name, k, c, LEFT(data, 5) AS data_prefix
FROM tp ORDER BY c DESC LIMIT 5;
id	name	k	c	data_prefix
1	user_00001	3	99	BBBBB
2	user_00002	6	98	CCCCC
3	user_00003	9	97	DDDDD
4	user_00004	12	96	EEEEE
5	user_00005	15	95	FFFFF
# -----------------------------------------------------------------------
# Test 5: ORDER BY k (secondary index column) with GPP stats
# -----------------------------------------------------------------------
call dbms_stat.flush_gpp();
SELECT * FROM tp ORDER BY k;
include/assert.inc [[partition filesort] gpp total (hit+miss) should be 100 for ORDER BY k]
# -----------------------------------------------------------------------
# Test 6: Verify no filesort GPP stat when GPP is disabled
# -----------------------------------------------------------------------
set global innodb_index_pos_guess_clust_enabled=off;
call dbms_stat.flush_gpp();
SELECT * FROM tp ORDER BY c;
include/assert.inc [[partition filesort GPP disabled] gpp hit should be 0]
include/assert.inc [[partition filesort GPP disabled] gpp miss should be 0]
set global innodb_index_pos_guess_clust_enabled=on;
# -----------------------------------------------------------------------
# Clean up
# -----------------------------------------------------------------------
DROP TABLE tp;
SET opt_index_format_gpp_enabled= 1;
SET GLOBAL innodb_lizard_stat_enabled= 0;
SET GLOBAL innodb_index_pos_guess_clust_enabled= 1;
