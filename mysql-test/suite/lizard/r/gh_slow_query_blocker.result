# Test 1: Test execution time limit
CREATE TABLE t1 (id INT, val INT);
INSERT INTO t1 VALUES (1,1);
SET GLOBAL polarx_slow_query_block_exec_timeout = 2;
SELECT SLEEP(5) FROM t1;
ERROR HY000: Slow query blocker, query killed bacause exceeding time limit, change variable polarx_slow_query_block_exec_timeout.
# Test 2: Test CPU and time limit combined
SET GLOBAL polarx_slow_query_block_exec_timeout = 0;
SET GLOBAL polarx_slow_query_block_cpu_percent_threshold = 60;
SET GLOBAL polarx_slow_query_block_exec_timeout_for_cpu_exceed = 2;
WITH RECURSIVE cte AS (
SELECT 1 AS n
UNION ALL
SELECT n + 1 FROM cte WHERE n < 1000000
)
SELECT /*+ SET_VAR(cte_max_recursion_depth = 1M) */ COUNT(*) FROM cte;
ERROR HY000: Slow query blocker, query killed bacause cpu usage high and exceeding time limit, change variable polarx_slow_query_block_cpu_percent_threshold and polarx_slow_query_block_exec_timeout_for_cpu_exceed.
DROP TABLE t1;
SET GLOBAL polarx_slow_query_block_exec_timeout = 0;
SET GLOBAL polarx_slow_query_block_cpu_percent_threshold = 0;
SET GLOBAL polarx_slow_query_block_exec_timeout_for_cpu_exceed = 0;
