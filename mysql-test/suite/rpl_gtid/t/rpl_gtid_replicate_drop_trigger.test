#
# Bug#24478 DROP TRIGGER is not caught by replicate-*-table filters
#
# This test verifies that DROP TRIGGER statements are properly
# filtered by replicate-do-table filters in GTID mode.
# When a trigger was previously skipped due to filtering rules,
# dropping it should also be silently skipped without errors.
#
--source include/not_group_replication_plugin.inc
source include/set_privilege_checks_user_as_system_user.inc;
source include/master-slave.inc;

--disable_warnings
connection master;
drop table if exists t1, t2;
connection slave;
drop table if exists t1, t2;
--enable_warnings

--echo #
--echo # Bug#24478: DROP TRIGGER is not caught by replicate-*-table filters
--echo # Test that dropping a trigger on a filtered table is handled correctly
--echo #

--echo *** master ***
connection master;
create table t1 (a int, b int);
create trigger trg1 before insert on t1 for each row set new.b=2;
create table t2 (a int, b int);
create trigger trg2 before insert on t2 for each row set new.b=2;
show tables;
--replace_column 6 #
show triggers;
--source include/sync_slave_sql_with_master.inc

--echo *** slave ***
connection slave;
show tables;
--replace_column 6 #
show triggers;
# Verify that only t1 and trg1 exist on slave (t2 and trg2 were filtered)

--echo *** master ***
connection master;
# Drop both triggers - trg1 should be dropped, trg2 should be silently skipped on slave
drop trigger trg1;
drop trigger trg2;
--replace_column 6 #
show triggers;
--source include/sync_slave_sql_with_master.inc

--echo *** slave ***
connection slave;
show tables;
--replace_column 6 #
show triggers;
# Verify that trg1 is dropped, and no error occurred when dropping trg2

--echo *** master ***
connection master;
drop table t1;
drop table t2;
--source include/sync_slave_sql_with_master.inc

--source include/rpl_end.inc
