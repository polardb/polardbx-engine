SET @base_seq = (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status WHERE variable_name = 'Lizard_current_gcn');
show global status like "single_shard_read_gcn_too_old";
Variable_name	Value
Single_shard_read_gcn_too_old	0
create table t1 (c1 int primary key, c2 int);
insert into t1 values (1, 10);
create table t2 (c1 int primary key, c2 int);
insert into t2 values (1, 10);
begin;
set innodb_current_snapshot_seq = 1;
select * from t1 union all select * from t2 as of gcn #snapshot_gcn
c1	c2
1	10
1	10
rollback;
drop table t1, t2;
CREATE TABLE users (
id INT PRIMARY KEY,
name VARCHAR(50),
dept_id INT,
version INT
);
CREATE TABLE departments (
id INT PRIMARY KEY,
dept_name VARCHAR(50),
version INT
);
INSERT INTO users VALUES
(1, 'Alice', 10, 0),
(2, 'Bob', 20, 0),
(3, 'Charlie', NULL, 0);
INSERT INTO departments VALUES
(10, 'HR', 0),
(20, 'Engineering', 0),
(30, 'Finance', 0);
begin;
set innodb_current_snapshot_seq = 1;
SELECT
u.id, u.name, u.dept_id, u.version AS user_version,
d.dept_name, d.version AS dept_version
FROM users u
INNER JOIN departments d ON u.dept_id = d.id;
id	name	dept_id	user_version	dept_name	dept_version
1	Alice	10	0	HR	0
2	Bob	20	0	Engineering	0
update users set version = version + 1;
update departments set version = version + 1;
SELECT
u.id, u.name, u.dept_id, u.version AS user_version,
d.dept_name, d.version AS dept_version
FROM users u
INNER JOIN departments d ON u.dept_id = d.id;
id	name	dept_id	user_version	dept_name	dept_version
1	Alice	10	1	HR	1
2	Bob	20	1	Engineering	1
commit;
begin;
set innodb_current_snapshot_seq = 1;
SELECT
u.id, u.name, u.dept_id, u.version
FROM users u
WHERE EXISTS (
SELECT 1 FROM departments d WHERE d.id = u.dept_id
);
id	name	dept_id	version
1	Alice	10	1
2	Bob	20	1
update users set version = version + 1;
update departments set version = version + 1;
SELECT
u.id, u.name, u.dept_id, u.version
FROM users u
WHERE EXISTS (
SELECT 1 FROM departments d WHERE d.id = u.dept_id
);
id	name	dept_id	version
1	Alice	10	2
2	Bob	20	2
commit;
begin;
set innodb_current_snapshot_seq = 1;
SELECT
u.id, u.name, u.dept_id, u.version
FROM users u
WHERE u.dept_id IN (SELECT d.id FROM departments d);
id	name	dept_id	version
1	Alice	10	2
2	Bob	20	2
update users set version = version + 1;
update departments set version = version + 1;
SELECT
u.id, u.name, u.dept_id, u.version
FROM users u
WHERE u.dept_id IN (SELECT d.id FROM departments d);
id	name	dept_id	version
1	Alice	10	3
2	Bob	20	3
commit;
begin;
set innodb_current_snapshot_seq = 1;
SELECT
id, name AS item, version
FROM users
UNION ALL
SELECT
id, dept_name AS item, version
FROM departments;
id	item	version
1	Alice	3
2	Bob	3
3	Charlie	3
10	HR	3
20	Engineering	3
30	Finance	3
update users set version = version + 1;
update departments set version = version + 1;
SELECT
id, name AS item, version
FROM users
UNION ALL
SELECT
id, dept_name AS item, version
FROM departments;
id	item	version
1	Alice	4
2	Bob	4
3	Charlie	4
10	HR	4
20	Engineering	4
30	Finance	4
commit;
drop table users, departments;
