--echo #
--echo # Test: encdb_kms_meta replication across 3-node xcluster
--echo # Verify that KMS metadata written on the leader is visible on followers.
--echo # Created 2026-06-30 by kaiwu.zfy
--echo #

--source include/paxos.inc

connection paxos1;
call mtr.add_suppression("\\[ERROR\\] \\[[^]]*\\] \\[[^]]*\\] Plugin encdb reported: *");
call mtr.add_suppression("\\[Warning\\] \\[[^]]*\\] \\[[^]]*\\] Plugin encdb reported: *");

# -----------------------------------------------------------------------
--echo # Step 1: Register first KMS MEK on leader
# -----------------------------------------------------------------------
connection paxos1;
SELECT encdb_process_message('{"request_type":50, "kms_enc_mek":"dGVzdF9jaXBoZXJ0ZXh0X2Jsb2Jfdg==", "plaintext":"MDAxMTIyMzM0NDU1NjY3Nzg4OTlhYWJiY2NkZGVlZmY=", "kms_region":"cn-hangzhou", "kms_key_id":"key-test-001", "version":0}') IS NOT NULL AS register_ok;

# -----------------------------------------------------------------------
--echo # Step 2: Wait for followers to apply
# -----------------------------------------------------------------------
--source include/wait_follower_catchup.inc

# -----------------------------------------------------------------------
--echo # Step 3: Verify data on follower1
# -----------------------------------------------------------------------
connection paxos2;
SELECT version, region, key_id FROM mysql.encdb_kms_meta ORDER BY version;

# -----------------------------------------------------------------------
--echo # Step 4: Verify data on follower2
# -----------------------------------------------------------------------
connection paxos3;
SELECT version, region, key_id FROM mysql.encdb_kms_meta ORDER BY version;

# -----------------------------------------------------------------------
--echo # Step 5: Key rotation on leader
# -----------------------------------------------------------------------
connection paxos1;
SELECT encdb_process_message('{"request_type":50, "kms_enc_mek":"cm90YXRlZF9jaXBoZXJ0ZXh0X2Jsb2I=", "plaintext":"ZmYwMDExMjIzMzQ0NTU2Njc3ODg5OWFhYmJjY2RkZWU=", "kms_region":"cn-hangzhou", "kms_key_id":"key-test-001", "version":1}') IS NOT NULL AS rotate_ok;

--source include/wait_follower_catchup.inc

# -----------------------------------------------------------------------
--echo # Step 6: Verify both versions on follower1
# -----------------------------------------------------------------------
connection paxos2;
SELECT version, region, key_id FROM mysql.encdb_kms_meta ORDER BY version;

# -----------------------------------------------------------------------
--echo # Step 7: Verify both versions on follower2
# -----------------------------------------------------------------------
connection paxos3;
SELECT version, region, key_id FROM mysql.encdb_kms_meta ORDER BY version;

# -----------------------------------------------------------------------
--echo # Step 8: Exit KMS mode on leader (request_type=51)
# -----------------------------------------------------------------------
connection paxos1;
SELECT encdb_process_message('{"request_type":51}') IS NOT NULL AS exit_ok;

--source include/wait_follower_catchup.inc

# -----------------------------------------------------------------------
--echo # Step 9: Verify table is empty on follower1
# -----------------------------------------------------------------------
connection paxos2;
SELECT COUNT(*) AS rows_remaining FROM mysql.encdb_kms_meta;

# -----------------------------------------------------------------------
--echo # Step 10: Verify table is empty on follower2
# -----------------------------------------------------------------------
connection paxos3;
SELECT COUNT(*) AS rows_remaining FROM mysql.encdb_kms_meta;

# -----------------------------------------------------------------------
--echo # Clean up
# -----------------------------------------------------------------------
connection paxos1;
DELETE FROM mysql.encdb_kms_meta;
