--echo #
--echo # Test case for column encryption
--echo #

--source include/have_binlog_format_row.inc
--source include/master-slave.inc

--echo #
--echo # Test there is no binlog for udf creation during startup.
--echo #
--let $master_binlog= query_get_value(SHOW MASTER STATUS, File, 1)
--let $MYSQLD_DATADIR= `select @@datadir`
--let $mysqlbinlog_output= $MYSQLTEST_VARDIR/tmp/mysqlbinlog_output
--let $mysqlbinlog_parameters= --base64-output=decode-rows -v -v $MYSQLD_DATADIR/$master_binlog
--let $mysqlbinlog_pipe= > $mysqlbinlog_output
--source include/mysqlbinlog.inc

--let $assert_file = $mysqlbinlog_output
--let $assert_text = CREATE FUNCTION encdb_rule_op RETURNS STRING SONAME
--let $assert_count = 0
--let $assert_select = FUNCTION
--source include/assert_grep.inc

create user aurora@`%` identified by '123456';
grant all privileges on *.* to aurora@`%` with grant option;
create user noAccess@`%` identified by '123456';
grant all privileges on test.* to aurora@`%` with grant option;
grant all privileges on mysql.cipher_text to noAccess@`%` with grant option;
flush privileges;

connect(conn_master,localhost,aurora,123456,test,$MASTER_MYPORT,);
connect(conn_slave,localhost,aurora,123456,test,$SLAVE_MYPORT,);
connect(conn_no_access,localhost,noAccess,123456,test,$MASTER_MYPORT,);

# Create UDFs for test.
connection conn_master;
create function encdb_decrypt returns string soname 'encdb_udf.so';
create function encdb_reload_rules returns string soname 'encdb_udf.so';
create function encdb_generate_mek_request returns string soname 'encdb_udf.so';

use test;
call mtr.add_suppression("\\[ERROR\\] \\[[^]]*\\] \\[[^]]*\\] Plugin encdb reported: *");
call mtr.add_suppression("\\[Warning\\] \\[[^]]*\\] \\[[^]]*\\] Plugin encdb reported: *");
echo #Turn off ONLY_FULL_GROUP_BY mode in order to test aggregation functions.;
set sql_mode = "";

create table t1 (c_int_null int,
                 c_tinyint tinyint, c_smallint smallint,
                 c_mediumint mediumint, c_int int, c_bigint bigint,
                 c_float float(10), c_double double, c_decimal decimal(10,3),
                 c_bit bit(64),
                 c_year year(4), c_date date, c_time time(3),
                 c_datetime datetime(6), c_timestamp timestamp,
                 c_char char(10) charset latin1,
                 c_varchar varchar(100) charset utf8mb4,
                 c_binary binary(10), c_varbinary varbinary(100),
                 c_text text, c_blob blob,
                 c_enum enum('one', 'two', 'three'),
                 c_set set('red', 'blue', 'yellow'), c_json json);

insert into t1 set
  c_tinyint = -1, c_smallint = 10000, c_mediumint = 50000, c_int = 1000000,
  c_bigint = 100000000000,
  c_float = 1.1111, c_double = 1000.00001, c_decimal = 1.234,
  c_bit = b'1000001',
  c_year = 2023, c_date = "2023-10-1", c_time = "15:24:25.123",
  c_datetime = "2023-10-1 15:24:25.123456",
  c_timestamp = "2023-10-1 15:24:25.123456",
  c_char = "0123456789", c_varchar = repeat("a", 100),
  c_binary = "0123456789", c_varbinary = repeat("A", 20),
  c_text = repeat("A", 300), c_blob = repeat("A", 1000),
  c_enum = 'two', c_set = 'red,blue',
  c_json = '{"key1": "value1", "key2": "value2"}';

insert into t1 set
  c_tinyint = -2, c_smallint = 20000, c_mediumint = 20000, c_int = 2000000,
  c_bigint = 200000000000,
  c_float = 2.2222, c_double = 2000.00002, c_decimal = 2.345,
  c_bit = b'1000010',
  c_year = 2023, c_date = "2023-11-11", c_time = "18:18:18.123",
  c_datetime = "2023-11-11 18:18:18.123456",
  c_timestamp = "2023-11-11 18:18:18.123456",
  c_char = "012345678", c_varchar = repeat("b", 100),
  c_binary = "012345678", c_varbinary = repeat("B", 20),
  c_text = repeat("B", 300), c_blob = repeat("B", 1000),
  c_enum = 'three', c_set = 'red,yellow',
  c_json = '{"key1": "v1", "key2": "v2"}';

create table t2 like t1;

insert into t2 set
  c_tinyint = -3, c_smallint = 3000, c_mediumint = 30000, c_int = 1000000,
  c_bigint = 300000000000,
  c_float = 3.3333, c_double = 3000.00003, c_decimal = 3.456,
  c_bit = b'1000011',
  c_year = 2024, c_date = "2024-10-1", c_time = "15:24:25.123",
  c_datetime = "2024-10-1 15:24:25.123456",
  c_timestamp = "2024-10-1 15:24:25.123456",
  c_char = "01234567", c_varchar = repeat("b", 100),
  c_binary = "01234567", c_varbinary = repeat("B", 20),
  c_text = repeat("B", 300), c_blob = repeat("B", 1000),
  c_enum = 'one', c_set = 'blue,yellow',
  c_json = '{"k1": "value1", "k2": "value2"}';

insert into t2 set 
  c_tinyint = -4, c_smallint = 4000, c_mediumint = 40000, c_int = 4000000,
  c_bigint = 400000000000,
  c_float = 4.4444, c_double = 2000.00002, c_decimal = 2.345,
  c_bit = b'1000100',
  c_year = 2024, c_date = "2024-11-11", c_time = "18:18:18.123",
  c_datetime = "2024-11-11 18:18:18.123456",
  c_timestamp = "2024-11-11 18:18:18.123456",
  c_char = "0123456", c_varchar = repeat("d", 100),
  c_binary = "0123456", c_varbinary = repeat("D", 20),
  c_text = repeat("D", 300), c_blob = repeat("D", 1000),
  c_enum = 'one', c_set = 'blue,yellow',
  c_json = '{"k1": "v1", "k2": "v2"}';

create table t3 like t1;
insert into t3 set
  c_tinyint = -3, c_smallint = 3000, c_mediumint = 30000, c_int = 1000000,
  c_bigint = 300000000000,
  c_float = 3.3333, c_double = 3000.00003, c_decimal = 3.456,
  c_bit = b'1000011',
  c_year = 2024, c_date = "2024-10-1", c_time = "15:24:25.123",
  c_datetime = "2024-10-1 15:24:25.123456",
  c_timestamp = "2024-10-1 15:24:25.123456",
  c_char = "01234567", c_varchar = repeat("b", 100),
  c_binary = "01234567", c_varbinary = repeat("B", 20),
  c_text = repeat("B", 300), c_blob = repeat("B", 1000),
  c_enum = 'one', c_set = 'blue,yellow',
  c_json = '{"k1": "value1", "k2": "value2"}';

create table t4 like t1;
insert into t4 set
  c_tinyint = -3, c_smallint = 3000, c_mediumint = 30000, c_int = 1000000,
  c_bigint = 300000000000,
  c_float = 3.3333, c_double = 3000.00003, c_decimal = 3.456,
  c_bit = b'1000011',
  c_year = 2024, c_date = "2024-10-1", c_time = "15:24:25.123",
  c_datetime = "2024-10-1 15:24:25.123456",
  c_timestamp = "2024-10-1 15:24:25.123456",
  c_char = "01234567", c_varchar = repeat("b", 100),
  c_binary = "01234567", c_varbinary = repeat("B", 20),
  c_text = repeat("B", 300), c_blob = repeat("B", 1000),
  c_enum = 'one', c_set = 'blue,yellow',
  c_json = '{"k1": "value1", "k2": "value2"}';

create ALGORITHM = MERGE view v1_merge as select * from t1;

create ALGORITHM = TEMPTABLE view v1_tmptable as select * from t1;

create table mysql.cipher_text(
               c0 text, c1 text, c2 text, c3 text,
               c4 text, c5 text, c6 text, c7 text,
               c8 text, c9 text, c10 text, c11 text,
               c12 text, c13 text, c14 text, c15 text,
               c16 text, c17 text, c18 text, c19 text,
               c20 text, c21 text, c22 text, c23 text);

create database test2;
create table test2.t1 like test.t1;
insert into test2.t1 set
  c_tinyint = -3, c_smallint = 3000, c_mediumint = 30000, c_int = 1000000,
  c_bigint = 300000000000,
  c_float = 3.3333, c_double = 3000.00003, c_decimal = 3.456,
  c_bit = b'1000011',
  c_year = 2024, c_date = "2024-10-1", c_time = "15:24:25.123",
  c_datetime = "2024-10-1 15:24:25.123456",
  c_timestamp = "2024-10-1 15:24:25.123456",
  c_char = "01234567", c_varchar = repeat("b", 100),
  c_binary = "01234567", c_varbinary = repeat("B", 20),
  c_text = repeat("B", 300), c_blob = repeat("B", 1000),
  c_enum = 'one', c_set = 'blue,yellow',
  c_json = '{"k1": "value1", "k2": "value2"}';

select encdb_rule_op('add', '{"name": "rule1","enabled": true,"meta": {"databases": ["test"],"tables": ["test"],"columns": ["a","b"]}}');
select encdb_rule_op('grant', '{"restrictedAccess":["root","aurora"]}');
select encdb_rule_export();
select encdb_userauth_export();
--source ../inc/check_slave_encdb_rule.inc

--echo #
--echo # Test invalid param for rule deletion.;
--echo #
--error ER_ENCDB_UDF_ERROR
select encdb_rule_op('delete', 'rule1');
select encdb_rule_export();
--source ../inc/check_slave_encdb_rule.inc


--echo #
--echo # Test correct rule deletion.;
--echo #
select encdb_rule_op('delete', '"rule1"');
--source ../inc/check_slave_encdb_rule.inc


--echo #
--echo # Test invalid param for user auth grant.;
--echo #
--error ER_ENCDB_UDF_ERROR
select encdb_rule_op('grant', '[{"user":"root", "access":"noneAccess"}, {"user":"aurora", "access":"noneAccess"}]');
select encdb_userauth_export();
--source ../inc/check_slave_encdb_rule.inc


--echo #
--echo # Test successful user auth grant.;
--echo #
select encdb_rule_op('grant', '[{"username":"root", "access":"noneAccess"}, {"username":"aurora", "access":"noneAccess"}]');
--source ../inc/check_slave_encdb_rule.inc


select from_base64(encdb_process_message(encdb_generate_mek_request(encdb_process_message('{"request_type":0, "version":"1.2.15"}'),
                                                        '00112233445566778899aabbccddeeff')));
select encdb_rule_export();
select encdb_userauth_export();
select encdb_rule_op('grant','{"fullAccess": ["root"], "expired": "2038-01-18 03:14:07"}');
select encdb_rule_op('grant','{"restrictedAccess": ["aurora"]}');
select encdb_userauth_export();
--source ../inc/check_slave_encdb_rule.inc


--echo #
--echo # Test user without privileges to tables will fail to execute encdb_rule_op UDF;
--echo #
connection conn_no_access;
--error ER_ENCDB_UDF_ERROR
select encdb_rule_op('grant','{"restrictedAccess": ["noAccess"]}');
--replace_regex /INSERT INTO mysql\.encdb_sensitive_rules.*$/<rule SQL>" with error code 1142"/
--error ER_ENCDB_UDF_ERROR
select encdb_rule_op('add','{"name":"newrule1","enabled":true,"meta":{"databases":["test"],"tables":["*"],"columns":["*"]}}');
select encdb_rule_export();
select encdb_userauth_export();
--source ../inc/check_slave_encdb_rule.inc


--echo #
--echo # 1. Test effectiveness of plugin encryption rules.;
--echo #

--echo # Test 1.1 : Add rules to encrypt all tables, columns in database test. Rules should be seen in both master and slave.
connection conn_master;
select encdb_rule_op('add','{"name":"newrule1","enabled":true,"meta":{"databases":["test"],"tables":["*"],"columns":["*"]}}');
select encdb_rule_export();
--source ../inc/check_slave_encdb_rule.inc


--echo # Test 1.2 : Grant noneAccess to aurora, the returned packet couldn't be decrypted cause that server encrypt it by random key.
select from_base64(encdb_process_message(encdb_generate_mek_request(encdb_process_message('{"request_type":0, "version":"1.2.15"}'),
                                                        '00112233445566778899aabbccddeeff', 'SM4_128_CBC')));

select encdb_rule_op('grant','{"noneAccess": ["aurora"]}');
create table t0 (a int);
insert into t0 values (1);
--write_file $MYSQL_TMP_DIR/aurora_t0.sql
SELECT from_base64(encdb_process_message(encdb_generate_mek_request(encdb_process_message('{"request_type":0, "version":"1.2.15"}'), '00112233445566778899aabbccddeeff', 'SM4_128_CBC'))) INTO @mek_prov;
select * from t0;
EOF
--exec $MYSQL --skip-column-names -uaurora -p123456 test < $MYSQL_TMP_DIR/aurora_t0.sql > $MYSQL_TMP_DIR/encrypt_data.txt

--echo # Test 1.3 : Grant restrictedAccess to aurora, the returned packet could be decrypted. We check if the decrypted data is correct

select encdb_rule_op('grant','{"restrictedAccess": ["aurora"]}');

let $select_stmt = select * from t1;
--source ../inc/encdb.inc

let $select_stmt = select * from t2;
--source ../inc/encdb.inc

let $select_stmt = select * from t3;
--source ../inc/encdb.inc

--echo # Test 1.4 : Update newrule1 to encrypt all columns in table t1 whatever the database is. 
SELECT encdb_rule_op('add','{"name":"newrule1","enabled":true,"meta":{"databases":["*"],"tables":["t1"],"columns":["*"]}}');
select encdb_rule_export();

let $select_stmt = select * from t1;
--source ../inc/encdb.inc

let $select_stmt = select * from test2.t1;
--source ../inc/encdb.inc

--echo # Test 1.5: Test that encryption rules will not be applied to tables;
--echo # in same database with same column definitions but different name.
let $select_stmt = select * from t2;
let $decrypt_sql = select * from mysql.cipher_text;
--source ../inc/encdb.inc

--echo # Test 1.6: Update newrule1 to encrypt column named c_tinyint in all tables of all databases.
SELECT encdb_rule_op('add','{"name":"newrule1","enabled":true,"meta":{"databases":["*"],"tables":["*"],
                             "columns":["c_tinyint"]}}');
select encdb_rule_export();

let $select_stmt = select * from t1;
let $decrypt_sql = select c0, encdb_decrypt(c1, 'aurora'), c2, c3, c4, c5, c6, c7, c8, c9, c10,
                          c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23
                          from mysql.cipher_text;
--source ../inc/encdb.inc

let $select_stmt = select * from t2;
let $decrypt_sql = select c0, encdb_decrypt(c1, 'aurora'), c2, c3, c4, c5, c6, c7, c8, c9, c10,
                          c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23
                          from mysql.cipher_text;
--source ../inc/encdb.inc

let $select_stmt = select * from test2.t1;
let $decrypt_sql = select c0, encdb_decrypt(c1, 'aurora'), c2, c3, c4, c5, c6, c7, c8, c9, c10,
                          c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23
                          from mysql.cipher_text;
--source ../inc/encdb.inc


--echo # Test 1.7 : Update newrule1 to encrypt all columns in table test.t1.
--echo #            Add newrule2 to encrypt part of columns in table test.t2.
--echo #            Only sensitive columns in table are expected to be encrypted.

select encdb_rule_op('add','{"name":"newrule1","enabled":true,"meta":{"databases":["test"],"tables":["t1"],
                             "columns":["c_int_null", "c_tinyint", "c_smallint", "c_mediumint", "c_int",
                                        "c_bigint", "c_float", "c_double", "c_decimal", "c_bit", "c_year",
                                        "c_date", "c_time", "c_datetime", "c_timestamp", "c_char", "c_varchar",
                                        "c_binary", "c_varbinary", "c_text", "c_blob", "c_enum", "c_set", "c_json"]}}');
select encdb_rule_op('add','{"name":"newrule2","enabled":true,"meta":{"databases":["test"],"tables":["t2"],
                             "columns":["c_tinyint", "c_mediumint", "c_bigint", "c_double", "c_bit", "c_date",
                                        "c_datetime", "c_char", "c_binary", "c_text", "c_enum", "c_json"]}}');
select encdb_rule_export();

let $select_stmt = select * from t2;
let $decrypt_sql = select c0, encdb_decrypt(c1, 'aurora'),
                        c2, encdb_decrypt(c3, 'aurora'),
                        c4, encdb_decrypt(c5, 'aurora'),
                        c6, encdb_decrypt(c7, 'aurora'),
                        c8, encdb_decrypt(c9, 'aurora'),
                        c10, encdb_decrypt(c11, 'aurora'),
                        c12, encdb_decrypt(c13, 'aurora'),
                        c14, encdb_decrypt(c15, 'aurora'),
                        c16, encdb_decrypt(c17, 'aurora'),
                        c18, encdb_decrypt(c19, 'aurora'),
                        c20, encdb_decrypt(c21, 'aurora'),
                        c22, encdb_decrypt(c23, 'aurora')
                        from mysql.cipher_text;
--source ../inc/encdb.inc

--echo # Test 1.8 : These rules should not be applied to test2.t1, even though they have the same name and column definitions.

let $select_stmt = select * from test2.t1;
let $decrypt_sql = select * from mysql.cipher_text;
--source ../inc/encdb.inc


--echo # 2. Test effectiveness of server layer sensitive column detection.

--echo # Test 2.0 : Test encryption for all MySQL built-in types.
let $select_stmt = select * from t1;
let $decrypt_sql = 0;
--source ../inc/encdb.inc

--echo # Test2.1 : Test encryption for all MySQL built-in types in slave.;
connection conn_slave;
let $select_stmt = select * from t1;
--source  ../inc/encdb.inc

--echo # Test 2.2 : Test whether sensitive columns in view using MERGE algorithm will be encrypted.
let $select_stmt = select * from v1_merge;
let $decrypt_sql = 0;
--source ../inc/encdb.inc

--echo # Test 2.3 : Test whether sensitive columns in view using TEMPTABLE algorithm will be encrypted.
let $select_stmt = select * from v1_tmptable;
let $decrypt_sql = 0;
--source ../inc/encdb.inc


connection conn_master;
--echo # Test 2.4 : Test whether output_fields are encrypted when executing multiple SQL statements in one row.;
delimiter |;
let $select_stmt = PREPARE stmt_2 FROM 'select * from t1';select * from t1;EXECUTE stmt_2|
delimiter ;|
let $decrypt_sql = 0;
let $skip_prepare = 1;
--source ../inc/encdb.inc

--echo # Test 2.5 : Test whether output_fields containing alias will be encrypted.
let $decrypt_sql = 0;
let $select_stmt = select c_int_null as c0, c_tinyint as c1, c_smallint as c2,
                        c_mediumint as c3, c_int as c4, c_bigint as c5,
                        c_float as c6, c_double as c7, c_decimal as c8,
                        c_bit as c9, c_year as c10, c_date as c11, c_time as c12,
                        c_datetime as c13, c_timestamp as c14, c_char as c15,
                        c_varchar as c16, c_binary as c17, c_varbinary as c18,
                        c_text as c19, c_blob as c20, c_enum as c21,
                        c_set as c22, c_json as c23 from t1;
let $skip_prepare = 0;
--source ../inc/encdb.inc

--echo # Test 2.6 : Test whether output_fields and derived_table containing alias will be encrypted.
let $select_stmt = select c0 as cc0, c1 as cc1, c2 as cc2, c3 as cc3, c4 as cc4,
                        c5 as cc5, c6 as cc6, c7 as cc7, c8 as cc8, c9 as cc9,
                        c10 as cc10, c11 as cc11, c12 as cc12, c13 as cc13,
                        c14 as cc14, c15 as cc15, c16 as cc16, c17 as cc17,
                        c18 as cc18, c19 as cc19, c20 as cc20, c21 as cc21,
                        c22 as cc22, c23 as cc23 from
                        (select c_int_null as c0, c_tinyint as c1, 
                        c_smallint as c2, c_mediumint as c3, c_int as c4,
                        c_bigint as c5, c_float as c6, c_double as c7,
                        c_decimal as c8, c_bit as c9, c_year as c10, c_date as c11,
                        c_time as c12, c_datetime as c13, c_timestamp as c14,
                        c_char as c15, c_varchar as c16, c_binary as c17,
                        c_varbinary as c18, c_text as c19, c_blob as c20,
                        c_enum as c21, c_set as c22, c_json as c23 from t1) t;
--source ../inc/encdb.inc

--echo # Test 2.7 : Test whether the order of union will affect the encryption results.
let $select_stmt = select * from t1 union select * from t2;
--source ../inc/encdb.inc

let $select_stmt = select * from t2 union select * from t1;
--source ../inc/encdb.inc

let $select_stmt = select * from t2 union distinct select * from t1;
--source ../inc/encdb.inc

let $select_stmt = select * from t3 union select * from t1 union select * from t4;
--source ../inc/encdb.inc

--echo # Test 2.8 : Test whether built-in functions containing sensitive_fields will be encrypted.;
let $select_stmt = select c_tinyint=0, (select c_tinyint from t1 limit 1), abs(c_tinyint), floor(c_double),
                        char(c_int+c_mediumint), sqrt(c_bigint), mod(c_bigint, c_int), date(c_datetime),
                        time(c_datetime), week(c_datetime), length(c_char), concat(c_char, "123456789"),
                        substring(c_text, 10, 8), strcmp(c_varchar, c_char), strcmp(c_text, c_varchar),
                        ascii(c_char), charset(c_char), md5(c_text), substring(c_char,1,2), space(c_tinyint),
                        hex(c_bit), cast(c_binary as char(10)), cast(c_enum as unsigned),
                        cast(c_json as char(50))  from t2;
--source ../inc/encdb.inc

--echo # Test 2.9 : Test whether sensitive columns will be encrypted after semi-join.
let $select_stmt = select * from t2 where c_tinyint in (select c_tinyint from t1 group by c_int);
let $decrypt_sql = select c0, encdb_decrypt(c1, 'aurora'),
                        c2, encdb_decrypt(c3, 'aurora'),
                        c4, encdb_decrypt(c5, 'aurora'),
                        c6, encdb_decrypt(c7, 'aurora'),
                        c8, encdb_decrypt(c9, 'aurora'),
                        c10, encdb_decrypt(c11, 'aurora'),
                        c12, encdb_decrypt(c13, 'aurora'),
                        c14, encdb_decrypt(c15, 'aurora'),
                        c16, encdb_decrypt(c17, 'aurora'),
                        c18, encdb_decrypt(c19, 'aurora'),
                        c20, encdb_decrypt(c21, 'aurora'),
                        c22, encdb_decrypt(c23, 'aurora')
                        from mysql.cipher_text;
--source ../inc/encdb.inc

--echo # Test 2.10 : Test whether output_fields containing table aliases will be encrypted.
insert into t2 set
  c_tinyint = -1, c_smallint = 10000, c_mediumint = 50000, c_int = 1000000,
  c_bigint = 100000000000,
  c_float = 1.1111, c_double = 1000.00001, c_decimal = 1.234,
  c_bit = b'1000001',
  c_year = 2023, c_date = "2023-10-1", c_time = "15:24:25.123",
  c_datetime = "2023-10-1 15:24:25.123456",
  c_timestamp = "2023-10-1 15:24:25.123456",
  c_char = "0123456789", c_varchar = repeat("a", 100),
  c_binary = "0123456789", c_varbinary = repeat("A", 20),
  c_text = repeat("A", 300), c_blob = repeat("A", 1000),
  c_enum = 'two', c_set = 'red,blue',
  c_json = '{"key1": "value1", "key2": "value2"}';
let $select_stmt = SELECT table2.c_int_null, table2.c_tinyint, table2.c_smallint, table2.c_mediumint,
                          table2.c_int, table2.c_bigint, table2.c_float, table2.c_double, table2.c_decimal,
                          table2.c_bit, table2.c_year, table2.c_date, table2.c_time, table2.c_datetime,
                          table2.c_timestamp, table2.c_char, table2.c_varchar, table2.c_binary, table2.c_varbinary,
                          table2.c_text, table2.c_blob, table2.c_enum, table2.c_set, table2.c_json
                          FROM t1 table1, t2 table2 WHERE table1.c_tinyint = table2.c_tinyint;
--source ../inc/encdb.inc
delete from t2 where c_tinyint = -1;

--echo # Test 2.11 : Test whether aggregation functions containing sensitive_fields will be encrypted.
let $select_stmt = select sum(c_tinyint), min(c_mediumint), max(c_bigint), avg(c_double), count(c_bit) from t1 group by c_int
union
select sum(c_tinyint), min(c_mediumint), max(c_bigint), avg(c_double), count(c_bit) from t2 group by c_int;
let $decrypt_sql = select encdb_decrypt(c0,'aurora'), encdb_decrypt(c1, 'aurora'),
                        encdb_decrypt(c2,'aurora'), encdb_decrypt(c3, 'aurora'),
                        encdb_decrypt(c4,'aurora') from mysql.cipher_text;
--source ../inc/encdb.inc

--echo # Test 2.12 : Test whether sensitive columns will be encrypted after join.
let $select_stmt = select * from t2 join t1 on t1.c_int = t2.c_int;
--source ../inc/encdb_join.inc

--echo # Test 2.13 : Test whether timestamp columns with 0 length will be encrypted properly.
insert into t1 set
  c_tinyint = 1, c_smallint = 20000, c_mediumint = 20000, c_int = 2000000,
  c_bigint = 200000000000,
  c_float = 2.2222, c_double = 2000.00002, c_decimal = 2.345,
  c_bit = b'1000010',
  c_year = 2023, c_date = "", c_time = "",
  c_datetime = "",
  c_timestamp = "",
  c_char = "012345678", c_varchar = repeat("b", 100),
  c_binary = "012345678", c_varbinary = repeat("B", 20),
  c_text = repeat("B", 300), c_blob = repeat("B", 1000),
  c_enum = 'three', c_set = 'red,yellow',
  c_json = '{"key1": "v1", "key2": "v2"}';
let $decrypt_sql = 0;
let $select_stmt = select * from t1 where c_tinyint = 1;
--source ../inc/encdb.inc
delete from t1 where c_tinyint = 1;

--echo # Test 2.14 : Test that select runs as expected after set encdb to off.
set global column_encryption = off;
let $select_stmt = select * from t1;
let $decrypt_sql = select * from t1;
--source ../inc/encdb.inc

--replace_column 2 # 4 #
select * from mysql.encdb_auth_users;
--replace_column 10 #
select * from mysql.encdb_sensitive_rules;

--echo # Test 2.15 : Test encryption scope with mixed columns and constants.
set global column_encryption = ON;

# Single-column SELECT: decrypt only c0 to match one-column output.
let $select_stmt = SELECT c_int + 1 AS calculated FROM t1 LIMIT 1;
let $decrypt_sql = select encdb_decrypt(c0, 'aurora') from mysql.cipher_text;
--source ../inc/encdb.inc

# Use CHAR() to avoid quote escaping in PREPARE and shell. CHAR(95,115,117,102,102,105,120) = '_suffix'.
let $select_stmt = SELECT CONCAT(c_char, CHAR(95,115,117,102,102,105,120)) FROM t1 LIMIT 1;
let $decrypt_sql = select encdb_decrypt(c0, 'aurora') from mysql.cipher_text;
--source ../inc/encdb.inc

--echo # 3. Test if the encrypted data should never be transferred to unencrypted tables.
set global column_encryption = ON;

--echo # 3.1 Test if insert encrypted data to unencrypted table will fail.
--error ER_COLUMNS_ENCRYPTION_TRANSFER
insert into t4 select * from t1;

--echo # 3.2 Test if replace into encrypted data to unencrypted table will fail.
--error ER_COLUMNS_ENCRYPTION_TRANSFER
replace into t4 select * from t1;

--echo # 3.3 Test if create unencrypted table with the encrypted data from encrypted table will fail.
--error ER_COLUMNS_ENCRYPTION_TRANSFER
create table t5 select * from t1;

--echo # 3.4 Test if select encrypted columns into user variables will fail.
--error ER_COLUMNS_ENCRYPTION_TRANSFER
SELECT c_tinyint INTO @a FROM t1 LIMIT 1;

--echo # 3.5 Test if select encrypted columns into outfile will fail.
--error ER_COLUMNS_ENCRYPTION_TRANSFER
SELECT c_tinyint FROM t1 INTO OUTFILE '$MYSQLTEST_VARDIR/tmp/encdb_outfile_test.txt';

--echo # 3.6 Test if select encrypted columns into dumpfile will fail.
--error ER_COLUMNS_ENCRYPTION_TRANSFER
SELECT c_tinyint FROM t1 LIMIT 1 INTO DUMPFILE '$MYSQLTEST_VARDIR/tmp/encdb_dumpfile_test.txt';

--echo # 3.7 Test if multi-table update with encrypted source to unencrypted target will fail.
--error ER_COLUMNS_ENCRYPTION_TRANSFER
UPDATE t4 JOIN t1 ON t4.c_int = t1.c_int SET t4.c_tinyint = t1.c_tinyint;

--echo # 3.8 Test if fetch cursor into sp variables with encrypted columns will fail.
delimiter |;
CREATE PROCEDURE test_fetch_encrypted()
BEGIN
  DECLARE v TINYINT;
  DECLARE cur CURSOR FOR SELECT c_tinyint FROM t1;
  OPEN cur;
  FETCH cur INTO v;
  CLOSE cur;
END|
delimiter ;|
--error ER_COLUMNS_ENCRYPTION_TRANSFER
CALL test_fetch_encrypted();
DROP PROCEDURE IF EXISTS test_fetch_encrypted;

--echo #
--echo # Clean up
--echo #
drop database test;
drop database test2;
drop table mysql.cipher_text;
create database test;
drop function encdb_decrypt;
drop function encdb_reload_rules;
drop function encdb_generate_mek_request;
drop user aurora@`%`;
drop user noAccess@`%`;
set global column_encryption = on;
--remove_file $mysqlbinlog_output
--error 0,1
--remove_file $MYSQL_TMP_DIR/aurora_t0.sql
--error 0,1
--remove_file $MYSQL_TMP_DIR/encrypt_data.txt

--source include/sync_slave_sql_with_master.inc
--source include/rpl_end.inc
