#
# Test: local MEK rotation (rotate_local_mek) keeps a valid session CC.
#
# Regression for the bug where rotate_local_mek() built the new CC without
# setting username. After a local MEK_UPDATE the rotating connection got an
# empty-username CC, so the next getCC(real_user) hit CC_MISS. With
# encdb_cc_miss_error = OFF (default) this silently fell back to a dummy
# key and returned data the client could not decrypt.
#
# To make the bug observable we set encdb_cc_miss_error = ON, so a broken
# CC surfaces as a hard error instead of a silent dummy-key fallback, and
# we assert end-to-end that the rotated connection can still decrypt back
# the original plaintext (not merely "no error").
#
# Created 2026-07-17 by kaiwu.zfy
#
call mtr.add_suppression("\\[ERROR\\] \\[[^]]*\\] \\[[^]]*\\] Plugin encdb reported: *");
call mtr.add_suppression("\\[Warning\\] \\[[^]]*\\] \\[[^]]*\\] Plugin encdb reported: *");
set global column_encryption = ON;
create function encdb_decrypt returns string soname 'encdb_udf.so';
create function encdb_generate_mek_request returns string soname 'encdb_udf.so';
create function encdb_generate_mek_update_request returns string soname 'encdb_udf.so';
create user enc_rot@'%' identified by '123456';
grant all privileges on *.* to enc_rot@'%' with grant option;
flush privileges;
create table test.t_rot (id int primary key, secret varchar(100));
insert into test.t_rot values (1, 'hello_rotation');
select encdb_rule_op('add', '{"name":"rot_rule","enabled":true,"meta":{"databases":["test"],"tables":["t_rot"],"columns":["secret"]}}');
encdb_rule_op('add', '{"name":"rot_rule","enabled":true,"meta":{"databases":["test"],"tables":["t_rot"],"columns":["secret"]}}')
OK
select encdb_rule_op('grant', '{"fullAccess":["root"]}');
encdb_rule_op('grant', '{"fullAccess":["root"]}')
OK
select encdb_rule_op('grant', '{"restrictedAccess":["enc_rot"]}');
encdb_rule_op('grant', '{"restrictedAccess":["enc_rot"]}')
OK
set global encdb_cc_miss_error = ON;
# Step 1: MEK_PROVISION with the OLD MEK on this connection.
#         This also persists the salt_mac, which the later rotation reads.
SELECT from_base64(encdb_process_message(encdb_generate_mek_request(
encdb_process_message('{"request_type":0, "version":"1.2.15"}'),
'00112233445566778899aabbccddeeff'))) IS NOT NULL AS provision_ok;
provision_ok
1
# Step 2: local MEK rotation OLD -> NEW on the SAME connection.
#         salt_mac now exists, so encdbUpdateMek takes the rotate_local_mek
#         branch (the code path under test), not import_mek.
SELECT from_base64(encdb_process_message(encdb_generate_mek_update_request(
encdb_process_message('{"request_type":0, "version":"1.2.15"}'),
'00112233445566778899aabbccddeeff',
'ffeeddccbbaa99887766554433221100'))) IS NOT NULL AS rotate_ok;
rotate_ok
1
# Step 3: end-to-end check that the rotated CC is still valid.
#         enc_rot is restricted, so this SELECT returns ciphertext produced
#         by the rotated CC; decrypting it back must yield the original
#         plaintext. If username were lost (the bug), encryption here would
#         raise CC_MISS (hard error) under encdb_cc_miss_error = ON.
SELECT @plain = 'hello_rotation' AS decrypt_ok;
decrypt_ok
1
# Clean up
set global encdb_cc_miss_error = OFF;
select encdb_rule_op('delete', '"rot_rule"');
encdb_rule_op('delete', '"rot_rule"')
OK
drop table test.t_rot;
drop user enc_rot@'%';
drop function encdb_decrypt;
drop function encdb_generate_mek_request;
drop function encdb_generate_mek_update_request;
set global column_encryption = OFF;
