#
# EncDB rule descriptions are persisted and exported.
#
call mtr.add_suppression("\\[ERROR\\] \\[[^]]*\\] \\[[^]]*\\] Plugin encdb reported: *");
call mtr.add_suppression("\\[Warning\\] \\[[^]]*\\] \\[[^]]*\\] Plugin encdb reported: *");
select column_type as column_type, is_nullable as is_nullable,
column_default is not null as has_default
from information_schema.columns
where table_schema = 'mysql' and table_name = 'encdb_sensitive_rules'
    and column_name = 'description';
column_type	is_nullable	has_default
text	NO	1
# Upgrade the original table schema and preserve existing rows.
alter table mysql.encdb_sensitive_rules drop column description;
insert into mysql.encdb_sensitive_rules
(sensitive_databases, sensitive_tables, sensitive_columns, algos,
default_algo, endpoints, rule_name, enabled, rule_type)
values ('["test"]', '["t"]', '["c"]', '[]', '', '[]',
'pre_upgrade_rule', true, 0);
include/assert_grep.inc [Reapplying the system table fix must not add description again]
select column_type as column_type, is_nullable as is_nullable,
column_default is not null as has_default
from information_schema.columns
where table_schema = 'mysql' and table_name = 'encdb_sensitive_rules'
    and column_name = 'description';
column_type	is_nullable	has_default
text	NO	1
select ordinal_position =
(select ordinal_position + 1 from information_schema.columns
where table_schema = 'mysql' and
table_name = 'encdb_sensitive_rules' and
column_name = 'rule_type') as description_after_rule_type
from information_schema.columns
where table_schema = 'mysql' and table_name = 'encdb_sensitive_rules' and
column_name = 'description';
description_after_rule_type
1
select description = '' as description_is_empty
from mysql.encdb_sensitive_rules where rule_name = 'pre_upgrade_rule';
description_is_empty
1
flush privileges;
select encdb_rule_export();
encdb_rule_export()
[{
    "algo" : [],
    "defaultAlgo" : "",
    "enabled" : true,
    "endpoints" : [],
    "meta" : {
      "columns" : ["c"],
      "databases" : ["test"],
      "tables" : ["t"]
    },
    "name" : "pre_upgrade_rule"
  }]
select encdb_rule_op('delete', '"pre_upgrade_rule"');
encdb_rule_op('delete', '"pre_upgrade_rule"')
OK
# Simulate the original standard binary writing only the original columns.
insert into mysql.encdb_sensitive_rules
(sensitive_databases, sensitive_tables, sensitive_columns, algos,
default_algo, endpoints, rule_name, enabled, rule_type)
values ('["test"]', '["t"]', '["c"]', '[]', '', '[]',
'standard_rule', true, 0);
select description = '' as description_is_empty
from mysql.encdb_sensitive_rules where rule_name = 'standard_rule';
description_is_empty
1
delete from mysql.encdb_sensitive_rules where rule_name = 'standard_rule';
select encdb_rule_op('add', '{"name":"description_rule","description":"initial description","enabled":true,"meta":{"databases":["test"],"tables":["t"],"columns":["c"]}}');
encdb_rule_op('add', '{"name":"description_rule","description":"initial description","enabled":true,"meta":{"databases":["test"],"tables":["t"],"columns":["c"]}}')
OK
select description from mysql.encdb_sensitive_rules
where rule_name = 'description_rule';
description
initial description
select encdb_rule_export();
encdb_rule_export()
[{
    "algo" : [],
    "defaultAlgo" : "",
    "description" : "initial description",
    "enabled" : true,
    "endpoints" : [],
    "meta" : {
      "columns" : ["c"],
      "databases" : ["test"],
      "tables" : ["t"]
    },
    "name" : "description_rule"
  }]
flush privileges;
select encdb_rule_export();
encdb_rule_export()
[{
    "algo" : [],
    "defaultAlgo" : "",
    "description" : "initial description",
    "enabled" : true,
    "endpoints" : [],
    "meta" : {
      "columns" : ["c"],
      "databases" : ["test"],
      "tables" : ["t"]
    },
    "name" : "description_rule"
  }]
select encdb_rule_op('update', '{"name":"description_rule","description":"updated description","enabled":true,"meta":{"databases":["test"],"tables":["t"],"columns":["c"]}}');
encdb_rule_op('update', '{"name":"description_rule","description":"updated description","enabled":true,"meta":{"databases":["test"],"tables":["t"],"columns":["c"]}}')
OK
select description from mysql.encdb_sensitive_rules
where rule_name = 'description_rule';
description
updated description
select encdb_rule_export();
encdb_rule_export()
[{
    "algo" : [],
    "defaultAlgo" : "",
    "description" : "updated description",
    "enabled" : true,
    "endpoints" : [],
    "meta" : {
      "columns" : ["c"],
      "databases" : ["test"],
      "tables" : ["t"]
    },
    "name" : "description_rule"
  }]
select encdb_rule_op('delete', '"description_rule"');
encdb_rule_op('delete', '"description_rule"')
OK
# Requests without description remain compatible.
select encdb_rule_op('add', '{"name":"legacy_rule","enabled":true,"meta":{"databases":["test"],"tables":["t"],"columns":["c"]}}');
encdb_rule_op('add', '{"name":"legacy_rule","enabled":true,"meta":{"databases":["test"],"tables":["t"],"columns":["c"]}}')
OK
select description from mysql.encdb_sensitive_rules
where rule_name = 'legacy_rule';
description

select encdb_rule_export();
encdb_rule_export()
[{
    "algo" : [],
    "defaultAlgo" : "",
    "enabled" : true,
    "endpoints" : [],
    "meta" : {
      "columns" : ["c"],
      "databases" : ["test"],
      "tables" : ["t"]
    },
    "name" : "legacy_rule"
  }]
select encdb_rule_op('delete', '"legacy_rule"');
