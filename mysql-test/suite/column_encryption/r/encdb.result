create ALGORITHM = MERGE view v1_merge as select * from t1;
create ALGORITHM = TEMPTABLE view v1_tmptable as select * from t1;
create table mysql.cipher_text(
c0 text, c1 text, c2 text, c3 text,
c4 text, c5 text, c6 text, c7 text,
c8 text, c9 text, c10 text, c11 text,
c12 text, c13 text, c14 text, c15 text,
c16 text, c17 text, c18 text, c19 text,
c20 text, c21 text, c22 text, c23 text);
create database test2;
create table test2.t1 like test.t1;
insert into test2.t1 set
c_tinyint = -3, c_smallint = 3000, c_mediumint = 30000, c_int = 1000000,
c_bigint = 300000000000,
c_float = 3.3333, c_double = 3000.00003, c_decimal = 3.456,
c_bit = b'1000011',
c_year = 2024, c_date = "2024-10-1", c_time = "15:24:25.123",
c_datetime = "2024-10-1 15:24:25.123456",
c_timestamp = "2024-10-1 15:24:25.123456",
c_char = "01234567", c_varchar = repeat("b", 100),
c_binary = "01234567", c_varbinary = repeat("B", 20),
c_text = repeat("B", 300), c_blob = repeat("B", 1000),
c_enum = 'one', c_set = 'blue,yellow',
c_json = '{"k1": "value1", "k2": "value2"}';
select encdb_rule_op('add', '{"name": "rule1","enabled": true,"meta": {"databases": ["test"],"tables": ["test"],"columns": ["a","b"]}}');
encdb_rule_op('add', '{"name": "rule1","enabled": true,"meta": {"databases": ["test"],"tables": ["test"],"columns": ["a","b"]}}')
OK
select encdb_rule_op('grant', '{"restrictedAccess":["root","aurora"]}');
encdb_rule_op('grant', '{"restrictedAccess":["root","aurora"]}')
OK
