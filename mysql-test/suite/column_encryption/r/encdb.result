# Test 1.7 : Update newrule1 to encrypt all columns in table test.t1.
#            Add newrule2 to encrypt part of columns in table test.t2.
#            Only sensitive columns in table are expected to be encrypted.
select encdb_rule_op('add','{"name":"newrule1","enabled":true,"meta":{"databases":["test"],"tables":["t1"],
                             "columns":["c_int_null", "c_tinyint", "c_smallint", "c_mediumint", "c_int",
                                        "c_bigint", "c_float", "c_double", "c_decimal", "c_bit", "c_year",
                                        "c_date", "c_time", "c_datetime", "c_timestamp", "c_char", "c_varchar",
