# Test 2.15 : Test encryption scope with mixed columns and constants.
set global column_encryption = ON;
# Verify data correctness in plain SQL.
SELECT c_int + 1 AS calculated FROM t1 LIMIT 1
load data local infile "MYSQL_TMP_DIR/encrypt_data.txt" into table mysql.cipher_text;
delete from mysql.cipher_text;
# Verify data correctness in prepared staments.
load data local infile "MYSQL_TMP_DIR/encrypt_data.txt" into table mysql.cipher_text;
delete from mysql.cipher_text;
# Verify data correctness in store procedure.
CREATE PROCEDURE `encdb_proc` ()
BEGIN
SELECT c_int + 1 AS calculated FROM t1 LIMIT 1;
END |
load data local infile "MYSQL_TMP_DIR/encrypt_data.txt" into table mysql.cipher_text;
drop procedure encdb_proc;
delete from mysql.cipher_text;
delete from mysql.cipher_text;
# Verify data correctness in plain SQL.
SELECT CONCAT(c_char, CHAR(95,115,117,102,102,105,120)) FROM t1 LIMIT 1
load data local infile "MYSQL_TMP_DIR/encrypt_data.txt" into table mysql.cipher_text;
delete from mysql.cipher_text;
# Verify data correctness in prepared staments.
load data local infile "MYSQL_TMP_DIR/encrypt_data.txt" into table mysql.cipher_text;
delete from mysql.cipher_text;
# Verify data correctness in store procedure.
CREATE PROCEDURE `encdb_proc` ()
BEGIN
SELECT CONCAT(c_char, CHAR(95,115,117,102,102,105,120)) FROM t1 LIMIT 1;
END |
load data local infile "MYSQL_TMP_DIR/encrypt_data.txt" into table mysql.cipher_text;
drop procedure encdb_proc;
delete from mysql.cipher_text;
delete from mysql.cipher_text;
# 3. Test if the encrypted data should never be transferred to unencrypted tables.
set global column_encryption = ON;
# 3.1 Test if insert encrypted data to unencrypted table will fail.
insert into t4 select * from t1;
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
# 3.2 Test if replace into encrypted data to unencrypted table will fail.
replace into t4 select * from t1;
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
# 3.3 Test if create unencrypted table with the encrypted data from encrypted table will fail.
create table t5 select * from t1;
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
# 3.4 Test if select encrypted columns into user variables will fail.
SELECT c_tinyint INTO @a FROM t1 LIMIT 1;
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
# 3.5 Test if select encrypted columns into outfile will fail.
SELECT c_tinyint FROM t1 INTO OUTFILE '$MYSQLTEST_VARDIR/tmp/encdb_outfile_test.txt';
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
# 3.6 Test if select encrypted columns into dumpfile will fail.
SELECT c_tinyint FROM t1 LIMIT 1 INTO DUMPFILE '$MYSQLTEST_VARDIR/tmp/encdb_dumpfile_test.txt';
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
# 3.7 Test if multi-table update with encrypted source to unencrypted target will fail.
UPDATE t4 JOIN t1 ON t4.c_int = t1.c_int SET t4.c_tinyint = t1.c_tinyint;
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
# 3.8 Test if fetch cursor into sp variables with encrypted columns will fail.
CREATE PROCEDURE test_fetch_encrypted()
BEGIN
DECLARE v TINYINT;
DECLARE cur CURSOR FOR SELECT c_tinyint FROM t1;
OPEN cur;
FETCH cur INTO v;
CLOSE cur;
END|
CALL test_fetch_encrypted();
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
DROP PROCEDURE IF EXISTS test_fetch_encrypted;
