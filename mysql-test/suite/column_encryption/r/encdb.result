#
# 1. Test effectiveness of plugin encryption rules.;
#
# Test 1.1 : Add rules to encrypt all tables, columns in database test. Rules should be seen in both master and slave.
select encdb_rule_op('add','{"name":"newrule1","enabled":true,"meta":{"databases":["test"],"tables":["*"],"columns":["*"]}}');
encdb_rule_op('add','{"name":"newrule1","enabled":true,"meta":{"databases":["test"],"tables":["*"],"columns":["*"]}}')
OK
select encdb_rule_export();
encdb_rule_export()
[{
    "algo" : [],
    "defaultAlgo" : "",
    "enabled" : true,
    "endpoints" : [],
    "meta" : {
      "columns" : ["*"],
      "databases" : ["test"],
      "tables" : ["*"]
    },
    "name" : "newrule1"
  }]
include/rpl_diff.inc
include/rpl_diff.inc
# Test 1.2 : Grant noneAccess to aurora, the returned packet couldn't be decrypted cause that server encrypt it by random key.
select from_base64(encdb_process_message(encdb_generate_mek_request(encdb_process_message('{"request_type":0, "version":"1.2.15"}'),
'00112233445566778899aabbccddeeff', 'SM4_128_CBC')));
from_base64(encdb_process_message(encdb_generate_mek_request(encdb_process_message('{"request_type":0, "version":"1.2.15"}'),
'00112233445566778899aabbccddeeff', 'SM4_128_CBC')))
{
  "body" : "",
  "status" : 0
}
select encdb_rule_op('grant','{"noneAccess": ["aurora"]}');
encdb_rule_op('grant','{"noneAccess": ["aurora"]}')
OK
create table t0 (a int);
insert into t0 values (1);
# Test 1.3 : Grant restrictedAccess to aurora, the returned packet could be decrypted. We check if the decrypted data is correct
select encdb_rule_op('grant','{"restrictedAccess": ["aurora"]}');
encdb_rule_op('grant','{"restrictedAccess": ["aurora"]}')
OK
