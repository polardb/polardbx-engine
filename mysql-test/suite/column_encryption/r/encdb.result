#
# Test case for column encryption
#
include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the master info repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START SLAVE; see the 'START SLAVE Syntax' in the MySQL Manual for more information.
[connection master]
#
# Test there is no binlog for udf creation during startup.
#
include/mysqlbinlog.inc
include/assert_grep.inc [CREATE FUNCTION encdb_rule_op RETURNS STRING SONAME]
create user aurora@`%` identified by '123456';
grant all privileges on *.* to aurora@`%` with grant option;
create user noAccess@`%` identified by '123456';
grant all privileges on test.* to aurora@`%` with grant option;
grant all privileges on mysql.cipher_text to noAccess@`%` with grant option;
flush privileges;
create function encdb_decrypt returns string soname 'encdb_udf.so';
create function encdb_reload_rules returns string soname 'encdb_udf.so';
create function encdb_generate_mek_request returns string soname 'encdb_udf.so';
use test;
call mtr.add_suppression("\\[ERROR\\] \\[[^]]*\\] \\[[^]]*\\] Plugin encdb reported: *");
call mtr.add_suppression("\\[Warning\\] \\[[^]]*\\] \\[[^]]*\\] Plugin encdb reported: *");
#Turn off ONLY_FULL_GROUP_BY mode in order to test aggregation functions.
set sql_mode = "";
create table t1 (c_int_null int,
c_tinyint tinyint, c_smallint smallint,
c_mediumint mediumint, c_int int, c_bigint bigint,
c_float float(10), c_double double, c_decimal decimal(10,3),
c_bit bit(64),
c_year year(4), c_date date, c_time time(3),
c_datetime datetime(6), c_timestamp timestamp,
c_char char(10) charset latin1,
c_varchar varchar(100) charset utf8mb4,
c_binary binary(10), c_varbinary varbinary(100),
c_text text, c_blob blob,
c_enum enum('one', 'two', 'three'),
c_set set('red', 'blue', 'yellow'), c_json json);
Warnings:
Warning	1287	'YEAR(4)' is deprecated and will be removed in a future release. Please use YEAR instead
insert into t1 set
c_tinyint = -1, c_smallint = 10000, c_mediumint = 50000, c_int = 1000000,
c_bigint = 100000000000,
c_float = 1.1111, c_double = 1000.00001, c_decimal = 1.234,
c_bit = b'1000001',
c_year = 2023, c_date = "2023-10-1", c_time = "15:24:25.123",
c_datetime = "2023-10-1 15:24:25.123456",
c_timestamp = "2023-10-1 15:24:25.123456",
c_char = "0123456789", c_varchar = repeat("a", 100),
c_binary = "0123456789", c_varbinary = repeat("A", 20),
c_text = repeat("A", 300), c_blob = repeat("A", 1000),
c_enum = 'two', c_set = 'red,blue',
c_json = '{"key1": "value1", "key2": "value2"}';
