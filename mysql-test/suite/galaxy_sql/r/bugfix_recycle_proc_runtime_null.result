NULLIF('new_db', 'new_db'), 'new_name');
ERROR HY000: The 2th parameter didn't match for native procedure dbms_recycle.restore_table
CALL dbms_recycle.restore_table('old_name', 'new_db',
NULLIF('new_name', 'new_name'));
