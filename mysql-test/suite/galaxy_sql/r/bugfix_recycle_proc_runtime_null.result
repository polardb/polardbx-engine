# Runtime NULL from a VARCHAR expression must be rejected safely.
CALL dbms_recycle.purge_table(NULLIF('purge_name', 'purge_name'));
ERROR HY000: The 1th parameter didn't match for native procedure dbms_recycle.purge_table
CALL dbms_recycle.restore_table(NULLIF('old_name', 'old_name'));
