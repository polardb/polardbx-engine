SELECT AI_PROMPT('Say exactly one word: ok') IS NOT NULL;
ERROR HY000: ai_prompt: no default model configured for AI_PROMPT.
# 1.4 update_function rejects a missing model
CALL dbms_ai.update_function('AI_PROMPT', '__POLARDBX_FUTURE_LLM');
ERROR HY000: Model not found.
