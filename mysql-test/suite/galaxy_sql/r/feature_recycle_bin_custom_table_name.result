5. Test table name validation
-- Verify check_recycle_bin_table_name function works correctly
------------------------------------------------------------------
SET SESSION recycle_bin_table_name = 'valid_table_name';
SET SESSION recycle_bin_table_name = 'table123';
SET SESSION recycle_bin_table_name = 'my_table_001';
SET SESSION recycle_bin_table_name = NULL;
SET SESSION recycle_bin_table_name = '';
ERROR 42000: Incorrect table name ''
SET SESSION recycle_bin_table_name = 'this_is_a_very_long_table_name_that_exceeds_the_maximum_length_limit_of_sixty_four_characters';
ERROR 42000: Identifier name 'this_is_a_very_long_table_name_that_exceeds_the_maximum_length_limit_of_sixty_four_characters' is too long
------------------------------------------------------
