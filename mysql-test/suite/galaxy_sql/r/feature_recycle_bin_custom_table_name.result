4. Test truncate operations with custom table names
-- Mix truncate and drop operations
------------------------------------------------------
SET SESSION recycle_bin_table_name = 'custom_truncate_001';
create table t_truncate1(id int, name varchar(50));
insert into t_truncate1 values(1, 'truncate_test1');
truncate table t_truncate1;
SET SESSION recycle_bin_table_name = 'custom_drop_after_truncate';
drop table t_truncate1;
create table t_mixed(id int, name varchar(50));
insert into t_mixed values(1, 'mixed_test1');
SET SESSION recycle_bin_table_name = 'custom_mixed_001';
truncate table t_mixed;
insert into t_mixed values(2, 'mixed_test2');
drop table t_mixed;
call dbms_recycle.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
__recycle_bin__	__innodb_167	db_recycle_test	t3	#	#
__recycle_bin__	__innodb_746	db_recycle_test	t_mixed	#	#
__recycle_bin__	custom_drop_after_truncate	db_recycle_test	t_truncate1	#	#
__recycle_bin__	custom_mixed_001	db_recycle_test	t_mixed	#	#
__recycle_bin__	custom_table_001	db_recycle_test	t1	#	#
__recycle_bin__	custom_table_002	db_recycle_test	t2	#	#
__recycle_bin__	custom_truncate_001	db_recycle_test	t_truncate1	#	#
