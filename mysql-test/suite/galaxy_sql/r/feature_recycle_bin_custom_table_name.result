7. Test recycle_bin_table_name duplicate handling
-- Verify warning when using same custom table name for different tables
----------------------------------------------------------------------------
SET SESSION recycle_bin_table_name = 'new_case_table';
CREATE TABLE t6(id INT);
INSERT INTO t6 VALUES(1);
DROP TABLE t6;
SET SESSION recycle_bin_table_name = 'new_case_table';
CREATE TABLE t7(id INT);
INSERT INTO t7 VALUES(1);
DROP TABLE t7;
Warnings:
Warning	7589	Table 'new_case_table' already exists in recycle_bin
SHOW WARNINGS;
Level	Code	Message
Warning	7589	Table 'new_case_table' already exists in recycle_bin
----------------------------------------------------------------------------
8. Test drop database with custom recycle table name
-- Verify database drop operations dosen't work with custom table naming
----------------------------------------------------------------------------
CREATE DATABASE new_db_for_tests;
USE new_db_for_tests;
CREATE TABLE t8(id INT);
INSERT INTO t8 VALUES(1);
CREATE TABLE t9(id INT);
INSERT INTO t9 VALUES(2);
SET SESSION recycle_bin_table_name = 'drop_db';
DROP DATABASE new_db_for_tests;
CALL dbms_recycle.show_tables();
