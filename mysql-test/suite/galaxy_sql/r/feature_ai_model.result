# 4. describe_model
# 4.1 describe existing model (api_key masked)
CALL dbms_ai.describe_model('qwen_plus');
MODEL_NAME	PROVIDER	ENDPOINT	MODEL	API_KEY	MODEL_PARAMS	STATUS	DESCRIPTION
qwen_plus	dashscope	https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation	qwen-plus	sk-7****0798		ACTIVE	Qwen Plus model
# 4.2 describe model with no api_key (should show empty)
CALL dbms_ai.describe_model('no_key_model');
MODEL_NAME	PROVIDER	ENDPOINT	MODEL	API_KEY	MODEL_PARAMS	STATUS	DESCRIPTION
no_key_model	dashscope	https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation	qwen-plus			ACTIVE	
# 4.3 describe model without 'model' field
CALL dbms_ai.describe_model('no_model_field');
MODEL_NAME	PROVIDER	ENDPOINT	MODEL	API_KEY	MODEL_PARAMS	STATUS	DESCRIPTION
no_model_field	dashscope	https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation		sk-7****0798		ACTIVE	
# 4.4 describe non-existent model should fail
CALL dbms_ai.describe_model('no_such_model');
ERROR HY000: dbms_ai.describe_model: model 'no_such_model' not found
# 4.5 describe with empty name should fail
CALL dbms_ai.describe_model('');
ERROR HY000: dbms_ai.describe_model: model_name is required
# 5. update_model
# 5.1 update description and model_params
CALL dbms_ai.update_model('qwen_turbo', '{"description":"Updated Qwen Turbo", "model_params":"temperature=0.5"}');
# 5.2 verify update took effect
CALL dbms_ai.describe_model('qwen_turbo');
MODEL_NAME	PROVIDER	ENDPOINT	MODEL	API_KEY	MODEL_PARAMS	STATUS	DESCRIPTION
qwen_turbo	dashscope	https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation	qwen-turbo	sk-7****0798	temperature=0.5	ACTIVE	Updated Qwen Turbo
# 5.3 update with empty options should fail
CALL dbms_ai.update_model('qwen_turbo', '');
ERROR HY000: dbms_ai.update_model: options_json is required
# 5.4 update with invalid JSON should fail
CALL dbms_ai.update_model('qwen_turbo', 'not json');
ERROR HY000: dbms_ai.update_model: invalid JSON in options
# 5.5 update non-existent model should fail
CALL dbms_ai.update_model('no_such_model', '{"description":"x"}');
ERROR HY000: dbms_ai: model 'no_such_model' not found
# 5.6 update provider to openai
CALL dbms_ai.update_model('qwen_turbo', '{"provider":"openai"}');
CALL dbms_ai.describe_model('qwen_turbo');
MODEL_NAME	PROVIDER	ENDPOINT	MODEL	API_KEY	MODEL_PARAMS	STATUS	DESCRIPTION
qwen_turbo	openai	https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation	qwen-turbo	sk-7****0798	temperature=0.5	ACTIVE	Updated Qwen Turbo
# 5.7 update provider back to dashscope
CALL dbms_ai.update_model('qwen_turbo', '{"provider":"dashscope"}');
# 5.8 update with invalid provider should fail
CALL dbms_ai.update_model('qwen_turbo', '{"provider":"invalid_provider"}');
ERROR HY000: dbms_ai.update_model: provider must be 'dashscope' or 'openai', got 'invalid_provider'
# 5.9 update with unrecognized JSON key should fail
CALL dbms_ai.update_model('qwen_turbo', '{"unknown_key":"value"}');
ERROR HY000: dbms_ai.update_model: no updatable field found in options. Supported fields: endpoint, provider, model, api_key, model_params, status, description
# 5.10 update endpoint accepts HTTP (no scheme restriction in kernel)
CALL dbms_ai.update_model('qwen_turbo', '{"endpoint":"http://example.com/api"}');
# restore endpoint for subsequent tests
CALL dbms_ai.update_model('qwen_turbo', '{"endpoint":"https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation"}');
# 5.11 update with empty JSON object should fail
CALL dbms_ai.update_model('qwen_turbo', '{}');
ERROR HY000: dbms_ai.update_model: no updatable field found in options. Supported fields: endpoint, provider, model, api_key, model_params, status, description
# 5.12 update_model masks api_key in direct SELECT and calls use the restored key
api_key
******
SELECT AI_PROMPT('Say exactly one word: cyan', 'qwen_turbo') IS NOT NULL;
AI_PROMPT('Say exactly one word: cyan', 'qwen_turbo') IS NOT NULL
1
# 7. AI_PROMPT happy path
# 7.1 AI_PROMPT with configured default model
SELECT AI_PROMPT('Say exactly one word: hello') IS NOT NULL;
AI_PROMPT('Say exactly one word: hello') IS NOT NULL
1
# 7.2 AI_PROMPT with explicit model name
SELECT AI_PROMPT('Say exactly one word: blue', 'qwen_turbo') IS NOT NULL;
AI_PROMPT('Say exactly one word: blue', 'qwen_turbo') IS NOT NULL
1
# 7.3 AI_PROMPT with options JSON (3rd arg)
SELECT AI_PROMPT('Say exactly one word: yes', 'qwen_plus', '{"temperature":0.1, "max_tokens":10}') IS NOT NULL;
AI_PROMPT('Say exactly one word: yes', 'qwen_plus', '{"temperature":0.1, "max_tokens":10}') IS NOT NULL
1
# 8. AI_PROMPT edge cases
# 8.1 NULL prompt -> NULL (SQL scalar function convention)
SELECT AI_PROMPT(NULL);
AI_PROMPT(NULL)
NULL
# 8.2 non-existent model name -> error
SELECT AI_PROMPT('hello', 'nonexistent_model');
ERROR HY000: ai_prompt: model 'nonexistent_model' not found in ai_model_config. Register it first with CALL dbms_ai.register_model(...).
# 8.3 model with no api_key -> falls back to env var (should succeed)
SELECT AI_PROMPT('hello', 'no_key_model') IS NOT NULL;
AI_PROMPT('hello', 'no_key_model') IS NOT NULL
1
# 8.4 model with invalid api_key -> HTTP 401 from API
SELECT AI_PROMPT('hello', 'bad_key_model');
ERROR HY000: AI: HTTP 401 error from remote server
# 8.5 model with bad/unreachable endpoint -> connection error
SELECT AI_PROMPT('hello', 'bad_url_model');
ERROR HY000: AI: connection to this-host-does-not-exist.example.com:443 failed
# 8.6 model without 'model' field -> fallback to model_name for API call
SELECT AI_PROMPT('hello', 'no_model_field');
ERROR HY000: AI: HTTP 400 error from remote server
# 8b. AI_EMBEDDING tests
# 8b.1 AI_EMBEDDING with configured default EMBEDDING model
SELECT AI_EMBEDDING('What is PolarDB-X?') IS NOT NULL;
AI_EMBEDDING('What is PolarDB-X?') IS NOT NULL
1
# 8b.2 AI_EMBEDDING with explicit model name
SELECT AI_EMBEDDING('hello world', 'embed_v3') IS NOT NULL;
AI_EMBEDDING('hello world', 'embed_v3') IS NOT NULL
1
# 8b.3 NULL text -> NULL (SQL scalar function convention)
SELECT AI_EMBEDDING(NULL);
AI_EMBEDDING(NULL)
NULL
# 8b.4 non-existent model -> error
SELECT AI_EMBEDDING('hello', 'nonexistent_embed_model');
ERROR HY000: AI_EMBEDDING: model 'nonexistent_embed_model' not found in ai_model_config. Register it first with CALL dbms_ai.register_model(...).
# 8b.5 model with no api_key -> falls back to env var (should succeed)
SELECT AI_EMBEDDING('hello', 'no_key_model');
ERROR HY000: AI: HTTP 400 error from remote server
# 8d. AI_CLASSIFY tests
# 8d.1 basic classification
SELECT AI_CLASSIFY('This product is excellent, very satisfied!', JSON_ARRAY('positive', 'negative', 'neutral')) IS NOT NULL;
AI_CLASSIFY('This product is excellent, very satisfied!', JSON_ARRAY('positive', 'negative', 'neutral')) IS NOT NULL
1
# 8d.2 classification with explicit model
SELECT AI_CLASSIFY('This is a technical article about databases', JSON_ARRAY('technology', 'finance', 'entertainment', 'sports'), 'qwen_plus') IS NOT NULL;
AI_CLASSIFY('This is a technical article about databases', JSON_ARRAY('technology', 'finance', 'entertainment', 'sports'), 'qwen_plus') IS NOT NULL
1
# 8d.3 NULL text -> NULL (SQL scalar function convention)
SELECT AI_CLASSIFY(NULL, JSON_ARRAY('a', 'b'));
AI_CLASSIFY(NULL, JSON_ARRAY('a', 'b'))
NULL
# 8d.4 NULL categories -> NULL (SQL scalar function convention)
SELECT AI_CLASSIFY('hello', NULL);
AI_CLASSIFY('hello', NULL)
NULL
# 8d.5 non-existent model -> error
SELECT AI_CLASSIFY('hello', JSON_ARRAY('a', 'b'), 'nonexistent_model');
ERROR HY000: AI_CLASSIFY: model 'nonexistent_model' not found in ai_model_config.
# 8d.6 classification with multi_label option
SELECT AI_CLASSIFY('This article discusses AI technology applications in the finance industry', JSON_ARRAY('technology', 'finance', 'entertainment', 'sports'), '', '{"multi_label":true}') IS NOT NULL;
AI_CLASSIFY('This article discusses AI technology applications in the finance industry', JSON_ARRAY('technology', 'finance', 'entertainment', 'sports'), '', '{"multi_label":true}') IS NOT NULL
1
# 8e. AI_EXTRACT tests
# 8e.1 basic extraction
SELECT AI_EXTRACT('Contact John, phone: 13800138000, email: john@example.com', JSON_OBJECT('name', 'Name', 'phone', 'Phone number', 'email', 'Email address')) IS NOT NULL;
AI_EXTRACT('Contact John, phone: 13800138000, email: john@example.com', JSON_OBJECT('name', 'Name', 'phone', 'Phone number', 'email', 'Email address')) IS NOT NULL
1
# 8e.2 AI_EXTRACT with explicit model
SELECT AI_EXTRACT('Contact Jane, mobile: 13900139000', JSON_OBJECT('name', 'Name', 'phone', 'Phone number'), 'qwen_plus') IS NOT NULL;
AI_EXTRACT('Contact Jane, mobile: 13900139000', JSON_OBJECT('name', 'Name', 'phone', 'Phone number'), 'qwen_plus') IS NOT NULL
1
# 8e.3 NULL text -> NULL (SQL scalar function convention)
SELECT AI_EXTRACT(NULL, JSON_OBJECT('name', 'Name'));
AI_EXTRACT(NULL, JSON_OBJECT('name', 'Name'))
NULL
# 8e.4 NULL schema -> NULL (SQL scalar function convention)
SELECT AI_EXTRACT('some text', NULL);
AI_EXTRACT('some text', NULL)
NULL
# 8f. AI_SUMMARIZE tests
# 8f.1 basic summarize (default max_length)
SELECT AI_SUMMARIZE('PolarDB-X is a cloud-native distributed database system independently developed by Alibaba, featuring high availability, high performance, and horizontal scalability, widely used in e-commerce and finance scenarios.') IS NOT NULL;
AI_SUMMARIZE('PolarDB-X is a cloud-native distributed database system independently developed by Alibaba, featuring high availability, high performance, and horizontal scalability, widely used in e-commerce and finance scenarios.') IS NOT NULL
1
# 8f.2 summarize with max_length
SELECT AI_SUMMARIZE('PolarDB-X is a cloud-native distributed database system independently developed by Alibaba, featuring high availability, high performance, and horizontal scalability.', 50) IS NOT NULL;
AI_SUMMARIZE('PolarDB-X is a cloud-native distributed database system independently developed by Alibaba, featuring high availability, high performance, and horizontal scalability.', 50) IS NOT NULL
1
# 8f.3 NULL text -> NULL (SQL scalar function convention)
SELECT AI_SUMMARIZE(NULL);
AI_SUMMARIZE(NULL)
NULL
# 8f.4 summarize with language option
SELECT AI_SUMMARIZE('PolarDB-X is a cloud-native distributed database system independently developed by Alibaba.', 100, '', '{"language":"Chinese"}') IS NOT NULL;
AI_SUMMARIZE('PolarDB-X is a cloud-native distributed database system independently developed by Alibaba.', 100, '', '{"language":"Chinese"}') IS NOT NULL
1
# 8f.5 summarize with bullet_points style
SELECT AI_SUMMARIZE('PolarDB-X is a cloud-native distributed database system. It features high availability and horizontal scalability. It is widely used in e-commerce and finance.', 200, '', '{"style":"bullet_points"}') IS NOT NULL;
AI_SUMMARIZE('PolarDB-X is a cloud-native distributed database system. It features high availability and horizontal scalability. It is widely used in e-commerce and finance.', 200, '', '{"style":"bullet_points"}') IS NOT NULL
1
