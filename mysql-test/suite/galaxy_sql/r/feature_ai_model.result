AI_EMBEDDING('hello world', 'embed_v3', '{"dimension":512}') IS NOT NULL
1
# 8n.4 NULL and empty rows return NULL without aborting the batch
CREATE TABLE ai_embed_batch (id INT PRIMARY KEY, content TEXT);
INSERT INTO ai_embed_batch VALUES (1, 'hello'), (2, NULL), (3, ''), (4, 'world');
SELECT id, AI_EMBEDDING(content) IS NULL AS emb_is_null FROM ai_embed_batch ORDER BY id;
id	emb_is_null
1	0
2	1
3	1
4	0
Warnings:
Warning	1210	ai_embedding: empty input text returned NULL
DROP TABLE ai_embed_batch;
