# 9.1 drop qwen_turbo
CALL dbms_ai.drop_model('qwen_turbo');
# 9.2 verify it's gone
CALL dbms_ai.describe_model('qwen_turbo');
ERROR HY000: dbms_ai.describe_model: model 'qwen_turbo' not found
# 9.3 list should show remaining models
CALL dbms_ai.list_models();
