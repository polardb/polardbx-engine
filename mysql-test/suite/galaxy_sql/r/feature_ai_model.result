# 1. Check ai_model_config table
show create table mysql.ai_model_config;
Table	Create Table
ai_model_config	CREATE TABLE `ai_model_config` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `model_name` varchar(128) COLLATE utf8mb4_bin NOT NULL,
  `provider` varchar(64) COLLATE utf8mb4_bin NOT NULL,
  `endpoint` varchar(512) COLLATE utf8mb4_bin NOT NULL,
  `model` varchar(128) COLLATE utf8mb4_bin DEFAULT NULL,
  `api_key` varchar(512) COLLATE utf8mb4_bin DEFAULT NULL,
  `model_params` text COLLATE utf8mb4_bin,
  `status` varchar(16) COLLATE utf8mb4_bin DEFAULT 'ACTIVE',
  `description` varchar(1024) COLLATE utf8mb4_bin DEFAULT NULL,
  `gmt_created` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `gmt_modified` timestamp NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_model_name` (`model_name`)
) /*!50100 TABLESPACE `mysql` */ ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin STATS_PERSISTENT=0 COMMENT='AI model configuration'
# 2. register_model
# 2.1 register qwen_plus (LLM, valid key)
# 2.1a register_model masks api_key in mysql.ai_model_config for direct SELECT
api_key
******
# 2.2 register qwen_turbo (LLM)
# 2.3 register EMBEDDING model
# 2.3b register RERANK model
# 2.3c register DOCUMENT_PARSE model
# 2.3d register VL_EMBEDDING model
# 2.3e register OpenAI-compatible LLM model
# 2.3f register OpenAI-compatible EMBEDDING model
# 2.3g register control-plane default-name LLM model without api_key
CALL dbms_ai.register_model(
'__POLARDBX_QWEN35_PLUS',
'dashscope',
'https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation',
'qwen-plus',
'{"description":"Control-plane default-name LLM no key"}'
);
# 2.4 register model WITHOUT api_key (no options)
CALL dbms_ai.register_model(
'no_key_model',
'dashscope',
'https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation',
'qwen-plus',
''
);
# 2.5 register model with INVALID api_key
CALL dbms_ai.register_model(
'bad_key_model',
'dashscope',
'https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation',
'qwen-plus',
'{"api_key":"sk-invalid-key-000000000000000000"}'
);
# 2.6 register model with BAD endpoint URL
# 2.7 register model without 'model' field (should fallback to model_name)
# 2.8 duplicate model_name should fail
ERROR HY000: dbms_ai: model 'qwen_plus' already exists
# 2.9 missing required fields (empty strings) should fail
CALL dbms_ai.register_model('bad_model', '', '', '', '');
ERROR HY000: dbms_ai.register_model: model_name, provider, and endpoint are required
# 2.10 wrong number of args should fail
CALL dbms_ai.register_model('only_name');
ERROR 42000: Incorrect number of arguments for PROCEDURE dbms_ai.register_model; expected 5, got 1
# 2.11 configure AI function defaults through dbms_ai.update_function
CALL dbms_ai.update_function('AI_PROMPT', 'qwen_plus');
CALL dbms_ai.update_function('AI_EMBEDDING', 'embed_v3');
CALL dbms_ai.update_function('AI_CLASSIFY', 'qwen_plus');
CALL dbms_ai.update_function('AI_RANK', 'rerank_v2');
CALL dbms_ai.update_function('AI_SIMILARITY', 'embed_v3');
CALL dbms_ai.update_function('AI_EXTRACT', 'qwen_plus');
CALL dbms_ai.update_function('AI_SUMMARIZE', 'qwen_plus');
CALL dbms_ai.update_function('AI_PARSE_DOCUMENT', 'doc_parse');
CALL dbms_ai.update_function('AI_VL_EMBEDDING', 'vl_embed');
CALL dbms_ai.update_function('AI_TEXT2SQL', 'qwen_plus');
# 3. list_models
CALL dbms_ai.list_models();
