# 8u. AI_TEXT2SQL
# 8u.0 prepare schema context tables in a dedicated database
CREATE DATABASE ai_t2s_real;
USE ai_t2s_real;
CREATE TABLE employees (
id BIGINT PRIMARY KEY AUTO_INCREMENT,
name VARCHAR(100) NOT NULL,
department VARCHAR(50),
salary DECIMAL(10,2),
hire_date DATE
);
CREATE TABLE departments (
id BIGINT PRIMARY KEY AUTO_INCREMENT,
dept_name VARCHAR(100) NOT NULL,
manager_id BIGINT
);
CREATE TABLE orders (
id BIGINT PRIMARY KEY AUTO_INCREMENT,
customer_name VARCHAR(100) NOT NULL,
product VARCHAR(100) NOT NULL,
quantity INT NOT NULL,
total_price DECIMAL(10,2) NOT NULL,
order_date DATE NOT NULL
);
INSERT INTO employees (name, department, salary, hire_date) VALUES
('Alice', 'Engineering', 95000.00, '2020-01-15'),
('Bob', 'Marketing', 75000.00, '2019-06-01'),
('Charlie', 'Engineering', 110000.00, '2018-03-10');
INSERT INTO departments (dept_name, manager_id) VALUES
('Engineering', 3), ('Marketing', 2);
INSERT INTO orders (customer_name, product, quantity, total_price, order_date) VALUES
('Alice', 'Laptop', 1, 1299.99, '2024-01-15'),
('Bob', 'Phone', 2, 1599.98, '2024-01-20');
# 8u.1 AI_TEXT2SQL happy path with configured default model
SELECT AI_TEXT2SQL('Find all employees') IS NOT NULL;
AI_TEXT2SQL('Find all employees') IS NOT NULL
1
# 8u.2 basic select references the schema table
SELECT UPPER(s) LIKE '%SELECT%' AND UPPER(s) LIKE '%EMPLOYEES%' AS basic_ok
FROM (SELECT AI_TEXT2SQL('Find all employees') AS s) t;
basic_ok
1
# 8u.3 filter query generates a WHERE clause on the schema column
SELECT UPPER(s) LIKE '%WHERE%' AND UPPER(s) LIKE '%SALARY%' AS filter_ok
FROM (SELECT AI_TEXT2SQL('Find employees with salary greater than 80000') AS s) t;
filter_ok
1
# 8u.4 aggregation query generates aggregate + GROUP BY
SELECT (UPPER(s) LIKE '%AVG%' OR UPPER(s) LIKE '%AVERAGE%')
AND UPPER(s) LIKE '%GROUP BY%' AS agg_ok
FROM (SELECT AI_TEXT2SQL('Calculate the average salary of employees by department') AS s) t;
agg_ok
1
# 8u.5 cross-table query references the orders table
SELECT UPPER(s) LIKE '%ORDERS%' AS cross_ok
FROM (SELECT AI_TEXT2SQL('Show the total order amount for each customer') AS s) t;
cross_ok
1
# 8u.6 explicit model references the departments table
SELECT UPPER(s) LIKE '%DEPARTMENTS%' AS model_ok
FROM (SELECT AI_TEXT2SQL('List all departments', 'qwen_plus') AS s) t;
model_ok
1
# 8u.7 AI_TEXT2SQL with options JSON
SELECT AI_TEXT2SQL('Find all employees', '', '{"temperature":0.1, "max_tokens":200}') IS NOT NULL;
AI_TEXT2SQL('Find all employees', '', '{"temperature":0.1, "max_tokens":200}') IS NOT NULL
1
# 8u.8 AI_TEXT2SQL with OpenAI-compatible model
SELECT UPPER(s) LIKE '%SELECT%' AS openai_ok
FROM (SELECT AI_TEXT2SQL('Find all employees', 'openai_llm') AS s) t;
openai_ok
1
# 8u.9 Chinese prompt maps to English schema identifiers
SELECT UPPER(s) LIKE '%EMPLOYEES%' AND UPPER(s) LIKE '%SALARY%' AS zh_ok
FROM (SELECT AI_TEXT2SQL('查询工资高于80000的员工姓名') AS s) t;
zh_ok
1
# 8u.10 generated SQL is executable against the schema
# generated SQL executed successfully
# 8u.11 NULL prompt -> NULL (SQL scalar function convention)
SELECT AI_TEXT2SQL(NULL);
AI_TEXT2SQL(NULL)
NULL
# 8u.12 cleanup text2sql database
DROP DATABASE ai_t2s_real;
USE test;
# 9. Real-call validation of DASHSCOPE_API_KEY fallback path
# 9.1 registered model has empty api_key, must fall back to DASHSCOPE_API_KEY
SELECT AI_PROMPT('Say exactly one word: ok', '__POLARDBX_QWEN35_PLUS') IS NOT NULL;
AI_PROMPT('Say exactly one word: ok', '__POLARDBX_QWEN35_PLUS') IS NOT NULL
1
# 10. Cleanup
CALL dbms_ai.drop_model('qwen_plus');
CALL dbms_ai.drop_model('embed_v3');
CALL dbms_ai.drop_model('rerank_v2');
CALL dbms_ai.drop_model('doc_parse');
CALL dbms_ai.drop_model('vl_embed');
CALL dbms_ai.drop_model('no_key_model');
CALL dbms_ai.drop_model('bad_key_model');
CALL dbms_ai.drop_model('bad_url_model');
CALL dbms_ai.drop_model('no_model_field');
CALL dbms_ai.drop_model('openai_llm');
CALL dbms_ai.drop_model('openai_embed');
CALL dbms_ai.drop_model('__POLARDBX_QWEN35_PLUS');
# 10.1 verify all cleaned up
CALL dbms_ai.list_models();
MODEL_NAME	PROVIDER	ENDPOINT	MODEL	STATUS
