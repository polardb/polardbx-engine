#
# 1. register a model with api_key
#
#
# 2. api_key is masked when mask_internal_user is disabled
#
SET GLOBAL mask_internal_user=OFF;
SELECT api_key FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
api_key
******
SELECT CONCAT(api_key, ':suffix') AS api_key_expr FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
api_key_expr
******
#
# 3. updated api_key is masked too
#
SELECT api_key FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
api_key
******
SELECT CONCAT(api_key, ':suffix') AS api_key_expr FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
api_key_expr
******
#
# 4. api_key remains masked when mask_internal_user is enabled
#
SET GLOBAL mask_internal_user=ON;
SELECT api_key FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
api_key
******
SELECT CONCAT(api_key, ':suffix') AS api_key_expr FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
api_key_expr
******
#
# 5. api_key transfer is rejected while mask is enabled
#
CREATE TABLE api_key_mask_sink(api_key TEXT);
INSERT INTO api_key_mask_sink SELECT api_key FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
SELECT api_key INTO @masked_api_key FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
INSERT INTO api_key_mask_sink VALUES ('plain');
UPDATE api_key_mask_sink s JOIN mysql.ai_model_config c
ON c.model_name = 'mask_secret_model'
  SET s.api_key = c.api_key;
ERROR HY000: Transfer of encrypted or masked columns is not allowed in this statement.
TRUNCATE TABLE api_key_mask_sink;
#
# 6. api_key mask can be disabled explicitly
#
SET GLOBAL mask_ai_model_config_api_key=OFF;
SELECT api_key <> '******' AS api_key_unmasked,
LEFT(api_key, 10) = CONCAT('$','AI_OBF','$','1:') AS api_key_has_prefix
FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
api_key_unmasked	api_key_has_prefix
1	1
INSERT INTO api_key_mask_sink SELECT api_key FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
SELECT COUNT(*) AS inserted_rows FROM api_key_mask_sink;
inserted_rows
1
SELECT LEFT(api_key, 10) = CONCAT('$','AI_OBF','$','1:') AS inserted_has_prefix
FROM api_key_mask_sink;
inserted_has_prefix
1
SELECT api_key INTO @unmasked_api_key FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
SELECT LEFT(@unmasked_api_key, 10) = CONCAT('$','AI_OBF','$','1:') AS variable_has_prefix;
variable_has_prefix
1
UPDATE api_key_mask_sink s JOIN mysql.ai_model_config c
ON c.model_name = 'mask_secret_model'
  SET s.api_key = c.api_key;
SELECT LEFT(api_key, 10) = CONCAT('$','AI_OBF','$','1:') AS updated_has_prefix
FROM api_key_mask_sink;
updated_has_prefix
1
#
# 7. api_key mask can be enabled again
#
SET GLOBAL mask_ai_model_config_api_key=ON;
SELECT api_key FROM mysql.ai_model_config WHERE model_name = 'mask_secret_model';
api_key
******
#
# 8. cleanup
#
SET GLOBAL mask_internal_user=OFF;
SET GLOBAL mask_ai_model_config_api_key=DEFAULT;
DROP TABLE api_key_mask_sink;
CALL dbms_ai.drop_model('mask_secret_model');
