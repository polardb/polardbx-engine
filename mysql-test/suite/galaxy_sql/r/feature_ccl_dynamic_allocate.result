create procedure LoopAddCclRule()
begin
declare i int default 0;
DECLARE tablename VARCHAR(100);
while i < 200 do
set tablename = concat('sbtest', i);
call dbms_ccl.add_ccl_rule('select', '', '', 2, tablename);
set i = i + 1;
end while;
end |
CALL LoopAddCclRule();
call dbms_ccl.show_ccl_rule();
