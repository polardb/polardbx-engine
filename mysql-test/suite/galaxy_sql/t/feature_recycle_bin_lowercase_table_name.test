--source include/have_debug.inc
--source include/have_binlog_format_row.inc
--source include/have_lowercase1.inc
--disable_ps_protocol

call mtr.add_suppression("Fail to recycle table");

connection default;
create database db_recycle_test;
show variables like "lower_case_table_names";

--echo ------------------------------------------------------
--echo 1. Test recycle table name conversion to lowercase
--echo    -- Verify uppercase table names are converted to lowercase
--echo ------------------------------------------------------

connection default;
set global recycle_scheduler=off;
use db_recycle_test;
SET SESSION recycle_bin = ON;

# Test with uppercase custom recycle table name
SET SESSION recycle_bin_table_name = 'CUSTOM_TABLE_001';
CREATE TABLE T1(id INT);
INSERT INTO T1 VALUES(2);
DROP TABLE T1;

--replace_column 5 # 6 #
call dbms_recycle.show_tables();
select * from __recycle_bin__.CUSTOM_TABLE_001;

--echo ------------------------------------------------------
--echo 2. Test purge_table with uppercase input
--echo    -- Verify purge works with uppercase table name input
--echo ------------------------------------------------------

SET SESSION recycle_bin_table_name = 'UPPER_PURGE_TABLE';
CREATE TABLE T2(id INT);
INSERT INTO T2 VALUES(3);
DROP TABLE T2;

--replace_column 5 # 6 #
call dbms_recycle.show_tables();

# Purge with uppercase name - should be converted to lowercase
call dbms_recycle.purge_table('UPPER_PURGE_TABLE');

--replace_column 5 # 6 #
call dbms_recycle.show_tables();

--echo ------------------------------------------------------
--echo 3. Test restore_table with uppercase input
--echo    -- Verify restore works with uppercase table name input
--echo    -- Note: restore_table returns expected error in single node mode
--echo ------------------------------------------------------

SET SESSION recycle_bin_table_name = 'UPPER_RESTORE_TABLE';
CREATE TABLE T3(id INT, name VARCHAR(50));
INSERT INTO T3 VALUES(4, 'restore_test');
DROP TABLE T3;

--replace_column 5 # 6 #
call dbms_recycle.show_tables();

# Restore with uppercase recycle table name - should be converted to lowercase
# Expected error in single node mode: restore only works on current node
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recycle.restore_table('UPPER_RESTORE_TABLE', 'db_recycle_test', 'RestoredTable');

# Verify table was restored
SHOW TABLES;
SELECT * FROM RestoredTable;

# Clean up
drop database db_recycle_test;