--disable_ps_protocol

--echo # Runtime NULL from a VARCHAR expression must be rejected safely.
--error ER_NATIVE_PROC_PARAMETER_MISMATCH
CALL dbms_recycle.purge_table(NULLIF('purge_name', 'purge_name'));

--error ER_NATIVE_PROC_PARAMETER_MISMATCH
CALL dbms_recycle.restore_table(NULLIF('old_name', 'old_name'));

--error ER_NATIVE_PROC_PARAMETER_MISMATCH
CALL dbms_recycle.restore_table('old_name',
                                NULLIF('new_db', 'new_db'), 'new_name');

--error ER_NATIVE_PROC_PARAMETER_MISMATCH
CALL dbms_recycle.restore_table('old_name', 'new_db',
                                NULLIF('new_name', 'new_name'));

SELECT 1 AS server_is_alive;
