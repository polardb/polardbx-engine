--source include/have_validate_password_component.inc
--source include/have_debug.inc

# Warning is generated when default file (NULL) is used
CALL mtr.add_suppression("Dictionary file not specified");

# Warning is generated when dictionary file is not loaded
CALL mtr.add_suppression("Dictionary file open failed");

# Warning is generated when dictionary file is not provided with
# PASSWORD_POLICY_STRONG
CALL mtr.add_suppression("Since the validate_password_policy is mentioned ");

# Warning is generated when dictionary file size exceeded
# MAX_DICTIONARY_FILE_LENGTH
CALL mtr.add_suppression("Dictionary file size exceeded");

# Warning is generated when validate_password.length is chaged
# as a result of changing value of system variables listed below:
# VALIDATE_PASSWORD.NUMBER_COUNT
# VALIDATE_PASSWORD.MIXED_CASE_COUNT
# VALIDATE_PASSWORD.SPECIAL_CHAR_COUNT
CALL mtr.add_suppression("Effective value of validate_password.length is changed.");

let $MYSQL_ERRMSG_BASEDIR=`select @@lc_messages_dir`;

# component is not installed so even 'pass' (very weak) is accepted as
# a password
CREATE USER 'base_user'@'127.0.0.1' IDENTIFIED BY 'pass';
CREATE USER 'base_user'@'::1' IDENTIFIED BY 'pass';

INSTALL COMPONENT "file://component_validate_password";

# There are three password policy: LOW, MEDIUM, STRONG
# Test if validate password component is skipped for local internal user

--echo # ----------------------- case 1 ------------------------------
# When we create a non-internal user with weak password, even if the 
# password policy is LOW, it should be refused.
# Test IPV4.
SET @@global.validate_password.policy=LOW;

# Test localhost
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user1'@'localhost' IDENTIFIED BY 'aweg';

# Test IPv4 loopback
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user2'@'127.0.0.1' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user3'@'127.0.0.2' IDENTIFIED BY 'aweg';

# Test IPv6 loopback
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user4'@'::1' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user5'@'0:0:0:0:0:0:0:1' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user6'@'0000:0000:0000:0000:0000:0000:0000:0001' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user7'@'::0001' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user8'@'0:0:0:0:0::1' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user9'@'::0.0.0.1' IDENTIFIED BY 'aweg';

# Test IPv4-mapped IPv6 loopback
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user10'@'::ffff:127.0.0.1' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user11'@'::ffff:127.0.0.2' IDENTIFIED BY 'aweg';

# Test non-local user
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user12'@'%' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user13'@'192.168.1.1' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user14'@'::2' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'user15'@'::ffff:192.168.1.1' IDENTIFIED BY 'aweg';

# Test alter/SET for base_user
--error ER_NOT_VALID_PASSWORD
ALTER USER 'base_user'@'127.0.0.1' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
SET PASSWORD FOR 'base_user'@'127.0.0.1' = 'awegh';

--error ER_NOT_VALID_PASSWORD
ALTER USER 'base_user'@'::1' IDENTIFIED BY 'aweg';
--error ER_NOT_VALID_PASSWORD
SET PASSWORD FOR 'base_user'@'::1' = 'awegh';

--echo # ----------------------- case 2 ------------------------------
# When we create a local internal user with weak password, even if the 
# password policy is STRONG, it should be accepted.
# Test IPV4.
SET @@global.validate_password.policy=STRONG;

# Test localhost
CREATE USER 'u0'@'localhost' IDENTIFIED BY '';
ALTER  USER 'u0'@'localhost' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'localhost' = 'awegh';
DROP USER 'u0'@'localhost';

# Test IPV4 loopback
CREATE USER 'u0'@'127.0.0.1' IDENTIFIED BY '';
ALTER  USER 'u0'@'127.0.0.1' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'127.0.0.1' = 'awegh';
DROP USER 'u0'@'127.0.0.1';

CREATE USER 'u0'@'127.0.0.2' IDENTIFIED BY '';
ALTER  USER 'u0'@'127.0.0.2' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'127.0.0.2' = 'awegh';
DROP USER 'u0'@'127.0.0.2';

# Test IPV6 loopback
CREATE USER 'u0'@'::1' IDENTIFIED BY '';
ALTER  USER 'u0'@'::1' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'::1' = 'awegh';
DROP USER 'u0'@'::1';

CREATE USER 'u0'@'0:0:0:0:0:0:0:1' IDENTIFIED BY '';
ALTER  USER 'u0'@'0:0:0:0:0:0:0:1' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'0:0:0:0:0:0:0:1' = 'awegh';
DROP USER 'u0'@'0:0:0:0:0:0:0:1';

CREATE USER 'u0'@'0000:0000:0000:0000:0000:0000:0000:0001' IDENTIFIED BY '';
ALTER  USER 'u0'@'0000:0000:0000:0000:0000:0000:0000:0001' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'0000:0000:0000:0000:0000:0000:0000:0001' = 'awegh';
DROP USER 'u0'@'0000:0000:0000:0000:0000:0000:0000:0001';

CREATE USER 'u0'@'::0001' IDENTIFIED BY '';
ALTER  USER 'u0'@'::0001' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'::0001' = 'awegh';
DROP USER 'u0'@'::0001';

CREATE USER 'u0'@'0:0:0:0:0::1' IDENTIFIED BY '';
ALTER  USER 'u0'@'0:0:0:0:0::1' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'0:0:0:0:0::1' = 'awegh';
DROP USER 'u0'@'0:0:0:0:0::1';

CREATE USER 'u0'@'::0.0.0.1' IDENTIFIED BY '';
ALTER  USER 'u0'@'::0.0.0.1' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'::0.0.0.1' = 'awegh';
DROP USER 'u0'@'::0.0.0.1';

# Test IPV4-mapped IPV6 loopback
CREATE USER 'u0'@'::ffff:127.0.0.1' IDENTIFIED BY '';
ALTER  USER 'u0'@'::ffff:127.0.0.1' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'::ffff:127.0.0.1' = 'awegh';
DROP USER 'u0'@'::ffff:127.0.0.1';

CREATE USER 'u0'@'::ffff:127.0.0.2' IDENTIFIED BY '';
ALTER  USER 'u0'@'::ffff:127.0.0.2' IDENTIFIED BY 'aweg';
SET PASSWORD FOR 'u0'@'::ffff:127.0.0.2' = 'awegh';
DROP USER 'u0'@'::ffff:127.0.0.2';

# A non-local internal user with weak password should be refused.
--error ER_NOT_VALID_PASSWORD
CREATE USER 'u1'@'%' IDENTIFIED BY '';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'u1'@'192.168.1.1' IDENTIFIED BY '';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'u1'@'::2' IDENTIFIED BY '';
--error ER_NOT_VALID_PASSWORD
CREATE USER 'u1'@'::ffff:192.168.1.1' IDENTIFIED BY '';

--echo # clean up after the test
DROP USER 'base_user'@'127.0.0.1';
DROP USER 'base_user'@'::1';
SET @@global.validate_password.policy = default; 
UNINSTALL COMPONENT "file://component_validate_password";






