--source include/paxos.inc
--source include/have_debug.inc

# IS_READABLE
# IS_LEADER
# IS_WRITEABLE
# NOT_IN_LEADER_TRANSFER
# NO_CLUSTER_CHANGED
# IS_IN_LEADER_TRANSFER
# IS_PAXOS_APPLING

--echo ############ check leader 
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
select @@ping_mode;

--echo ### check basic 

set @@ping_mode=IS_READABLE;
select @@ping_mode;

set @@ping_mode='IS_READABLE';
select @@ping_mode;

set @@ping_mode='IS_readable';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER,NO_CLUSTER_CHANGED';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER,NO_CLUSTER_CHANGED,IS_IN_LEADER_TRANSFER';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER,NO_CLUSTER_CHANGED,IS_IN_LEADER_TRANSFER,IS_PAXOS_APPLING';
select @@ping_mode;

set @@ping_mode=0;
select @@ping_mode;

set @@ping_mode=1;
select @@ping_mode;

set @@ping_mode=1;
select @@ping_mode;

set @@ping_mode=3;
select @@ping_mode;

set @@ping_mode=7;
select @@ping_mode;

set @@ping_mode=15;
select @@ping_mode;

set @@ping_mode=31;
select @@ping_mode;

set @@ping_mode=63;
select @@ping_mode;

set @@ping_mode=64;
select @@ping_mode;

--error ER_WRONG_VALUE_FOR_VAR
set @@ping_mode=243;
select @@ping_mode;

--error ER_WRONG_VALUE_FOR_VAR
set @@ping_mode=HAHA;
select @@ping_mode;

--error ER_WRONG_VALUE_FOR_VAR
set @@ping_mode='IS_READABLE,HAHA';
select @@ping_mode;

--error ER_WRONG_VALUE_FOR_VAR
set @@ping_mode='  IS_READABLE,  IS_LEADER  ';
select @@ping_mode;

set @@ping_mode=IS_READABLE;
select @@ping_mode;
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,IS_LEADER';
select @@ping_mode;
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE';
select @@ping_mode;
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER';
select @@ping_mode;
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER,NO_CLUSTER_CHANGED';
select @@ping_mode;
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER,NO_CLUSTER_CHANGED,IS_IN_LEADER_TRANSFER';
select @@ping_mode;
--error ER_PING_CHECK_FAILED
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER,NO_CLUSTER_CHANGED,IS_PAXOS_APPLING';
select @@ping_mode;
--error ER_PING_CHECK_FAILED
call dbms_proxy.ping();


set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER,NO_CLUSTER_CHANGED';
select @@ping_mode;
call dbms_proxy.ping();

--replace_result $PAXOS_PORT_2 PAXOS_PORT_2
eval call dbms_consensus.downgrade_follower("127.0.0.1:$PAXOS_PORT_2");
--sleep 5
select server_id, role from information_schema.alisql_cluster_global order by server_id;


select @@ping_mode;
--error ER_PING_CHECK_FAILED
call dbms_proxy.ping();
call dbms_proxy.ping();

--replace_result $PAXOS_PORT_2 PAXOS_PORT_2
eval call dbms_consensus.upgrade_learner("127.0.0.1:$PAXOS_PORT_2");
--sleep 5
select server_id, role from information_schema.alisql_cluster_global order by server_id;

select @@ping_mode;
--error ER_PING_CHECK_FAILED
call dbms_proxy.ping();
call dbms_proxy.ping();

--disconnect leader


--echo ############ check follower 
--connect (follower,127.0.0.1,root,,test,$MYPORT_2)
--connection follower
--source include/wait_apply_catchup.inc
select @@ping_mode;

--echo ### check basic 

set @@ping_mode=IS_READABLE;
select @@ping_mode;

set @@ping_mode='IS_READABLE';
select @@ping_mode;

set @@ping_mode='IS_readable';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER,NO_CLUSTER_CHANGED';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER,NO_CLUSTER_CHANGED,IS_IN_LEADER_TRANSFER';
select @@ping_mode;

set @@ping_mode='IS_READABLE,IS_LEADER,IS_WRITEABLE,NOT_IN_LEADER_TRANSFER,NO_CLUSTER_CHANGED,IS_IN_LEADER_TRANSFER,IS_PAXOS_APPLING';
select @@ping_mode;

set @@ping_mode=0;
select @@ping_mode;

set @@ping_mode=1;
select @@ping_mode;

set @@ping_mode=1;
select @@ping_mode;

set @@ping_mode=3;
select @@ping_mode;

set @@ping_mode=7;
select @@ping_mode;

set @@ping_mode=15;
select @@ping_mode;

set @@ping_mode=31;
select @@ping_mode;

set @@ping_mode=63;
select @@ping_mode;

set @@ping_mode=64;
select @@ping_mode;

--error ER_WRONG_VALUE_FOR_VAR
set @@ping_mode=243;
select @@ping_mode;

--error ER_WRONG_VALUE_FOR_VAR
set @@ping_mode=HAHA;
select @@ping_mode;

--error ER_WRONG_VALUE_FOR_VAR
set @@ping_mode='IS_READABLE,HAHA';
select @@ping_mode;

--error ER_WRONG_VALUE_FOR_VAR
set @@ping_mode='  IS_READABLE,  IS_LEADER  ';
select @@ping_mode;

set @@ping_mode=IS_READABLE;
select @@ping_mode;
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,IS_LEADER';
select @@ping_mode;
--error ER_PING_CHECK_FAILED
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,IS_WRITEABLE';
select @@ping_mode;
--error ER_PING_CHECK_FAILED
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,NOT_IN_LEADER_TRANSFER';
select @@ping_mode;
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,NO_CLUSTER_CHANGED';
select @@ping_mode;
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,IS_IN_LEADER_TRANSFER';
select @@ping_mode;
--error ER_PING_CHECK_FAILED
call dbms_proxy.ping();

set @@ping_mode='IS_READABLE,IS_PAXOS_APPLING';
select @@ping_mode;
call dbms_proxy.ping();

stop xpaxos_replication;

select @@ping_mode;
--error ER_PING_CHECK_FAILED
call dbms_proxy.ping();

start xpaxos_replication;

select @@ping_mode;
call dbms_proxy.ping();

--disconnect follower
