--source include/paxos.inc

--source include/not_valgrind.inc
--source include/not_windows.inc
#--source include/have_innodb.inc
--source include/have_binlog_format_row.inc
--source include/have_log_bin.inc

# connect 3 server. must have test database
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)

# wait leader and find who is leader
--connection conn1
--let $isleader=`select server_id from information_schema.alisql_cluster_local where role='leader'`
if ($isleader)
{
  --let $leader= $isleader
}

--connection conn2
--let $isleader=`select server_id from information_schema.alisql_cluster_local where role='leader'`
if ($isleader)
{
  --let $leader= $isleader
}

--connection conn3
--let $isleader=`select server_id from information_schema.alisql_cluster_local where role='leader'`
if ($isleader)
{
  --let $leader= $isleader
}

# test leader transfer
if ($leader == 1) 
{
  --connection conn1
}
if ($leader == 2) 
{
  --connection conn2
}
if ($leader == 3) 
{
  --connection conn3
}

#change consensus_leader to 1;
--replace_result $PAXOS_PORT_1 PAXOS_PORT_1

eval call dbms_consensus.change_leader("127.0.0.1:$PAXOS_PORT_1");

let $wait_condition= select role='Leader' from information_schema.alisql_cluster_local;
--source include/wait_condition.inc

--connection conn1
let $wait_condition= select role='Leader' from information_schema.alisql_cluster_local;
--source include/wait_condition.inc
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--connection conn2
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--connection conn3
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;

--connection conn1
#change consensus_leader to 2;
--replace_result $PAXOS_PORT_2 PAXOS_PORT_2
eval call dbms_consensus.change_leader("127.0.0.1:$PAXOS_PORT_2");

--connection conn2
let $wait_condition= select role='Leader' from information_schema.alisql_cluster_local;
--source include/wait_condition.inc

--connection conn1
--enable_reconnect
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--disable_reconnect
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
--connection conn2
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--connection conn3
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;

--connection conn2
#change consensus_leader to 3;
--replace_result $PAXOS_PORT_3 PAXOS_PORT_3
eval call dbms_consensus.change_leader("127.0.0.1:$PAXOS_PORT_3");

--connection conn3
let $wait_condition= select role='Leader' from information_schema.alisql_cluster_local;
--source include/wait_condition.inc

--sleep 10
--connection conn1
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--connection conn2
--enable_reconnect
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--disable_reconnect
--connection conn3
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;

--connection conn3
#change consensus_leader to 1;
--replace_result $PAXOS_PORT_1 PAXOS_PORT_1
eval call dbms_consensus.change_leader("127.0.0.1:$PAXOS_PORT_1");

--connection conn1
let $wait_condition= select role='Leader' from information_schema.alisql_cluster_local;
--source include/wait_condition.inc

--connection conn1
--enable_reconnect
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--disable_reconnect
--connection conn2
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--connection conn3
--enable_reconnect
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--disable_reconnect



# wait leader and find who is leader
--connection conn1
--let $isleader=`select server_id from information_schema.alisql_cluster_local where role='leader'`
if ($isleader)
{
  --let $leader= $isleader
}

--connection conn2
--let $isleader=`select server_id from information_schema.alisql_cluster_local where role='leader'`
if ($isleader)
{
  --let $leader= $isleader
}

--connection conn3
--let $isleader=`select server_id from information_schema.alisql_cluster_local where role='leader'`
if ($isleader)
{
  --let $leader= $isleader
}

# test leader transfer
if ($leader == 1) 
{
  --connection conn1
}
if ($leader == 2) 
{
  --connection conn2
}
if ($leader == 3) 
{
  --connection conn3
}

--source include/kill_and_restart_mysqld.inc


--connection conn1
--enable_reconnect
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
set global consensus_force_promote=1;
--source include/wait_follower_catchup.inc
--disable_reconnect
--connection conn2
--enable_reconnect
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--disable_reconnect
--connection conn3
--enable_reconnect
--replace_column 1 # 2 # 3 # 4 # 5 # 6 # 7 # 8 # 9 #
select * from information_schema.CONSENSUS_HA_HISTORY order by FINISH_TIMESTAMP desc limit 1;
--disable_reconnect

--sleep 5






