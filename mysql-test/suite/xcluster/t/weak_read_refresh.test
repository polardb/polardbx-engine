--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
set global consensus_weak_read_refresh_timeout=-1;
set global consensus_optimistic_heartbeat=0;
--disconnect leader
--sleep 5

--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
create database if not exists d1;
drop table if exists d1.t0;
create table d1.t0(c1 int , c2 varchar(100));
--source include/wait_follower_catchup.inc
--disconnect leader

--connect (f1,127.0.0.1,root,,test,$MYPORT_2)
--connection f1
set global consensus_force_promote=1;
--source include/wait_follower_catchup.inc
--disconnect f1

--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
