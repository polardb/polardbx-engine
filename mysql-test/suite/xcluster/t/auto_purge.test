--source include/paxos.inc
--source include/have_debug.inc

--echo ############ init and add learner
let $learner_base_port = query_get_value("select $MYPORT_1+50 as c1", c1, 1);
--source include/start_new_learner.inc

--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
#add consensus_learner $learner_cluster_info;
--replace_result $learner_cluster_info learner_cluster_info
eval call dbms_consensus.add_learner($learner_cluster_info);
#change consensus_node 100 consensus_learner_source 1;
--replace_result $learner_cluster_info learner_cluster_info $PAXOS_PORT_1 PAXOS_PORT_1
eval call dbms_consensus.configure_learner($learner_cluster_info, "127.0.0.1:$PAXOS_PORT_1");
--sleep 5
select server_id, role, learner_source from information_schema.alisql_cluster_global;
--disconnect leader


--echo ############ check follower before
--connect (follower,127.0.0.1,root,,test,$MYPORT_2)
--connection follower
--source include/wait_apply_catchup.inc

--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

stop xpaxos_replication;
SET @@global.binlog_expire_logs_seconds=1;

--disconnect follower

--echo ############ check logger before
--connect (logger,127.0.0.1,root,,test,$MYPORT_3)
--connection logger
--source include/wait_apply_catchup.inc

--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

SET @@global.binlog_expire_logs_seconds=1;

--disconnect logger

--echo ############ check learner before
--connect (learner,127.0.0.1,root,,test,$learner_port)
--connection learner
--source include/wait_apply_catchup.inc

--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

stop xpaxos_replication;
SET @@global.binlog_expire_logs_seconds=1;

--disconnect learner


--echo ############ check leader before
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader

create table t1(c1 int auto_increment primary key, c2 blob);
insert into t1 (c2) values(repeat('#', 5000));
--sleep 1
insert into t1 (c2) values(repeat('#', 5000));

--sleep 1
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

SET @@global.binlog_expire_logs_seconds=1;

--disconnect leader



--echo ############ check follower before2
--connect (follower,127.0.0.1,root,,test,$MYPORT_2)
--connection follower
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;
--disconnect follower

--echo ############ check logger before2
--connect (logger,127.0.0.1,root,,test,$MYPORT_3)
--connection logger
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;
--disconnect logger

--echo ############ check learner before2
--connect (learner,127.0.0.1,root,,test,$learner_port)
--connection learner
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;
--disconnect learner


--echo ############ check leader after
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

SET SESSION debug="+d,force_rotate";

--sleep 1
insert into t1 (c2) values(repeat('#', 5000));
--sleep 1
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

--sleep 1
insert into t1 (c2) values(repeat('#', 5000));
--sleep 1
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

--sleep 1
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

SET @@global.binlog_expire_logs_seconds=default;
--disconnect leader



--echo ############ check follower after
--connect (follower,127.0.0.1,root,,test,$MYPORT_2)
--connection follower

--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

start xpaxos_replication;
--source include/wait_apply_catchup.inc
sleep 1;

--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

--disconnect follower


--echo ############ check logger after
--connect (logger,127.0.0.1,root,,test,$MYPORT_3)
--connection logger
set global consensus_disable_election=ON;

--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

# Turn off disable_election so node3 can vote in the upcoming leader election
# (after node1 shutdown). Without this, node3 rejects RequestVote messages
# and node2 can never form a majority to become the new leader.
set global consensus_disable_election=OFF;
--disconnect logger


--echo ############ check learner after
--connect (learner,127.0.0.1,root,,test,$learner_port)
--connection learner

--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

start xpaxos_replication;
--source include/wait_apply_catchup.inc
sleep 1;

--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

--disconnect learner



--echo ############ check leader after2
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
--enable_reconnect
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--shutdown_server 0
--sleep 20
--source include/wait_until_disconnected.inc


--echo ############ check follower after2
--connect (follower,127.0.0.1,root,,test,$MYPORT_2)
--connection follower
--enable_reconnect
--source include/wait_until_connected_again.inc

SET SESSION debug="+d,force_rotate";

insert into t1 (c2) values(repeat('#', 5000));
--sleep 1
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

--sleep 1
insert into t1 (c2) values(repeat('#', 5000));
--sleep 1

--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

SET @@global.binlog_expire_logs_seconds=default;
--disconnect follower


--echo ############ check logger after2
--connect (logger,127.0.0.1,root,,test,$MYPORT_3)
--connection logger
--source include/wait_apply_catchup.inc
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

SET @@global.binlog_expire_logs_seconds=default;
set global consensus_disable_election=OFF;
--disconnect logger

--echo ############ check learner after2
--connect (learner,127.0.0.1,root,,test,$learner_port)
--connection learner
--source include/wait_apply_catchup.inc
--replace_column 2 # 3 #
--replace_regex /master-bin\.\d{6}/master-bin.NNNNNN/
show consensus logs;

SET @@global.binlog_expire_logs_seconds=default;
--disconnect learner

--echo ############ check leader after3
--connection leader
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again_old.inc
--disable_reconnect

--connection leader
set global consensus_force_promote=1;
--source include/wait_until_connected_again.inc
--source include/wait_follower_catchup.inc
--disconnect leader

--echo ############ cleanup
--source include/stop_new_learner.inc
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
--replace_result $learner_cluster_info learner_cluster_info
eval call dbms_consensus.drop_learner($learner_cluster_info);
drop table t1;
--source include/wait_follower_catchup.inc
--disconnect leader
