--source include/paxos.inc
--source include/have_debug.inc

--echo ############ init and add learner
let $learner_base_port = query_get_value("select $MYPORT_1+50 as c1", c1, 1);
--source include/start_new_learner.inc
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
#add consensus_learner $learner_cluster_info;
--replace_result $learner_cluster_info learner_cluster_info
eval call dbms_consensus.add_learner($learner_cluster_info);
#change consensus_node 100 consensus_learner_source 1;
--replace_result $learner_cluster_info learner_cluster_info $PAXOS_PORT_1 PAXOS_PORT_1
eval call dbms_consensus.configure_learner($learner_cluster_info, "127.0.0.1:$PAXOS_PORT_1");
--sleep 5
select server_id, role, learner_source from information_schema.alisql_cluster_global;
--disconnect leader


--echo ############ check follower before
--connect (follower,127.0.0.1,root,,test,$MYPORT_2)
--connection follower
--source include/wait_apply_catchup.inc

set force_revise=1;
set sql_log_bin=0; 
flush relay logs;
--replace_column 2 # 3 #
show consensus logs;

stop xpaxos_replication;
SET @@global.binlog_expire_logs_seconds=1;

--disconnect follower

--echo ############ check learner before
--connect (learner,127.0.0.1,root,,mysql,$learner_port)
--connection learner
--source include/wait_apply_catchup.inc

set force_revise=1;
set sql_log_bin=0; 
flush relay logs;
--replace_column 2 # 3 #
show consensus logs;

stop xpaxos_replication;
SET @@global.binlog_expire_logs_seconds=1;

--disconnect learner


--echo ############ check leader before
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader

create table t1(id int);
insert into t1 values (1);
insert into t1 values (2);
flush logs;

--sleep 1
--replace_column 2 # 3 #
show consensus logs;

SET @@global.binlog_expire_logs_seconds=1;

--disconnect leader



--echo ############ check follower before2
--connect (follower,127.0.0.1,root,,test,$MYPORT_2)
--connection follower
set force_revise=1;
set sql_log_bin=0; 
flush relay logs;
--replace_column 2 # 3 #
show consensus logs;
--disconnect follower

--echo ############ check learner before2
--connect (learner,127.0.0.1,root,,mysql,$learner_port)
--connection learner
set force_revise=1;
set sql_log_bin=0; 
flush relay logs;
--replace_column 2 # 3 #
show consensus logs;
--disconnect learner


--echo ############ check leader after
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
--replace_column 2 # 3 #
show consensus logs;

SET SESSION debug="+d,force_rotate";

--sleep 1
insert into t1 values(6);
--sleep 1
--replace_column 2 # 3 #
show consensus logs;

--sleep 1
insert into t1 values(7);
--sleep 1
--replace_column 2 # 3 #
show consensus logs;

--sleep 1
flush logs;
--replace_column 2 # 3 #
show consensus logs;

SET @@global.binlog_expire_logs_seconds=default;
--disconnect leader



--echo ############ check follower after
--connect (follower,127.0.0.1,root,,mysql,$MYPORT_2)
--connection follower

--replace_column 2 # 3 #
show consensus logs;

start xpaxos_replication;
--source include/wait_apply_catchup.inc
sleep 1;
set force_revise=1;
set sql_log_bin=0; 
flush relay logs;

--replace_column 2 # 3 #
show consensus logs;

--disconnect follower


--echo ############ check learner after
--connect (learner,127.0.0.1,root,,mysql,$learner_port)
--connection learner

--replace_column 2 # 3 #
show consensus logs;

start xpaxos_replication;
--source include/wait_apply_catchup.inc
sleep 1;
set force_revise=1;
set sql_log_bin=0; 
flush relay logs;

--replace_column 2 # 3 #
show consensus logs;

--disconnect learner



--echo ############ check leader after2
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
insert into t1 values(8);
insert into t1 values(9);
sleep 1;
--disconnect leader



--echo ############ check follower after2
--connect (follower,127.0.0.1,root,,mysql,$MYPORT_2)
--connection follower
--source include/wait_apply_catchup.inc
--replace_column 2 # 3 #
show consensus logs;

SET @@global.binlog_expire_logs_seconds=default;
--disconnect follower


--echo ############ check learner after2
--connect (learner,127.0.0.1,root,,mysql,$learner_port)
--connection learner
--source include/wait_apply_catchup.inc
--replace_column 2 # 3 #
show consensus logs;

SET @@global.binlog_expire_logs_seconds=default;
--disconnect learner


--echo ############ cleanup
--source include/stop_new_learner.inc
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
--replace_result $learner_cluster_info learner_cluster_info
eval call dbms_consensus.drop_learner($learner_cluster_info);
drop table t1;
--source include/wait_follower_catchup.inc
--disconnect leader
