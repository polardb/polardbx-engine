--source include/have_debug.inc
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
let $MYPORT_CONSENSUS_3 = query_get_value("select $MYPORT_3+40 as c1", c1, 1);
let $MYPORT_CONSENSUS_2 = query_get_value("select $MYPORT_2+40 as c1", c1, 1);

--connection conn2
set global consensus_auto_leader_transfer=ON;
--connection conn3
set global consensus_auto_leader_transfer=ON;

--connection conn1
create table test.t1(id int);
insert into test.t1 values(1);
xa start 'x1';
insert into test.t1 values(1);
xa end 'x1';
xa prepare 'x1';
select count(*) from test.t1;
--sleep 2

--connection conn2
--source include/wait_apply_catchup.inc

--disable_warnings

select count(*) from test.t1;
stop xpaxos_replication;

--connection conn3
--source include/wait_apply_catchup.inc
stop xpaxos_replication;
select count(*) from test.t1;

--connection conn1
xa commit 'x1';


--echo "# case 1 ha to Follower2 succ"
--connection conn1

#change consensus_leader to 2;
--replace_result $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2
eval call dbms_consensus.change_leader("127.0.0.1:$MYPORT_CONSENSUS_2"); 

--connection conn2
--sleep 5
select role from information_schema.alisql_cluster_local;
--error ER_CONSENSUS_LEADER_NOT_ALLOWED
insert into test.t1 values(1);
select count(*) from test.t1;

start xpaxos_replication;
--sleep 10
select role from information_schema.alisql_cluster_local;
select count(*) from test.t1;


--echo "# case 1 ha to Follower3 failed"

--connection conn2
#change consensus_node 3 consensus_force_sync false consensus_election_weight 1;
--replace_result $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2
eval call dbms_consensus.configure_follower("127.0.0.1:$MYPORT_CONSENSUS_2", 1, 0); 

#change consensus_leader to 3;
--replace_result $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
eval call dbms_consensus.change_leader("127.0.0.1:$MYPORT_CONSENSUS_3");

--connection conn3
--sleep 5
select role from information_schema.alisql_cluster_local;

--sleep 15
select role from information_schema.alisql_cluster_local;
start xpaxos_replication;

--disconnect conn1
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
select role from information_schema.alisql_cluster_local;
#change consensus_node 2 consensus_force_sync false consensus_election_weight 5;
--replace_result $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2
eval call dbms_consensus.configure_follower("127.0.0.1:$MYPORT_CONSENSUS_2", 5, 0);
drop table test.t1;
--source include/wait_follower_catchup.inc
--disconnect conn1

--enable_warnings
