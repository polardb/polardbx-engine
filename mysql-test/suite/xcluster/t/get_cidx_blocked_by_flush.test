#
# Test that dbms_consensus.get_cidx() blocks when another thread holds LOCK_log
# in the flush stage, and returns the incremented index after flush completes.
#
# Flow:
# 1. Single-node cluster (both threads connect to leader)
# 2. Thread 1: insert with debug_sync to block at flush stage (holds LOCK_log)
# 3. Thread 2: call get_cidx - should block waiting for LOCK_log
# 4. Thread 1: release flush - get_cidx unblocks and returns incremented index
#

--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc

--source include/paxos.inc

# Ensure leader is on node 1
--replace_result $PAXOS_PORT_1 PAXOS_PORT_1
eval call dbms_consensus.change_leader("127.0.0.1:$PAXOS_PORT_1");
--source include/wait_follower_catchup.inc

# All connections to leader (single-node semantics)
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connect (conn2,127.0.0.1,root,,test,$MYPORT_1)
--connect (conn3,127.0.0.1,root,,test,$MYPORT_1)

--connection conn1
use test;
create table t1 (id int);
insert into t1 values (1);

--echo # Get initial index before the blocking insert
--connection conn1
let $cidx_before = query_get_value(call dbms_consensus.get_cidx(), CIDX, 1);

--echo # Thread 1: Start insert, block at flush stage (holds LOCK_log)
--connection conn1
SET debug_sync = "flush_stage_holds_lock SIGNAL flush_started WAIT_FOR flush_continue";
--send insert into t1 values (2)

--echo # Thread 2: Wait for flush to start, then call get_cidx (will block on LOCK_log)
--connection conn2
SET debug_sync = "now WAIT_FOR flush_started";
SET debug_sync = "get_cidx_acquiring_lock SIGNAL get_cidx_reached_lock_point";
--send call dbms_consensus.get_cidx()

--echo # Thread 3: Wait for get_cidx to reach lock (proves it is blocked), then release flush
--connection conn3
SET debug_sync = "now WAIT_FOR get_cidx_reached_lock_point";
SET debug_sync = "now SIGNAL flush_continue";

--echo # Reap both: conn1 (insert) and conn2 (get_cidx)
--connection conn1
--reap

# Suppress conn2's reap output: the absolute CIDX is non-deterministic when other
# tests share the cluster; we verify the increment via assert.inc below instead.
--connection conn2
--disable_result_log
--reap
--enable_result_log

--echo # Verify: get_cidx returned index after the insert (index should have incremented)
--connection conn1
let $cidx_after = query_get_value(call dbms_consensus.get_cidx(), CIDX, 1);
--let $assert_text = CIDX should have incremented after the blocked insert flushed
--let $assert_cond = $cidx_after > $cidx_before
--source include/assert.inc

--connection conn1
drop table t1;
--source include/wait_follower_catchup.inc

--echo #
--echo # Call get_cidx on leader, follower, learner, logger (no crash)
--echo #

--connection conn1
--replace_column 1 #
call dbms_consensus.get_cidx();

--connection conn2
--connect (conn_follower,127.0.0.1,root,,test,$MYPORT_2)
--connection conn_follower
--replace_column 1 #
call dbms_consensus.get_cidx();

--connection conn1
let $learner_base_port = query_get_value("select $MYPORT_1+50 as c1", c1, 1);
--source include/start_new_learner.inc

--connection conn1
--replace_result $learner_cluster_info learner_cluster_info
eval call dbms_consensus.add_learner($learner_cluster_info);
--sleep 5

--connect (conn_learner,127.0.0.1,root,,test,$learner_port)
--connection conn_learner
--replace_column 1 #
call dbms_consensus.get_cidx();

--connection conn1
--replace_result $learner_cluster_info learner_cluster_info
eval call dbms_consensus.drop_learner($learner_cluster_info);
--source include/stop_new_learner.inc

--connection conn1
--replace_result $PAXOS_PORT_3 PAXOS_PORT_3
eval call dbms_consensus.change_leader("127.0.0.1:$PAXOS_PORT_3");

--connect (conn_leader3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn_leader3
--source include/wait_follower_catchup.inc

# Logger: stop replication on a follower (node 2), then call get_cidx
--connect (conn_logger,127.0.0.1,root,,test,$MYPORT_2)
--connection conn_logger
stop xpaxos_replication;
--replace_column 1 #
call dbms_consensus.get_cidx();
--disable_warnings
start xpaxos_replication;
--enable_warnings

--connection conn_leader3
--replace_result $PAXOS_PORT_1 PAXOS_PORT_1
eval call dbms_consensus.change_leader("127.0.0.1:$PAXOS_PORT_1");

--connection conn1
--enable_reconnect
--source include/wait_follower_catchup.inc
