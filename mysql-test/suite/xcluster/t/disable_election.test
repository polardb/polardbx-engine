--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn3
set global consensus_disable_election=1;
--sleep 2

--disconnect conn1
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
insert into test.t1 values(1);
select count(*) from test.t1;
--source include/wait_follower_catchup.inc
select SERVER_ID,ROLE,ELECTION_WEIGHT,INSTANCE_TYPE,DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_GLOBAL;
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
select SERVER_ID, CURRENT_LEADER, ROLE, SERVER_READY_FOR_RW, DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_local;

--disconnect conn2
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connection conn2
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
select SERVER_ID, CURRENT_LEADER, ROLE, SERVER_READY_FOR_RW, DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_local;

--disconnect conn3
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn3
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
select SERVER_ID, CURRENT_LEADER, ROLE, SERVER_READY_FOR_RW, DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_local;

--echo ###################### CASE 5.1: change_leader  node1(leader,disable_election=1) -> node2(follower,disable_election=1),  expected: succeeds

--disconnect conn1
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
--replace_result $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2
eval call dbms_consensus.change_leader("127.0.0.1:$MYPORT_CONSENSUS_2");
--sleep 8

--echo #### check target: node2 -> leader(disable_election=1)
--disconnect conn2
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connection conn2
insert into test.t1 values(1);
select count(*) from test.t1;
--source include/wait_follower_catchup.inc
select SERVER_ID,ROLE,ELECTION_WEIGHT,INSTANCE_TYPE,DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_GLOBAL;
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
select SERVER_ID, CURRENT_LEADER, ROLE, SERVER_READY_FOR_RW, DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_local;

--echo #### check self:   node1 -> follower(disable_election=1)
--disconnect conn1
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
select SERVER_ID, CURRENT_LEADER, ROLE, SERVER_READY_FOR_RW, DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_local;

--echo #### check other:  node3 -> follower(disable_election=1)
--disconnect conn3
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn3
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
select SERVER_ID, CURRENT_LEADER, ROLE, SERVER_READY_FOR_RW, DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_local;

--echo ###################### CASE 5.1 rollback: restore node1 as leader for case 5.2

--disconnect conn2
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connection conn2
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1
eval call dbms_consensus.change_leader("127.0.0.1:$MYPORT_CONSENSUS_1");
--sleep 8

--disconnect conn1
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
insert into test.t1 values(1);
select count(*) from test.t1;
--source include/wait_follower_catchup.inc

--echo ###################### CASE 5.2: force_promote  node2(follower,disable_election=1),  expected: node2 becomes leader

--disconnect conn2
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connection conn2
set global consensus_force_promote=1;
--sleep 7

--echo #### check self:   node2 -> leader(disable_election=1, force_promote succeeded)
--disconnect conn2
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connection conn2
insert into test.t1 values(1);
select count(*) from test.t1;
--source include/wait_follower_catchup.inc
select SERVER_ID,ROLE,ELECTION_WEIGHT,INSTANCE_TYPE,DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_GLOBAL;
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
select SERVER_ID, CURRENT_LEADER, ROLE, SERVER_READY_FOR_RW, DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_local;

--echo #### check other:  node1 -> follower(disable_election=1)
--disconnect conn1
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
select SERVER_ID, CURRENT_LEADER, ROLE, SERVER_READY_FOR_RW, DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_local;

--echo #### check other:  node3 -> follower(disable_election=1)
--disconnect conn3
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn3
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
select SERVER_ID, CURRENT_LEADER, ROLE, SERVER_READY_FOR_RW, DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_local;

--echo ###################### CASE 5.2 rollback: restore node1 as leader

--disconnect conn2
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connection conn2
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1
eval call dbms_consensus.change_leader("127.0.0.1:$MYPORT_CONSENSUS_1");
--sleep 8

--disconnect conn1
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
set global consensus_disable_election=0;

--disconnect conn2
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connection conn2
set global consensus_disable_election=0;

--disconnect conn3
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn3
set global consensus_disable_election=0;
--sleep 2



--disconnect conn1
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
drop table test.t1;
--source include/wait_follower_catchup.inc

