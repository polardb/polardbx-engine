--disconnect conn3
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn3
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
select SERVER_ID, CURRENT_LEADER, ROLE, SERVER_READY_FOR_RW, DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_local;

--echo ###################### CASE 1.1: change_leader  node1(leader,disable_election=1) -> node2(follower)

--disconnect conn1
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
--replace_result $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2
eval call dbms_consensus.change_leader("127.0.0.1:$MYPORT_CONSENSUS_2");
--sleep 8

--echo #### check target: node2 -> leader
--disconnect conn2
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connection conn2
insert into test.t1 values(1);
select count(*) from test.t1;
--source include/wait_follower_catchup.inc
select SERVER_ID,ROLE,ELECTION_WEIGHT,INSTANCE_TYPE,DISABLE_ELECTION from information_schema.ALISQL_CLUSTER_GLOBAL;
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
