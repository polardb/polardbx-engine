#
# TODO may need more check
#
--source include/paxos.inc

select SERVER_ID,ROLE,FORCE_SYNC,ELECTION_WEIGHT from information_schema.alisql_cluster_global;
#CHANGE CONSENSUS_NODE 1 CONSENSUS_FORCE_SYNC true CONSENSUS_ELECTION_WEIGHT 9;

--replace_result $PAXOS_PORT_1 PAXOS_PORT_1 $PAXOS_PORT_2 PAXOS_PORT_2 $PAXOS_PORT_3 PAXOS_PORT_3
eval call dbms_consensus.configure_followers("127.0.0.1:$PAXOS_PORT_1", 9, 1);
select SERVER_ID,ROLE,FORCE_SYNC,ELECTION_WEIGHT from information_schema.alisql_cluster_global;

--replace_result $PAXOS_PORT_1 PAXOS_PORT_1 $PAXOS_PORT_2 PAXOS_PORT_2 $PAXOS_PORT_3 PAXOS_PORT_3
eval call dbms_consensus.configure_followers("127.0.0.1:$PAXOS_PORT_1", 9, 0, "127.0.0.1:$PAXOS_PORT_2", 7, 1);
select SERVER_ID,ROLE,FORCE_SYNC,ELECTION_WEIGHT from information_schema.alisql_cluster_global;

--replace_result $PAXOS_PORT_1 PAXOS_PORT_1 $PAXOS_PORT_2 PAXOS_PORT_2 $PAXOS_PORT_3 PAXOS_PORT_3
eval call dbms_consensus.configure_followers("127.0.0.1:$PAXOS_PORT_1", 8, 1, "127.0.0.1:$PAXOS_PORT_2", 7, 1, "127.0.0.1:$PAXOS_PORT_3", 5, 0);
select SERVER_ID,ROLE,FORCE_SYNC,ELECTION_WEIGHT from information_schema.alisql_cluster_global;

--replace_result $PAXOS_PORT_1 PAXOS_PORT_1 $PAXOS_PORT_2 PAXOS_PORT_2 $PAXOS_PORT_3 PAXOS_PORT_3
--error ER_SP_WRONG_NO_OF_ARGS
eval call dbms_consensus.configure_followers("127.0.0.1:$PAXOS_PORT_1", 9, 1, "127.0.0.1:$PAXOS_PORT_1", 9, 1, "127.0.0.1:$PAXOS_PORT_3", 4);

--replace_result $PAXOS_PORT_1 PAXOS_PORT_1 $PAXOS_PORT_2 PAXOS_PORT_2 $PAXOS_PORT_3 PAXOS_PORT_3
--error ER_SP_WRONG_NO_OF_ARGS
eval call dbms_consensus.configure_followers("127.0.0.1:$PAXOS_PORT_1", 7, 1, "127.0.0.1:$PAXOS_PORT_2", 5, 1, "127.0.0.1:$PAXOS_PORT_3");

--replace_result $PAXOS_PORT_1 PAXOS_PORT_1 $PAXOS_PORT_2 PAXOS_PORT_2 $PAXOS_PORT_3 PAXOS_PORT_3
eval call dbms_consensus.configure_followers("127.0.0.1:$PAXOS_PORT_1", 7, 1, "127.0.0.1:$PAXOS_PORT_2", 5, 1, "127.0.0.1:$PAXOS_PORT_1", 9, 1, "127.0.0.1:$PAXOS_PORT_2", 9, 1);
select SERVER_ID,ROLE,FORCE_SYNC,ELECTION_WEIGHT from information_schema.alisql_cluster_global;

--replace_result $PAXOS_PORT_1 PAXOS_PORT_1 $PAXOS_PORT_2 PAXOS_PORT_2 $PAXOS_PORT_3 PAXOS_PORT_3
eval call dbms_consensus.configure_followers("127.0.0.1:$PAXOS_PORT_1", 7, 1, "127.0.0.1:$PAXOS_PORT_2", 5, 1, "127.0.0.1:$PAXOS_PORT_1", 9, 1, "127.0.0.1:$PAXOS_PORT_2", 9, 1,  "127.0.0.1:$PAXOS_PORT_3", 1, 0);
select SERVER_ID,ROLE,FORCE_SYNC,ELECTION_WEIGHT from information_schema.alisql_cluster_global;

--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
#change consensus_leader to 3;
--replace_result $PAXOS_PORT_3 PAXOS_PORT_3
eval call dbms_consensus.change_leader("127.0.0.1:$PAXOS_PORT_3");
--sleep 1
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn3
select role from information_schema.alisql_cluster_local;

--disconnect conn3
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn3
select role from information_schema.alisql_cluster_local;

--sleep 6
--disconnect conn3
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn3
select role from information_schema.alisql_cluster_local;

--sleep 6
--disconnect conn3
--connect (conn3,127.0.0.1,root,,test,$MYPORT_3)
--connection conn3
select role from information_schema.alisql_cluster_local;

--connect (conn1_1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1_1
let $wait_condition= select count(*)=1 from information_schema.alisql_cluster_local where role='leader';
--source include/wait_condition.inc
--sleep 1
select role from information_schema.alisql_cluster_local;

--replace_result $PAXOS_PORT_1 PAXOS_PORT_1 $PAXOS_PORT_2 PAXOS_PORT_2 $PAXOS_PORT_3 PAXOS_PORT_3
eval call dbms_consensus.configure_followers("127.0.0.1:$PAXOS_PORT_1", 5, 0, "127.0.0.1:$PAXOS_PORT_2", 5, 0, "127.0.0.1:$PAXOS_PORT_3", 5, 0);
--source include/wait_follower_catchup.inc
select SERVER_ID,ROLE,FORCE_SYNC,ELECTION_WEIGHT from information_schema.alisql_cluster_global;
