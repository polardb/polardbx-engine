--disable_query_log
call mtr.add_suppression('\\[Warning\\] .*');
--enable_query_log

--disable_warnings

let $learner_base_port = query_get_value("select $MYPORT_1+50 as c1", c1, 1);
--source include/start_new_learner.inc

--echo # connect leader
--connect (leader,127.0.0.1,root,,test,$MYPORT_1)
--connection leader
--replace_result $learner_cluster_info learner_cluster_info
eval call dbms_consensus.add_learner($learner_cluster_info);
--sleep 5
select count(*) from information_schema.alisql_cluster_global where role='LEARNER';
create database aaa;
use aaa;
create table t (id int);
insert into t values(1);

let $learner_port_1 = query_get_value("select $MYPORT_1+50 as c1", c1, 1);
let $learner_info_1 = query_get_value("select IP_PORT from information_schema.alisql_cluster_global where role='LEARNER'", IP_PORT, 1);


let $learner_base_port = query_get_value("select $MYPORT_1+51 as c1", c1, 1);
--source include/start_new_learner.inc

--replace_result $learner_cluster_info learner_cluster_info
eval call dbms_consensus.add_learner($learner_cluster_info);
# wait learner get log
--sleep 5
select count(*) from information_schema.alisql_cluster_global where role='LEARNER';

let $learner_port_2 = query_get_value("select $MYPORT_1+51 as c1", c1, 1);
let $learner_info_2 = query_get_value("select IP_PORT from information_schema.alisql_cluster_global where role='LEARNER' order by SERVER_ID", IP_PORT, 2);

--connect (learner2,127.0.0.1,root,,test,$learner_port_2)
--connection learner2
stop xpaxos_replication;
--disconnect learner2

--connection leader
--replace_result $learner_info_1 learner_info_1
eval call dbms_consensus.drop_learner("$learner_info_1");

--replace_result $learner_info_2 learner_info_2
eval call dbms_consensus.drop_learner("$learner_info_2");
--sleep 5
select count(*) from information_schema.alisql_cluster_global where role='LEARNER';


--connect (learner,127.0.0.1,root,,test,$learner_port_1)
--connection learner
eval call dbms_consensus.force_single_mode();

--replace_result $learner_info_2 learner_info_2
eval call dbms_consensus.add_learner("$learner_info_2");
--sleep 5
--replace_result $learner_info_2 learner_info_2
eval call dbms_consensus.upgrade_learner("$learner_info_2");

--sleep 5
select count(*) from information_schema.alisql_cluster_global where role='FOLLOWER';

--connect (learner2,127.0.0.1,root,,test,$learner_port_2)
--connection learner2
start xpaxos_replication;


#create master slave replication

--connection leader
--let $slave_host_id= query_get_value("show slave hosts", Server_id, 1)
--echo "slave_host_id":$slave_host_id

create user rep identified with mysql_native_password by '123456';
grant replication slave on *.* to rep;

--connection learner
--error ER_SLAVE_CHANNEL_DOES_NOT_EXIST
stop slave for channel 'aaa';
--error ER_SLAVE_CHANNEL_DOES_NOT_EXIST
reset slave all for channel 'aaa';
--replace_result $MYPORT_1 MYPORT_1
eval change master to master_host = '127.0.0.1', master_port = $MYPORT_1,  master_user = 'rep', master_password = '123456',   master_auto_position=1  for channel 'aaa';

--let $io_running= query_get_value("show slave status for channel 'aaa'", Slave_IO_Running, 1)
--let $sql_running= query_get_value("show slave status for channel 'aaa'", Slave_SQL_Running, 1)
--echo "io_running":$io_running,"sql_running":$sql_running
--let $io_running= query_get_value("show slave status for channel 'aaa'", Slave_IO_Running, 1)
--let $sql_running= query_get_value("show slave status for channel 'aaa'", Slave_SQL_Running, 1)
--echo "io_running":$io_running,"sql_running":$sql_running
start slave for channel 'aaa';
--let $io_running= query_get_value("show slave status for channel 'aaa'", Slave_IO_Running, 1)
--let $sql_running= query_get_value("show slave status for channel 'aaa'", Slave_SQL_Running, 1)
--echo "io_running":$io_running,"sql_running":$sql_running


--connection leader
drop database if exists d1;
create database if not exists d1;
drop table if exists d1.t0;
create table d1.t0(c1 int , c2 varchar(100));
insert into d1.t0 values(3, "ddddddddddddddddddddddddddddddddddddddddddddddddddd");
select * from d1.t0;
sleep 5;


--connection learner
--let $io_running= query_get_value("show slave status for channel 'aaa'", Slave_IO_Running, 1)
--let $sql_running= query_get_value("show slave status for channel 'aaa'", Slave_SQL_Running, 1)
--echo "io_running":$io_running,"sql_running":$sql_running
select * from d1.t0;
--replace_result $learner_info_2 learner_info_2
eval call dbms_consensus.change_leader("$learner_info_2");
--sleep 5

--disconnect learner

--connect (learner,127.0.0.1,root,,test,$learner_port_1)
--connection learner
--let $io_running= query_get_value("show slave status for channel 'aaa'", Slave_IO_Running, 1)
--let $sql_running= query_get_value("show slave status for channel 'aaa'", Slave_SQL_Running, 1)
--echo "io_running":$io_running,"sql_running":$sql_running

--error ER_CONSENSUS_FOLLOWER_NOT_ALLOWED
stop slave for channel 'aaa';
--error ER_CONSENSUS_FOLLOWER_NOT_ALLOWED
start slave for channel 'aaa';
reset slave all for channel 'aaa';

--replace_result $MYPORT_1 MYPORT_1
--error ER_CONSENSUS_FOLLOWER_NOT_ALLOWED
eval change master to master_host = '127.0.0.1', master_port = $MYPORT_1,  master_user = 'rep', master_password = '123456',   master_auto_position=1  for channel 'aaa';

--error ER_SLAVE_CHANNEL_DOES_NOT_EXIST
show slave status for channel 'aaa';

--disconnect learner2
--connect (learner2,127.0.0.1,root,,test,$learner_port_2)
--connection learner2
--error ER_SLAVE_CHANNEL_DOES_NOT_EXIST
show slave status for channel 'aaa';

--error ER_SLAVE_CHANNEL_DOES_NOT_EXIST
stop slave for channel 'aaa';
--error ER_SLAVE_CHANNEL_DOES_NOT_EXIST
reset slave all for channel 'aaa';
--replace_result $MYPORT_1 MYPORT_1
eval change master to master_host = '127.0.0.1', master_port = $MYPORT_1,  master_user = 'rep', master_password = '123456',   master_auto_position=1  for channel 'aaa';
--let $io_running= query_get_value("show slave status for channel 'aaa'", Slave_IO_Running, 1)
--let $sql_running= query_get_value("show slave status for channel 'aaa'", Slave_SQL_Running, 1)
--echo "io_running":$io_running,"sql_running":$sql_running
start slave for channel 'aaa';
--let $io_running= query_get_value("show slave status for channel 'aaa'", Slave_IO_Running, 1)
--let $sql_running= query_get_value("show slave status for channel 'aaa'", Slave_SQL_Running, 1)
--echo "io_running":$io_running,"sql_running":$sql_running
select * from d1.t0;


--connection leader
insert into d1.t0 values(3, "ddddddddddddddddddddddddddddddddddddddddddddddddddd");
select * from d1.t0;


--connection learner2
--let $io_running= query_get_value("show slave status for channel 'aaa'", Slave_IO_Running, 1)
--let $sql_running= query_get_value("show slave status for channel 'aaa'", Slave_SQL_Running, 1)
--echo "io_running":$io_running,"sql_running":$sql_running
select * from d1.t0;

stop slave for channel 'aaa';
reset slave all for channel 'aaa';


--connection learner
--error ER_SLAVE_CHANNEL_DOES_NOT_EXIST
show slave status for channel 'aaa';
select * from d1.t0;

--connection leader
let $learner_base_port = query_get_value("select $MYPORT_1+50 as c1", c1, 1);
--source include/stop_new_learner.inc

let $learner_base_port = query_get_value("select $MYPORT_1+51 as c1", c1, 1);
--source include/stop_new_learner.inc

drop database if exists d1;
drop database if exists aaa;
drop user rep;
--source include/wait_follower_catchup.inc
--enable_warnings
