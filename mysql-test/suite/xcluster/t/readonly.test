--source include/have_debug.inc
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
let $MYPORT_CONSENSUS_3 = query_get_value("select $MYPORT_3+40 as c1", c1, 1);
let $MYPORT_CONSENSUS_2 = query_get_value("select $MYPORT_2+40 as c1", c1, 1);
let $MYPORT_CONSENSUS_1 = query_get_value("select $MYPORT_1+40 as c1", c1, 1);

--connect (conn11,127.0.0.1,root,,test,$MYPORT_1)

--connection conn11
select @@super_read_only, @@read_only;
set global read_only=1;
select @@super_read_only, @@read_only;

--connection conn1
CREATE DATABASE db1;
drop DATABASE db1;
select @@super_read_only, @@read_only;

--connection conn11
set global super_read_only=1;
select @@super_read_only, @@read_only;
--disconnect conn11

--connection conn1
select @@super_read_only, @@read_only;
--error ER_OPTION_PREVENTS_STATEMENT
CREATE DATABASE db2;
--error ER_OPTION_PREVENTS_STATEMENT
drop DATABASE db2;

--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3 $MYPORT_1 MYPORT_1  $MYPORT_2 MYPORT_2  $MYPORT_3 MYPORT_3
select SERVER_ID,CURRENT_LEADER,ROLE,LEADER_IP,LEADER_PORT from information_schema.ALISQL_CLUSTER_LOCAL;

--replace_result $MYPORT_1 MYPORT_1 $MYPORT_2 MYPORT_2 $MYPORT_3 MYPORT_3
select SERVER_ID,ROLE,SERVER_IP,SERVER_PORT from information_schema.ALISQL_CLUSTER_GLOBAL order by SERVER_ID;
select @@super_read_only, @@read_only;


--replace_result $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2
eval call dbms_consensus.change_leader("127.0.0.1:$MYPORT_CONSENSUS_2");
--sleep 5
--disconnect conn1

--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
--connection conn1
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3 $MYPORT_1 MYPORT_1  $MYPORT_2 MYPORT_2  $MYPORT_3 MYPORT_3
select SERVER_ID,CURRENT_LEADER,ROLE,LEADER_IP,LEADER_PORT from information_schema.ALISQL_CLUSTER_LOCAL;

--replace_result $MYPORT_1 MYPORT_1 $MYPORT_2 MYPORT_2 $MYPORT_3 MYPORT_3
select SERVER_ID,ROLE,SERVER_IP,SERVER_PORT from information_schema.ALISQL_CLUSTER_GLOBAL order by SERVER_ID;
select @@super_read_only, @@read_only;


--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
--connection conn2
--replace_result $MYPORT_CONSENSUS_1 MYPORT_CONSENSUS_1 $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3 $MYPORT_1 MYPORT_1  $MYPORT_2 MYPORT_2  $MYPORT_3 MYPORT_3
select SERVER_ID,CURRENT_LEADER,ROLE,LEADER_IP,LEADER_PORT from information_schema.ALISQL_CLUSTER_LOCAL;

--replace_result $MYPORT_1 MYPORT_1 $MYPORT_2 MYPORT_2 $MYPORT_3 MYPORT_3
select SERVER_ID,ROLE,SERVER_IP,SERVER_PORT from information_schema.ALISQL_CLUSTER_GLOBAL order by SERVER_ID;
select @@super_read_only, @@read_only;
CREATE DATABASE db2;
--connection conn2
--sleep 5


--connection conn1
show databases like "%db%";
set global consensus_force_promote=1;
--sleep 5

set global super_read_only=0;
set global read_only=0;
select @@super_read_only, @@read_only;
DROP DATABASE db2;
--source include/wait_follower_catchup.inc
