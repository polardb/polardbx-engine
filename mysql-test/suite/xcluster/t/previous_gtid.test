#
# Feature: revise end_pos & relay log flag & timestamp in consensus log
# Testcase:
#   L->F->重启->F->L->F->binlog写满rotated -> F->重启->F->L
#
--connect (conn1,127.0.0.1,root,,test,$MYPORT_1)
flush local logs;
--let $uuid_1= `SELECT @@GLOBAL.SERVER_UUID`
--connect (conn2,127.0.0.1,root,,test,$MYPORT_2)
flush local logs;
--let $uuid_2= `SELECT @@GLOBAL.SERVER_UUID`

let $MYPORT_CONSENSUS_3 = query_get_value("select $MYPORT_3+40 as c1", c1, 1);
let $MYPORT_CONSENSUS_2 = query_get_value("select $MYPORT_2+40 as c1", c1, 1);

--connection conn1
create table t1(c1 int auto_increment primary key, c2 blob) DEFAULT CHARSET=utf8mb4;
insert into t1 (c2) values(repeat('#', 10));
insert into t1 (c2) values(repeat('#', 10));
insert into t1 (c2) values(repeat('#', 10));
--source include/wait_follower_catchup.inc
--replace_result $uuid_2 uuid_2 $uuid_1 uuid_1
select @@gtid_executed;

--connect (conn11,127.0.0.1,root,,test,$MYPORT_1)
--connection conn11
--replace_result $MYPORT_CONSENSUS_2 MYPORT_CONSENSUS_2 $MYPORT_CONSENSUS_3 MYPORT_CONSENSUS_3
--eval set global consensus_flow_control="127.0.0.1:$MYPORT_CONSENSUS_2 -2;127.0.0.1:$MYPORT_CONSENSUS_3 -2";
sleep 1;
--send insert into t1 (c2) values(repeat('#', 10));
sleep 1;
--enable_reconnect

--connection conn1
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
-- send_shutdown
--source include/wait_until_disconnected.inc

--connection conn2
--enable_reconnect
set global consensus_force_promote=1;
--source include/wait_until_connected_again.inc
insert into t1 (c2) values(repeat('#', 10));
insert into t1 (c2) values(repeat('#', 10));
--replace_result $uuid_2 uuid_2 $uuid_1 uuid_1
select @@gtid_executed;

--connection conn1
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again_old.inc

--replace_result $uuid_2 uuid_2 $uuid_1 uuid_1
select @@gtid_executed;

set global consensus_force_promote=1;
--source include/wait_until_connected_again.inc
--source include/wait_follower_catchup.inc
insert into t1 (c2) values(repeat('#', 10));
insert into t1 (c2) values(repeat('#', 10));
--source include/wait_follower_catchup.inc
--replace_result $uuid_2 uuid_2 $uuid_1 uuid_1
select @@gtid_executed;


--connection conn2
--enable_reconnect
set global consensus_force_promote=1;
--source include/wait_until_connected_again.inc
--source include/wait_follower_catchup.inc
insert into t1 (c2) values(repeat('#', 10));
insert into t1 (c2) values(repeat('#', 10));
--source include/wait_follower_catchup.inc
--replace_result $uuid_2 uuid_2 $uuid_1 uuid_1
select @@gtid_executed;

flush logs;
--let $MYSQLD_DATADIR= `select @@datadir;`
--let $master_binlog= query_get_value(SHOW MASTER STATUS, File, 1)
--replace_result $uuid_1 uuid_1
--exec $MYSQL_BINLOG -vv --base64-output=decode-rows $MYSQLD_DATADIR/$master_binlog | grep $uuid_1
--replace_result $uuid_2 uuid_2
--exec $MYSQL_BINLOG -vv --base64-output=decode-rows $MYSQLD_DATADIR/$master_binlog | grep $uuid_2


--connection conn1
flush logs;
--let $MYSQLD_DATADIR= `select @@datadir;`
--let $master_binlog= query_get_value(SHOW MASTER STATUS, File, 1)
--replace_result $uuid_1 uuid_1
--exec $MYSQL_BINLOG -vv --base64-output=decode-rows $MYSQLD_DATADIR/$master_binlog | grep $uuid_1
--replace_result $uuid_2 uuid_2
--exec $MYSQL_BINLOG -vv --base64-output=decode-rows $MYSQLD_DATADIR/$master_binlog | grep $uuid_2

--replace_result $uuid_2 uuid_2 $uuid_1 uuid_1
select @@gtid_executed;
--replace_result $uuid_2 uuid_2 $uuid_1 uuid_1
select @@gtid_purged;


--connection conn1
--enable_reconnect
set global consensus_force_promote=1;
--source include/wait_until_connected_again.inc
--source include/wait_follower_catchup.inc
drop table t1;
--source include/wait_follower_catchup.inc
