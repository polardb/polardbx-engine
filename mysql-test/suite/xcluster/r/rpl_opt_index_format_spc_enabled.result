# PART 1: spc=ON only
SET session opt_index_format_spc_enabled = ON;
SET session opt_index_format_panda_enabled = OFF;
SET session opt_index_format_hippo_enabled = OFF;
CREATE TABLE t_spc (
id INT PRIMARY KEY,
a  VARCHAR(100),
b  INT,
UNIQUE KEY idx_a (a),
KEY idx_b (b)
) ENGINE=InnoDB;
INSERT INTO t_spc VALUES (1, 'aaa', 10), (2, 'bbb', 20), (3, 'ccc', 30);
# Leader: check INDEX_PAGE_TYPE
SELECT INDEX_NAME, INDEX_PAGE_TYPE FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS
WHERE TABLE_NAME='t_spc' AND SCHEMA_NAME='test' ORDER BY INDEX_NAME;
INDEX_NAME	INDEX_PAGE_TYPE
idx_a	INDEX
idx_b	SPC_PAGE
PRIMARY	INDEX
# Follower: check INDEX_PAGE_TYPE (should match leader)
SELECT INDEX_NAME, INDEX_PAGE_TYPE FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS
WHERE TABLE_NAME='t_spc' AND SCHEMA_NAME='test' ORDER BY INDEX_NAME;
INDEX_NAME	INDEX_PAGE_TYPE
idx_a	INDEX
idx_b	SPC_PAGE
PRIMARY	INDEX
# PART 2: panda=ON only
SET session opt_index_format_spc_enabled = OFF;
SET session opt_index_format_panda_enabled = ON;
SET session opt_index_format_hippo_enabled = OFF;
CREATE TABLE t_panda (
id INT PRIMARY KEY,
a  VARCHAR(100),
b  INT,
UNIQUE KEY idx_a (a),
KEY idx_b (b)
) ENGINE=InnoDB;
INSERT INTO t_panda VALUES (1, 'aaa', 10), (2, 'bbb', 20), (3, 'ccc', 30);
