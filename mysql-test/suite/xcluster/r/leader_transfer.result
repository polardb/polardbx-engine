2	Follower	5	Normal	Yes
3	Follower	5	Normal	No
show global status like "consensus_in_leader_transfer";
Variable_name	Value
consensus_in_leader_transfer	0
set global consensus_disable_election=0;
# case 2 change_leader succeeds even when both leader and target have disable_election=1
set global consensus_disable_election=1;
set global consensus_disable_election=1;
insert into test.t1 values(1);
select count(*) from test.t1;
count(*)
