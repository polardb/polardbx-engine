create table t1(a int, b int);
insert into t1 values (1,1);
start transaction;
savepoint a1;
insert into t1 values (2,2);
rollback to a1;
commit;
start transaction;
savepoint a2;
insert into t1 values (3,3);
savepoint a3;
insert into t1 values (4,4);
rollback to a3;
insert into t1 values (5,5);
rollback to a2;
commit;
start transaction;
savepoint a2;
insert into t1 values (3,3);
savepoint a3;
insert into t1 values (4,4);
rollback to a3;
insert into t1 values (5,5);
commit;
start transaction;
savepoint a4;
insert into t1 values (6,6);
set global disable_binlog_savepoint = false;
savepoint a5;
insert into t1 values (7,7);
set global disable_binlog_savepoint = true;
commit;
start transaction;
savepoint a6;
insert into t1 values (8,8);
set global disable_binlog_savepoint = false;
savepoint a7;
insert into t1 values (9,9);
rollback to a7;
set global disable_binlog_savepoint = true;
commit;
start transaction;
savepoint a6;
insert into t1 values (9,9);
set global disable_binlog_savepoint = false;
savepoint a8;
insert into t1 values (9,9);
rollback to a8;
rollback to a6;
commit;
CREATE TABLE employees (
id INT ,
name VARCHAR(100) NOT NULL,
created_at int
);
CREATE TRIGGER before_insert_employees
BEFORE INSERT ON employees
FOR EACH ROW
begin
SET NEW.created_at = 2;
insert into t1 values(11,11);
savepoint a9;
insert into t1 values(10,10);
rollback to a9;
end |
INSERT INTO employees (name) VALUES ('John Doe');
set global disable_binlog_savepoint = true;
INSERT INTO employees (name) VALUES ('Doe John');
