@@gtid_executed
leader_uuid:X
set global consensus_force_promote=1;
insert into t1 values (1);
"restart leader"
show consensus logs;
Log_name	File_size	Start_log_index
master-bin.000004	#	#
select @@gtid_purged;
@@gtid_purged
leader_uuid:X
select @@gtid_executed;
@@gtid_executed
leader_uuid:X,
f1_uuid:X
set global consensus_force_promote=1;
insert into t1 values (1);
flush local logs;
flush local logs;
flush local logs;
insert into t1 values (1);
call dbms_consensus.add_learner("127.0.0.1:24000");
call dbms_consensus.configure_learner("127.0.0.1:24000", "127.0.0.1:PAXOS_PORT_2");
insert into t1 values (1);
call dbms_consensus.local_purge_log(100000000);
call dbms_consensus.force_purge_log(100000000);
# for f1: purge local should fail
call dbms_consensus.local_purge_log(100000000);
call dbms_consensus.force_purge_log(100000000);
show consensus logs;
Log_name	File_size	Start_log_index
master-bin.000004	#	#
extra_purged_vs_leader

select @@gtid_executed;
@@gtid_executed
leader_uuid:X,
f1_uuid:X
# for f2: purge local should success
call dbms_consensus.local_purge_log(100000000);
show consensus logs;
Log_name	File_size	Start_log_index
master-bin.000004	#	#
extra_purged_vs_leader

select @@gtid_executed;
@@gtid_executed
leader_uuid:X,
f1_uuid:X
call dbms_consensus.drop_learner("127.0.0.1:24000");
drop table t1;
