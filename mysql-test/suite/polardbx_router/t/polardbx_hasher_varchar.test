--echo #
--echo # Test polardbx_hasher function with variable length string types
--echo #

--echo
--echo  Test with utf8mb4_general_ci charset and collation
--echo
CREATE TABLE t_utf8mb4_general_ci (
  id VARCHAR(64) CHARSET utf8mb4 COLLATE utf8mb4_general_ci,
  name VARCHAR(64),
  age INT,
  salary DECIMAL(10,2),
  create_time DATETIME,
  is_active BOOLEAN
);

