--echo
--echo  Test for polardbx_hasher function with integer types
--echo

--echo
--echo  Test with TINYINT type
--echo
CREATE TABLE t_tinyint (
  id TINYINT,
  name VARCHAR(64),
  age INT,
  salary DECIMAL(10,2),
  create_time DATETIME,
  is_active BOOLEAN
);

INSERT INTO t_tinyint (id, name, age, salary, create_time, is_active) VALUES
  (-128, 'min tinyint', 25, 50000.00, '2023-01-01 00:00:00', true),
  (0, 'zero tinyint', 30, 60000.50, '2023-01-01 00:00:01', false),
  (127, 'max tinyint', 35, 70000.75, '2023-01-01 00:00:02', true),
  (NULL, 'null tinyint', 40, 80000.00, '2023-01-01 00:00:03', false),
  (-1, 'negative one', 45, 90000.25, '2023-01-01 00:00:04', true),
  (1, 'positive one', 50, 95000.00, '2023-01-01 00:00:05', false),
  (42, 'meaning of life', 55, 100000.00, '2023-01-01 00:00:06', true),
  (-42, 'negative meaning', 60, 105000.00, '2023-01-01 00:00:07', false),
  (100, 'round number', 65, 110000.00, '2023-01-01 00:00:08', true),
  (-100, 'negative round', 70, 115000.00, '2023-01-01 00:00:09', false);

SELECT id, age, polardbx_hasher(id) AS hash_value FROM t_tinyint ORDER BY age, hash_value;

--echo
--echo  Test with TINYINT UNSIGNED type
--echo
CREATE TABLE t_tinyint_unsigned (
  id TINYINT UNSIGNED,
  name VARCHAR(64),
  age INT,
  salary DECIMAL(10,2),
  create_time DATETIME,
  is_active BOOLEAN
);

INSERT INTO t_tinyint_unsigned (id, name, age, salary, create_time, is_active) VALUES
  (0, 'min tinyint unsigned', 125, 50000.00, '2023-01-01 00:00:00', true),
  (255, 'max tinyint unsigned', 130, 60000.50, '2023-01-01 00:00:01', false),
  (NULL, 'null tinyint unsigned', 135, 70000.75, '2023-01-01 00:00:02', true),
  (1, 'one unsigned', 140, 80000.00, '2023-01-01 00:00:03', false),
  (42, 'meaning of life unsigned', 145, 90000.25, '2023-01-01 00:00:04', true),
  (100, 'round number unsigned', 150, 95000.00, '2023-01-01 00:00:05', false),
  (200, 'double century', 155, 100000.00, '2023-01-01 00:00:06', true),
  (128, 'midpoint', 160, 105000.00, '2023-01-01 00:00:07', false),
  (64, 'power of two', 165, 110000.00, '2023-01-01 00:00:08', true),
  (32, 'small power of two', 170, 115000.00, '2023-01-01 00:00:09', false);

SELECT id, age, polardbx_hasher(id) AS hash_value FROM t_tinyint_unsigned ORDER BY age, hash_value;

