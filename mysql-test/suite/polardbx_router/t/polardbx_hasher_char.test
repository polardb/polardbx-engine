--echo
--echo  Test with utf8mb4_general_ci charset and collation
--echo
CREATE TABLE t_char_utf8mb4_general_ci (
  id CHAR(64) CHARSET utf8mb4 COLLATE utf8mb4_general_ci,
  name VARCHAR(64),
  age INT,
  salary DECIMAL(10,2),
  create_time DATETIME,
  is_active BOOLEAN
);

INSERT INTO t_char_utf8mb4_general_ci (id, name, age, salary, create_time, is_active) VALUES
  ('', 'empty string', 25, 50000.00, '2023-01-01 00:00:00', true),
  ('ABC', 'uppercase', 30, 60000.50, '2023-01-01 00:00:01', false),
  ('abc', 'lowercase', 35, 70000.75, '2023-01-01 00:00:02', true),
  ('中文测试', 'chinese string', 40, 80000.00, '2023-01-01 00:00:03', false),
  (NULL, 'actual null', 45, 90000.25, '2023-01-01 00:00:04', true),
  ('   ', 'spaces', 50, 95000.00, '2023-01-01 00:00:05', false),
  ('特殊字符!@#$%^&*()', 'special chars', 55, 100000.00, '2023-01-01 00:00:06', true),
  ('😊🚀🎉', 'emoji id 1', 85, 110000.00, '2023-01-01 00:01:06', true),
  ('🐱🐶🐭🐹', 'emoji id 2', 86, 111000.00, '2023-01-01 00:01:07', false),
  ('안녕하세요', 'korean', 614, 180000.00, '2023-01-01 00:00:22', false),
  ('🌍🌎🌏', 'emoji id 3', 87, 112000.00, '2023-01-01 00:01:08', true);

SELECT id, age, polardbx_hasher(id) AS hash_value FROM t_char_utf8mb4_general_ci ORDER BY age, hash_value;

