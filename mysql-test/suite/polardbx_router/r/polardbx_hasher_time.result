
Test for polardbx_hasher function with time types


Test with TIMESTAMP default precision

set sql_mode='';
CREATE TABLE t_timestamp_default (
id TIMESTAMP,
name VARCHAR(64),
age INT,
salary DECIMAL(10,2),
create_time DATETIME,
is_active BOOLEAN
);
