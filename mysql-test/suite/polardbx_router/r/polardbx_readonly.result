CREATE TABLE t21_source (
id INT PRIMARY KEY,
data VARCHAR(100)
) SECONDARY_ENGINE_ATTRIBUTE='{"polarx.readonly": true}';
INSERT INTO t21_source VALUES (1, 'source data 1'), (2, 'source data 2');
ERROR HY000: Table is in readonly status : operation DML is not allowed
Try to create view as select from readonly table (should work for CREATE VIEW)
