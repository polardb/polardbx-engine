#
# Test 15: Test with all supported numeric types from PolarDB-X
#
Test hasher with all supported numeric types
CREATE TABLE t12 (
id INT PRIMARY KEY,
-- Signed integer types
tiny_int_col TINYINT,
small_int_col SMALLINT,
medium_int_col MEDIUMINT,
int_col INT,
big_int_col BIGINT,
-- Unsigned integer types
tiny_int_unsigned_col TINYINT UNSIGNED,
small_int_unsigned_col SMALLINT UNSIGNED,
medium_int_unsigned_col MEDIUMINT UNSIGNED,
int_unsigned_col INT UNSIGNED,
big_int_unsigned_col BIGINT UNSIGNED
);
INSERT INTO t12 VALUES (
1,
-- Signed values
-128,      -- TINYINT min
-32768,    -- SMALLINT min
-8388608,  -- MEDIUMINT min
-2147483648, -- INT min
-9223372036854775808, -- BIGINT min
-- Unsigned values
255,       -- TINYINT UNSIGNED max
65535,     -- SMALLINT UNSIGNED max
16777215,  -- MEDIUMINT UNSIGNED max
4294967295, -- INT UNSIGNED max
18446744073709551615 -- BIGINT UNSIGNED max
);
Test hasher with all numeric types
SELECT id,
polardbx_hasher(tiny_int_col),
polardbx_hasher(small_int_col),
polardbx_hasher(medium_int_col),
polardbx_hasher(int_col),
polardbx_hasher(big_int_col),
polardbx_hasher(tiny_int_unsigned_col),
polardbx_hasher(small_int_unsigned_col),
polardbx_hasher(medium_int_unsigned_col),
polardbx_hasher(int_unsigned_col),
polardbx_hasher(big_int_unsigned_col)
FROM t12;
id	polardbx_hasher(tiny_int_col)	polardbx_hasher(small_int_col)	polardbx_hasher(medium_int_col)	polardbx_hasher(int_col)	polardbx_hasher(big_int_col)	polardbx_hasher(tiny_int_unsigned_col)	polardbx_hasher(small_int_unsigned_col)	polardbx_hasher(medium_int_unsigned_col)	polardbx_hasher(int_unsigned_col)	polardbx_hasher(big_int_unsigned_col)
