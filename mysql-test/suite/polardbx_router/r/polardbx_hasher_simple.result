#
# Test for PolarDB-X hasher function compatibility
#
#
# Test 1: Basic polardbx_hasher function usage
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(50),
value BIGINT
);
INSERT INTO t1 VALUES
(1, 'test1', 100),
(2, 'test2', 200),
(3, 'test3', 300),
(4, 'test4', 400),
(5, 'test5', 500);
Test basic hasher function
SELECT id, polardbx_hasher(id) FROM t1 ORDER BY id;
id	polardbx_hasher(id)
1	6161172798010463909
2	-8757930400787925687
3	-7000469012213606124
4	9172397366371939626
5	-4269195568055077416
SELECT name, polardbx_hasher(name) FROM t1 ORDER BY id;
name	polardbx_hasher(name)
test1	-2864529164705671005
test2	9044262613283300252
test3	-3467060756958554187
test4	3564119877896740020
test5	-1990518718783157724
SELECT value, polardbx_hasher(value) FROM t1 ORDER BY id;
value	polardbx_hasher(value)
100	8273138365905483981
200	-6627188659413746981
300	-5816586087938738740
400	-8347077748959235974
500	5517404819946206893
Test with multiple columns
SELECT id, name, polardbx_hasher(id, name) FROM t1 ORDER BY id;
id	name	polardbx_hasher(id, name)
1	test1	3216227858031304336
2	test2	-8567005430787718437
3	test3	5205272871264451179
4	test4	3879586236949059943
5	test5	-2949577889977931041
#
# Test 2: polardbx_hasher with range validation
#
Test valid range parameters
SELECT id, polardbx_hasher(id, -9223372036854775807, 9223372036854775807) FROM t1 ORDER BY id;
id	polardbx_hasher(id, -9223372036854775807, 9223372036854775807)
1	6161172798010463909
2	-8757930400787925687
3	-7000469012213606124
4	9172397366371939626
5	-4269195568055077416
Test specific range
SELECT id, polardbx_hasher(id, -8757930400787925687, 9172397366371939626) FROM t1 ORDER BY id;
id	polardbx_hasher(id, -8757930400787925687, 9172397366371939626)
1	6161172798010463909
2	-8757930400787925687
3	-7000469012213606124
4	9172397366371939626
5	-4269195568055077416
#
# Test 3: Edge cases for range validation
#
SELECT id, polardbx_hasher(id, 6161172798010463909, 6161172798010463909) FROM t1 WHERE id = 1;
id	polardbx_hasher(id, 6161172798010463909, 6161172798010463909)
1	6161172798010463909
#
# Test 4: Error cases for range validation
#
Test invalid range (min > max) - should produce error
SELECT id, polardbx_hasher(id, 100, 50) FROM t1 LIMIT 1;
ERROR HY000: Invalid hash range in polardbx_hasher function: min_range (100) must be not greater than max_range (50)
Test out of range values - should produce error
Since we don't know the exact hash values, we'll use a narrow range that should fail
We'll first check what values we get to determine a proper test range
SELECT id, polardbx_hasher(id, 1, 2) as hash_val FROM t1 ORDER BY id;
ERROR HY000: Hash value 6161172798010463909 computed from partitioning key [id=1] is out of the expected source partition range [1, 2]. This indicates a data consistency issue during partition migration.
#
# Test 5: Test with different data types
#
CREATE TABLE t2 (
id INT PRIMARY KEY,
str_val VARCHAR(50),
int_val INT,
bigint_val BIGINT,
decimal_val DECIMAL(10,2),
float_val FLOAT,
double_val DOUBLE
);
INSERT INTO t2 VALUES
(1, 'string_value', 123, 123456789012345, 999.99, 3.14, 2.718281828459045);
Test hasher with different data types
SELECT id, polardbx_hasher(str_val) FROM t2;
id	polardbx_hasher(str_val)
1	-2171065234399000591
SELECT id, polardbx_hasher(int_val) FROM t2;
id	polardbx_hasher(int_val)
1	-8537719995137208844
SELECT id, polardbx_hasher(bigint_val) FROM t2;
id	polardbx_hasher(bigint_val)
1	2852661729848918113
SELECT id, polardbx_hasher(decimal_val) FROM t2;
id	polardbx_hasher(decimal_val)
1	-9205501361145232638
SELECT id, polardbx_hasher(float_val) FROM t2;
id	polardbx_hasher(float_val)
1	-5496013630912323755
SELECT id, polardbx_hasher(double_val) FROM t2;
id	polardbx_hasher(double_val)
1	-2633296057684279665
Test hasher with mixed data types
SELECT id, polardbx_hasher(str_val, int_val, bigint_val) FROM t2;
id	polardbx_hasher(str_val, int_val, bigint_val)
1	-7937082275022275117
#
# Test 6: Test with NULL values
#
CREATE TABLE t3 (
id INT PRIMARY KEY,
nullable_col VARCHAR(50)
);
INSERT INTO t3 VALUES
(1, 'non-null value'),
(2, NULL);
Test hasher with NULL values
SELECT id, nullable_col, polardbx_hasher(nullable_col) FROM t3;
id	nullable_col	polardbx_hasher(nullable_col)
1	non-null value	5835219639111273568
2	NULL	-2447670524089286488
Test hasher with mix of NULL and non-NULL values
SELECT id, polardbx_hasher(id, nullable_col) FROM t3;
id	polardbx_hasher(id, nullable_col)
1	-3801149021274954358
2	-8313158268418437284
