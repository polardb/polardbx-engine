SELECT COUNT(*) as count,
MIN(polardbx_hasher(id)) as min_hash,
MAX(polardbx_hasher(id)) as max_hash,
AVG(polardbx_hasher(id)) as avg_hash
FROM t4;
count	min_hash	max_hash	avg_hash
100	-8757930400787925687	9172397366371939626	534317052750093678.3700
#
# Test 8: Test consistency of hash values
#
Hash values should be consistent across multiple calls
CREATE TABLE t5 (
id INT PRIMARY KEY,
data VARCHAR(50)
);
INSERT INTO t5 VALUES (1, 'consistent_data');
SELECT id, polardbx_hasher(data) as hash1 FROM t5;
id	hash1
1	4099836034205488783
SELECT id, polardbx_hasher(data) as hash2 FROM t5;
id	hash2
1	4099836034205488783
SELECT id, polardbx_hasher(data) as hash3 FROM t5;
id	hash3
1	4099836034205488783
Verify consistency - all hash values should be the same
SELECT id,
polardbx_hasher(data) as hash1,
polardbx_hasher(data) as hash2,
polardbx_hasher(data) as hash3,
CASE
WHEN polardbx_hasher(data) = polardbx_hasher(data) AND
polardbx_hasher(data) = polardbx_hasher(data)
THEN 'CONSISTENT'
         ELSE 'INCONSISTENT'
       END as consistency_check
FROM t5;
id	hash1	hash2	hash3	consistency_check
1	4099836034205488783	4099836034205488783	4099836034205488783	CONSISTENT
