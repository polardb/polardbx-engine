Test hasher with UTF8MB4 charset and various collations
SELECT id,
polardbx_hasher(utf8mb4_bin_col),
polardbx_hasher(utf8mb4_general_ci_col),
polardbx_hasher(utf8mb4_unicode_ci_col),
polardbx_hasher(utf8mb4_0900_ai_ci_col)
FROM t17_utf8mb4;
id	polardbx_hasher(utf8mb4_bin_col)	polardbx_hasher(utf8mb4_general_ci_col)	polardbx_hasher(utf8mb4_unicode_ci_col)	polardbx_hasher(utf8mb4_0900_ai_ci_col)
1	2445337721452445897	8657401410175528627	5159245535947495451	3170291041205304931
Test hasher with mixed charsets
SELECT a.id,
polardbx_hasher(a.ascii_col, l.latin1_bin_col, u.utf8mb4_bin_col)
FROM t15_ascii a, t16_latin1 l, t17_utf8mb4 u
WHERE a.id = l.id AND l.id = u.id;
id	polardbx_hasher(a.ascii_col, l.latin1_bin_col, u.utf8mb4_bin_col)
1	-6568145765723755236
DROP TABLE t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13, t14, t15_ascii, t16_latin1, t17_utf8mb4;
