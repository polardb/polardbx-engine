--echo #
--echo # Bug#27607720: WRONG UPDATION OF COLLATION AFTER ALTER TABLE COMMAND
--echo #

SET SESSION default_collation_for_utf8mb4 = utf8mb4_general_ci;

SHOW GLOBAL VARIABLES LIKE '%default_collation_for_utf8mb4%';
SHOW SESSION VARIABLES LIKE '%default_collation_for_utf8mb4%';

CREATE DATABASE db1;
USE db1;
CREATE TABLE st1 (c1 INT ,c3 varchar(10) UNIQUE KEY);
SHOW CREATE TABLE st1;
ALTER TABLE st1 DROP COLUMN c1;

SHOW CREATE TABLE st1;

DROP DATABASE db1;
USE test;

--echo #
--echo # CONVERT TO
--echo #

CREATE DATABASE d1;
CREATE TABLE d1.t1 (c1 INT ,c3 varchar(10) UNIQUE KEY);
--query_vertical SHOW CREATE TABLE d1.t1

alter table d1.t1 DEFAULT CHARACTER SET latin1;
--query_vertical SHOW CREATE TABLE d1.t1

--error ER_NO_COLLATION_FOR_UTF8MB4_CHARSET
alter table d1.t1 CONVERT TO CHARACTER SET utf8mb4;
alter table d1.t1 CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
--query_vertical SHOW CREATE TABLE d1.t1
--error ER_NO_COLLATION_FOR_UTF8MB4_CHARSET
alter table d1.t1 CONVERT TO CHARACTER SET DEFAULT;
alter table d1.t1 CONVERT TO CHARACTER SET DEFAULT COLLATE utf8mb4_general_ci;
--query_vertical SHOW CREATE TABLE d1.t1

DROP DATABASE d1;
USE test;


--echo #

SET @@default_collation_for_utf8mb4 = DEFAULT;