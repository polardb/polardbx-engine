CREATE TABLE t1 (
id INT NOT NULL PRIMARY KEY,
c INT NOT NULL,
v INT GENERATED ALWAYS AS (c + 1) VIRTUAL,
KEY idx_v (v)
) ENGINE=InnoDB;
