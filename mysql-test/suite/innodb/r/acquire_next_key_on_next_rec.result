#
# Setup
#
DROP TABLE IF EXISTS t1;
Warnings:
Note	1051	Unknown table 'test.t1'
CREATE TABLE t1 (
id INT AUTO_INCREMENT,
c1 VARCHAR(10),
c2 VARCHAR(10),
PRIMARY KEY(id),
UNIQUE KEY uk_c1_c2 (c1, c2) secondary_engine_attribute '{"panda index":"0"}'
) ENGINE=InnoDB;
INSERT INTO t1 (c1, c2) VALUES ('c1-1', '222'), ('c1-2', '999');
SELECT * FROM t1;
id	c1	c2
1	c1-1	222
2	c1-2	999
########################################################################
# Test Case 1: acquire_next_key_on_next_rec = ON
# Expected: Transaction 2's DELETE will wait for lock held by Transaction 1
########################################################################
SET GLOBAL innodb_acquire_next_key_on_next_rec = ON;
SET GLOBAL innodb_lock_wait_timeout = 2;
# Transaction 1: Delete and insert
BEGIN;
DELETE FROM t1 WHERE c1 = 'c1-1';
INSERT INTO t1 (c1, c2) VALUES ('c1-1', '222');
# Transaction 2: Try to delete - should wait for lock
SET SESSION innodb_lock_wait_timeout = 2;
BEGIN;
# This DELETE should wait for lock and eventually timeout
DELETE FROM t1 WHERE c1 = 'c1-2';
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
ROLLBACK;
ROLLBACK;
# Verify data is unchanged
SELECT * FROM t1 ORDER BY id;
id	c1	c2
1	c1-1	222
2	c1-2	999
########################################################################
# Test Case 2: acquire_next_key_on_next_rec = OFF
# Expected: Deadlock will occur
########################################################################
SET GLOBAL innodb_acquire_next_key_on_next_rec = OFF;
# Reset data
DELETE FROM t1;
INSERT INTO t1 (c1, c2) VALUES ('c1-1', '222'), ('c1-2', '999');
SELECT * FROM t1 ORDER BY id;
id	c1	c2
4	c1-1	222
5	c1-2	999
# Transaction 1: Delete and insert c1-1
BEGIN;
DELETE FROM t1 WHERE c1 = 'c1-1';
INSERT INTO t1 (c1, c2) VALUES ('c1-1', '222');
# Transaction 2: Delete and insert c1-2
BEGIN;
DELETE FROM t1 WHERE c1 = 'c1-2';
INSERT INTO t1 (c1, c2) VALUES ('c1-2', '999');
# Transaction 1: Try to insert another row - this will wait
SET DEBUG_SYNC = 'lock_wait_will_wait SIGNAL con1_waiting';
INSERT INTO t1 (c1, c2) VALUES ('c1-1', '333');
# Transaction 2: Try to insert another row - should cause deadlock
SET DEBUG_SYNC = 'now WAIT_FOR con1_waiting';
INSERT INTO t1 (c1, c2) VALUES ('c1-2', '444');
# Rollback both transactions
ROLLBACK;
ROLLBACK;
# Verify data is unchanged
SELECT * FROM t1 ORDER BY id;
id	c1	c2
4	c1-1	222
5	c1-2	999
########################################################################
# Cleanup
########################################################################
DROP TABLE t1;
SET GLOBAL innodb_acquire_next_key_on_next_rec = default;
SET GLOBAL innodb_lock_wait_timeout = default;
