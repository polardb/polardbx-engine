# Test with REDUNDANT row format (primary trigger scenario)
CREATE TABLE t1 (a INT, b INT) ROW_FORMAT=REDUNDANT;
INSERT INTO t1 VALUES(0,0);
ALTER TABLE t1 ADD COLUMN c VARCHAR(25) DEFAULT NULL, ALGORITHM=INSTANT;
UPDATE t1 SET c="" WHERE a=0;
SELECT * FROM t1;
a	b	c
0	0	
DROP TABLE t1;
# Test with DYNAMIC row format
CREATE TABLE t2 (a INT, b INT) ROW_FORMAT=DYNAMIC;
INSERT INTO t2 VALUES(1,1);
ALTER TABLE t2 ADD COLUMN c VARCHAR(25) DEFAULT NULL, ALGORITHM=INSTANT;
UPDATE t2 SET c="hello" WHERE a=1;
SELECT * FROM t2;
a	b	c
1	1	hello
DROP TABLE t2;
# Test with COMPACT row format
CREATE TABLE t3 (a INT, b INT) ROW_FORMAT=COMPACT;
INSERT INTO t3 VALUES(2,2);
ALTER TABLE t3 ADD COLUMN c VARCHAR(25) DEFAULT NULL, ALGORITHM=INSTANT;
UPDATE t3 SET c="world" WHERE a=2;
SELECT * FROM t3;
a	b	c
2	2	world
DROP TABLE t3;
# Test update to NULL and back
CREATE TABLE t4 (a INT, b INT) ROW_FORMAT=REDUNDANT;
INSERT INTO t4 VALUES(3,3);
ALTER TABLE t4 ADD COLUMN c INT DEFAULT NULL, ALGORITHM=INSTANT;
UPDATE t4 SET c=100 WHERE a=3;
SELECT * FROM t4;
a	b	c
3	3	100
UPDATE t4 SET c=NULL WHERE a=3;
SELECT * FROM t4;
a	b	c
3	3	NULL
DROP TABLE t4;
