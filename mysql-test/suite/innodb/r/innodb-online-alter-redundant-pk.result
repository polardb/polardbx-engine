#
# Online rebuild of a REDUNDANT table changing PK and row format:
# concurrent DML logs ROW_T_UPDATE with old_pk serialized against the
# new (COMPACT/DYNAMIC) clustered index. old_pk serialization must not
# pass an invalid row version.
#
CREATE TABLE t1 (a INT NOT NULL, b INT NOT NULL, c INT,
PRIMARY KEY(a)) ENGINE=InnoDB ROW_FORMAT=REDUNDANT;
INSERT INTO t1 VALUES (1, 10, 100), (2, 20, 200);
SET DEBUG_SYNC = 'row_log_table_apply1_before SIGNAL logging WAIT_FOR dml_done';
ALTER TABLE t1 DROP PRIMARY KEY, ADD PRIMARY KEY(b), ROW_FORMAT=DYNAMIC, ALGORITHM=INPLACE, LOCK=NONE;
/* connection con1 */
SET DEBUG_SYNC = 'now WAIT_FOR logging';
UPDATE t1 SET c = c + 1 WHERE a = 1;
SET DEBUG_SYNC = 'now SIGNAL dml_done';
/* connection default */
SET DEBUG_SYNC = 'RESET';
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
SELECT * FROM t1;
a	b	c
1	10	101
2	20	200
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int NOT NULL,
  `b` int NOT NULL,
  `c` int DEFAULT NULL,
  PRIMARY KEY (`b`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC
DROP TABLE t1;
