CREATE TABLE t1 (
id INT PRIMARY KEY,
c CHAR(10) CHARACTER SET utf8mb3
) ENGINE=InnoDB ROW_FORMAT=REDUNDANT;
INSERT INTO t1 VALUES (1, 'abc'), (2, 'defghij');
ALTER TABLE t1 CONVERT TO CHARACTER SET utf8mb4, ALGORITHM=INPLACE;
SELECT CHARACTER_SET_NAME
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't1' AND COLUMN_NAME = 'c';
CHARACTER_SET_NAME
utf8mb4
SELECT ROW_FORMAT
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't1';
ROW_FORMAT
Redundant
SELECT id, c, CHAR_LENGTH(c), LENGTH(c) FROM t1 ORDER BY id;
id	c	CHAR_LENGTH(c)	LENGTH(c)
1	abc	3	3
2	defghij	7	7
DROP TABLE t1;
