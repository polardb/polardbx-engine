create database src;
create database dst;
create table src.t1 (
`name` varchar(128),
KEY `name1` (`name`(8))
);
alter table src.t1 add index name2 (name(15));
alter table src.t1 drop index name2;
create table dst.t1 like src.t1;
alter table dst.t1 discard tablespace;
flush tables src.t1 for export;
unlock tables;
alter table dst.t1 import tablespace;
drop table dst.t1;
drop table src.t1;
create table src.t1 (
`name` varchar(128),
KEY `name1` (`name`(8))
);
alter table src.t1 add index name2 (name);
alter table src.t1 drop index name2;
create table dst.t1 like src.t1;
alter table dst.t1 discard tablespace;
flush tables src.t1 for export;
unlock tables;
alter table dst.t1 import tablespace;
# Cleanup
drop database src;
drop database dst;
