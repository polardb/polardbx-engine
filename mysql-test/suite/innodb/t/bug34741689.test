# Created 2026-08-04 by kaiwu.zfy
#
# Bug#34741689: generated-column evaluation overwrites a virtual-column value
# still referenced by the UPDATE vector.

CREATE TABLE t1 (
  a INT,
  b INT,
  v1 TEXT GENERATED ALWAYS AS (CONCAT('val_', a)) VIRTUAL,
  v2 TEXT GENERATED ALWAYS AS (IF(b IS NULL, NULL, CONCAT(v1, '_', b))) VIRTUAL,
  KEY k1 (v1(20)),
  KEY k2 (v2(20))
) ENGINE=InnoDB;

INSERT INTO t1 (a, b) VALUES (5, NULL);
UPDATE t1 SET a = 105;

# The clustered record and secondary index must find the same row.
SELECT COUNT(*) AS by_full_scan FROM t1 IGNORE INDEX(k1, k2)
  WHERE v1 = 'val_105';
SELECT COUNT(*) AS by_k1 FROM t1 FORCE INDEX(k1)
  WHERE v1 = 'val_105';

DROP TABLE t1;
