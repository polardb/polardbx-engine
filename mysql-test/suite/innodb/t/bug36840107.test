# Bug#36840107 mysql crash after update inplace in instant ddl redundant table
#
# rec_get_instant_offset() only set REC_OFFS_SQL_NULL for an
# instant-added column whose default is NULL, missing REC_OFFS_DEFAULT.
# The update path then believed the old record had a physical slot for
# the field and performed an in-place update, reading the offset entry
# beyond the record boundary in REDUNDANT row format.
#
# Correct behavior: UPDATE on the instant-added column rebuilds the
# record, succeeds without crash, and returns correct data.

--echo # Test with REDUNDANT row format (primary trigger scenario)
CREATE TABLE t1 (a INT, b INT) ROW_FORMAT=REDUNDANT;
INSERT INTO t1 VALUES(0,0);
ALTER TABLE t1 ADD COLUMN c VARCHAR(25) DEFAULT NULL, ALGORITHM=INSTANT;
UPDATE t1 SET c="" WHERE a=0;
SELECT * FROM t1;
DROP TABLE t1;

--echo # Test with DYNAMIC row format
CREATE TABLE t2 (a INT, b INT) ROW_FORMAT=DYNAMIC;
INSERT INTO t2 VALUES(1,1);
ALTER TABLE t2 ADD COLUMN c VARCHAR(25) DEFAULT NULL, ALGORITHM=INSTANT;
UPDATE t2 SET c="hello" WHERE a=1;
SELECT * FROM t2;
DROP TABLE t2;

--echo # Test with COMPACT row format
CREATE TABLE t3 (a INT, b INT) ROW_FORMAT=COMPACT;
INSERT INTO t3 VALUES(2,2);
ALTER TABLE t3 ADD COLUMN c VARCHAR(25) DEFAULT NULL, ALGORITHM=INSTANT;
UPDATE t3 SET c="world" WHERE a=2;
SELECT * FROM t3;
DROP TABLE t3;

--echo # Test update to NULL and back
CREATE TABLE t4 (a INT, b INT) ROW_FORMAT=REDUNDANT;
INSERT INTO t4 VALUES(3,3);
ALTER TABLE t4 ADD COLUMN c INT DEFAULT NULL, ALGORITHM=INSTANT;
UPDATE t4 SET c=100 WHERE a=3;
SELECT * FROM t4;
UPDATE t4 SET c=NULL WHERE a=3;
SELECT * FROM t4;
DROP TABLE t4;
