# Bug#34819454: temp-table UPDATE wrongly maintains change-buffer bitmap
# Community commit: 935a7dfc103f
#
# Deterministic observation version. The missing !is_temporary() checks in
# btr_cur_optimistic_update() func_exit / btr_cur_pessimistic_update() cause
# ibuf_update_free_bits_low() to run for secondary-index leaf pages of a
# TEMPORARY table. That dirties the IBUF_BITMAP page (page 1) of the session
# temp tablespace. On correct code that page is written only once at
# tablespace initialization and never again by DML.
#
# Trigger: UPDATE that appends a trailing space to a PAD-SPACE collated
# VARCHAR key. The new sec-index entry is collation-equal to the
# delete-marked old entry but binary-different, so the insert phase goes
# through row_ins_sec_index_entry_by_modify() -> btr_cur_optimistic_update()
# on the temp table's secondary index with a size-changing update vector.
# Repeated growth crosses 512-byte free-space levels so
# ibuf_update_free_bits_low() sees before != after and writes the bitmap.
#
# Verdict: dirty_bitmap_pages_after_updates > 0  => bug reproduced.

--source include/have_debug.inc

CREATE TEMPORARY TABLE t_tmp (
  id INT PRIMARY KEY,
  v VARCHAR(200) CHARACTER SET latin1 COLLATE latin1_swedish_ci,
  KEY idx_v (v)
) ENGINE=InnoDB;

--disable_query_log
let $i = 1;
while ($i <= 300) {
  eval INSERT INTO t_tmp VALUES ($i, CONCAT('val', LPAD($i, 6, '0')));
  inc $i;
}
--enable_query_log

# Find this session's temp tablespace id
let $temp_space = query_get_value(SELECT SPACE FROM INFORMATION_SCHEMA.INNODB_SESSION_TEMP_TABLESPACES WHERE ID = CONNECTION_ID() AND PURPOSE = 'USER', SPACE, 1);

# Flush everything so the bitmap page (dirtied at tablespace init) is clean
SET GLOBAL innodb_buf_flush_list_now = ON;

--disable_query_log
eval SET @temp_space = $temp_space;
--enable_query_log

# Baseline: bitmap page of the session temp tablespace must be clean
SELECT COUNT(*) AS dirty_bitmap_pages_baseline
  FROM INFORMATION_SCHEMA.INNODB_BUFFER_PAGE
 WHERE SPACE = @temp_space AND PAGE_NUMBER = 1 AND OLDEST_MODIFICATION > 0;

# Grow the secondary index key repeatedly: each round rewrites every
# sec-index entry via the by_modify path and shrinks page free space,
# crossing ibuf free-bits levels.
--disable_query_log
let $r = 1;
while ($r <= 60) {
  UPDATE t_tmp SET v = CONCAT(v, ' ');
  inc $r;
}
--enable_query_log

# Bug check: on buggy code the IBUF_BITMAP page of the temp tablespace has
# been re-dirtied by ibuf_update_free_bits_low(); on fixed code it is clean.
SELECT COUNT(*) AS dirty_bitmap_pages_after_updates
  FROM INFORMATION_SCHEMA.INNODB_BUFFER_PAGE
 WHERE SPACE = @temp_space AND PAGE_NUMBER = 1 AND OLDEST_MODIFICATION > 0;

# Also verify data stayed consistent
SELECT COUNT(*) FROM t_tmp;
SELECT COUNT(*) FROM t_tmp FORCE INDEX(idx_v) WHERE v LIKE 'val%';

DROP TEMPORARY TABLE t_tmp;
