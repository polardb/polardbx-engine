# Bug#33691659 ON DELETE CASCADE with generated column crashes in
#              innobase_get_computed_value
#
# When a child table has a secondary index on a virtual generated column
# (unrelated to the FK columns), ON DELETE CASCADE from the parent table
# must initialize vc_templ before computing the virtual column value for
# secondary index maintenance. The old code only checked foreign->v_cols,
# missing the case where the indexed virtual column is not part of the FK.
#
# This test verifies correct behavior after fix: cascade delete succeeds
# without crash, and both parent/child data and secondary index are
# consistent, including the cold path after restart.

--echo #
--echo # Setup: parent table and child table with indexed virtual generated column
--echo #

CREATE TABLE parent (
  id INT PRIMARY KEY
) ENGINE=InnoDB;

CREATE TABLE child (
  id INT PRIMARY KEY,
  parent_id INT NOT NULL,
  val INT NOT NULL,
  vcol INT AS (val * 2) VIRTUAL,
  KEY idx_vcol (vcol),
  CONSTRAINT fk_parent FOREIGN KEY (parent_id) REFERENCES parent(id)
    ON DELETE CASCADE
) ENGINE=InnoDB;

INSERT INTO parent VALUES (1), (2), (3);
INSERT INTO child (id, parent_id, val) VALUES (10, 1, 100), (20, 2, 200), (30, 3, 300);

SELECT * FROM parent ORDER BY id;
SELECT id, parent_id, val, vcol FROM child ORDER BY id;

--echo #
--echo # Trigger cascade delete - this must not crash
--echo #

DELETE FROM parent WHERE id = 1;

SELECT * FROM parent ORDER BY id;
SELECT id, parent_id, val, vcol FROM child ORDER BY id;

--echo #
--echo # Verify the virtual column index is still usable
--echo #

--sorted_result
SELECT vcol FROM child FORCE INDEX (idx_vcol) WHERE vcol >= 0;

--echo #
--echo # Multiple cascade delete
--echo #

DELETE FROM parent WHERE id IN (2, 3);

SELECT * FROM parent ORDER BY id;
SELECT * FROM child ORDER BY id;

--echo #
--echo # Cold path: restart so that vc_templ is nullptr again
--echo #

INSERT INTO parent VALUES (10), (20);
INSERT INTO child (id, parent_id, val) VALUES (100, 10, 500), (200, 20, 600);

--source include/restart_mysqld.inc

DELETE FROM parent WHERE id = 10;

SELECT * FROM parent ORDER BY id;
SELECT id, parent_id, val, vcol FROM child ORDER BY id;

DROP TABLE child;
DROP TABLE parent;
