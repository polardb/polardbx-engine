# Connection control procedure tests for valid user accounts

# ----------------------------------------------------------------------

# Setup
# Install connection_control plugin
INSTALL PLUGIN connection_control SONAME 'CONNECTION_CONTROL_LIB';
INSTALL PLUGIN connection_control_failed_login_attempts SONAME 'CONNECTION_CONTROL_LIB';
INSTALL PLUGIN connection_control_refuse_statistic SONAME 'CONNECTION_CONTROL_LIB';
# Create user accounts for testing
CREATE USER u1 IDENTIFIED BY 'abcd';
CREATE USER u2 IDENTIFIED BY 'abcd';
CREATE USER u3 IDENTIFIED BY 'abcd';
# Save original values of connection_control variables
SET @saved_connections_threshold = @@global.connection_control_failed_connections_threshold;
SET @saved_refuse_period = @@global.connection_control_refuse_connection_period;
SET @saved_max_delay = @@global.connection_control_max_connection_delay;
SET @saved_min_delay = @@global.connection_control_min_connection_delay;

# ------------------ Test 1 : for connection refuse --------------------------------------

# Set small values for connection_control variables
SET @@global.connection_control_failed_connections_threshold = 3;
SET @@global.connection_control_refuse_connection_period = 10000;
# Make enough failed attempts to trigger refuse
connect(localhost,u1,,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u1,haha,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u2,efgh,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u3,,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u2,haha,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u3,efgh,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u2,,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u1,haha,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u3,efgh,test,MASTER_PORT,MASTER_SOCKET);

# Following attempts will be refused to authenticate the password.
# The connection will not be held
# Refuse to authenticate the password
Connection_control_refuse_generated should be 1
Variable_name	Value
Connection_control_refuse_generated	1
# Refuse to authenticate the password
Connection_control_refuse_generated should be 2
Variable_name	Value
Connection_control_refuse_generated	2
# Refuse to authenticate the password
Connection_control_refuse_generated should be 3
Variable_name	Value
Connection_control_refuse_generated	3
# Refuse to authenticate the password
Connection_control_refuse_generated should be 4
Variable_name	Value
Connection_control_refuse_generated	4
# Refuse to authenticate the password
Connection_control_refuse_generated should be 5
Variable_name	Value
Connection_control_refuse_generated	5
# Refuse to authenticate the password
Connection_control_refuse_generated should be 6
Variable_name	Value
Connection_control_refuse_generated	6

# Unlock the user u1@%, different ip address should be remove totally

Set GLOBAL debug ='+d, simulate_connection_refuse_event_ip';
connect(localhost,u1,,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u1,haha,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u1,haha,test,MASTER_PORT,MASTER_SOCKET);
Set GLOBAL debug ='-d, simulate_connection_refuse_event_ip';
SELECT USERHOST, IP, FAILED_ATTEMPTS FROM INFORMATION_SCHEMA.connection_control_refuse_statistic;
USERHOST	IP	FAILED_ATTEMPTS
'u1'@'%'		3
'u1'@'%'	192.168.1.1	3
'u2'@'%'		3
'u3'@'%'		3
# Unlock the user u1@%
ALTER USER u1 ACCOUNT UNLOCK;
SELECT USERHOST, IP, FAILED_ATTEMPTS FROM INFORMATION_SCHEMA.connection_control_refuse_statistic;
USERHOST	IP	FAILED_ATTEMPTS
'u2'@'%'		3
'u3'@'%'		3
# Connection attempt should succeed.
Connection_control_refuse_generated should be 6
Variable_name	Value
Connection_control_refuse_generated	6
# Refuse to authenticate the password
Connection_control_refuse_generated should be 7
Variable_name	Value
Connection_control_refuse_generated	7
# Refuse to authenticate the password
Connection_control_refuse_generated should be 8
Variable_name	Value
Connection_control_refuse_generated	8
# Unlock all users
ALTER USER u1 ACCOUNT UNLOCK;
ALTER USER u2 ACCOUNT UNLOCK;
ALTER USER u3 ACCOUNT UNLOCK;
# ------------------ Test 2 : for connection delay --------------------------------------

# Disable connection refuse, change mode to delay from refuse
SET @@global.connection_control_refuse_connection_period = 0;
# Set small values for connection_control variables
SET @@global.connection_control_max_connection_delay = 4000;
SET @@global.connection_control_min_connection_delay = 2000;
# Failed attempts should have been reset to zero
SELECT * FROM INFORMATION_SCHEMA.connection_control_failed_login_attempts;
USERHOST	FAILED_ATTEMPTS
# Make enough failed attempts to trigger delay
connect(localhost,u1,,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u1,haha,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u2,efgh,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u3,,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u2,haha,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u3,efgh,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u2,,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u1,haha,test,MASTER_PORT,MASTER_SOCKET);
connect(localhost,u3,efgh,test,MASTER_PORT,MASTER_SOCKET);

# Following attempts will experience delay in server response
# Connection attempt should fail.
Connection_control_delay_generated should be 1
Variable_name	Value
Connection_control_delay_generated	1
# Connection attempt should fail.
Connection_control_delay_generated should be 2
Variable_name	Value
Connection_control_delay_generated	2
# Connection attempt should fail.
Connection_control_delay_generated should be 3
Variable_name	Value
Connection_control_delay_generated	3
# Unlock the user u1@%

SELECT * FROM INFORMATION_SCHEMA.connection_control_failed_login_attempts;
USERHOST	FAILED_ATTEMPTS
'u1'@'%'	4
'u2'@'%'	4
'u3'@'%'	4
ALTER USER u1 ACCOUNT UNLOCK;
SELECT * FROM INFORMATION_SCHEMA.connection_control_failed_login_attempts;
USERHOST	FAILED_ATTEMPTS
'u2'@'%'	4
'u3'@'%'	4
# Connection attempt should fail.
Connection_control_delay_generated should be 3
Variable_name	Value
Connection_control_delay_generated	3
# Connection attempt should fail.
Connection_control_delay_generated should be 4
Variable_name	Value
Connection_control_delay_generated	4
# Connection attempt should fail.
Connection_control_delay_generated should be 5
Variable_name	Value
Connection_control_delay_generated	5
# Unlock all users

ALTER USER u1 ACCOUNT UNLOCK;
ALTER USER u2 ACCOUNT UNLOCK;
ALTER USER u3 ACCOUNT UNLOCK;
SELECT * FROM INFORMATION_SCHEMA.connection_control_failed_login_attempts;
USERHOST	FAILED_ATTEMPTS
# Connection attempt should succeed.
Connection_control_delay_generated should be 5
Variable_name	Value
Connection_control_delay_generated	5
# Connection attempt should succeed.
Connection_control_delay_generated should be 5
Variable_name	Value
Connection_control_delay_generated	5
# Connection attempt should succeed.
Connection_control_delay_generated should be 5
Variable_name	Value
Connection_control_delay_generated	5

# ----------------------------------------------------------------------

# Cleanup
# Restore original values of conenction_control variables
SET @@global.connection_control_failed_connections_threshold = @saved_connections_threshold;
SET @@global.connection_control_refuse_connection_period = @saved_refuse_period;
SET @@global.connection_control_max_connection_delay = @saved_max_delay;
SET @@global.connection_control_min_connection_delay = @saved_min_delay;
# Remove user accounts created for the test
DROP USER u1;
DROP USER u2;
DROP USER u3;
# Uninstall connection_control plugin
UNINSTALL PLUGIN connection_control;
UNINSTALL PLUGIN connection_control_failed_login_attempts;
UNINSTALL PLUGIN connection_control_refuse_statistic;

# ----------------------------------------------------------------------
