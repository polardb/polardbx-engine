#
# Test flush on error in bulk load to make sure we do a proper cleanup.
# Note: We flush all dirty pages before applying any online log in bulk load.
#

-- source include/have_debug.inc

# Create Insert Procedure
DELIMITER |;
CREATE PROCEDURE populate_spc_table()
BEGIN
	DECLARE i int DEFAULT 1;

	START TRANSACTION;
	WHILE (i <= 10000) DO
		INSERT INTO spc_table VALUES (i, CONCAT('name', i), CONCAT('address', i));
		SET i = i + 1;
	END WHILE;
	COMMIT;
END|
DELIMITER ;|

CREATE TABLE spc_table(
	id	INT,
	name	VARCHAR(100),
	address	VARCHAR(100)
) ENGINE=InnoDB;

-- disable_query_log
CALL populate_spc_table();
-- enable_query_log

SELECT COUNT(*) FROM spc_table;

SET SESSION debug="+d,ib_index_build_fail_before_flush";

--error ER_GET_ERRNO
CREATE INDEX idx_id ON spc_table(id) SECONDARY_ENGINE_ATTRIBUTE='{"spc": "true"}';

CHECK TABLE spc_table;

-- error ER_GET_ERRNO
CREATE INDEX idx_name ON spc_table(name) SECONDARY_ENGINE_ATTRIBUTE='{"spc": "true"}';

CHECK TABLE spc_table;

-- error ER_GET_ERRNO
CREATE INDEX idx_address ON spc_table(address) SECONDARY_ENGINE_ATTRIBUTE='{"spc": "true"}';

CHECK TABLE spc_table;

-- error ER_GET_ERRNO
CREATE FULLTEXT INDEX fidx_name ON spc_table(name) SECONDARY_ENGINE_ATTRIBUTE='{"spc": "true"}';

CHECK TABLE spc_table;

-- error ER_GET_ERRNO
ALTER TABLE spc_table ADD COLUMN content TEXT, ALGORITHM=INPLACE;

CHECK TABLE spc_table;

SET SESSION debug="-d,ib_index_build_fail_before_flush";

INSERT INTO spc_table VALUES (10001, CONCAT('name', 10000), CONCAT('address', 10000));

-- error ER_DUP_ENTRY
ALTER TABLE spc_table ADD UNIQUE INDEX idx_name(name) SECONDARY_ENGINE_ATTRIBUTE='{"spc": "true"}';

CHECK TABLE spc_table;

-- error ER_DUP_ENTRY
ALTER TABLE spc_table ADD UNIQUE INDEX idx_id(id) SECONDARY_ENGINE_ATTRIBUTE='{"spc": "true"}', 
                     ADD UNIQUE INDEX idx_name(name) SECONDARY_ENGINE_ATTRIBUTE='{"spc": "true"}';

CHECK TABLE spc_table;

DROP TABLE spc_table;

DROP PROCEDURE populate_spc_table;
