### Purpose ###
#
# Crash recovery with innodb_mark_corrupt_spc_by_space_id.
# Table layout and data load follow suite/spc/t/redo_simple.test (sbtest1 + sp_insert_random_sbtest_rows);
# this case adds two non-unique SPC secondaries: c1(c1), c2(c2).
#
#   - Purge is held during checksum / doomed txn (sp_insert_random_sbtest_rows uses REPLACE for mix of insert/update/delete).
#   - innodb_change_buffering_debug encourages change buffering for secondaries.
#   - A large transaction updates columns indexed by both SPC secondaries; not committed;
#     mysqld is killed.
#   - Smoke restart with knob: suite/spc/t/feature_spc_mark_corrupt_spc_restart_smoke.test
#   - This file: data load, crash + knob recovery, clean restart, purge/stats, DROP INDEX, DML.
#   - After knob recovery, SPC secondaries are corrupt in DD: assert PK checksum only (vs pre-crash snapshot).
#   - After any mysqld restart, SESSION state is lost; GLOBALs revert to defaults unless set again.

--source include/have_debug.inc
--source include/not_valgrind.inc
--source include/have_innodb_max_16k.inc

# wait_until_connected_again.inc: default ~100s (1000 x sleep 0.1); long recovery can exceed that.
# $explicit_default_wait_counter persists for this test; each unit is 0.1s (72000 => 2h).
--let $explicit_default_wait_counter=72000

--echo #
--echo # Schema + SPC indexes c1(c1), c2(c2) (redo_simple-style sbtest1 + extra char column)
--echo #

--connection default

DROP DATABASE IF EXISTS sbtest;
CREATE DATABASE sbtest;

USE sbtest;

CREATE TABLE `sbtest1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `k` int NOT NULL DEFAULT '0',
  `c1` char(120) NOT NULL DEFAULT '',
  `c2` char(120) NOT NULL DEFAULT '',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=0 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

set opt_index_format_spc_enabled = 1;
ALTER TABLE sbtest.sbtest1 ADD INDEX c1(c1);
ALTER TABLE sbtest.sbtest1 ADD INDEX c2(c2);

SELECT index_name, index_page_type
  FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS
  WHERE SCHEMA_NAME = 'sbtest' AND TABLE_NAME = 'sbtest1'
  ORDER BY index_name;

DELIMITER //;

CREATE PROCEDURE sp_insert_random_sbtest_rows(IN num_rows INT)
BEGIN
    DECLARE i INT DEFAULT 0;

    SET @table_size = 2500;
    SET @group_len = 11;
    SET @base_group_string = RPAD('', @group_len, '@');

    WHILE i < num_rows DO
        REPLACE INTO sbtest.sbtest1 (id, k, c1, c2)
        VALUES (
            FLOOR(1 + RAND() * @table_size),
            FLOOR(1 + RAND() * @table_size),
            CONCAT_WS('-',
              (CASE WHEN RAND() < 1.0 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.9 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.8 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.7 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.6 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.5 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.4 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.3 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.2 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.1 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END)
            ),
            CONCAT_WS('-',
              (CASE WHEN RAND() < 1.0 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.9 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.8 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.7 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.6 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.5 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.4 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.3 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.2 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
              (CASE WHEN RAND() < 0.1 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END)
            )
        );
        SET i = i + 1;
    END WHILE;
END //

DELIMITER ;//

--connection default

--source suite/innodb/include/force_purge.inc
SET GLOBAL innodb_purge_stop_now = ON;

SET GLOBAL innodb_stats_auto_recalc = OFF;
SET GLOBAL innodb_change_buffering_debug = 1;
set global innodb_redo_log_capacity = 4*1024*1024*1024;
set global innodb_buffer_pool_size = 4303355904;
SET GLOBAL innodb_log_checkpoint_now = 1;
SET GLOBAL innodb_page_cleaner_disabled_debug = 1;
SET GLOBAL innodb_checkpoint_disabled = 1;

--echo #
--echo # Data load (redo_simple-style), crash recovery with mark_corrupt knob
--echo #
--echo # Load: 2500 rows per session x4 (mysqltest cannot --eval --send; four parallel CALLs below).
--echo #

--connect (con1, localhost, root,,sbtest)
--connect (con2, localhost, root,,sbtest)
--connect (con3, localhost, root,,sbtest)
--connect (con4, localhost, root,,sbtest)

--connection con1
--send CALL sbtest.sp_insert_random_sbtest_rows(2500)
--connection con2
--send CALL sbtest.sp_insert_random_sbtest_rows(2500)
--connection con3
--send CALL sbtest.sp_insert_random_sbtest_rows(2500)
--connection con4
--send CALL sbtest.sp_insert_random_sbtest_rows(2500)

--connection con1
--reap
--connection con2
--reap
--connection con3
--reap
--connection con4
--reap

--disconnect con1
--disconnect con2
--disconnect con3
--disconnect con4

--connection default

--echo #
--echo # Fingerprint committed rows (via PK) before uncommitted txn — after recovery must match
--echo #

let $chk_pk = `SELECT BIT_XOR(CRC32(CONCAT_WS('|', id, k, c1, c2))) FROM sbtest.sbtest1 FORCE INDEX (PRIMARY)`;

--connect (con_big, localhost, root,,sbtest)
--echo #
--echo # Large open transaction touching c1, c2 (SPC secondaries) and k; not committed
--echo #

--connection con_big
BEGIN;
--disable_query_log
let $i = 50;
while ($i <= 1500) {
  eval UPDATE sbtest.sbtest1 SET
    c1 = CONCAT('Z', SUBSTRING(c1, 1, 119)),
    k = k + 3,
    c2 = CONCAT('W', SUBSTRING(c2, 1, 119))
    WHERE id = $i;
  inc $i;
}
--enable_query_log

--echo # kill_and_restart on default (reconnect via kill_and_restart_mysqld.inc, same pattern as redo_simple.test)
--connection default

--let $restart_parameters= `SELECT CONCAT('restart: --loose-innodb-mark-corrupt-spc-by-space-id=', SPACE) FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME = 'sbtest/sbtest1'`
--replace_regex /space-id=[0-9]+/space-id=SPACE_ID/
--source include/kill_and_restart_mysqld.inc

--disconnect con_big
--connection default

--echo #
--echo # After recovery with knob: SPC indexes are DICT_CORRUPT — only PK checksum vs pre-crash baseline
--echo #

USE sbtest;

let $chk_pk2 = `SELECT BIT_XOR(CRC32(CONCAT_WS('|', id, k, c1, c2))) FROM sbtest.sbtest1 FORCE INDEX (PRIMARY)`;
--let $assert_text = PK checksum unchanged after recovery vs baseline
--let $assert_cond = $chk_pk2 = $chk_pk
--source include/assert.inc


--echo #
--echo # Purge + stats. Read SPC indexes get corrupt error.
--echo #

SET GLOBAL innodb_purge_run_now = ON;
--source include/wait_innodb_all_purged.inc

ANALYZE TABLE sbtest.sbtest1;

--error ER_INDEX_CORRUPT
SELECT COUNT(*) FROM sbtest.sbtest1 FORCE INDEX (c1);
--error ER_INDEX_CORRUPT
SELECT COUNT(*) FROM sbtest.sbtest1 FORCE INDEX (c2);

--echo #
--echo # Drop SPC indexes + DML
--echo #

DROP INDEX c1 ON sbtest.sbtest1;
DROP INDEX c2 ON sbtest.sbtest1;

CHECK TABLE sbtest.sbtest1;

INSERT INTO sbtest.sbtest1 (id, k, c1, c2)
  VALUES (60001, 0, REPEAT('p', 120), REPEAT('q', 120));
UPDATE sbtest.sbtest1 SET c2 = REPEAT('r', 120) WHERE id = 60001;
DELETE FROM sbtest.sbtest1 WHERE id BETWEEN 500 AND 502;

INSERT INTO sbtest.sbtest1 (k, c1, c2) VALUES (0, REPEAT('s', 120), REPEAT('t', 120));

--echo #
--echo # Final restart
--echo #

--let $restart_parameters=
--source include/restart_mysqld.inc

DROP PROCEDURE sp_insert_random_sbtest_rows;
DROP TABLE sbtest.sbtest1;
DROP DATABASE sbtest;

SET GLOBAL innodb_change_buffering_debug = default;
SET GLOBAL innodb_stats_auto_recalc = default;

