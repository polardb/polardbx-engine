# Prepare the table.
Warnings:
Note	1051	Unknown table 'test.spc_table'
CREATE TABLE spc_table (
id INT,
name VARCHAR(200),
address VARCHAR(200),
PRIMARY KEY (id)
) ENGINE=InnoDB;
# Create Insert Procedure
CREATE PROCEDURE populate_spc_table(IN max_rows INT)
BEGIN
DECLARE i INT DEFAULT 1;
DECLARE name_prefix VARCHAR(200) DEFAULT REPEAT('a', 190);
START TRANSACTION;
WHILE (i <= max_rows) DO
INSERT INTO spc_table VALUES (i, CONCAT(name_prefix, i), CONCAT('address', i));
SET i = i + 1;
END WHILE;
COMMIT;
END|
# Test 1: Bulk create SPC index. The index only have one page, and the page 
# have been encoded by using Prefix Compression. 
SET GLOBAL innodb_fill_factor = 10;
# Rough calculation for compression threshold with fill_factor=10:
# 6-8 records without compression will trigger the first page split.
# After the first page have been compressed, about 6 records will 
# trigger the second page split. So, we just insert 10 records to 
# make sure only one page is used.
SELECT COUNT(*) FROM spc_table;
COUNT(*)
10
CREATE INDEX idx_name ON spc_table(name, address) SECONDARY_ENGINE_ATTRIBUTE='{"spc": "true"}';
CHECK TABLE spc_table;
Table	Op	Msg_type	Msg_text
test.spc_table	check	status	OK
# Select by index.
SELECT * FROM spc_table FORCE INDEX (idx_name) WHERE name like '%1';
id	name	address
1	aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa1	address1
SELECT * FROM spc_table FORCE INDEX (idx_name) WHERE name like '%3';
id	name	address
3	aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa3	address3
# Insert/update/delete.
DELETE FROM spc_table WHERE name like '%1';
INSERT INTO spc_table VALUES (16, 'aaaaaaaaaaa16', 'address16');
UPDATE spc_table SET address = CONCAT('address', 'test') WHERE name like '%5';
# Clean up this index.
DROP INDEX idx_name ON spc_table;
TRUNCATE TABLE spc_table;
# Test 2: Bulk create SPC index. The index have multiple pages.
SELECT COUNT(*) FROM spc_table;
COUNT(*)
500
CREATE INDEX idx_name ON spc_table(name, address) SECONDARY_ENGINE_ATTRIBUTE='{"spc": "true"}';
