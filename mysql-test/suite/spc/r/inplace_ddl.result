# === Case 16: Extending varchar (column not in SPC INDEX), add new SPC index on it -> INPLACE succeed, But REBUILD ===
# Column d is NOT in any SPC INDEX. Extending d + adding SPC index on d in same ALTER triggers REBUILD.
# Existing SPC indexes lose SPC attribute after rebuild (opt_index_format_spc_enabled=0)
#
CREATE TABLE t7 (
id INT PRIMARY KEY,
a VARCHAR(10),
b VARCHAR(10),
d VARCHAR(20)
) ENGINE=InnoDB;
ALTER TABLE t7 ADD INDEX idx_a_spc (a) SECONDARY_ENGINE_ATTRIBUTE='{"spc":"true"}';
INSERT INTO t7 VALUES (1, 'a', 'x', 'hello'), (2, 'aa', 'xx', 'world');
