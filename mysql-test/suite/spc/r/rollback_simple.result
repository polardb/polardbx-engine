set global transaction_isolation = 'read-committed';
set global innodb_undo_retention = 120;
set global innodb_change_buffering = none;
create database sbtest;
use sbtest;
CREATE TABLE `sbtest1` (
`id` int NOT NULL,
`k` bigint NOT NULL DEFAULT '0',
`c` char(120) NOT NULL DEFAULT '',
`pad` char(60) NOT NULL DEFAULT '',
primary key(id)
) ENGINE=InnoDB AUTO_INCREMENT=0 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
set opt_index_format_spc_enabled = 1;
alter table sbtest.sbtest1 add index k(k);
CREATE PROCEDURE sp_insert_random_sbtest_rows(IN num_rows INT)
BEGIN
DECLARE i INT DEFAULT 0;
SET @table_size = 5000;
SET @group_len = 11;
SET @pad_len = 60;
SET @base_group_string = RPAD('', @group_len, '@');
WHILE i < num_rows DO
START TRANSACTION;
REPLACE INTO sbtest.sbtest1 (id, k, c, pad)
VALUES (
FLOOR(1 + RAND() * @table_size),
FLOOR(1 + RAND() * @table_size),
CONCAT_WS('-',
(CASE WHEN RAND() < 1.0 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
(CASE WHEN RAND() < 0.9 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
(CASE WHEN RAND() < 0.8 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
(CASE WHEN RAND() < 0.7 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
(CASE WHEN RAND() < 0.6 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
(CASE WHEN RAND() < 0.5 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
(CASE WHEN RAND() < 0.4 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
(CASE WHEN RAND() < 0.3 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
(CASE WHEN RAND() < 0.2 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END),
(CASE WHEN RAND() < 0.1 THEN @base_group_string ELSE SUBSTRING(MD5(RAND()), 1, @group_len) END)
),
SUBSTRING(MD5(RAND()), 1, @pad_len)
);
SET i = i + 1;
IF (i > 0 AND i % 2 = 0) THEN
COMMIT;
ELSE
ROLLBACK;
END IF;
IF (i > 0 AND i % 5000 = 0) THEN
WITH
checksum_secondary AS (
SELECT BIT_XOR(CRC32(c)) AS chk FROM sbtest.sbtest1 FORCE INDEX (k)
),
checksum_primary AS (
SELECT BIT_XOR(CRC32(c)) AS chk FROM sbtest.sbtest1 FORCE INDEX (PRIMARY)
)
SELECT
CASE
WHEN NOT (s.chk <=> p.chk) THEN
'CHECKSUM_FAILED'
                ELSE
'CHECKSUM_OK'
              END AS verification_result
FROM
checksum_secondary AS s,
checksum_primary AS p;
END IF;
END WHILE;
END //
select @@transaction_isolation;
@@transaction_isolation
READ-COMMITTED
call sbtest.sp_insert_random_sbtest_rows(20000);
select @@transaction_isolation;
@@transaction_isolation
READ-COMMITTED
call sbtest.sp_insert_random_sbtest_rows(20000);
select @@transaction_isolation;
@@transaction_isolation
READ-COMMITTED
call sbtest.sp_insert_random_sbtest_rows(20000);
select @@transaction_isolation;
@@transaction_isolation
READ-COMMITTED
call sbtest.sp_insert_random_sbtest_rows(20000);
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
verification_result
CHECKSUM_OK
drop PROCEDURE sp_insert_random_sbtest_rows;
drop table sbtest.sbtest1;
drop database sbtest;
set global innodb_undo_retention = default;
set global innodb_change_buffering = default;
set global transaction_isolation = default;
