#
# CASE 1: simple insert
#
# DYNAMIC
SET opt_index_format_spc_enabled = ON;
CREATE TABLE t1 (id INT NOT NULL AUTO_INCREMENT PRIMARY KEY, c VARCHAR(120) NOT NULL DEFAULT '', KEY idx_c (c)) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;;
SET GLOBAL innodb_log_checkpoint_now = 1;
# Produce redo (checkpoint disabled)
SET GLOBAL innodb_checkpoint_disabled = 1;
INSERT INTO t1 (c) VALUES (CONCAT(REPEAT('a', 100), 1)); INSERT INTO t1 (c) VALUES (CONCAT(REPEAT('b', 100), 2)); UPDATE t1 SET c = CONCAT(REPEAT('c', 100)) WHERE id = 1;;
# Kill the server
# mysqld was killed by no_checkpoint_end; restart to replay redo
# restart
# After recovery: verify SPC index == PRIMARY KEY (checksum)
WITH
ck_spc AS (SELECT BIT_XOR(CRC32(CONCAT_WS(',', id, c))) AS chk
FROM t1 FORCE INDEX (idx_c)),
ck_pk  AS (SELECT BIT_XOR(CRC32(CONCAT_WS(',', id, c))) AS chk
FROM t1 FORCE INDEX (PRIMARY))
SELECT IF(s.chk <=> p.chk, 'CHECKSUM_OK', 'CHECKSUM_FAILED') AS result
FROM ck_spc AS s, ck_pk AS p;
result
CHECKSUM_OK
SET GLOBAL innodb_checkpoint_disabled = 0;
SET opt_index_format_spc_enabled = 1;
SHOW CREATE TABLE t1; SELECT id, LEFT(c,1) AS cp FROM t1 ORDER BY id; DROP TABLE IF EXISTS t1;;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `c` varchar(120) NOT NULL DEFAULT '',
  PRIMARY KEY (`id`),
  KEY `idx_c` (`c`)
) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC
id	cp
1	c
2	b
