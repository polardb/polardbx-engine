#
# CASE 5: insert reusing del-marked slot (DELETE + INSERT in one txn)
#
# DYNAMIC
SET opt_index_format_spc_enabled = ON;
CREATE TABLE t1 (id INT NOT NULL AUTO_INCREMENT PRIMARY KEY, c VARCHAR(120) NOT NULL DEFAULT '', KEY idx_c (c)) ENGINE=InnoDB ROW_FORMAT=DYNAMIC; INSERT INTO t1 (id, c) VALUES (1, CONCAT(REPEAT('a', 100), 1));;
SET GLOBAL innodb_log_checkpoint_now = 1;
# Produce redo (checkpoint disabled)
SET GLOBAL innodb_checkpoint_disabled = 1;
BEGIN; DELETE FROM t1 WHERE id = 1; INSERT INTO t1 (id, c) VALUES (2, CONCAT(REPEAT('b', 100), 2)); COMMIT;;
# Kill the server
# mysqld was killed by no_checkpoint_end; restart to replay redo
# restart
# After recovery: verify SPC index == PRIMARY KEY (checksum)
WITH
ck_spc AS (SELECT BIT_XOR(CRC32(CONCAT_WS(',', id, c))) AS chk
FROM t1 FORCE INDEX (idx_c)),
ck_pk  AS (SELECT BIT_XOR(CRC32(CONCAT_WS(',', id, c))) AS chk
FROM t1 FORCE INDEX (PRIMARY))
SELECT IF(s.chk <=> p.chk, 'CHECKSUM_OK', 'CHECKSUM_FAILED') AS result
FROM ck_spc AS s, ck_pk AS p;
result
CHECKSUM_OK
SET GLOBAL innodb_checkpoint_disabled = 0;
SET opt_index_format_spc_enabled = 1;
