SET opt_index_format_hippo_enabled=off;
CREATE TABLE dummy_table (id int primary key);
INSERT INTO dummy_table VALUES (1);
CREATE PROCEDURE populate_spc(IN tbl VARCHAR(64), IN n INT)
BEGIN
DECLARE i INT DEFAULT 1;
DECLARE prefix VARCHAR(200);
SET prefix = REPEAT('a', 190);
START TRANSACTION;
WHILE (i <= n) DO
SET @s = CONCAT('INSERT INTO ', tbl,
' VALUES (', i, ',',
' CONCAT(''', prefix, ''', LPAD(', i, ',10,''0'')),',
' CONCAT(''', prefix, ''', LPAD(', i, ' % 100,10,''0'')))');
PREPARE stmt FROM @s;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
SET i = i + 1;
END WHILE;
COMMIT;
END|
#####################################
# Test 1: Basic SPC Index Export/Import
#   - 500 rows with long common prefix → encoded pages
#   - 5 extra rows after batch → last page may be non-encoded
#####################################
CREATE TABLE t1 (
id  INT NOT NULL PRIMARY KEY,
c1  VARCHAR(200),
c2  VARCHAR(200),
INDEX idx_c1 (c1),
INDEX idx_c1_prefix (c1(64)),
INDEX idx_c1c2 (c1, c2)
) ENGINE=InnoDB;
CALL populate_spc('t1', 500);
INSERT INTO t1 VALUES (501, CONCAT(REPEAT('a',190), 'EXTRA00001'),
CONCAT(REPEAT('a',190), 'EXTRA_0001'));
INSERT INTO t1 VALUES (502, CONCAT(REPEAT('a',190), 'EXTRA00002'),
CONCAT(REPEAT('a',190), 'EXTRA_0002'));
SELECT INDEX_NAME, INDEX_PAGE_TYPE FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS
WHERE TABLE_NAME='t1' AND SCHEMA_NAME='test' ORDER BY INDEX_NAME;
INDEX_NAME	INDEX_PAGE_TYPE
idx_c1	SPC_PAGE
idx_c1c2	SPC_PAGE
idx_c1_prefix	SPC_PAGE
PRIMARY	INDEX
include/assert.inc [Pre-export: PK and SPC index checksum must match]
include/assert.inc [Pre-export: PK and SPC prefix index checksum must match]
CHECKSUM TABLE t1;
Table	Checksum
test.t1	4222443122
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
BEGIN;
SELECT * FROM dummy_table;
id
1
FLUSH TABLE t1 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE t1;
CREATE TABLE t1 (
id  INT NOT NULL PRIMARY KEY,
c1  VARCHAR(200),
c2  VARCHAR(200),
INDEX idx_c1 (c1),
INDEX idx_c1_prefix (c1(64)),
INDEX idx_c1c2 (c1, c2)
) ENGINE=InnoDB;
ALTER TABLE t1 DISCARD TABLESPACE;
ALTER TABLE t1 IMPORT TABLESPACE;
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
CHECKSUM TABLE t1;
Table	Checksum
test.t1	4222443122
SELECT COUNT(*) FROM t1;
COUNT(*)
502
SELECT INDEX_NAME, INDEX_PAGE_TYPE FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS
WHERE TABLE_NAME='t1' AND SCHEMA_NAME='test' ORDER BY INDEX_NAME;
INDEX_NAME	INDEX_PAGE_TYPE
idx_c1	SPC_PAGE
idx_c1c2	SPC_PAGE
idx_c1_prefix	SPC_PAGE
PRIMARY	INDEX
include/assert.inc [Post-import: PK and SPC index checksum must match]
include/assert.inc [Post-import: PK and SPC prefix index checksum must match]
SELECT COUNT(*) FROM t1 FORCE INDEX(idx_c1) WHERE c1 < CONCAT(REPEAT('a',190), '0000000100');
COUNT(*)
99
SELECT COUNT(*) FROM t1 FORCE INDEX(idx_c1_prefix) WHERE c1 < CONCAT(REPEAT('a',190), '0000000100');
COUNT(*)
99
SELECT COUNT(*) FROM t1 FORCE INDEX(idx_c1c2);
COUNT(*)
502
SELECT id FROM t1 FORCE INDEX(idx_c1) WHERE c1 LIKE '%EXTRA%' ORDER BY id;
id
501
502
SELECT c1 FROM t1 FORCE INDEX(idx_c1) WHERE c1 LIKE '%0000000001' LIMIT 1;
ERROR HY000: Table definition has changed, please retry transaction
COMMIT;
DROP TABLE t1;
#####################################
# Test 2: SPC -> non-SPC Mismatch (should fail)
#####################################
CREATE TABLE t2 (
id int NOT NULL PRIMARY KEY,
c1 int NOT NULL,
INDEX idx_c1 (c1)
) ENGINE=InnoDB;
INSERT INTO t2 VALUES (1, 100), (2, 200);
SELECT INDEX_NAME, INDEX_PAGE_TYPE FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS
WHERE TABLE_NAME='t2' AND SCHEMA_NAME='test' AND INDEX_NAME='idx_c1';
INDEX_NAME	INDEX_PAGE_TYPE
idx_c1	SPC_PAGE
FLUSH TABLE t2 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE t2;
SET opt_index_format_spc_enabled=off;
CREATE TABLE t2 (
id int NOT NULL PRIMARY KEY,
c1 int NOT NULL,
INDEX idx_c1 (c1)
) ENGINE=InnoDB;
SET opt_index_format_spc_enabled=on;
SELECT INDEX_NAME, INDEX_PAGE_TYPE FROM INFORMATION_SCHEMA.INNODB_INDEX_STATUS
WHERE TABLE_NAME='t2' AND SCHEMA_NAME='test' AND INDEX_NAME='idx_c1';
INDEX_NAME	INDEX_PAGE_TYPE
idx_c1	INDEX
ALTER TABLE t2 DISCARD TABLESPACE;
ALTER TABLE t2 IMPORT TABLESPACE;
ERROR HY000: Schema mismatch (Page type (17855) of the index idx_c1 is mismatch with the page type (42) tablespace meta-data file.)
DROP TABLE t2;
#####################################
