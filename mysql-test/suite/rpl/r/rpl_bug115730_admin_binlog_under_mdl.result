bug115730_db.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
bug115730_db.t1	optimize	status	OK
include/assert_grep.inc [scenario 3b: single-table OPTIMIZE recorded exactly one binlog event]
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
include/assert.inc [scenario 3b: no replica applier worker reported an error]
include/assert.inc [scenario 3b: OPTIMIZE replicated, t1 still readable]
# --- scenario 4: multi-table ANALYZE still writes to binlog ---
