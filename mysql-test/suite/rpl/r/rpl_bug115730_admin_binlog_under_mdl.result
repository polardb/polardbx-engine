# --- scenario 8: TRY_ALTER failure writes exactly one binlog event via caller ---
[connection master]
SET SESSION debug = '+d,admin_try_alter_fail_after_recreate';
OPTIMIZE TABLE bug115730_db.t1;
Table	Op	Msg_type	Msg_text
bug115730_db.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
bug115730_db.t1	optimize	error	Unknown error
bug115730_db.t1	optimize	status	Operation failed
