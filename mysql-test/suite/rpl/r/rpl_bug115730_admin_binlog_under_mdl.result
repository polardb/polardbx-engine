# --- scenario 9: sql_log_bin=0 suppresses binlog for single-table OPTIMIZE ---
[connection master]
SET sql_log_bin = 0;
OPTIMIZE TABLE bug115730_db.t1;
Table	Op	Msg_type	Msg_text
bug115730_db.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
bug115730_db.t1	optimize	status	OK
SET sql_log_bin = 1;
include/assert.inc [scenario 9: binlog position unchanged when sql_log_bin=0]
[connection master]
DROP DATABASE bug115730_db;
