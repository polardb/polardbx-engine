[connection master]
[connection slave]
STOP REPLICA SQL_THREAD;
SET GLOBAL replica_parallel_workers = 4;
SET GLOBAL replica_parallel_type    = 'LOGICAL_CLOCK';
Warnings:
Warning	1287	'@@replica_parallel_type' is deprecated and will be removed in a future release.
START REPLICA SQL_THREAD;
[connection master]
CREATE DATABASE bug115730_db;
CREATE TABLE bug115730_db.t1 (id INT) ENGINE=InnoDB;
INSERT INTO bug115730_db.t1 VALUES (0);
CREATE TABLE bug115730_db.t3 (id INT) ENGINE=InnoDB;
INSERT INTO bug115730_db.t3 VALUES (100);
CREATE TABLE bug115730_db.pt (id INT) ENGINE=InnoDB PARTITION BY RANGE (id) (PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN (20), PARTITION p2 VALUES LESS THAN MAXVALUE);
INSERT INTO bug115730_db.pt VALUES (1), (5), (15), (25);
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
# --- scenario 1: ANALYZE TABLE + XA PREPARE in same BGC group ---
[connection master]
SET DEBUG_SYNC = 'bgc_before_flush_stage SIGNAL admin_in_bgc1 WAIT_FOR xa_in_bgc1';
ANALYZE TABLE bug115730_db.t1;
SET DEBUG_SYNC = 'now WAIT_FOR admin_in_bgc1';
SET DEBUG_SYNC = 'bgc_before_flush_stage SIGNAL xa_in_bgc1';
XA START 'bug115730_xa1';
INSERT INTO bug115730_db.t1 VALUES (1);
XA END 'bug115730_xa1';
XA PREPARE 'bug115730_xa1';
Table	Op	Msg_type	Msg_text
bug115730_db.t1	analyze	status	OK
XA COMMIT 'bug115730_xa1';
[connection master]
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
include/assert.inc [scenario 1: replica row count matches master after ANALYZE+XA]
include/assert.inc [scenario 1: no replica applier worker reported an error]
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'RESET';
# --- scenario 2: OPTIMIZE TABLE main-loop path replicates ---
[connection master]
SET @save_fulltext_only = @@GLOBAL.innodb_optimize_fulltext_only;
SET GLOBAL innodb_optimize_fulltext_only = ON;
OPTIMIZE TABLE bug115730_db.t1;
Table	Op	Msg_type	Msg_text
bug115730_db.t1	optimize	status	OK
SET GLOBAL innodb_optimize_fulltext_only = @save_fulltext_only;
include/assert.inc [scenario 2: OPTIMIZE produced binlog events on master]
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
include/assert.inc [scenario 2: OPTIMIZE replicated, t1 readable]
include/assert.inc [scenario 2: no replica applier worker reported an error]
# --- scenario 3: OPTIMIZE TABLE HA_ADMIN_TRY_ALTER path replicates ---
[connection master]
OPTIMIZE TABLE bug115730_db.t1;
Table	Op	Msg_type	Msg_text
bug115730_db.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
bug115730_db.t1	optimize	status	OK
include/assert.inc [scenario 3: OPTIMIZE (TRY_ALTER) produced binlog events on master]
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
include/assert.inc [scenario 3: OPTIMIZE (TRY_ALTER) replicated, t1 readable]
include/assert.inc [scenario 3: no replica applier worker reported an error]
