##### test for table with trigger
set global hotspot_for_autocommit=1;
create table t1(id int primary key, a int) engine = innodb;
create table t2(id int primary key, a int) engine = innodb;
create trigger t1_trigger before update on t1 for each row update t2 set a = new.a;
insert into t1 select 1,1000;
insert into t1 select 2,1000;
insert into t1 select 3,1000;
insert into t2 select 1,1000;
