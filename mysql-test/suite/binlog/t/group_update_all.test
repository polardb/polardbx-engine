##### test for follower be killed while leader start commit
--echo ##### test for follower be killed while leader start commit
connection default;
set debug_sync='now SIGNAL nogo';
# new lock
create table t1(id int primary key, a int) engine = innodb;

insert into t1 select 1,1000;
insert into t1 select 2,1000;
insert into t1 select 3,1000;
insert into t1 select 4,1000;


# kill
connection con4;
set debug_sync='now signal nogo';
set debug_sync='update_unlock_after WAIT_FOR go';
#set debug_sync='before_leader_done WAIT_FOR go1';
set debug_sync='leader_enter_commit_done WAIT_FOR go1';
--send update t1 set a=a-1 where id = 2;
--sleep 0.5
connection con11;
--send update       t1 set a=a-1 where id = 2;
--sleep 0.5
connection con2;
set debug_sync='follower_wait_all_done_after_wait WAIT_FOR go1';
--send update            t1 set a=a-1 where id = 2;

connection con5;
--sleep 0.5
--replace_column 1 # 6 #
show processlist;
set debug_sync='now signal go';
--sleep 1
--replace_column 1 # 6 #
show processlist;
--sleep 2
select ID into @id from information_schema.PROCESSLIST where INFO like 'update       t1 set a%';
kill @id;
--replace_column 1 # 6 #
show processlist;
--sleep 0.5
set debug_sync='now signal go1';
# Revision: Do not know why must signal twice
--sleep 1
set debug_sync='now signal go1';


connection con4;
--reap
connection con11;
--error 2013
--reap
connection con2;
--reap

connection default;
show global status like 'Group_update%';
select * from t1;
--replace_column 1 # 6 #
show processlist;


flush logs;
let $MYSQLD_DATADIR=`select @@datadir`;
--exec $MYSQL_BINLOG --verbose $MYSQLD_DATADIR/binlog.000008 |egrep '^###|^BEGIN|^COMMIT'

select * from t1;
drop table t1;


##### test for part key and null case
--echo ##### test for part key and null case
create table t1(id1 int not null, id2 int not null, u1 int, u2 int,  a int, primary key(id1, id2), unique key (u1, u2)) engine = innodb;
insert into t1 select 1,1,1,NULL,1;
insert into t1 select 1,2,1,NULL,1;
insert into t1 select 2,3,2,1,1;
insert into t1 select 2,4,2,2,1;


show global status like 'Group_update_leader_count';
update t1 set a=a+1 where id1 = 1;
select * from t1 where id1 = 1;
show global status like 'Group_update_leader_count';
update t1 set a=a+1 where id1 = 1 and id2 = 2;
select * from t1 where id1 = 1 and id2 = 2;
show global status like 'Group_update_leader_count';

# test variables hotspot_for_autocommit
set global hotspot_for_autocommit=0;
update t1 set a=a+1 where id1 = 1 and id2 = 2;
select * from t1 where id1 = 1 and id2 = 2;

show global status like 'Group_update_leader_count';
update t1 set a=a+1 where u1 = 1 and u2 is null;
select * from t1 where u1 = 1 and u2 is null;
show global status like 'Group_update_leader_count';
update t1 set a=a+1 where u1 = 2 and u2 = 1;
select * from t1 where u1 = 2 and u2 = 1;
show global status like 'Group_update_leader_count';
show global status like 'Group_update%';

flush logs;
let $MYSQLD_DATADIR=`select @@datadir`;
--exec $MYSQL_BINLOG --verbose $MYSQLD_DATADIR/binlog.000009 |egrep '^###|^BEGIN|^COMMIT'

select * from t1;
drop table t1;

##### test for table with trigger (not use group update)
--echo ##### test for table with trigger
set global hotspot_for_autocommit=1;
create table t1(id int primary key, a int) engine = innodb;
create table t2(id int primary key, a int) engine = innodb;

create trigger t1_trigger before update on t1 for each row update t2 set a = new.a;

insert into t1 select 1,1000;
insert into t1 select 2,1000;
insert into t1 select 3,1000;
insert into t2 select 1,1000;
insert into t2 select 2,1000;
insert into t2 select 3,1000;

show global status like 'Group_update%';

update t1 set a=a+1 where id = 1;
select * from t1 where id = 1;
update t1 set a=a+2 where id = 2;
select * from t1 where id = 2;
update t1 set a=a+3 where id = 3;
select * from t1 where id = 3;

#value of the counters should not change
show global status like 'Group_update%';

flush logs;
let $MYSQLD_DATADIR=`select @@datadir`;
--exec $MYSQL_BINLOG --verbose $MYSQLD_DATADIR/binlog.000006 |egrep '^###|^BEGIN|^COMMIT'

drop table t1;
drop table t2;

##### test for partitioned table (not use group update)
--echo ##### test for partitioned table
create table t1(id int primary key, a int) engine = innodb partition by hash(id) partitions 3;

insert into t1 select 1,1000;
insert into t1 select 2,1000;
insert into t1 select 3,1000;

show global status like 'Group_update%';

update t1 set a=a+1 where id = 1;
select * from t1 where id = 1;
update t1 set a=a+2 where id = 2;
select * from t1 where id = 2;
update t1 set a=a+3 where id = 3;
select * from t1 where id = 3;

#value of the counters should not change
show global status like 'Group_update%';

flush logs;
let $MYSQLD_DATADIR=`select @@datadir`;
--exec $MYSQL_BINLOG --verbose $MYSQLD_DATADIR/binlog.000006 |egrep '^###|^BEGIN|^COMMIT'

drop table t1;

##### test for session level bin logging (not use group update if it's disabled)
--echo ##### test for disabled session level bin logging
create table t1(id int primary key, a int) engine = innodb;

insert into t1 select 1,1000;
insert into t1 select 2,1000;
insert into t1 select 3,1000;

#disable bin log, group update should not be used
show variables like 'sql_log_bin';
set sql_log_bin = OFF;

show global status like 'Group_update%';

update t1 set a=a+1 where id = 1;
select * from t1 where id = 1;
update t1 set a=a+2 where id = 2;
select * from t1 where id = 2;
update t1 set a=a+3 where id = 3;
select * from t1 where id = 3;

#value of the counters should not change
show global status like 'Group_update%';

#enable bin log, group update should be used
set sql_log_bin = ON;

update t1 set a=a+1 where id = 1;
select * from t1 where id = 1;
update t1 set a=a+2 where id = 2;
select * from t1 where id = 2;
update t1 set a=a+3 where id = 3;
select * from t1 where id = 3;

#value of the counters should change
show global status like 'Group_update%';

flush logs;
let $MYSQLD_DATADIR=`select @@datadir`;
--exec $MYSQL_BINLOG --verbose $MYSQLD_DATADIR/binlog.000006 |egrep '^###|^BEGIN|^COMMIT'

drop table t1;

set global innodb_thread_concurrency= 0;
set global innodb_thread_sleep_delay= 10000;
set global hotspot_update_max_wait_time=100;
set global hotspot_fast_insert_dup=0;
set global hotspot_for_autocommit=0;
set global hotspot_lock_type=0;
set global hotspot=0;
set global polardb_ic_reduce_hint_enable=1;
set global transaction_isolation= 'REPEATABLE-READ';
