##### error by no change with 2 groups
--echo ##### error by no change with 2 groups
connection default;
set debug_sync='now SIGNAL nogo';
set global hotspot_lock_type=0;
create table t1(id int primary key, a int) engine = innodb;

insert into t1 select 1,1000;
insert into t1 select 2,1000;
insert into t1 select 3,1000;
insert into t1 select 4,1000;

connection default;
--send update t1 set a=a-1 where id = 1;
--sleep 0.5
connection con1;
--send update /* 1 */ t1 set a=a-1 where id = 1;
--sleep 0.5
connection con2;
set debug_sync='error_done_before WAIT_FOR go';
--send update /* 2 */ t1 set a=a where id = 1;

--sleep 2
# the new group.
connection con3;
--send update /* 3 */ t1 set a=a-1 where id = 1;

connection con4;
set debug_sync='now SIGNAL go';

connection default;
--error ER_ERROR_DURING_COMMIT
--reap
connection con1;
--error ER_ERROR_DURING_COMMIT
--reap
connection con2;
--error ER_ERROR_DURING_COMMIT
--reap
connection con3;
--reap
update /* 4 */ t1 set a=a-1 where id = 1;
select * from t1 where id = 1;


show global status like 'Group_update%';


## use hotspot_lock_type we should deal with the dependcy between two groups
set global hotspot_lock_type=1;
--sleep 1
connection default;
--send update /* 5 */ t1 set a=a-1 where id = 1;

--sleep 1

connection con1;
--send update /* 6 */ t1 set a=a-1 where id = 1;
connection con2;
set debug_sync='now SIGNAL nogo';
set debug_sync='error_done_before WAIT_FOR go';
--send update /* 7 */ t1 set a=a where id = 1;


--sleep 2
# the new group.
connection con3;
--send update /* 8 */ t1 set a=a-1 where id = 1;

connection con4;
set debug_sync='now SIGNAL go';

connection default;
--error ER_ERROR_DURING_COMMIT
--reap
connection con1;
--error ER_ERROR_DURING_COMMIT
--reap
connection con2;
--error ER_ERROR_DURING_COMMIT
--reap
connection con3;
--error ER_ERROR_DURING_COMMIT
--reap
update /* 9 */ t1 set a=a-1 where id = 1;
select * from t1 where id = 1;

show global status like 'Group_update%';

connection default;
show global status like 'Group_update%';
select * from t1;

flush logs;
