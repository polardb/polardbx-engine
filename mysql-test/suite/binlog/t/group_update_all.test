##### test for uk
--echo ##### test for uk
connection default;
set debug_sync='now SIGNAL nogo';
set global hotspot_fast_insert_dup=1;
create table t1(id int primary key, a int, u1 int not null, u2 varchar(10) not null, unique key uk(u1, u2)) engine = innodb;

insert into t1 select 1,1000,1,'aa1';
insert into t1 select 2,1000,2,'aa2';
insert into t1 select 3,1000,3,'aa3';
insert into t1 select 4,1000,4,'aa4';

set debug_sync='update_unlock_before WAIT_FOR go';
--send update t1 set a=a-1 where u1=1 and u2='aa1';
--sleep 0.5
connection con1;
--send update       t1 set a=a-1 where u1=1 and u2='aa1';
--sleep 0.5
connection con2;
--send update            t1 set a=a-1 where u1=1 and u2='aa1';

connection con3;
--send update t1 set a=a-1 where u1=2 and u2='aa2';
--sleep 0.5
connection con4;
--send update       t1 set a=a-1 where u1=2 and u2='aa2';
--sleep 0.5
connection con5;
--send update            t1 set a=a-1 where u1=2 and u2='aa2';

connection con3;
--reap
connection con4;
--reap
connection con5;
--reap

connection con6;
# --error ER_DUP_ENTRY
# Revision: NOT SUPPORT hotspot_fast_insert_dup again
set innodb_lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
insert into t1 select 5,1000,1,'aa1';
show global status like 'Group_update_insert_dup';
set innodb_lock_wait_timeout=1;
begin;
--error ER_LOCK_WAIT_TIMEOUT
insert into t1 select 5,1000,1,'aa1';
rollback;
show global status like 'Group_update_insert_dup';
set debug_sync='now SIGNAL go';
connection default;
--reap
connection con1;
--reap
connection con2;
--reap

connection default;
show global status like 'Group_update%';
select * from t1;


connection default;
--send update t1 set a=a-1 where u1=1 and u2='aa1';
--sleep 0.5
connection con1;
--send update       t1 set a=a-1 where u1=1 and u2='aa1';
--sleep 0.5
connection con2;
--send update            t1 set a=a-1 where u1=1 and u2='aa1';

connection default;
--reap
connection con1;
--reap
connection con2;
--reap

connection default;
show global status like 'Group_update%';
select * from t1;

flush logs;
let $MYSQLD_DATADIR=`select @@datadir`;
--exec $MYSQL_BINLOG --verbose $MYSQLD_DATADIR/binlog.000003 |egrep '^###|^BEGIN|^COMMIT'
drop table t1;


##### test for new lock and kill
--echo ##### test for new lock and kill
connection default;
set debug_sync='now SIGNAL nogo';
# new lock
create table t1(id int primary key, a int) engine = innodb;

insert into t1 select 1,1000;
insert into t1 select 2,1000;
insert into t1 select 3,1000;
insert into t1 select 4,1000;

set debug_sync='update_unlock_after WAIT_FOR go';
--send update t1 set a=a-1 where id = 1;
--sleep 0.5
connection con1;
--send update       t1 set a=a-1 where id = 1;
--sleep 0.5
connection con2;
--send update            t1 set a=a-1 where id = 1;

connection con3;
--sleep 2
# the new group.
--send update                t1 set a=a-1 where id = 1;

connection con5;
--sleep 3
--replace_column 1 # 6 #
show processlist;
--send delete from t1 where id = 1;

connection con4;
--sleep 2
--replace_column 1 # 6 #
show processlist;
select count(*) from performance_schema.data_lock_waits;
select count(*) from performance_schema.data_locks;
set debug_sync='now signal go';


connection default;
--reap
connection con1;
--reap
connection con2;
--reap
connection con3;
--reap
connection con5;
--reap

# new lock X with normal lock
connection con1;
set debug_sync='now SIGNAL nogo';
insert into t1 select 1,1000;
begin;
select * from t1 where id=1 for update;

--sleep 1
connection con2;
--send update t1 set a=a-1 where id = 1;

--sleep 1

connection con1;
--replace_column 1 # 6 #
show processlist;
# --replace_regex /.*------- TRX HAS BEEN WAITING/------- TRX HAS BEEN WAITING/ /gap hotspot type waiting.*/gap hotspot type waiting/ /space id [0-9]* page/space id # page/ /trx id [0-9]*/trx id #/ /WAITING [0-9]* SEC/WAITING # SEC/
# show engine innodb status;
select LOCK_TYPE, LOCK_MODE, LOCK_STATUS from performance_schema.data_locks where object_name = 't1';
commit;

# new one
connection con2;
--reap
--sleep 1
set debug_sync='update_unlock_after WAIT_FOR go';
--send update t1 set a=a-1 where id = 1;

--sleep 1
connection con3;
--send select * from t1 /* 1 */ where id=1 for update;


connection con1;
--sleep 3
--replace_column 1 # 6 #
show processlist;
# --replace_regex /.*------- TRX HAS BEEN WAITING/------- TRX HAS BEEN WAITING/ /gap waiting.*/gap waiting/ /space id [0-9]* page/space id # page/ /trx id [0-9]*/trx id #/ /WAITING [0-9]* SEC/WAITING # SEC/
# show engine innodb status;
select LOCK_TYPE, LOCK_MODE, LOCK_STATUS from performance_schema.data_locks where object_name = 't1';
set debug_sync='now signal go';

connection con2;
--reap
connection con3;
--reap


# kill
connection con4;
set debug_sync='now signal nogo';
set debug_sync='update_unlock_after WAIT_FOR go';
--send update t1 set a=a-1 where id = 2;
--sleep 0.5
connection con10;
--send update       t1 set a=a-1 where id = 2;
--sleep 0.5
connection con2;
--send update            t1 set a=a-1 where id = 2;

connection con5;
--sleep 3
select ID into @id from information_schema.PROCESSLIST where INFO like 'update       t1 set a%';
kill @id;
--sleep 1
--replace_column 1 # 6 #
show processlist;
set debug_sync='now signal go';
connection con4;
--error ER_ERROR_DURING_COMMIT
--reap
connection con10;
--error 2013
--reap
connection con2;
--error ER_ERROR_DURING_COMMIT
--reap

connection default;
show global status like 'Group_update%';
select * from t1;

flush logs;
let $MYSQLD_DATADIR=`select @@datadir`;
--exec $MYSQL_BINLOG --verbose $MYSQLD_DATADIR/binlog.000004 |egrep '^###|^BEGIN|^COMMIT'
drop table t1;


##### error by no change
--echo ##### error by no change
connection default;
set debug_sync='now SIGNAL nogo';
create table t1(id int primary key, a int) engine = innodb;

insert into t1 select 1,1000;
insert into t1 select 2,1000;
insert into t1 select 3,1000;
insert into t1 select 4,1000;

--send update t1 set a=a-1 where id = 1;
--sleep 1
connection con1;
--send update /* 1 */ t1 set a=a-1 where id = 1;
connection con2;
--send update /* 2 */ t1 set a=a where id = 1;

connection default;
--error ER_ERROR_DURING_COMMIT
--reap
connection con1;
--error ER_ERROR_DURING_COMMIT
--reap
connection con2;
--error ER_ERROR_DURING_COMMIT
--reap

# the new group.
connection con1;
--sleep 1
--replace_column 1 # 6 #
show processlist;
show global status like 'Group_update%';
update /* 3 */ t1 set a=a-1 where id = 1;
select * from t1 where id = 1;

# the new group.
--sleep 1
--replace_column 1 # 6 #
show processlist;
show global status like 'Group_update%';
update /* 4 */ t1 set a=a-1 where id = 1;
select * from t1 where id = 1;

# the new group.
--sleep 1
--replace_column 1 # 6 #
show processlist;
show global status like 'Group_update%';
update /* 5 */ t1 set a=a where id = 1;
select * from t1 where id = 1;

# the new group.
connection con1;
--sleep 1
--replace_column 1 # 6 #
show processlist;
show global status like 'Group_update%';
send update /* 6 */ t1 set a=a where id = 1;

--sleep 1
connection con2;
send update /* 7 */ t1 set a=a-1 where id = 1;

--sleep 1
connection con1;
--error ER_ERROR_DURING_COMMIT
