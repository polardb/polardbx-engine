##### error by overflow
--echo ##### error by overflow
connection default;
set debug_sync='now SIGNAL nogo';
create table t1(id int primary key, a int) engine = innodb;

insert into t1 select 1,1000;
insert into t1 select 2,1000;
insert into t1 select 3,1000;
insert into t1 select 4,1000;

--send update t1 set a=a-1 where id = 1;
--sleep 0.5
connection con1;
--send update /* 1 */ t1 set a=a-1 where id = 1;
--sleep 0.5
connection con2;
set sql_mode='strict_all_tables';
--send update /* 2 */ t1 set a=100000000000 where id = 1;

connection default;
--reap
connection con1;
--reap
connection con2;
--error ER_WARN_DATA_OUT_OF_RANGE
--reap

# the new group.
connection con1;
--sleep 1
--replace_column 1 # 6 #
show processlist;
show global status like 'Group_update%';
update /* 3 */ t1 set a=a-1 where id = 1;
select * from t1 where id = 1;

# the new group.
--sleep 1
--replace_column 1 # 6 #
show processlist;
show global status like 'Group_update%';
update /* 4 */ t1 set a=a-1 where id = 1;
select * from t1 where id = 1;

# the new group.
--sleep 1
--replace_column 1 # 6 #
show processlist;
show global status like 'Group_update%';
set sql_mode='strict_all_tables';
--error ER_WARN_DATA_OUT_OF_RANGE
update /* 2 */ t1 set a=100000000000 where id = 1;
select * from t1 where id = 1;

# the new group.
connection con1;
--sleep 0.5
send update /* 6 */ t1 set a=a-1 where id = 1;

--sleep 0.5
connection con2;
send update /* 7 */ t1 set a=a-1 where id = 1;

--sleep 1
connection con1;
--reap
show global status like 'Group_update%';
connection con2;
--reap
show global status like 'Group_update%';

