--source include/have_binlog_format_row.inc
--source include/have_debug_sync.inc

#restart server to clean status
let $restart_file= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect;
--exec echo "wait" > $restart_file
--shutdown_server 10
--source include/wait_until_disconnected.inc
-- exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
-- enable_reconnect
-- source include/wait_until_connected_again.inc

set global transaction_isolation = 'READ-COMMITTED';
set session transaction_isolation = 'READ-COMMITTED';
connect(con10,localhost,root,,);
connect(con11,localhost,root,,);
connect(con1,localhost,root,,);
connect(con2,localhost,root,,);
connect(con3,localhost,root,,);
connect(con4,localhost,root,,);
connect(con5,localhost,root,,);
connect(con6,localhost,root,,);

##### test for configuration setting
--echo ###test for configuration setting

connection default;
set global polardb_ic_reduce_hint_enable=0;
set global hotspot=1;
show variables like "hotspot";

##### test for normal function
--echo ###test for normal function

connection default;
set debug_sync='now SIGNAL nogo';
set global innodb_thread_concurrency= 32;
set global hotspot=0;
set global hotspot_lock_type=1;
set global hotspot_for_autocommit=1;
set global hotspot_update_max_wait_time=2*1000*1000;
flush logs;
create table t1(id int primary key, a int) engine = innodb;

insert into t1 select 1,1000;
insert into t1 select 2,1000;
insert into t1 select 3,1000;
insert into t1 select 4,1000;

update t1 set a=a-1 where id = 1;
select * from t1 where id = 1;
update t1 set a=a+1 where id = 1;
select * from t1 where id = 1;
show global variables like '%thread_concurrency';

set global hotspot=1;

--send update t1 set a=a-1 where id = 1;
--sleep 0.5
connection con1;
--send update       t1 set a=a-1 where id = 1;
connection con2;
--sleep 0.5
--send update            t1 set a=a-1 where id = 1;

connection con3;
--send update t1 set a=a-1 where id = 2;
--sleep 0.5
connection con4;
--send update       t1 set a=a-1 where id = 2;
--sleep 0.5
connection con5;
--send update            t1 set a=a-1 where id = 2;

connection con3;
--reap
connection con4;
--reap
connection con5;
--reap

connection default;
--reap
connection con1;
--reap
connection con2;
--reap

connection default;
show global status like 'Group_update%';
select * from t1;


connection default;
--send update t1 set a=a-1 where id = 1;
--sleep 0.5
connection con1;
--send update       t1 set a=a-1 where id = 1;
--sleep 0.5
connection con2;
--send update            t1 set a=a-1 where id = 1;

connection default;
--reap
connection con1;
--reap
connection con2;
--reap

connection default;
show global status like 'Group_update%';
select * from t1;


connection default;
--send update t1 set a=a-1 where id = 1;
--sleep 0.5
connection con1;
--send update       t1 set a=a-1 where id = 1;
--sleep 0.5
connection con2;
--send update            t1 set a=a-1 where id = 1;

connection default;
--reap
connection con1;
--reap
connection con2;
--reap

connection default;
