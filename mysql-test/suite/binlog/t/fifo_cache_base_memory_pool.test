--echo ###################
call dbms_consensus.force_purge_cache(4611686018427387904);
set global consensus_log_cache_size = 2*1024*1024;

set debug = "+d,fifo_cache_disable_evicit_oldest_try";

insert into t1 values (repeat('a', 255*1024));
