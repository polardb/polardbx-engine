insert into t1 values (repeat('a', 255*1024));

insert into t1 values (repeat('a', 255*1024));
insert into t1 values (repeat('a', 255*1024));

show global status like "consensus_fifo_cache_log_count";

set global consensus_log_cache_size = 4*1024*1024;

insert into t1 values (repeat('a', 255*1024));
insert into t1 values (repeat('a', 255*1024));
insert into t1 values (repeat('a', 255*1024));
insert into t1 values (repeat('a', 255*1024));
