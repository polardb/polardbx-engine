
--source include/have_binlog_format_row.inc

#######################################################################
# BUG#13799489: ROWS_QUERY_LOG_EVENTS CORRUPTED IF QUERY LONGER THAN 255 BYTES
#
# Check that queries with more than 255 characters are not truncated
# when stored on Rows_query_log_events.
SET @@SESSION.BINLOG_ROWS_QUERY_LOG_EVENTS = 1;
CREATE TABLE t1 (a VARCHAR(256));

--let $as= `SELECT REPEAT('a', 256)`
--let $query= INSERT INTO t1 VALUES ('$as')

--let $assert_text= Logged query must match the one issued.
--let $binlog_file= query_get_value("SHOW MASTER STATUS", File, 1)
--let $binlog_position= query_get_value("SHOW MASTER STATUS", Position, 1)
--eval $query

--let $row_number= 5
if (`SELECT @@session.binlog_transaction_compression`)
{
  --let $row_number= 6
}
--let $logged_query= query_get_value(SHOW BINLOG EVENTS IN "$binlog_file" FROM $binlog_position, Info, $row_number)
--let $assert_cond= `SELECT "$logged_query" LIKE "%$query"`
--source include/assert.inc

#######################################################################
# Check that binlog_rows_query_key_content keeps only the first leading
# comment, while statements without a leading comment remain unchanged.
SET @saved_binlog_rows_query_key_content =
  @@GLOBAL.binlog_rows_query_key_content;
SET GLOBAL binlog_rows_query_key_content = ON;

--let $query= /*trace_id=key-content*/ INSERT INTO t1 VALUES ('key-content')
--let $binlog_file= query_get_value("SHOW MASTER STATUS", File, 1)
--let $binlog_position= query_get_value("SHOW MASTER STATUS", Position, 1)
--eval $query
--let $logged_query= query_get_value(SHOW BINLOG EVENTS IN "$binlog_file" FROM $binlog_position, Info, $row_number)
--let $assert_text= Only the first leading comment must be logged.
--let $assert_cond= `SELECT "$logged_query" = "# /*trace_id=key-content*/"`
--source include/assert.inc

--let $query= INSERT INTO t1 /*trace_id=embedded*/ VALUES ('full-query')
--let $binlog_file= query_get_value("SHOW MASTER STATUS", File, 1)
--let $binlog_position= query_get_value("SHOW MASTER STATUS", Position, 1)
--eval $query
--let $logged_query= query_get_value(SHOW BINLOG EVENTS IN "$binlog_file" FROM $binlog_position, Info, $row_number)
--let $assert_text= A query without a leading comment must remain complete.
--let $assert_cond= `SELECT "$logged_query" = "# $query"`
--source include/assert.inc

--let $query= /*trace_id=first*//*trace_id=second*/ INSERT INTO t1 VALUES ('first-comment')
--let $binlog_file= query_get_value("SHOW MASTER STATUS", File, 1)
--let $binlog_position= query_get_value("SHOW MASTER STATUS", Position, 1)
--eval $query
--let $logged_query= query_get_value(SHOW BINLOG EVENTS IN "$binlog_file" FROM $binlog_position, Info, $row_number)
--let $assert_text= Only the first of multiple leading comments must be logged.
--let $assert_cond= `SELECT "$logged_query" = "# /*trace_id=first*/"`
--source include/assert.inc

SET GLOBAL binlog_rows_query_key_content =
  @saved_binlog_rows_query_key_content;

# Clean up
DROP TABLE t1;
