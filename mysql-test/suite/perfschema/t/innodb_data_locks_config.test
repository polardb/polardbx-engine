--disable_query_log
call mtr.add_suppression("The transaction .* holds too many locks which exceeds the configured pfs_data_locks_max_locks_per_batch");
--enable_query_log
 
CREATE TABLE t1 (id INT PRIMARY KEY) Engine=InnoDB;
INSERT INTO t1 VALUES (0);
 
--connect (C1, localhost, root,,)
--connect (C2, localhost, root,,)
--connect (C3, localhost, root,,)
--connect (C4, localhost, root,,)
--connect (C5, localhost, root,,)
--connect (C6, localhost, root,,)
--connect (C7, localhost, root,,)
--connect (C8, localhost, root,,)
--connect (C9, localhost, root,,)
--connect (C10, localhost, root,,)
 
--connection default
  BEGIN;
  SELECT * FROM t1 where id=0 FOR UPDATE;

--connection C1
  --send SELECT * FROM t1 where id=0 FOR UPDATE;

--connection C2
  --send SELECT * FROM t1 where id=0 FOR UPDATE;

--connection C3
  --send SELECT * FROM t1 where id=0 FOR UPDATE;

--connection C4
  --send SELECT * FROM t1 where id=0 FOR UPDATE;

--connection C5
  --send SELECT * FROM t1 where id=0 FOR UPDATE;

--connection C6
  --send SELECT * FROM t1 where id=0 FOR UPDATE;

--connection C7
  --send SELECT * FROM t1 where id=0 FOR UPDATE;

--connection C8
  --send SELECT * FROM t1 where id=0 FOR UPDATE;

--connection C9
  --send SELECT * FROM t1 where id=0 FOR UPDATE;

--connection C10
  --send SELECT * FROM t1 where id=0 FOR UPDATE;

--connection default
  SELECT COUNT(*) FROM performance_schema.data_lock_waits;
 
  SET GLOBAL innodb_pfs_data_locks_max_locks_per_batch = 3;
  SELECT COUNT(*) FROM performance_schema.data_lock_waits;

  SET GLOBAL innodb_pfs_data_locks_max_locks_per_batch = 1;
  SELECT COUNT(*) FROM performance_schema.data_lock_waits;

  SET GLOBAL innodb_pfs_data_locks_max_locks_per_batch = 0;
  SELECT COUNT(*) FROM performance_schema.data_lock_waits;

  SET GLOBAL innodb_pfs_data_locks_max_locks_per_batch = 1024*1024*1024;
  SELECT COUNT(*) FROM performance_schema.data_lock_waits;

--connection default
  COMMIT;
--connection C1
  --reap
--connection C2
  --reap
--connection C3
  --reap
--connection C4
  --reap
--connection C5
  --reap
--connection C6
  --reap
--connection C7
  --reap
--connection C8
  --reap
--connection C9
  --reap
--connection C10
  --reap
 
--connection default
--disconnect C1
--disconnect C2
--disconnect C3
--disconnect C4
--disconnect C5
--disconnect C6
--disconnect C7
--disconnect C8
--disconnect C9
--disconnect C10
SET GLOBAL innodb_pfs_data_locks_max_locks_per_batch = default;
DROP TABLE t1;