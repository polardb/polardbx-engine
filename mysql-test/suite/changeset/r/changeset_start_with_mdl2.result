1	abc	a
SET lock_wait_timeout = 1;
call polarx.changeset_start('c_mdl', 10000, 1);
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
xa end "tt";
xa prepare "tt";
xa commit "tt";
call polarx.changeset_start('c_mdl', 10000, 1);
