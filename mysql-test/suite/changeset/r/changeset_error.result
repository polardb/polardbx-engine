DROP TABLE IF EXISTS c1;
CREATE TABLE c1 (
id INT NOT NULL,
gmt_modified DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
value VARCHAR(50) NOT NULL,
PRIMARY KEY (id, gmt_modified)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;
