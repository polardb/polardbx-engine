SET @saved_xa_detach_on_prepare = @@GLOBAL.xa_detach_on_prepare;
SET GLOBAL xa_detach_on_prepare = OFF;
DROP TABLE IF EXISTS c3;
CREATE TABLE c3 (
id INT NOT NULL,
str VARCHAR(20) NOT NULL,
value VARCHAR(50) NOT NULL,
PRIMARY KEY (id, str)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;
xa begin "tt";
insert into c3 values (1, "abc", "a");
select * from c3;
id	str	value
1	abc	a
call polarx.changeset_start('c3');
TABLE
c3
call polarx.changeset_stats('c3');
SCHEMA	TABLE	NUM_INSERTS	NUM_UPDATES	NUM_DELETES	NUM_FILES	MEMORY_SIZE	CURRENT_PRIMARY_KEY_NUM	BACKPRESSURE_TRIGGER	BUCKET_AVAILABLE_TOKENS	BUCKET_FILL_RATE
test	c3	0	0	0	0	0	0	-	-	-
call polarx.changeset_fetch('c3');
OP	PK
insert into c3 values (2, "bcd", "b");
update c3 set str = "efg" where id = 1;
call polarx.changeset_stats('c3');
SCHEMA	TABLE	NUM_INSERTS	NUM_UPDATES	NUM_DELETES	NUM_FILES	MEMORY_SIZE	CURRENT_PRIMARY_KEY_NUM	BACKPRESSURE_TRIGGER	BUCKET_AVAILABLE_TOKENS	BUCKET_FILL_RATE
test	c3	0	0	0	0	0	0	-	-	-
call polarx.changeset_fetch('c3');
OP	PK
xa end "tt";
call polarx.changeset_stats('c3');
SCHEMA	TABLE	NUM_INSERTS	NUM_UPDATES	NUM_DELETES	NUM_FILES	MEMORY_SIZE	CURRENT_PRIMARY_KEY_NUM	BACKPRESSURE_TRIGGER	BUCKET_AVAILABLE_TOKENS	BUCKET_FILL_RATE
test	c3	0	0	0	0	0	0	-	-	-
call polarx.changeset_fetch('c3');
OP	PK
xa prepare "tt";
call polarx.changeset_fetch('c3');
OP	PK
xa commit "tt";
call polarx.changeset_stats('c3');
SCHEMA	TABLE	NUM_INSERTS	NUM_UPDATES	NUM_DELETES	NUM_FILES	MEMORY_SIZE	CURRENT_PRIMARY_KEY_NUM	BACKPRESSURE_TRIGGER	BUCKET_AVAILABLE_TOKENS	BUCKET_FILL_RATE
test	c3	1	1	0	0	192	3	-	-	-
call polarx.changeset_fetch('c3');
OP	id	str
DELETE	1	abc
INSERT	1	efg
INSERT	2	bcd
call polarx.changeset_stats('c3');
SCHEMA	TABLE	NUM_INSERTS	NUM_UPDATES	NUM_DELETES	NUM_FILES	MEMORY_SIZE	CURRENT_PRIMARY_KEY_NUM	BACKPRESSURE_TRIGGER	BUCKET_AVAILABLE_TOKENS	BUCKET_FILL_RATE
test	c3	1	1	0	0	192	0	-	-	-
call polarx.changeset_finish('c3');
SEQ	ROW
DROP TABLE c3;
SET GLOBAL xa_detach_on_prepare = @saved_xa_detach_on_prepare;
