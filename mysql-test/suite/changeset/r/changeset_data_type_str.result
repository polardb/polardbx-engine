DROP TABLE IF EXISTS c8;
CREATE TABLE c8 (
a char(50),
b varchar(60),
c varchar(300),
d varbinary(257),
e VARCHAR(50) NOT NULL,
PRIMARY KEY (a,b,c,d)
) ENGINE=InnoDB default charset utf8mb4;
set names utf8mb4;
call polarx.changeset_start('c8');
