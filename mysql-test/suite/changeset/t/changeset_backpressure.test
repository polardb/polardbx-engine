--disable_warnings
DROP TABLE IF EXISTS c3;
--enable_warnings

CREATE TABLE c3 (
id INT NOT NULL AUTO_INCREMENT,
str VARCHAR(40) NOT NULL,
value VARCHAR(40) NOT NULL,
PRIMARY KEY (id, str)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

insert into c3(str, value) values
("changeset", "test"),
("changeset1", "test1"),
("changeset12", "test2"),
("changeset123", "test3");

insert into c3(str, value) select str, value from c3;
insert into c3(str, value) select str, value from c3;
insert into c3(str, value) select str, value from c3;

call polarx.changeset_start('c3', 1024);

call polarx.changeset_backpressure('c3', 10, 100, 10000);

insert into c3(str, value) select str, value from c3 order by id limit 32;

call polarx.changeset_stats('c3');

insert into c3(str, value) values ("changeset4", "test4");

--sleep 1

call polarx.changeset_times('c3');
call polarx.changeset_stats('c3');

insert into c3(str, value) select str, value from c3 order by id limit 32;

call polarx.changeset_times('c3');
call polarx.changeset_stats('c3');

insert into c3(str, value) values ("changeset5", "test5");

call polarx.changeset_backpressure('c3', 10, 0, 10000);

# FETCH_TIMES_NUM (= file_count + 2) is timing-dependent after backpressure
# changes fill_rate, because the background flush thread may or may not have
# triggered a flush before changeset_times is called. Mask column 2 to make
# the test deterministic.
--replace_column 2 <FETCH_TIMES>
call polarx.changeset_times('c3');
call polarx.changeset_stats('c3');

call polarx.changeset_backpressure('c3', 0, 0, 10000);

--replace_column 2 <FETCH_TIMES>
call polarx.changeset_times('c3');
call polarx.changeset_stats('c3');

call polarx.changeset_backpressure('c3', 10, 0, 0);

--replace_column 2 <FETCH_TIMES>
call polarx.changeset_times('c3');
call polarx.changeset_stats('c3');

call polarx.changeset_backpressure('c3', 10, 0, 20000);

--replace_column 2 <FETCH_TIMES>
call polarx.changeset_times('c3');
call polarx.changeset_stats('c3');

# test fetch

call polarx.changeset_fetch('c3');

--replace_column 2 <FETCH_TIMES>
call polarx.changeset_times('c3');
call polarx.changeset_stats('c3');

call polarx.changeset_fetch('c3');

--replace_column 2 <FETCH_TIMES>
call polarx.changeset_times('c3');
call polarx.changeset_stats('c3');

call polarx.changeset_finish('c3');

DROP TABLE c3;
