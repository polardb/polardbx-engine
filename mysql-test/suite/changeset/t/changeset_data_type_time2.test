--disable_warnings
DROP TABLE IF EXISTS c7;
--enable_warnings

CREATE TABLE c7 (
tdate date,
ttime time,
ttimestamp timestamp(3),
tdatetime datetime(3),
value VARCHAR(50) NOT NULL,
PRIMARY KEY (tdate, ttime, ttimestamp, tdatetime)
) ENGINE=InnoDB;

call polarx.changeset_start('c7');
call polarx.changeset_fetch('c7');

