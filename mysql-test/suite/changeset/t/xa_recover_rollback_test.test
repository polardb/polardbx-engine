--disable_warnings
DROP TABLE IF EXISTS c3;
--enable_warnings
 
CREATE TABLE c3 (
id INT NOT NULL,
str VARCHAR(20) NOT NULL,
value VARCHAR(50) NOT NULL,
PRIMARY KEY (id, str)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;
 
connect (conn1,localhost,root,,);
connect (conn2,localhost,root,,);
 
connection conn1;
xa begin "tt";
insert into c3 values (1, "abc", "a");
select * from c3;
 
connection conn2;
call polarx.changeset_start('c3');
call polarx.changeset_stats('c3');
call polarx.changeset_fetch('c3');
 
connection conn1;
insert into c3 values (2, "bcd", "b");
update c3 set str = "efg" where id = 1;
 
connection conn2;
call polarx.changeset_stats('c3');
call polarx.changeset_fetch('c3');
 
connection conn1;
xa end "tt";
 
connection conn2;
call polarx.changeset_stats('c3');
call polarx.changeset_fetch('c3');
 
connection conn1;
xa prepare "tt";
disconnect conn1;
 
connection conn2;
call polarx.changeset_fetch('c3');
 
xa rollback "tt";
 
call polarx.changeset_stats('c3');
call polarx.changeset_fetch('c3');
call polarx.changeset_stats('c3');
call polarx.changeset_finish('c3');
 
DROP TABLE c3;