##########################################
# VECTOR INDEX with various ALTER TABLE scenarios
##########################################
--source include/have_binlog_format_mixed_or_row.inc

CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

--echo #
--echo # Cleanup before test
--echo #
--disable_warnings
DROP TABLE IF EXISTS t1, t2;
--enable_warnings

--echo #
--echo # 10.1 ALTER TABLE ADD COLUMN - verify VECTOR INDEX preserved
--echo #
CREATE TABLE t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(3),
  extra INT,
  VECTOR INDEX vi(v) m=10 distance=euclidean
) ENGINE=InnoDB;

SHOW CREATE TABLE t1;

ALTER TABLE t1 ADD COLUMN new_col VARCHAR(100);
SHOW CREATE TABLE t1;

--echo # Verify VECTOR INDEX still exists
SELECT INDEX_NAME, INDEX_TYPE FROM information_schema.STATISTICS 
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' AND INDEX_NAME = 'vi';

--echo #
--echo # 10.2 ALTER TABLE DROP COLUMN - verify VECTOR INDEX preserved
--echo #
ALTER TABLE t1 DROP COLUMN new_col;
SHOW CREATE TABLE t1;

--echo # Verify VECTOR INDEX still exists
SELECT INDEX_NAME, INDEX_TYPE FROM information_schema.STATISTICS 
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' AND INDEX_NAME = 'vi';

--echo #
--echo # 10.3 ALTER TABLE MODIFY COLUMN - verify VECTOR INDEX preserved
--echo #
ALTER TABLE t1 MODIFY COLUMN extra BIGINT;
SHOW CREATE TABLE t1;

--echo # Verify VECTOR INDEX still exists and column type changed
SELECT INDEX_NAME, INDEX_TYPE FROM information_schema.STATISTICS 
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' AND INDEX_NAME = 'vi';

--echo #
--echo # 10.4 ALTER TABLE ADD regular INDEX - verify VECTOR INDEX unaffected
--echo #
ALTER TABLE t1 ADD INDEX idx_extra(extra);
SHOW CREATE TABLE t1;

--echo # Both indexes should exist
SELECT INDEX_NAME, INDEX_TYPE FROM information_schema.STATISTICS 
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1'
ORDER BY INDEX_NAME;

--echo #
--echo # 10.5 Mixed ALTER operations with VECTOR INDEX ADD should fail
--echo #

--echo # Create a new table without VECTOR INDEX for this test
CREATE TABLE t2 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(3),
  extra INT
) ENGINE=InnoDB;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t2 ADD VECTOR INDEX vi(v), ADD COLUMN c2 INT;

--echo # Verify table unchanged
SHOW CREATE TABLE t2;

DROP TABLE t2;

--echo #
--echo # 10.6 Mixed ALTER operations with VECTOR INDEX DROP should fail
--echo #

--echo # Note: According to vidx_ddl.test, DROP INDEX vi uses standard syntax
--echo # Test mixed operation: DROP VECTOR INDEX + other change

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 DROP INDEX vi, DROP COLUMN extra;

--echo # Verify table unchanged
SHOW CREATE TABLE t1;

--echo #
--echo # 10.7 ALTER TABLE RENAME INDEX - verify VECTOR INDEX renamed
--echo #

--echo # First drop the extra index we added
ALTER TABLE t1 DROP INDEX idx_extra;

ALTER TABLE t1 RENAME INDEX vi TO vi_renamed;
SHOW CREATE TABLE t1;

--echo # Verify renamed index exists
SELECT INDEX_NAME, INDEX_TYPE FROM information_schema.STATISTICS 
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' AND INDEX_NAME = 'vi_renamed';

--echo # Check auxiliary tables are unaffected
SELECT COUNT(*) > 0 AS has_vidx_tables FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE 'test/vidx_%';

--echo #
--echo # 10.8 ALTER TABLE ENGINE=InnoDB (equivalent to OPTIMIZE TABLE)
--echo #
ALTER TABLE t1 ENGINE=InnoDB;
SHOW CREATE TABLE t1;

--echo # Verify VECTOR INDEX preserved after engine rebuild
SELECT INDEX_NAME, INDEX_TYPE FROM information_schema.STATISTICS 
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' AND INDEX_NAME = 'vi_renamed';

--echo #
--echo # Additional scenarios
--echo #

--echo # Test: ADD multiple columns at once
ALTER TABLE t1 ADD COLUMN col1 INT, ADD COLUMN col2 VARCHAR(50);
SHOW CREATE TABLE t1;

--echo # Test: CHANGE column name
ALTER TABLE t1 CHANGE col1 col1_renamed INT;
SHOW CREATE TABLE t1;

--echo # Test: ALTER TABLE with DEFAULT value change
ALTER TABLE t1 ALTER COLUMN extra SET DEFAULT 100;
SHOW CREATE TABLE t1;

--echo # Test: Rename index back
ALTER TABLE t1 RENAME INDEX vi_renamed TO vi;
SHOW CREATE TABLE t1;

--echo # Test: DROP all added columns
ALTER TABLE t1 DROP COLUMN col1_renamed, DROP COLUMN col2;
SHOW CREATE TABLE t1;

--echo #
--echo # Test: ALTER TABLE operations on VECTOR column itself
--echo #

# Note: Dropping VECTOR column with VECTOR INDEX may have specific error
# Skipping this test as the exact error code needs verification

--echo #
--echo # Test: ALTER TABLE with CHARACTER SET change
--echo #
ALTER TABLE t1 CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
SHOW CREATE TABLE t1;

--echo # Verify VECTOR INDEX still exists
SELECT INDEX_NAME, INDEX_TYPE FROM information_schema.STATISTICS 
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' AND INDEX_NAME = 'vi';

--echo #
--echo # Test: Multiple ALTER TABLE operations preserving VECTOR INDEX
--echo #
CREATE TABLE t2 (
  id INT PRIMARY KEY,
  v VECTOR(4),
  data VARCHAR(100),
  VECTOR INDEX vi(v) m=12 distance=cosine
) ENGINE=InnoDB;

SHOW CREATE TABLE t2;

--echo # Multiple operations in sequence
ALTER TABLE t2 ADD COLUMN ts TIMESTAMP DEFAULT CURRENT_TIMESTAMP;
ALTER TABLE t2 ADD INDEX idx_data(data);
ALTER TABLE t2 MODIFY COLUMN data VARCHAR(200);
ALTER TABLE t2 RENAME INDEX vi TO vidx_main;

SHOW CREATE TABLE t2;

--echo #
--echo # Cleanup
--echo #
DROP TABLE t1, t2;

--echo # Verify all auxiliary tables cleaned up
SELECT COUNT(*) AS final_vidx_count FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE 'test/vidx_%';

SET GLOBAL vidx_disabled = ON;
