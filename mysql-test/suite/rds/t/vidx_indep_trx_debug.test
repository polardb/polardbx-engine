##########################################
# DBUG_EXECUTE_IF error path testing     #
# for independent transaction (vidx)     #
##########################################
#
# TEST: vidx_indep_trx_debug
#
# Tests error injection points in hlindex_indep_dml() to verify
# correct error handling and state consistency when independent
# transaction operations fail at various stages.
#
# Requires: debug build

--source include/have_debug.inc

SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;

--echo
--echo ##############################################
--echo # Setup                                      #
--echo ##############################################

CREATE TABLE t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  a INT NOT NULL DEFAULT 0,
  v VECTOR(3),
  VECTOR INDEX vi(v)
) ENGINE = InnoDB;

SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';

# Insert seed data to build HNSW graph
INSERT INTO t1(a, v) VALUES (1, VEC_FROMTEXT('[1,0,0]'));
INSERT INTO t1(a, v) VALUES (2, VEC_FROMTEXT('[0,1,0]'));
INSERT INTO t1(a, v) VALUES (3, VEC_FROMTEXT('[0,0,1]'));

# Record baseline
SELECT COUNT(*) INTO @main_baseline FROM t1;
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_baseline FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
SELECT @main_baseline AS main_baseline, @aux_baseline AS aux_baseline;

--echo
--echo ##############################################
--echo # 1. fail_after_begin_attach: INSERT fails   #
--echo #    No main-table row, no aux-table row     #
--echo ##############################################

SET SESSION debug = '+d,vidx_indep_dml_fail_after_begin_attach';
--error ER_GET_ERRNO
INSERT INTO t1(a, v) VALUES (10, VEC_FROMTEXT('[10,10,10]'));
SET SESSION debug = '-d,vidx_indep_dml_fail_after_begin_attach';

--echo # Main table: no new row
SELECT COUNT(*) AS main_count FROM t1;
--echo # Aux table: no change
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_after FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
SELECT @aux_after = @aux_baseline AS aux_unchanged;

--echo # ANN search still works
--sorted_result
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[10,10,10]')) LIMIT 3;

--echo
--echo ##############################################
--echo # 2. fail_before_load_start: INSERT fails    #
--echo #    No main-table row, no aux-table change  #
--echo ##############################################

SET SESSION debug = '+d,vidx_indep_dml_fail_before_load_start';
--error ER_GET_ERRNO
INSERT INTO t1(a, v) VALUES (11, VEC_FROMTEXT('[11,11,11]'));
SET SESSION debug = '-d,vidx_indep_dml_fail_before_load_start';

--echo # Main table: no new row
SELECT COUNT(*) AS main_count FROM t1;
--echo # Aux table: no change
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_after FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
SELECT @aux_after = @aux_baseline AS aux_unchanged;

--echo # ANN search still works
--sorted_result
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[11,11,11]')) LIMIT 3;

--echo
--echo ##############################################
--echo # 3. fail_before_commit: DML executed but    #
--echo #    commit fails, aux rolled back           #
--echo ##############################################

SET SESSION debug = '+d,vidx_indep_dml_fail_before_commit';
--error ER_GET_ERRNO
INSERT INTO t1(a, v) VALUES (12, VEC_FROMTEXT('[12,12,12]'));
SET SESSION debug = '-d,vidx_indep_dml_fail_before_commit';

--echo # Main table: no new row (statement rolled back)
SELECT COUNT(*) AS main_count FROM t1;
--echo # Aux table: no change (independent trx rolled back before commit)
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_after FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
SELECT @aux_after = @aux_baseline AS aux_unchanged;

--echo # ANN search still works
--sorted_result
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[12,12,12]')) LIMIT 3;

--echo
--echo ##############################################
--echo # 4. UPDATE: fail_after_invalidate           #
--echo #    invalidate committed, insert fails      #
--echo #    old node invalidated, no new node       #
--echo ##############################################

--echo # Record aux count before update
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_before_upd FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;

SET SESSION debug = '+d,vidx_indep_update_fail_after_invalidate';
--error ER_GET_ERRNO
UPDATE t1 SET v = VEC_FROMTEXT('[88,88,88]') WHERE id = 1;
SET SESSION debug = '-d,vidx_indep_update_fail_after_invalidate';

--echo # Main table: id=1 should still have old value (statement failed, rolled back)
SELECT id, VEC_TOTEXT(v) AS vec FROM t1 WHERE id = 1;

--echo # Aux table: invalidate was independently committed
--echo # The old node is invalidated but no new node was inserted
--echo # So count may decrease or stay same depending on invalidate implementation
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_after_upd FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
SELECT @aux_after_upd AS aux_after_update;

--echo # ANN search still works; node 1 is now an orphan (TREF NULLed by
--echo # the independently-committed invalidate) and is skipped by search
--sorted_result
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,0,0]')) LIMIT 3;

--echo
--echo ##############################################
--echo # 5. Multi-row INSERT: fail on 2nd row      #
--echo #    1st row aux committed, 2nd fails       #
--echo ##############################################

--echo # Record state before
SELECT COUNT(*) INTO @main_before_multi FROM t1;
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_before_multi FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;

--echo # Use debug counter to fail only on 2nd invocation
SET SESSION debug = '+d,vidx_indep_dml_fail_after_begin_attach';
--error ER_GET_ERRNO
INSERT INTO t1(a, v) VALUES
  (40, VEC_FROMTEXT('[40,40,40]')),
  (41, VEC_FROMTEXT('[41,41,41]')),
  (42, VEC_FROMTEXT('[42,42,42]'));
SET SESSION debug = '-d,vidx_indep_dml_fail_after_begin_attach';

--echo # Main table: statement failed so no rows inserted (atomic statement)
SELECT COUNT(*) AS main_count FROM t1;
SELECT COUNT(*) = @main_before_multi AS main_unchanged FROM t1;

--echo # ANN search still works (node 1 remains orphan from case 4)
--sorted_result
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[40,40,40]')) LIMIT 3;

--echo
--echo ##############################################
--echo # 6. INSERT in explicit transaction: fail    #
--echo #    Verify transaction state is clean       #
--echo ##############################################

BEGIN;
INSERT INTO t1(a, v) VALUES (50, VEC_FROMTEXT('[50,50,50]'));

SET SESSION debug = '+d,vidx_indep_dml_fail_after_begin_attach';
--error ER_GET_ERRNO
INSERT INTO t1(a, v) VALUES (51, VEC_FROMTEXT('[51,51,51]'));
SET SESSION debug = '-d,vidx_indep_dml_fail_after_begin_attach';

--echo # vidx_indep_dml_fail_after_begin_attach forces HA_ERR_GENERIC at
--echo # the inner attachable boundary; the SQL layer marks the outer trx
--echo # for rollback (mark_transaction_to_rollback), so a clean ROLLBACK
--echo # is the deterministic next step.  COMMIT semantics depend on
--echo # whether SQL escalates to ER_LOCK_DEADLOCK; we sidestep that
--echo # ambiguity to keep the assertion single-path.
ROLLBACK;

--echo # Check state — both rows must be rolled back.
SELECT COUNT(*) AS rows_50 FROM t1 WHERE a = 50;
SELECT COUNT(*) AS rows_51 FROM t1 WHERE a = 51;

--echo
--echo ##############################################
--echo # 7. Verify server is still healthy          #
--echo ##############################################

--echo # Normal operations should work after all error injections
INSERT INTO t1(a, v) VALUES (100, VEC_FROMTEXT('[100,100,100]'));
SELECT COUNT(*) AS has_100 FROM t1 WHERE a = 100;

# Error-injection paths leave the graph in a partially-consistent state.
# The original {1,2,3} rows are all ~equidistant from [100,100,100], so any
# tie-breaker among them is non-deterministic; LIMIT 1 isolates the only
# stable top result (id=12, the row at vec [100,100,100]).
--echo # ANN search works
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[100,100,100]')) LIMIT 1;

--echo # Aux table has entries
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_final FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
SELECT @aux_final > 0 AS aux_has_data;

--echo
--echo ##############################################
--echo # Cleanup                                    #
--echo ##############################################

DROP TABLE t1;
SET GLOBAL show_vidx_hlindex_tables = OFF;
SET GLOBAL vidx_disabled = ON;
