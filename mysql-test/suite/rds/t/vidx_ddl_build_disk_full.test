##############################################################
# Disk-full during the DDL direct build.                     #
#                                                            #
# The build persists every window through the graph handler;  #
# a write failure at ANY pass must fail-fast: the ALTER       #
# fails with a storage error, the intermediate #sql graph     #
# table is discarded, no vector index appears, and the        #
# failure is accounted exactly once in                         #
# Vidx_ddl_build_error_count.  A retry with the disk healed  #
# must then build the graph in full.                          #
##############################################################
--source include/have_debug.inc
--source include/have_binlog_format_mixed_or_row.inc

CREATE DATABASE vidx_ddl_build_disk_full;
USE vidx_ddl_build_disk_full;
SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;

CREATE TABLE t1 (
  id INT NOT NULL PRIMARY KEY,
  v VECTOR(5)
) ENGINE = InnoDB;
--disable_query_log
let $i = 1;
while ($i <= 40) {
  eval INSERT INTO t1 VALUES ($i, VEC_FROMTEXT(CONCAT('[', $i, ',', $i+1, ',', $i+2, ',', $i+3, ',', $i+4, ']')));
  inc $i;
}
--enable_query_log
SET SESSION vidx_ddl_threads = 4;
let $err_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Vidx_ddl_build_error_count', Value, 1);

--echo
--echo ############################################
--echo # The build fails on a disk-full write     #
--echo ############################################
SET DEBUG = "+d,vidx_ddl_inject_disk_full";
# The message names the auxiliary table vidx_<table_id>_0; the id grows
# across restarts, so mask it for a stable result.
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_AUX_SLOT/
--error ER_RECORD_FILE_FULL
ALTER TABLE t1 ADD VECTOR INDEX vi(v);
SET DEBUG = "-d,vidx_ddl_inject_disk_full";

--echo # Assert: nothing half-built survives a failed build
SELECT COUNT(*) AS vector_indexes
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't1';
let $aux_cnt = query_get_value(SELECT COUNT(*) AS c FROM information_schema.innodb_tables WHERE NAME LIKE 'vidx_ddl_build_disk_full/vidx_%', c, 1);
if ($aux_cnt != 0) {
  --echo FATAL: $aux_cnt auxiliary tables survived the failed build
  --die a disk-full build left its intermediate graph table behind
}
--echo VERDICT no orphan graph table after disk-full: PASS

--echo # Assert: the failure is accounted exactly once
let $err_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Vidx_ddl_build_error_count', Value, 1);
if (`SELECT $err_after <> $err_before + 1`) {
  --echo FATAL: build error counter moved $err_before -> $err_after, expected +1
  --die a disk-full build was not accounted as exactly one build error
}
--echo VERDICT error count +1: PASS

--echo
--echo ############################################
--echo # A retry with the disk healed builds full #
--echo ############################################
ALTER TABLE t1 ADD VECTOR INDEX vi(v);
let $tid = query_get_value(SELECT TABLE_ID FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME = 'vidx_ddl_build_disk_full/t1', TABLE_ID, 1);
--disable_query_log
eval SET @s = CONCAT('SELECT COUNT(*) INTO @live FROM \`vidx_', $tid, '_0\` WHERE tref IS NOT NULL');
PREPARE stmt FROM @s; EXECUTE stmt; DEALLOCATE PREPARE stmt;
--enable_query_log
if (`SELECT @live <> 40`) {
  --die retry after disk-full produced an incomplete graph
}
--echo VERDICT retry live==base: PASS
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[20,21,22,23,24]')) LIMIT 1;

DROP TABLE t1;
SET SESSION vidx_ddl_threads = default;
SET GLOBAL show_vidx_hlindex_tables = default;
SET GLOBAL vidx_disabled = default;

DROP DATABASE IF EXISTS vidx_ddl_build_disk_full;
