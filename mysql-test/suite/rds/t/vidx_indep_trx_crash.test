##########################################
# Crash recovery test for independent    #
# transaction (Attachable_trx_rw)        #
##########################################
#
# TEST: vidx_indep_trx_crash
#
# Tests crash recovery scenarios for the per-row independent commit
# in hlindex_indep_dml(). Verifies that:
#   - Crash before commit: aux DML rolled back via undo
#   - Crash after commit: aux DML persisted via redo, orphan tolerated
#   - Multi-row partial crash: committed rows persist, others lost
#   - UPDATE partial crash: invalidate persisted, insert lost
#
# Requires: debug build, not valgrind (crash testing)

--source include/have_debug.inc
--source include/not_valgrind.inc
--source include/not_crashrep.inc

# We need to use the restart capability
--source include/have_log_bin.inc

SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;

--echo
--echo ##############################################
--echo # Setup                                      #
--echo ##############################################

CREATE TABLE t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  a INT NOT NULL DEFAULT 0,
  v VECTOR(3),
  VECTOR INDEX vi(v)
) ENGINE = InnoDB;

SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';

# Insert seed data
INSERT INTO t1(a, v) VALUES (1, VEC_FROMTEXT('[1,0,0]'));
INSERT INTO t1(a, v) VALUES (2, VEC_FROMTEXT('[0,1,0]'));
INSERT INTO t1(a, v) VALUES (3, VEC_FROMTEXT('[0,0,1]'));
INSERT INTO t1(a, v) VALUES (4, VEC_FROMTEXT('[1,1,0]'));
INSERT INTO t1(a, v) VALUES (5, VEC_FROMTEXT('[0,1,1]'));

SELECT COUNT(*) AS main_rows FROM t1;
SET @s = CONCAT('SELECT COUNT(*) AS aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;

--echo
--echo ##############################################
--echo # 1. Crash BEFORE commit of independent trx #
--echo #    Expected: aux DML rolled back (undo)   #
--echo #    Main table also rolled back            #
--echo ##############################################

--echo # Record state before crash
SELECT COUNT(*) INTO @main_before FROM t1;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

SET SESSION debug = '+d,vidx_indep_dml_crash_before_commit';
--error 2013
INSERT INTO t1(a, v) VALUES (10, VEC_FROMTEXT('[10,10,10]'));

--echo # Server crashed. Restart and verify recovery.
--source include/wait_until_disconnected.inc
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;

--echo # After recovery: main table should not have the crashed row
SELECT COUNT(*) AS main_rows FROM t1;
SELECT COUNT(*) AS crashed_row FROM t1 WHERE a = 10;

--echo # Aux table: the uncommitted independent trx should be rolled back
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
SET @s = CONCAT('SELECT COUNT(*) AS aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;

--echo # ANN search works normally after recovery (LIMIT 2: ids 4,5 are
--echo # strictly closest; ids 1,2,3 are equidistant so LIMIT 3 is flaky)
--sorted_result
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[10,10,10]')) LIMIT 2;

--echo
--echo ##############################################
--echo # 2. Crash AFTER commit of independent trx  #
--echo #    Expected: aux DML persisted (redo)     #
--echo #    Main table user trx rolled back        #
--echo #    Result: orphan node in aux table       #
--echo ##############################################

--echo # Use explicit transaction so main-table commit is separate
BEGIN;
INSERT INTO t1(a, v) VALUES (20, VEC_FROMTEXT('[20,20,20]'));

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

SET SESSION debug = '+d,vidx_indep_dml_crash_after_commit';
--error 2013
INSERT INTO t1(a, v) VALUES (21, VEC_FROMTEXT('[21,21,21]'));

--echo # Server crashed after aux committed but before main committed
--source include/wait_until_disconnected.inc
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;

--echo # After recovery: main table rows from the open trx should be gone
SELECT COUNT(*) AS row_20 FROM t1 WHERE a = 20;
SELECT COUNT(*) AS row_21 FROM t1 WHERE a = 21;

--echo # Aux table: the crash_after_commit row's aux entry IS persisted (orphan)
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
SET @s = CONCAT('SELECT COUNT(*) AS aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;

--echo # ANN search works (orphan node tolerated by mhnsw_read_next)
SELECT COUNT(*) >= 3 AS ann_returns_rows FROM (
  SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[20,20,20]')) LIMIT 3
) t;

--echo
--echo ##############################################
--echo # 3. Normal operation after crash recovery  #
--echo #    Verify server is fully functional      #
--echo ##############################################

--echo # INSERT should work normally
INSERT INTO t1(a, v) VALUES (30, VEC_FROMTEXT('[30,30,30]'));
SELECT COUNT(*) AS row_30 FROM t1 WHERE a = 30;

--echo # UPDATE should work normally
UPDATE t1 SET v = VEC_FROMTEXT('[99,99,99]') WHERE id = 1;
SELECT VEC_TOTEXT(v) AS updated_vec FROM t1 WHERE id = 1;

--echo # DELETE should work normally
DELETE FROM t1 WHERE id = 5;
SELECT COUNT(*) AS row_5 FROM t1 WHERE id = 5;

--echo # ANN search works
--sorted_result
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[30,30,30]')) LIMIT 5;

--echo # Aux table consistent
SET @s = CONCAT('SELECT COUNT(*) AS aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;

--echo
--echo ##############################################
--echo # Cleanup                                    #
--echo ##############################################

DROP TABLE t1;
SET GLOBAL show_vidx_hlindex_tables = OFF;
SET GLOBAL vidx_disabled = ON;
