################################################################################
# SQL Guard: block GRANT ... AS grantor-impersonation to prevent privilege
#            escalation that bypasses opt_enable_rds_priv_strategy.
#
# Issue: #85329745  (PolarDB-X 8.0 GRANT AS 语法绕过 opt_enable_rds_priv_strategy 提权)
#
# Vulnerability:
#   GRANT ... AS 'user'@'host' runs the grant with the authorization context of
#   another account.  Grant_validator::validate_and_process_grant_as() swapped
#   the security context to the AS-user via change_security_context(force=true)
#   with NO check that the current user may impersonate it.  The RDS entity
#   guards (im::guard_record -> guard_insert/guard_update) gate mysql.global_grants
#   / mysql.user on the *current* security context and exempt only SUPER, so a
#   non-SUPER attacker could:
#     1. GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO self AS <built-in SUPER account>
#        -> context swapped to SUPER -> guard fooled -> dynamic priv written
#     2. SET GLOBAL opt_enable_rds_priv_strategy=OFF   (now has SYSTEM_VARIABLES_ADMIN)
#     3. UPDATE mysql.user Super_priv='Y', File_priv='Y' (guard now disabled)
#
# Fix:
#   validate_and_process_grant_as() now rejects GRANT ... AS for non-SUPER users
#   while opt_enable_rds_priv_strategy is ON (checked before the context swap,
#   so it inspects the real current user), aligning with the guards' SUPER-only
#   exemption model.  SUPER users and strategy-off behaviour are unchanged.
#
# Test coverage (four-part per DML防护测试规范):
#   Part A: Attack paths  — GRANT AS impersonation blocked (ERROR 7529)
#   Part B: Normal paths  — SUPER GRANT AS / non-AS grants must NOT be blocked
#   Part C: Boundary/edge — strategy off, guard_insert layer, prepared stmt
#   Part D: Full exploit chain — end-to-end proof the escalation is stopped
################################################################################

connect (con_root, localhost, root,,,$MASTER_MYPORT);
connection con_root;

set global opt_enable_rds_priv_strategy=on;

create database test_db;
create table test_db.t1 (id int primary key);
insert into test_db.t1 values (1);

--echo #
--echo # === Setup ===
--echo #

--echo # 'u0': a built-in-style high-privilege account (represents aliyun_root@127.0.0.1):
--echo #        has SUPER + SYSTEM_VARIABLES_ADMIN WITH GRANT OPTION, the AS-target.
create user 'u0'@'%';
grant all privileges on *.* to 'u0'@'%' with grant option;
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u0'@'%' with grant option;

--echo # 'u2': an ordinary bystander account, used as an alternate grantee.
create user 'u2'@'%';

--echo # Attacker 'u1': broad static privileges incl. global UPDATE (NO SUPER),
--echo #                WITH GRANT OPTION, plus CONNECTION_ADMIN with grant option.
create user 'u1'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, RELOAD, PROCESS,
      REFERENCES, INDEX, ALTER, SHOW DATABASES, CREATE TEMPORARY TABLES,
      LOCK TABLES, EXECUTE, REPLICATION SLAVE, REPLICATION CLIENT, CREATE VIEW,
      SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, CREATE USER, EVENT, TRIGGER,
      CREATE ROLE, DROP ROLE ON *.* TO 'u1'@'%' WITH GRANT OPTION;
grant all privileges on test_db.* to 'u1'@'%';
grant CONNECTION_ADMIN on *.* to 'u1'@'%' with grant option;
flush privileges;

--echo # Confirm initial state: u1 has NO SUPER/FILE, only CONNECTION_ADMIN dynamic priv
select user, host, super_priv, file_priv from mysql.user where user='u1';
select user, host, priv from mysql.global_grants where user='u1' order by priv;

connect (con_u1, localhost, u1,,,$MASTER_MYPORT);
connection con_u1;

--echo #
--echo ###########################################################################
--echo # Part A: Attack paths — GRANT ... AS must be rejected (ERROR 7529)
--echo ###########################################################################
--echo #

--echo # A.1 THE VULNERABILITY: grab SYSTEM_VARIABLES_ADMIN by impersonating a
--echo #     built-in SUPER account (root@localhost ~ aliyun_root@127.0.0.1)
--error ER_RESERVED_USER_OR_PRIVS
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u1'@'%' as 'root'@'localhost';

--echo # A.2 Same, impersonating the reserved high-privilege account u0
--error ER_RESERVED_USER_OR_PRIVS
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u1'@'%' as 'u0'@'%';

--echo # A.3 Other high-value dynamic privileges via AS
--error ER_RESERVED_USER_OR_PRIVS
grant ROLE_ADMIN on *.* to 'u1'@'%' as 'root'@'localhost';

--error ER_RESERVED_USER_OR_PRIVS
grant BINLOG_ADMIN on *.* to 'u1'@'%' as 'u0'@'%';

--error ER_RESERVED_USER_OR_PRIVS
grant PERSIST_RO_VARIABLES_ADMIN on *.* to 'u1'@'%' as 'root'@'localhost';

--echo # A.4 Grant the dynamic priv to a THIRD account (not self) via AS
--error ER_RESERVED_USER_OR_PRIVS
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u2'@'%' as 'root'@'localhost';

--echo # A.5 AS with WITH ROLE clause (blocked before role activation)
--error ER_RESERVED_USER_OR_PRIVS
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u1'@'%' as 'u0'@'%' with role DEFAULT;

--echo # A.6 AS combined with WITH GRANT OPTION on the granted privilege
--error ER_RESERVED_USER_OR_PRIVS
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u1'@'%' with grant option as 'root'@'localhost';

--echo # A.7 Fail-closed: AS a non-existent account is rejected too (checked
--echo #     before the AS-user existence lookup, so no info leak either)
--error ER_RESERVED_USER_OR_PRIVS
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u1'@'%' as 'no_such_user'@'localhost';

--echo # A.8 AS impersonating self: still requires SUPER, still blocked
--error ER_RESERVED_USER_OR_PRIVS
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u1'@'%' as 'u1'@'%';

--echo # A.9 Prepared statement: dynamic SQL GRANT AS bypass attempt
prepare stmt from
  "grant SYSTEM_VARIABLES_ADMIN on *.* to 'u1'@'%' as 'root'@'localhost'";
--error ER_RESERVED_USER_OR_PRIVS
execute stmt;
deallocate prepare stmt;

--echo # A.10 Static (global) privilege via GRANT AS is blocked too (the gate is
--echo #      not limited to dynamic privileges): u1 tries to grant a static priv
--echo #      it holds WITH GRANT OPTION to u2 while impersonating root as grantor.
--echo #      (GRANT ... AS is only allowed for global privileges, hence ON *.*)
--error ER_RESERVED_USER_OR_PRIVS
grant SELECT on *.* to 'u2'@'%' as 'root'@'localhost';

--echo # A.11 Verify state unchanged after all attacks: u1 gained nothing
connection con_root;
select user, host, priv from mysql.global_grants where user='u1' order by priv;
select user, host, priv from mysql.global_grants where user='u2' order by priv;
select super_priv, file_priv from mysql.user where user='u1';
show grants for 'u2'@'%';
connection con_u1;

--echo #
--echo ###########################################################################
--echo # Part B: Normal paths — must NOT be blocked by the fix
--echo ###########################################################################
--echo #

--echo # B.1 SUPER user (root) CAN use GRANT ... AS (exempted from the restriction)
connection con_root;
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u2'@'%' as 'u0'@'%';
select user, host, priv from mysql.global_grants where user='u2' order by priv;
revoke SYSTEM_VARIABLES_ADMIN on *.* from 'u2'@'%';

--echo # B.2 SUPER user GRANT ... AS with WITH ROLE clause also works
grant ROLE_ADMIN on *.* to 'u2'@'%' as 'root'@'localhost' with role DEFAULT;
select user, host, priv from mysql.global_grants where user='u2' order by priv;
revoke ROLE_ADMIN on *.* from 'u2'@'%';

--echo # B.3 SUPER user normal dynamic GRANT without AS works
grant BINLOG_ADMIN on *.* to 'u2'@'%';
select user, host, priv from mysql.global_grants where user='u2' order by priv;
revoke BINLOG_ADMIN on *.* from 'u2'@'%';

--echo # B.4 Non-SUPER u1 normal (non-AS) static GRANT within its rights works
connection con_u1;
grant SELECT on test_db.* to 'u2'@'%';
connection con_root;
show grants for 'u2'@'%';
connection con_u1;
revoke SELECT on test_db.* from 'u2'@'%';

--echo # B.5 Non-guarded table: normal user can freely UPDATE
update test_db.t1 set id=2 where id=1;
select * from test_db.t1;
update test_db.t1 set id=1 where id=2;

--echo # B.6 SUPER path is truly unchanged: GRANT AS a non-existent account still
--echo #     returns the ORIGINAL masked error (ER 3546), not our guard error,
--echo #     proving the gate is a no-op for SUPER users (does not short-circuit).
connection con_root;
--error ER_UKNOWN_AUTH_ID_OR_ACCESS_DENIED_FOR_GRANT_AS
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u2'@'%' as 'no_such_user'@'localhost';

--echo #
--echo ###########################################################################
--echo # Part C: Boundary / edge cases
--echo ###########################################################################
--echo #

--echo # C.1 Strategy OFF: GRANT AS restriction lifted (upstream behaviour intact)
connection con_root;
set global opt_enable_rds_priv_strategy=off;
connection con_u1;
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u1'@'%' as 'root'@'localhost';
connection con_root;
select user, host, priv from mysql.global_grants where user='u1' order by priv;
--echo # cleanup the grant obtained while strategy was off
revoke SYSTEM_VARIABLES_ADMIN on *.* from 'u1'@'%';

--echo # C.2 Re-enable strategy: restriction resumes
set global opt_enable_rds_priv_strategy=on;
connection con_u1;
--error ER_RESERVED_USER_OR_PRIVS
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u1'@'%' as 'root'@'localhost';

--echo # C.3 Defense-in-depth: even WITHOUT AS, a non-SUPER user cannot add a
--echo #     dynamic-privilege row (guard_insert layer blocks the write), so the
--echo #     AS clause was the only bypass and it is now closed.
--error ER_RESERVED_USER_OR_PRIVS
grant CONNECTION_ADMIN on *.* to 'u2'@'%';

--echo # C.4 SUPER user is unaffected by C.3 (grants dynamic priv without AS)
connection con_root;
grant CONNECTION_ADMIN on *.* to 'u2'@'%';
select user, host, priv from mysql.global_grants where user='u2' order by priv;
revoke CONNECTION_ADMIN on *.* from 'u2'@'%';

--echo #
--echo ###########################################################################
--echo # Part D: Full exploit chain verification (end-to-end, post-fix)
--echo ###########################################################################
--echo #
connection con_u1;

--echo # Step 1: GRANT AS to obtain SYSTEM_VARIABLES_ADMIN → BLOCKED
--error ER_RESERVED_USER_OR_PRIVS
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u1'@'%' as 'root'@'localhost';

--echo # Step 2: Without SYSTEM_VARIABLES_ADMIN, cannot disable the protection
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
set global opt_enable_rds_priv_strategy=off;

--echo # Step 3: Protection still ON → cannot rewrite static privileges either
--error ER_RESERVED_USER_OR_PRIVS
update mysql.user set super_priv='Y', file_priv='Y' where user='u1' and host='%';

--echo # Step 4: Verify final state — u1 NOT escalated
show grants for current_user();

connection con_root;
--echo # Confirm no SUPER, no FILE, no SYSTEM_VARIABLES_ADMIN for u1
select super_priv, file_priv from mysql.user where user='u1';
select priv from mysql.global_grants where user='u1' order by priv;

--echo #
--echo ###########################################################################
--echo # Cleanup
--echo ###########################################################################
--echo #
disconnect con_u1;
connection con_root;

drop database test_db;
drop user 'u0'@'%';
drop user 'u1'@'%';
drop user 'u2'@'%';
set global opt_enable_rds_priv_strategy=off;
