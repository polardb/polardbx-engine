##############################################################
# Micro-batch parallel DDL direct build: targeted coverage.  #
#                                                            #
# The build concurrency W comes from the session variable    #
# vidx_ddl_threads; a batch is W*8 rows                     #
# (DDL_BUILD_ROWS_PER_THREAD=8). The first non-NULL row      #
# seeds the empty graph on                                   #
# the serial path and does not occupy a parallel slot, so    #
# with N non-NULL rows the batch counter must advance by     #
# exactly ceil((N-1)/(W*8)) — and by 0 when W==1 (serial     #
# fallback branch, the orchestrator is never entered).       #
#                                                            #
# Phase 1  W=1: serial fallback — batches delta 0.           #
# Phase 2  W=2: 97 rows / batch 16 -> 7 batches (tail 1).    #
# Phase 3  W=8: 97 rows / batch 64 -> 2 batches (tail 33).   #
# Phase 2/3 run a FULL self-probe as a basic reachability    #
# check, then compare three off-sample ANN top-10 sets with  #
# exact base-table scans and require recall@10 >= 0.90.      #
# Phase 4  W=4: duplicate vectors exercise the diversity     #
# pruning inside the worker-side neighbor selection.         #
#                                                            #
# All phases: direct-build live node count == non-NULL base   #
# rows (NULLs interleaved mid-scan must be skipped without    #
# consuming a parallel slot).                                 #
##############################################################
--source include/have_binlog_format_mixed_or_row.inc

CREATE DATABASE vidx_ddl_parallel_build;
USE vidx_ddl_parallel_build;
SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;
SET transaction_isolation = 'READ-COMMITTED';

CREATE TABLE t1 (
  id INT NOT NULL PRIMARY KEY,
  v VECTOR(5)
) ENGINE = InnoDB;

# 98 self-distinguishable rows ([i,i+1..i+4]: nearest neighbor of each
# vector is itself, uniquely) with NULLs interleaved mid-scan.
--disable_query_log
let $i = 1;
while ($i <= 98) {
  eval INSERT INTO t1(id, v) VALUES ($i, VEC_FROMTEXT(CONCAT('[', $i, ',', $i+1, ',', $i+2, ',', $i+3, ',', $i+4, ']')));
  if ($i == 25) {
    INSERT INTO t1(id, v) VALUES (1025, NULL);
  }
  if ($i == 50) {
    INSERT INTO t1(id, v) VALUES (1050, NULL);
  }
  inc $i;
}
--enable_query_log
SELECT COUNT(*) AS total_rows, COUNT(v) AS non_null_rows FROM t1;

# Freeze exact top-10 answers before any vector index exists. Fractional
# query points avoid a tie at the LIMIT boundary.
--disable_query_log
CREATE TEMPORARY TABLE quality_expected (
  qid TINYINT NOT NULL,
  id INT NOT NULL,
  PRIMARY KEY(qid, id)
) ENGINE = MEMORY;
CREATE TEMPORARY TABLE quality_ann LIKE quality_expected;
INSERT INTO quality_expected
  SELECT 1, id FROM t1 FORCE INDEX(PRIMARY) WHERE v IS NOT NULL
  ORDER BY VEC_DISTANCE_EUCLIDEAN(
    v, VEC_FROMTEXT('[10.2,11.2,12.2,13.2,14.2]'))
  LIMIT 10;
INSERT INTO quality_expected
  SELECT 2, id FROM t1 FORCE INDEX(PRIMARY) WHERE v IS NOT NULL
  ORDER BY VEC_DISTANCE_EUCLIDEAN(
    v, VEC_FROMTEXT('[49.2,50.2,51.2,52.2,53.2]'))
  LIMIT 10;
INSERT INTO quality_expected
  SELECT 3, id FROM t1 FORCE INDEX(PRIMARY) WHERE v IS NOT NULL
  ORDER BY VEC_DISTANCE_EUCLIDEAN(
    v, VEC_FROMTEXT('[90.2,91.2,92.2,93.2,94.2]'))
  LIMIT 10;
--enable_query_log
if (`SELECT COUNT(*) <> 30 FROM quality_expected`) {
  --die exact top-10 fixture must contain 30 rows
}

--echo
--echo ############################################
--echo # Phase 1: W=1 serial fallback            #
--echo ############################################
SET SESSION vidx_ddl_threads = 1;
let $pb_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Vidx_ddl_parallel_batches', Value, 1);

ALTER TABLE t1 ADD VECTOR INDEX vi(v);

let $pb_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Vidx_ddl_parallel_batches', Value, 1);
if ($pb_after != $pb_before) {
  --echo FATAL: batch counter moved $pb_before -> $pb_after under W=1
  --die Phase 1: W=1 must take the serial branch, not the orchestrator
}
--echo VERDICT 1 serial-fallback (no parallel batches): PASS

let $tid = query_get_value(SELECT TABLE_ID FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE '%/t1', TABLE_ID, 1);
--disable_query_log
eval SET @s = CONCAT('SELECT COUNT(*) INTO @live FROM \`vidx_', $tid, '_0\` WHERE tref IS NOT NULL');
PREPARE stmt FROM @s; EXECUTE stmt; DEALLOCATE PREPARE stmt;
--enable_query_log
if (`SELECT @live <> 98`) {
  --die Phase 1: live nodes != 98 non-NULL base rows
}
--echo VERDICT 1 live==non-null-base: PASS
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 1;
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[98,99,100,101,102]')) LIMIT 1;

--echo
--echo ############################################
--echo # Phase 2: W=2, tail batch of 1           #
--echo ############################################
ALTER TABLE t1 DROP INDEX vi;
SET SESSION vidx_ddl_threads = 2;
let $pb_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Vidx_ddl_parallel_batches', Value, 1);

ALTER TABLE t1 ADD VECTOR INDEX vi(v);

let $pb_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Vidx_ddl_parallel_batches', Value, 1);
let $delta = `SELECT $pb_after - $pb_before`;
# 97 parallel rows / (2*8 per batch) = 6 full + 1 tail(1) = 7
if ($delta != 7) {
  --echo FATAL: batch delta $delta, expected 7 (97 rows / batch 16)
  --die Phase 2: batch accounting broken (partial tail batch lost?)
}
--echo VERDICT 2 batch-count ceil(97/16)==7: PASS

let $tid = query_get_value(SELECT TABLE_ID FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE '%/t1', TABLE_ID, 1);
--disable_query_log
eval SET @s = CONCAT('SELECT COUNT(*) INTO @live FROM \`vidx_', $tid, '_0\` WHERE tref IS NOT NULL');
PREPARE stmt FROM @s; EXECUTE stmt; DEALLOCATE PREPARE stmt;
--enable_query_log
if (`SELECT @live <> 98`) {
  --die Phase 2: live nodes != 98 (tail-batch rows lost?)
}
--echo VERDICT 2 live==non-null-base: PASS

--disable_query_log
let $i = 1;
let $bad = 0;
while ($i <= 98) {
  SET @nn = NULL;
  eval SELECT id INTO @nn FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT(CONCAT('[', $i, ',', $i+1, ',', $i+2, ',', $i+3, ',', $i+4, ']'))) LIMIT 1;
  if (`SELECT @nn IS NULL OR @nn <> $i`) {
    --echo self-probe MISS: row $i got another id
    inc $bad;
  }
  inc $i;
}
--enable_query_log
if ($bad) {
  --die Phase 2: $bad/98 self-probes missed (graph reachability broken)
}
--echo VERDICT 2 full self-probe 98/98: PASS

--disable_query_log
DELETE FROM quality_ann;
INSERT INTO quality_ann
  SELECT 1, id FROM t1 FORCE INDEX(vi)
  ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[10.2,11.2,12.2,13.2,14.2]'))
  LIMIT 10;
INSERT INTO quality_ann
  SELECT 2, id FROM t1 FORCE INDEX(vi)
  ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[49.2,50.2,51.2,52.2,53.2]'))
  LIMIT 10;
INSERT INTO quality_ann
  SELECT 3, id FROM t1 FORCE INDEX(vi)
  ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[90.2,91.2,92.2,93.2,94.2]'))
  LIMIT 10;
let $quality_hits = `SELECT COUNT(*) FROM quality_expected e JOIN quality_ann a USING(qid, id)`;
--enable_query_log
if ($quality_hits < 27) {
  --die Phase 2: parallel DDL recall@10 below 0.90 ($quality_hits/30)
}
--echo VERDICT 2 off-sample recall@10 >= 0.90: PASS

--echo
--echo ############################################
--echo # Phase 3: W=8, single tail-heavy batch   #
--echo ############################################
ALTER TABLE t1 DROP INDEX vi;
SET SESSION vidx_ddl_threads = 8;
let $pb_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Vidx_ddl_parallel_batches', Value, 1);

ALTER TABLE t1 ADD VECTOR INDEX vi(v);

let $pb_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Vidx_ddl_parallel_batches', Value, 1);
let $delta = `SELECT $pb_after - $pb_before`;
# 97 parallel rows / (8*8 per batch) = 1 full + 1 tail(33) = 2
if ($delta != 2) {
  --echo FATAL: batch delta $delta, expected 2 (97 rows / batch 64)
  --die Phase 3: batch accounting broken
}
--echo VERDICT 3 batch-count ceil(97/64)==2: PASS

let $tid = query_get_value(SELECT TABLE_ID FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE '%/t1', TABLE_ID, 1);
--disable_query_log
eval SET @s = CONCAT('SELECT COUNT(*) INTO @live FROM \`vidx_', $tid, '_0\` WHERE tref IS NOT NULL');
PREPARE stmt FROM @s; EXECUTE stmt; DEALLOCATE PREPARE stmt;
--enable_query_log
if (`SELECT @live <> 98`) {
  --die Phase 3: live nodes != 98
}
--echo VERDICT 3 live==non-null-base: PASS

--disable_query_log
let $i = 1;
let $bad = 0;
while ($i <= 98) {
  SET @nn = NULL;
  eval SELECT id INTO @nn FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT(CONCAT('[', $i, ',', $i+1, ',', $i+2, ',', $i+3, ',', $i+4, ']'))) LIMIT 1;
  if (`SELECT @nn IS NULL OR @nn <> $i`) {
    --echo self-probe MISS: row $i got another id
    inc $bad;
  }
  inc $i;
}
--enable_query_log
if ($bad) {
  --die Phase 3: $bad/98 self-probes missed (graph reachability broken)
}
--echo VERDICT 3 full self-probe 98/98: PASS

--disable_query_log
DELETE FROM quality_ann;
INSERT INTO quality_ann
  SELECT 1, id FROM t1 FORCE INDEX(vi)
  ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[10.2,11.2,12.2,13.2,14.2]'))
  LIMIT 10;
INSERT INTO quality_ann
  SELECT 2, id FROM t1 FORCE INDEX(vi)
  ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[49.2,50.2,51.2,52.2,53.2]'))
  LIMIT 10;
INSERT INTO quality_ann
  SELECT 3, id FROM t1 FORCE INDEX(vi)
  ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[90.2,91.2,92.2,93.2,94.2]'))
  LIMIT 10;
let $quality_hits = `SELECT COUNT(*) FROM quality_expected e JOIN quality_ann a USING(qid, id)`;
--enable_query_log
if ($quality_hits < 27) {
  --die Phase 3: parallel DDL recall@10 below 0.90 ($quality_hits/30)
}
--echo VERDICT 3 off-sample recall@10 >= 0.90: PASS

--echo
--echo ############################################
--echo # Phase 4: W=4, duplicate vectors         #
--echo ############################################
# 20 identical vectors + 10 distinct: the worker-side neighbor selection
# (select_neighbors_scratch) must survive zero-distance candidates and the
# diversity pruning must not disconnect the duplicates.
CREATE TABLE t2 (
  id INT NOT NULL PRIMARY KEY,
  v VECTOR(5)
) ENGINE = InnoDB;
--disable_query_log
let $i = 1;
while ($i <= 20) {
  eval INSERT INTO t2(id, v) VALUES ($i, VEC_FROMTEXT('[7,7,7,7,7]'));
  inc $i;
}
while ($i <= 30) {
  eval INSERT INTO t2(id, v) VALUES ($i, VEC_FROMTEXT(CONCAT('[', $i*10, ',', $i, ',', $i, ',', $i, ',', $i, ']')));
  inc $i;
}
--enable_query_log
SET SESSION vidx_ddl_threads = 4;
let $pb_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Vidx_ddl_parallel_batches', Value, 1);

ALTER TABLE t2 ADD VECTOR INDEX vi(v);

let $pb_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Vidx_ddl_parallel_batches', Value, 1);
let $delta = `SELECT $pb_after - $pb_before`;
# 29 parallel rows / (4*8 per batch) = 1
if ($delta != 1) {
  --echo FATAL: batch delta $delta, expected 1 (29 rows / batch 32)
  --die Phase 4: batch accounting broken
}
--echo VERDICT 4 batch-count ceil(29/32)==1: PASS

let $tid = query_get_value(SELECT TABLE_ID FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME LIKE '%/t2', TABLE_ID, 1);
--disable_query_log
eval SET @s = CONCAT('SELECT COUNT(*) INTO @live FROM \`vidx_', $tid, '_0\` WHERE tref IS NOT NULL');
PREPARE stmt FROM @s; EXECUTE stmt; DEALLOCATE PREPARE stmt;
--enable_query_log
if (`SELECT @live <> 30`) {
  --die Phase 4: live nodes != 30 (duplicates dropped by pruning?)
}
--echo VERDICT 4 live==30 duplicates all indexed: PASS
# Every duplicate must remain reachable: the 20 nearest to [7,7,7,7,7]
# are exactly the 20 duplicates.
SELECT COUNT(*) AS dup_hits FROM (
  SELECT id FROM t2 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[7,7,7,7,7]')) LIMIT 20
) q WHERE q.id <= 20;

DROP TABLE t1;
DROP TABLE t2;
DROP TEMPORARY TABLE quality_expected;
DROP TEMPORARY TABLE quality_ann;
SET SESSION vidx_ddl_threads = default;
SET GLOBAL show_vidx_hlindex_tables = default;
SET GLOBAL vidx_disabled = default;

DROP DATABASE IF EXISTS vidx_ddl_parallel_build;
