##########################################
# XA Transaction tests for VECTOR INDEX  #
##########################################
#
# §3 (cross-connection PREPARE then disconnect, default conn does
# XA RECOVER + COMMIT) doubles as regression coverage for the
# disconnect-degrades-to-detach path: xa_detach_on_prepare defaults
# to OFF, so set_prepared_in_tc returns 0 at PREPARE time and
# THD::cleanup must drive flush_share_cache_on_xa_disconnect when
# the prepared session goes away.  See vidx_xa_prepare_flush §4 for
# the focused, multi-section variant of that scenario.
#
--source include/have_binlog_format_mixed_or_row.inc
CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

--echo # 1. Prepare - Create table with vector index
CREATE TABLE t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(5),
  VECTOR INDEX vi(v)
  ) ENGINE = InnoDB;
--disable_warnings

--echo
--echo # ========================================
--echo # 2. XA Basic Flow: BEGIN -> INSERT -> END -> PREPARE -> COMMIT
--echo # ========================================
XA START 'xa_basic_1';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[1,2,3,4,5]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[5,4,3,2,1]"));
XA END 'xa_basic_1';
XA PREPARE 'xa_basic_1';
XA COMMIT 'xa_basic_1';

--echo # Verify data after XA COMMIT
SELECT COUNT(*) FROM t1;
SELECT id, VEC_TOTEXT(v) FROM t1 ORDER BY id;

--echo # Verify ANN query works after XA COMMIT
EXPLAIN SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 5;
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 5;

--echo
--echo # ========================================
--echo # 3. XA Cross-Connection: PREPARE in conn1, COMMIT in default
--echo # ========================================
--connect (xa_conn, localhost, root,,)
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

XA START 'xa_cross_conn';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[10,20,30,40,50]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[50,40,30,20,10]"));
XA END 'xa_cross_conn';
XA PREPARE 'xa_cross_conn';

--echo # Disconnect the connection that prepared XA
--disconnect xa_conn

--echo # Reconnect and commit in default connection
--connection default

--echo # XA RECOVER should show the prepared transaction
XA RECOVER;

--echo # Commit the XA transaction from different connection
XA COMMIT 'xa_cross_conn';

--echo # Verify data after cross-connection XA COMMIT
SELECT COUNT(*) FROM t1;

--echo # Verify ANN query returns correct results (compare with full table scan)
--echo # Full table scan result:
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(PRIMARY) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[10,20,30,40,50]")) LIMIT 3;
--echo # Vector index scan result:
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[10,20,30,40,50]")) LIMIT 3;

--echo
--echo # ========================================
--echo # 4. XA ROLLBACK after PREPARE
--echo # ========================================
XA START 'xa_rollback_1';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[100,200,300,400,500]"));
XA END 'xa_rollback_1';
XA PREPARE 'xa_rollback_1';

--echo # Record count before rollback
SELECT COUNT(*) FROM t1;

XA ROLLBACK 'xa_rollback_1';

--echo # Record count after rollback - should be same as before INSERT
SELECT COUNT(*) FROM t1;

--echo # Verify the rolled back data is not visible in ANN query
--disable_result_log
SELECT id FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[100,200,300,400,500]")) LIMIT 1;
--enable_result_log

--echo
--echo # ========================================
--echo # 5. XA PREPARE then ANN query (verify cache state)
--echo # ========================================
XA START 'xa_cache_test';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[1.1,2.1,3.1,4.1,5.1]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[1.2,2.2,3.2,4.2,5.2]"));
XA END 'xa_cache_test';
XA PREPARE 'xa_cache_test';

--echo # ANN query during XA PREPARE state (data should not be visible yet)
--echo # The prepared but not committed data should not appear in query results
SELECT COUNT(*) FROM t1;

XA COMMIT 'xa_cache_test';

--echo # After commit, data should be visible
SELECT COUNT(*) FROM t1;

--echo
--echo # ========================================
--echo # 6. XA COMMIT - Verify vector index integrity
--echo # ========================================
--echo # Compare FORCE INDEX(vi) ANN query vs FORCE INDEX(PRIMARY) full scan
--echo # Both should return the same nearest neighbors

--echo # Insert more data for comprehensive comparison
XA START 'xa_integrity';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[2,3,4,5,6]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[3,4,5,6,7]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[4,5,6,7,8]"));
XA END 'xa_integrity';
XA PREPARE 'xa_integrity';
XA COMMIT 'xa_integrity';

--echo # Query vector: [2.5,3.5,4.5,5.5,6.5]
--echo # Full table scan (ground truth):
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[2.5,3.5,4.5,5.5,6.5]")) AS dist 
FROM t1 FORCE INDEX(PRIMARY) 
ORDER BY dist LIMIT 5;

--echo # Vector index scan:
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[2.5,3.5,4.5,5.5,6.5]")) AS dist 
FROM t1 FORCE INDEX(`vi`) 
ORDER BY dist LIMIT 5;

--echo
--echo # ========================================
--echo # 7. Multiple XA transactions (sequential, to avoid lock contention)
--echo # ========================================
--echo # First XA transaction
XA START 'xa_multi_1';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[11,12,13,14,15]"));
XA END 'xa_multi_1';
XA PREPARE 'xa_multi_1';
XA COMMIT 'xa_multi_1';

--echo # Second XA transaction (different connection)
--connect (xa_conn2, localhost, root,,)
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

XA START 'xa_multi_2';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[21,22,23,24,25]"));
XA END 'xa_multi_2';
XA PREPARE 'xa_multi_2';
XA COMMIT 'xa_multi_2';

--disconnect xa_conn2
--connection default

--echo # Verify both transactions committed
SELECT COUNT(*) FROM t1;

--echo
--echo # ========================================
--echo # 8. XA with UPDATE operation
--echo # ========================================
XA START 'xa_update';
UPDATE t1 SET v = VEC_FROMTEXT("[99,99,99,99,99]") WHERE id = 1;
XA END 'xa_update';
XA PREPARE 'xa_update';
XA COMMIT 'xa_update';

--echo # Verify update
SELECT id, VEC_TOTEXT(v) FROM t1 WHERE id = 1;

--echo # Verify ANN query reflects the update
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[99,99,99,99,99]")) LIMIT 1;

--echo
--echo # ========================================
--echo # 9. XA with DELETE operation
--echo # ========================================
--echo # Get current count
SELECT COUNT(*) FROM t1;

XA START 'xa_delete';
DELETE FROM t1 WHERE id = 2;
XA END 'xa_delete';
XA PREPARE 'xa_delete';
XA COMMIT 'xa_delete';

--echo # Verify delete
SELECT COUNT(*) FROM t1;

--echo
--echo # ========================================
--echo # 10. Clean up
--echo # ========================================
--enable_warnings
DROP TABLE t1;

SET GLOBAL vidx_disabled = ON;
