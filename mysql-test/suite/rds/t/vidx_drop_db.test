##########################################
# VECTOR INDEX with DROP DATABASE cascade
##########################################
--source include/have_binlog_format_mixed_or_row.inc

CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

--echo #
--echo # Cleanup before test
--echo #
--disable_warnings
DROP DATABASE IF EXISTS db_vidx_test;
--enable_warnings

--echo #
--echo # 9.1 Create database with multiple VECTOR INDEX tables
--echo #
CREATE DATABASE db_vidx_test;

--echo # Create t1 with dimension=3, M=6
CREATE TABLE db_vidx_test.t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(3),
  VECTOR INDEX vi(v) m=6 distance=euclidean
) ENGINE=InnoDB;

--echo # Create t2 with dimension=5, M=10
CREATE TABLE db_vidx_test.t2 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(5),
  VECTOR INDEX vi(v) m=10 distance=cosine
) ENGINE=InnoDB;

--echo # Create t3 with dimension=8, M=16
CREATE TABLE db_vidx_test.t3 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(8),
  VECTOR INDEX vi(v) m=16 distance=euclidean
) ENGINE=InnoDB;

--echo # Verify all tables created
SHOW CREATE TABLE db_vidx_test.t1;
SHOW CREATE TABLE db_vidx_test.t2;
SHOW CREATE TABLE db_vidx_test.t3;

--echo #
--echo # 9.2 Verify auxiliary tables exist
--echo #
--replace_regex /vidx_[0-9]+/vidx_XXXXX/
SELECT NAME FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE 'db_vidx_test/vidx_%' ORDER BY NAME;

--echo # Count auxiliary tables
SELECT COUNT(*) AS vidx_table_count FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE 'db_vidx_test/vidx_%';

--echo #
--echo # 9.3 DROP DATABASE
--echo #
DROP DATABASE db_vidx_test;

--echo #
--echo # 9.4 Verify auxiliary tables are cleaned up
--echo #
--replace_regex /vidx_[0-9]+/vidx_XXXXX/
SELECT NAME FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE 'db_vidx_test/vidx_%' ORDER BY NAME;

SELECT COUNT(*) AS remaining_vidx_count FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE 'db_vidx_test/vidx_%';

--echo #
--echo # 9.5 Recreate same database and tables - verify no conflicts
--echo #
CREATE DATABASE db_vidx_test;

CREATE TABLE db_vidx_test.t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(3),
  VECTOR INDEX vi(v) m=6 distance=euclidean
) ENGINE=InnoDB;

CREATE TABLE db_vidx_test.t2 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(5),
  VECTOR INDEX vi(v) m=10 distance=cosine
) ENGINE=InnoDB;

CREATE TABLE db_vidx_test.t3 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(8),
  VECTOR INDEX vi(v) m=16 distance=euclidean
) ENGINE=InnoDB;

--echo # Verify tables recreated successfully
SHOW CREATE TABLE db_vidx_test.t1;
SHOW CREATE TABLE db_vidx_test.t2;
SHOW CREATE TABLE db_vidx_test.t3;

--echo # Verify new auxiliary tables created
--replace_regex /vidx_[0-9]+/vidx_XXXXX/
SELECT NAME FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE 'db_vidx_test/vidx_%' ORDER BY NAME;

--echo #
--echo # Additional: Test DROP DATABASE with mixed table types
--echo #
--echo # Add a table without VECTOR INDEX
CREATE TABLE db_vidx_test.t_normal (
  id INT PRIMARY KEY,
  data VARCHAR(100),
  INDEX idx_data(data)
) ENGINE=InnoDB;

--echo # Add a table with both regular and VECTOR INDEX
CREATE TABLE db_vidx_test.t_mixed (
  id INT PRIMARY KEY,
  v VECTOR(4),
  extra INT,
  INDEX idx_extra(extra),
  VECTOR INDEX vi(v) m=8 distance=cosine
) ENGINE=InnoDB;

--echo # Verify all auxiliary tables
--replace_regex /vidx_[0-9]+/vidx_XXXXX/
SELECT NAME FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE 'db_vidx_test/vidx_%' ORDER BY NAME;

--echo # DROP DATABASE with mixed tables
DROP DATABASE db_vidx_test;

--echo # Verify complete cleanup
SELECT COUNT(*) AS final_count FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE 'db_vidx_test/%';

--echo #
--echo # Test: Rapid create/drop cycle
--echo #
CREATE DATABASE db_vidx_test;
CREATE TABLE db_vidx_test.t1 (id INT PRIMARY KEY, v VECTOR(3), VECTOR INDEX vi(v)) ENGINE=InnoDB;
DROP DATABASE db_vidx_test;

CREATE DATABASE db_vidx_test;
CREATE TABLE db_vidx_test.t1 (id INT PRIMARY KEY, v VECTOR(3), VECTOR INDEX vi(v)) ENGINE=InnoDB;
DROP DATABASE db_vidx_test;

CREATE DATABASE db_vidx_test;
CREATE TABLE db_vidx_test.t1 (id INT PRIMARY KEY, v VECTOR(3), VECTOR INDEX vi(v)) ENGINE=InnoDB;

--echo # Verify no leftover from previous cycles
--replace_regex /vidx_[0-9]+/vidx_XXXXX/
SELECT NAME FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE 'db_vidx_test/vidx_%' ORDER BY NAME;

--echo #
--echo # Final cleanup
--echo #
DROP DATABASE db_vidx_test;

--echo # Verify final cleanup
SELECT COUNT(*) AS absolute_final_count FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'db_vidx_test/%';

--echo #
--echo # 9.6 DROP DATABASE while show_vidx_hlindex_tables=ON
--echo #     (regression: previously failed with ER_NO_SUCH_TABLE because
--echo #      find_db_tables() leaked hlindex aux tables into the drop
--echo #      worklist and drop_base_table() rejected HT_HIDDEN_SE.)
--echo #
SET @save_show_vidx = @@global.show_vidx_hlindex_tables;
SET GLOBAL show_vidx_hlindex_tables = ON;

CREATE DATABASE db_vidx_show;
CREATE TABLE db_vidx_show.t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(3),
  VECTOR INDEX vi(v) m=6 distance=euclidean
) ENGINE=InnoDB;
INSERT INTO db_vidx_show.t1(v) VALUES (VEC_FROMTEXT('[1,0,0]'));

--echo # Aux table is exposed under SHOW TABLES while flag is ON
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
SHOW TABLES IN db_vidx_show;

--echo # DROP DATABASE must succeed even with the flag ON
DROP DATABASE db_vidx_show;

--echo # No leftover at SE level
SELECT COUNT(*) AS db_vidx_show_leftover FROM information_schema.INNODB_TABLES
 WHERE NAME LIKE 'db_vidx_show/%';

--echo # Also exercise multi-vidx-table schemas under the flag
CREATE DATABASE db_vidx_show;
CREATE TABLE db_vidx_show.t1 (id INT PRIMARY KEY, v VECTOR(3),
                              VECTOR INDEX vi(v) m=6 distance=euclidean)
  ENGINE=InnoDB;
CREATE TABLE db_vidx_show.t2 (id INT PRIMARY KEY, v VECTOR(5),
                              VECTOR INDEX vi(v) m=10 distance=cosine)
  ENGINE=InnoDB;
INSERT INTO db_vidx_show.t1 VALUES (1, VEC_FROMTEXT('[1,2,3]'));
INSERT INTO db_vidx_show.t2 VALUES (1, VEC_FROMTEXT('[1,2,3,4,5]'));
DROP DATABASE db_vidx_show;
SELECT COUNT(*) AS db_vidx_show_leftover2 FROM information_schema.INNODB_TABLES
 WHERE NAME LIKE 'db_vidx_show/%';

--echo #
--echo # 9.7 User-visible surfaces remain functional under show_vidx_hlindex_tables=ON
--echo #     (no regression: hlindex aux tables must still be enumerable / queryable
--echo #      via SHOW TABLES, I_S.{TABLES,COLUMNS,STATISTICS,INNODB_TABLES},
--echo #      SHOW CREATE TABLE, DESC, SHOW INDEX, and direct SELECT; and OFF must
--echo #      still hide them from SHOW TABLES / I_S and reject direct SELECT.)
--echo #
SET GLOBAL show_vidx_hlindex_tables = ON;

CREATE DATABASE db_vidx_vis;
CREATE TABLE db_vidx_vis.t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(3),
  VECTOR INDEX vi(v) m=6 distance=euclidean
) ENGINE=InnoDB;
INSERT INTO db_vidx_vis.t1(v) VALUES
  (VEC_FROMTEXT('[1,0,0]')),
  (VEC_FROMTEXT('[0,1,0]')),
  (VEC_FROMTEXT('[0,0,1]'));

# Capture the non-deterministic aux table name for use in subsequent statements.
--let $aux= `SELECT table_name FROM information_schema.tables WHERE table_schema='db_vidx_vis' AND table_name LIKE 'vidx_%' LIMIT 1`

--echo # --- flag=ON: SHOW TABLES lists the aux ---
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
SHOW TABLES IN db_vidx_vis;

--echo # --- flag=ON: SHOW TABLES LIKE matches the aux ---
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
SHOW TABLES IN db_vidx_vis LIKE 'vidx_%';

--echo # --- flag=ON: I_S.TABLES lists the aux ---
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
SELECT table_name FROM information_schema.tables
 WHERE table_schema='db_vidx_vis' ORDER BY table_name;

--echo # --- flag=ON: I_S.COLUMNS exposes aux schema (4 cols: layer/tref/vec/neighbors) ---
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
eval SELECT COUNT(*) AS aux_cols FROM information_schema.columns
      WHERE table_schema='db_vidx_vis' AND table_name='$aux';

--echo # --- flag=ON: I_S.STATISTICS exposes aux indexes (2 keys: tref, layer) ---
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
eval SELECT COUNT(*) AS aux_stats FROM information_schema.statistics
      WHERE table_schema='db_vidx_vis' AND table_name='$aux';

--echo # --- flag=ON: I_S.INNODB_TABLES lists the aux (engine-side view, flag-independent) ---
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
SELECT name FROM information_schema.innodb_tables
 WHERE name LIKE 'db_vidx_vis/%' ORDER BY name;

--echo # --- flag=ON: SHOW CREATE TABLE works on the aux ---
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
eval SHOW CREATE TABLE db_vidx_vis.`$aux`;

--echo # --- flag=ON: DESC works on the aux ---
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
eval DESC db_vidx_vis.`$aux`;

--echo # --- flag=ON: SHOW INDEX FROM works on the aux ---
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
eval SHOW INDEX FROM db_vidx_vis.`$aux`;

--echo # --- flag=ON: direct SELECT counts aux rows (one per inserted vector) ---
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
eval SELECT COUNT(*) AS aux_rows FROM db_vidx_vis.`$aux`;

--echo # --- Flip flag OFF and verify the aux disappears from row-filter surfaces.
--echo #     (open-path guard is verified in a fresh session below to avoid the
--echo #      pre-existing table-share cache that already held an open handle on
--echo #      the aux from the flag=ON SELECT above.)
SET GLOBAL show_vidx_hlindex_tables = OFF;

--echo # --- flag=OFF: SHOW TABLES hides the aux ---
SHOW TABLES IN db_vidx_vis;

--echo # --- flag=OFF: I_S.TABLES hides the aux ---
SELECT table_name FROM information_schema.tables
 WHERE table_schema='db_vidx_vis' ORDER BY table_name;

--echo # --- flag=OFF in a fresh session: open-path guard rejects direct SELECT ---
--connect (vidx_off_con, localhost, root,,)
--connection vidx_off_con
--replace_regex /vidx_[0-9]+_[0-9]+/vidx_XXXXX_X/
--error ER_NO_SUCH_TABLE
eval SELECT COUNT(*) FROM db_vidx_vis.`$aux`;
--disconnect vidx_off_con
--connection default

--echo # --- flag=OFF: DROP DATABASE works (pre-fix already worked, sanity) ---
DROP DATABASE db_vidx_vis;

SET GLOBAL show_vidx_hlindex_tables = @save_show_vidx;

SET GLOBAL vidx_disabled = ON;
