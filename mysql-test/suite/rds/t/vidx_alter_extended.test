##########################################
# VECTOR INDEX with extended ALTER TABLE #
# DROP vector column, MODIFY dimension,  #
# ADD COLUMN positioning, CHANGE/RENAME, #
# compound ALTER, nullable vector + DDL  #
##########################################
# Note: ENCRYPTION requires keyring plugin, COMPRESSION requires OS
# punch-hole support. Both go through the standard table rebuild path
# already tested by ALTER TABLE FORCE / ROW_FORMAT in vidx_tablespace.test.
--source include/have_binlog_format_mixed_or_row.inc

CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

--disable_warnings
DROP TABLE IF EXISTS t1, t2;
--enable_warnings

--echo #
--echo # ==========================================================
--echo # 1. Setup
--echo # ==========================================================
--echo #
CREATE TABLE t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(4),
  extra INT DEFAULT 0,
  name VARCHAR(50) DEFAULT 'test',
  VECTOR INDEX vi(v) m=12 distance=euclidean
) ENGINE=InnoDB;

INSERT INTO t1(id, v, extra, name) VALUES (1, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'), 10, 'a');
INSERT INTO t1(id, v, extra, name) VALUES (2, VEC_FROMTEXT('[0.0, 1.0, 0.0, 0.0]'), 20, 'b');
INSERT INTO t1(id, v, extra, name) VALUES (3, VEC_FROMTEXT('[0.0, 0.0, 1.0, 0.0]'), 30, 'c');
INSERT INTO t1(id, v, extra, name) VALUES (4, VEC_FROMTEXT('[0.0, 0.0, 0.0, 1.0]'), 40, 'd');

SHOW CREATE TABLE t1;
SELECT COUNT(*) AS row_count FROM t1;

--echo #
--echo # ==========================================================
--echo # 2. DROP the vector column itself (with data)
--echo # ==========================================================
--echo # Risk: Dropping the vector column must also drop the vector
--echo # index and clean up the auxiliary table. The vector index
--echo # depends on this column.
--echo #
--echo # Note: check_alter_vector_ddl() should reject mixed operations.
--echo # Dropping the vector column implicitly drops the vector index,
--echo # which counts as DROP INDEX mixed with DROP COLUMN.
--echo #

--echo # 2.1 First, try to DROP the vector column (may be rejected as mixed op)
--error 0,ER_NOT_SUPPORTED_YET
ALTER TABLE t1 DROP COLUMN v;

--echo # Check table state
--disable_abort_on_error
SHOW CREATE TABLE t1;
SELECT COUNT(*) FROM t1;
--enable_abort_on_error

--echo # Check if auxiliary tables were cleaned up
SELECT COUNT(*) AS vidx_tables FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';

--echo # Recreate for further tests
DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(4),
  extra INT DEFAULT 0,
  name VARCHAR(50) DEFAULT 'test',
  VECTOR INDEX vi(v) m=12 distance=euclidean
) ENGINE=InnoDB;

INSERT INTO t1(id, v, extra, name) VALUES (1, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'), 10, 'a');
INSERT INTO t1(id, v, extra, name) VALUES (2, VEC_FROMTEXT('[0.0, 1.0, 0.0, 0.0]'), 20, 'b');
INSERT INTO t1(id, v, extra, name) VALUES (3, VEC_FROMTEXT('[0.0, 0.0, 1.0, 0.0]'), 30, 'c');
INSERT INTO t1(id, v, extra, name) VALUES (4, VEC_FROMTEXT('[0.0, 0.0, 0.0, 1.0]'), 40, 'd');

--echo #
--echo # ==========================================================
--echo # 3. MODIFY vector column dimension
--echo # ==========================================================
--echo # Risk: Changing vector dimension should be rejected because
--echo # the auxiliary table is built for a specific dimension.
--echo #
--error 0,ER_NOT_SUPPORTED_YET,ER_ALTER_OPERATION_NOT_SUPPORTED,ER_DATA_INCOMPATIBLE_WITH_VECTOR
ALTER TABLE t1 MODIFY v VECTOR(8);

SHOW CREATE TABLE t1;
SELECT COUNT(*) AS row_count FROM t1;

--echo # Verify ANN search still works (if column was not modified)
--disable_result_log
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
--enable_result_log

--echo #
--echo # ==========================================================
--echo # 4. ADD COLUMN ... AFTER vector_column
--echo # ==========================================================
--echo # Risk: Adding a column after the vector column changes column
--echo # ordering; auxiliary table's reference must still be valid.
--echo #
ALTER TABLE t1 ADD COLUMN data1 INT DEFAULT 0 AFTER v;
SHOW CREATE TABLE t1;

--echo # Verify ANN search after column position change
--disable_result_log
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
--enable_result_log

--echo # ADD COLUMN ... BEFORE vector column (FIRST position)
ALTER TABLE t1 ADD COLUMN data2 INT DEFAULT 0 FIRST;
SHOW CREATE TABLE t1;

--echo # Verify ANN search
--disable_result_log
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
--enable_result_log

--echo # Verify auxiliary tables intact
SELECT COUNT(*) > 0 AS has_vidx_tables FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';

--echo #
--echo # ==========================================================
--echo # 5. ALTER TABLE CHANGE/RENAME the vector column
--echo # ==========================================================
--echo # Risk: Renaming the column that the vector index depends on.
--echo # The vector index key_part references the column by field pointer,
--echo # so column rename should be transparent if done correctly.
--echo #
--error 0,ER_NOT_SUPPORTED_YET
ALTER TABLE t1 CHANGE v vec VECTOR(4);

--echo # Check state
SHOW CREATE TABLE t1;

--echo # If rename succeeded, test ANN search with new column name
--disable_abort_on_error
--disable_result_log
SELECT id, VEC_DISTANCE_EUCLIDEAN(vec, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(vec, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
--enable_result_log
--enable_abort_on_error

--echo # Rename back if needed
--disable_abort_on_error
ALTER TABLE t1 CHANGE vec v VECTOR(4);
--enable_abort_on_error

SHOW CREATE TABLE t1;

--echo #
--echo # ==========================================================
--echo # 6. ALTER TABLE with multiple non-vector operations
--echo # ==========================================================
--echo # Risk: Multiple non-index operations in a single ALTER TABLE
--echo # while vector index exists. check_alter_vector_ddl() should
--echo # allow this since vector index is not being modified.
--echo #
ALTER TABLE t1 ADD COLUMN z1 INT, ADD COLUMN z2 VARCHAR(10), DROP COLUMN data2;
SHOW CREATE TABLE t1;

--echo # Verify ANN search after compound ALTER
--disable_result_log
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
--enable_result_log

--echo #
--echo # ==========================================================
--echo # 7. ALTER TABLE ADD VECTOR INDEX + ADD COLUMN in same DDL
--echo # ==========================================================
--echo # Risk: check_alter_vector_ddl() should reject mixed operations
--echo # where vector index is being added along with other changes.
--echo #
CREATE TABLE t2 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(4)
) ENGINE=InnoDB;

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t2 ADD VECTOR INDEX vi(v), ADD COLUMN extra INT;

SHOW CREATE TABLE t2;

--echo # Do them separately (should succeed)
ALTER TABLE t2 ADD VECTOR INDEX vi(v);
SHOW CREATE TABLE t2;

ALTER TABLE t2 ADD COLUMN extra INT;
SHOW CREATE TABLE t2;

DROP TABLE t2;

--echo #
--echo # ==========================================================
--echo # 8. ALTER TABLE DROP VECTOR INDEX + DROP COLUMN in same DDL
--echo # ==========================================================
--echo # Risk: check_alter_vector_ddl() should reject mixed operations.
--echo #

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t1 DROP INDEX vi, DROP COLUMN z1;

SHOW CREATE TABLE t1;

--echo #
--echo # ==========================================================
--echo # 9. ALTER TABLE with nullable vector column + NULL data
--echo # ==========================================================
--echo # The table allows NULL vector values. Verify DDL operations
--echo # handle NULL vector values correctly during table rebuild.
--echo #
CREATE TABLE t3 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(4),
  VECTOR INDEX vi3(v) m=12 distance=euclidean
) ENGINE=InnoDB;

INSERT INTO t3(id, v) VALUES (1, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'));
INSERT INTO t3(id, v) VALUES (2, NULL);
INSERT INTO t3(id, v) VALUES (3, VEC_FROMTEXT('[0.0, 1.0, 0.0, 0.0]'));
INSERT INTO t3(id, v) VALUES (4, NULL);

SELECT COUNT(*) AS total_rows FROM t3;
SELECT COUNT(v) AS non_null_vectors FROM t3;

--echo # OPTIMIZE TABLE with NULL vector data
OPTIMIZE TABLE t3;
SHOW CREATE TABLE t3;

SELECT COUNT(*) AS total_rows FROM t3;
SELECT COUNT(v) AS non_null_vectors FROM t3;

--echo # ANN search should work, NULLs excluded from results
--disable_result_log
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t3
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
--enable_result_log

--echo # ALTER TABLE FORCE with NULL data
ALTER TABLE t3 FORCE;

SELECT COUNT(*) AS total_rows FROM t3;
SELECT COUNT(v) AS non_null_vectors FROM t3;

--disable_result_log
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t3
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
--enable_result_log

DROP TABLE t3;

--echo #
--echo # ==========================================================
--echo # 10. Cleanup
--echo # ==========================================================
--echo #
DROP TABLE IF EXISTS t1;

--echo # Verify all auxiliary tables cleaned up
SELECT COUNT(*) AS final_vidx_count FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';

SET GLOBAL vidx_disabled = ON;
