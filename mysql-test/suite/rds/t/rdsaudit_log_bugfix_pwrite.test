call mtr.add_suppression("can not open rds audit log");
call mtr.add_suppression("audit my_pwrite got");
call mtr.add_suppression("Some audit logs have lost before");
--source include/have_debug.inc

set global rds_audit_log_version=MYSQL_V1;
set global rds_audit_log_enabled=on;

# simu pwrite return -1
set debug='+d,rds_audit_pwrite_err';
select 1;
select 1;
--sleep 1

# flush ok
show status like 'rds_audit_pwrite_err_num';
set global rds_audit_log_flush=1;
set debug='-d,rds_audit_pwrite_err';

# simu pwrite return 0
set debug='+d,rds_audit_pwrite_0';
select 1;
select 1;
--sleep 1

# flush ok
show status like 'rds_audit_pwrite_err_num';
set global rds_audit_log_flush=1;
set debug='-d,rds_audit_pwrite_0';

set global rds_audit_log_version=default;
set global rds_audit_log_enabled=default;
