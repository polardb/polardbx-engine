################################################################################
# SQL Guard: block UPDATE on mysql.global_grants to prevent privilege escalation
#
# Issue: #85228509  (PolarDB-X 8.0 mysql.global_grants UPDATE绕过提权/文件写)
#
# Vulnerability:
#   Dynamic_privilege_entity_guard::guard_update previously only checked the
#   USER field, leaving PRIV/HOST/WITH_GRANT_OPTION unguarded.  An attacker
#   with mysql.* UPDATE privilege could:
#     1. UPDATE PRIV to SYSTEM_VARIABLES_ADMIN
#     2. SET GLOBAL opt_enable_rds_priv_strategy=OFF
#     3. UPDATE mysql.user Super_priv='Y', File_priv='Y'
#
# Fix:
#   guard_update now unconditionally blocks all non-SUPER UPDATE on
#   mysql.global_grants (aligned with guard_insert blanket block).
#
# Test coverage (three-class per DML防护测试规范):
#   Part A: Attack paths  — blocked operations (ERROR 7529)
#   Part B: Normal paths  — legitimate operations must NOT be blocked
#   Part C: Boundary/edge — strategy off, zero-match, prepared stmt, etc.
#   Part D: Full exploit chain — end-to-end proof the attack is stopped
################################################################################

connect (con_root, localhost, root,,,$MASTER_MYPORT);
connection con_root;

set global opt_enable_rds_priv_strategy=on;

create database test_db;
create table test_db.t1 (id int primary key);
insert into test_db.t1 values (1);

--echo #
--echo # === Setup ===
--echo #

--echo # Reserved account 'u0' with high dynamic privilege
create user 'u0'@'%';
grant SYSTEM_VARIABLES_ADMIN on *.* to 'u0'@'%';

--echo # Attacker 'u1': broad static privileges (NO SUPER), only CONNECTION_ADMIN
create user 'u1'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, RELOAD, PROCESS,
      REFERENCES, INDEX, ALTER, SHOW DATABASES, CREATE TEMPORARY TABLES,
      LOCK TABLES, EXECUTE, REPLICATION SLAVE, REPLICATION CLIENT, CREATE VIEW,
      SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, CREATE USER, EVENT, TRIGGER,
      CREATE ROLE, DROP ROLE ON *.* TO 'u1'@'%' WITH GRANT OPTION;
grant all privileges on test_db.* to 'u1'@'%';
grant CONNECTION_ADMIN on *.* to 'u1'@'%' with grant option;
flush privileges;

--echo # Confirm initial state: u1 only has CONNECTION_ADMIN
select user, host, priv, with_grant_option
  from mysql.global_grants where user='u1' order by priv;
show grants for 'u1'@'%';

connect (con_u1, localhost, u1,,,$MASTER_MYPORT);
connection con_u1;

--echo #
--echo ###########################################################################
--echo # Part A: Attack paths — all must return ERROR 7529
--echo ###########################################################################
--echo #

--echo # A.1 UPDATE PRIV: the exact vulnerability (CONNECTION_ADMIN → SYSTEM_VARIABLES_ADMIN)
--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set priv='SYSTEM_VARIABLES_ADMIN'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';

--echo # A.2 UPDATE PRIV to other high-value targets
--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set priv='ROLE_ADMIN'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';

--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set priv='ENCRYPTION_KEY_ADMIN'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';

--echo # A.3 UPDATE HOST: scope expansion from '%' to more permissive
--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set host='10.%'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';

--echo # A.4 UPDATE USER: hijack reserved user's high privilege
--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set user='u1'
  where user='u0' and host='%';

--echo # A.5 UPDATE USER: hijack into a reserved user name
--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set user='u0'
  where user='u1' and host='%';

--echo # A.6 UPDATE WITH_GRANT_OPTION: escalate grant ability N→Y
connection con_root;
--echo # (prep: set to N so attacker's change is real)
set global opt_enable_rds_priv_strategy=off;
update mysql.global_grants set with_grant_option='N'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';
flush privileges;
set global opt_enable_rds_priv_strategy=on;
connection con_u1;

--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set with_grant_option='Y'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';

--echo # A.7 Multi-table UPDATE (immediate path): join bypass
--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants g, test_db.t1 b
  set g.priv='SYSTEM_VARIABLES_ADMIN'
  where g.user='u1' and b.id=1;

--echo # A.8 Multi-table UPDATE (self-join, buffered path)
--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants a, mysql.global_grants b
  set a.priv='SYSTEM_VARIABLES_ADMIN'
  where a.user='u1' and b.user='u0';

--echo # A.9 INSERT ... ON DUPLICATE KEY UPDATE targeting PRIV
--error ER_RESERVED_USER_OR_PRIVS
insert into mysql.global_grants (user, host, priv, with_grant_option)
  values ('u1','%','CONNECTION_ADMIN','Y')
  on duplicate key update priv='SYSTEM_VARIABLES_ADMIN';

--echo # A.10 REPLACE: implicitly DELETE+INSERT, guard blocks INSERT
--error ER_RESERVED_USER_OR_PRIVS
replace into mysql.global_grants (user, host, priv, with_grant_option)
  values ('u1','%','SYSTEM_VARIABLES_ADMIN','Y');

--echo # A.11 INSERT ... SELECT: cross-table injection
--error ER_RESERVED_USER_OR_PRIVS
insert into mysql.global_grants (user, host, priv, with_grant_option)
  select 'u1','%','SYSTEM_VARIABLES_ADMIN','Y' from test_db.t1 where id=1;

--echo # A.12 Prepared statement: dynamic SQL bypass attempt
prepare stmt from
  'update mysql.global_grants set priv=? where user=? and host=? and priv=?';
set @p1='SYSTEM_VARIABLES_ADMIN', @p2='u1', @p3='%', @p4='CONNECTION_ADMIN';
--error ER_RESERVED_USER_OR_PRIVS
execute stmt using @p1, @p2, @p3, @p4;
deallocate prepare stmt;

--echo # A.13 Subquery in SET clause
--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set priv=(select 'SYSTEM_VARIABLES_ADMIN')
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';

--echo # A.14 UPDATE with LIMIT (partial update attempt)
--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set priv='SYSTEM_VARIABLES_ADMIN'
  where user='u1'
  limit 1;

--echo # A.15 Verify state unchanged after all attacks
select user, host, priv, with_grant_option
  from mysql.global_grants where user='u1' order by priv;

--echo #
--echo ###########################################################################
--echo # Part B: Normal paths — must NOT be blocked
--echo ###########################################################################
--echo #

--echo # B.1 SUPER user can UPDATE global_grants (exempted from guard)
connection con_root;
update mysql.global_grants
  set with_grant_option='Y'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';
select user, host, priv, with_grant_option
  from mysql.global_grants where user='u1';

--echo # B.2 GRANT dynamic privilege via SQL (internal path, not DML)
grant ROLE_ADMIN on *.* to 'u1'@'%';
select user, host, priv from mysql.global_grants
  where user='u1' order by priv;

--echo # B.3 REVOKE dynamic privilege via SQL (internal path)
revoke ROLE_ADMIN on *.* from 'u1'@'%';
select user, host, priv from mysql.global_grants
  where user='u1' order by priv;

--echo # B.4 GRANT with WITH GRANT OPTION upgrade (internal no-op or re-insert)
grant CONNECTION_ADMIN on *.* to 'u1'@'%' with grant option;
select user, host, priv, with_grant_option from mysql.global_grants
  where user='u1' order by priv;

--echo # B.5 DROP USER cleans up global_grants rows (internal path)
create user 'tmp_u'@'%';
grant BINLOG_ADMIN on *.* to 'tmp_u'@'%';
select user, priv from mysql.global_grants where user='tmp_u';
drop user 'tmp_u'@'%';
select user, priv from mysql.global_grants where user='tmp_u';

--echo # B.6 RENAME USER updates global_grants user column (internal path)
create user 'rename_src'@'%';
grant BINLOG_ADMIN on *.* to 'rename_src'@'%';
select user, priv from mysql.global_grants where user='rename_src';
rename user 'rename_src'@'%' to 'rename_dst'@'%';
select user, priv from mysql.global_grants where user='rename_dst';
drop user 'rename_dst'@'%';

--echo # B.7 Non-guarded table: normal user can freely UPDATE
connection con_u1;
update test_db.t1 set id=2 where id=1;
select * from test_db.t1;

--echo #
--echo ###########################################################################
--echo # Part C: Boundary / edge cases
--echo ###########################################################################
--echo #

--echo # C.1 Zero-match WHERE: no row matched, no guard triggered
update mysql.global_grants
  set priv='SYSTEM_VARIABLES_ADMIN'
  where user='nonexistent_xyz' and host='impossible';

--echo # C.2 Strategy OFF: guard disabled, UPDATE is allowed
connection con_root;
set global opt_enable_rds_priv_strategy=off;
connection con_u1;

update mysql.global_grants
  set with_grant_option='N'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';
select user, host, priv, with_grant_option
  from mysql.global_grants where user='u1';

--echo # C.3 Re-enable strategy: guard resumes
connection con_root;
set global opt_enable_rds_priv_strategy=on;
connection con_u1;

--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set with_grant_option='Y'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';

--echo # C.4 Noop UPDATE (same value): MySQL skips ha_update_row, no guard triggered
update mysql.global_grants
  set with_grant_option='N'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';

--echo # C.5 SELECT on global_grants: read is always allowed
select count(*) > 0 as has_rows from mysql.global_grants;

--echo #
--echo ###########################################################################
--echo # Part D: Full exploit chain verification (end-to-end)
--echo ###########################################################################
--echo #

--echo # Step 1: Attacker tries UPDATE PRIV → BLOCKED
--error ER_RESERVED_USER_OR_PRIVS
update mysql.global_grants
  set priv='SYSTEM_VARIABLES_ADMIN'
  where user='u1' and host='%' and priv='CONNECTION_ADMIN';

--echo # Step 2: Without SYSTEM_VARIABLES_ADMIN, cannot disable protection
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
set global opt_enable_rds_priv_strategy=off;

--echo # Step 3: Protection still on → cannot escalate via mysql.user either
--error ER_RESERVED_USER_OR_PRIVS
update mysql.user set super_priv='Y' where user='u1' and host='%';

--echo # Step 4: Verify final state — u1 NOT escalated
show grants for current_user();

--echo # Confirm no SUPER, no FILE, no SYSTEM_VARIABLES_ADMIN
select Super_priv, File_priv from mysql.user where user='u1';
select priv from mysql.global_grants where user='u1';

--echo #
--echo ###########################################################################
--echo # Cleanup
--echo ###########################################################################
--echo #
disconnect con_u1;
connection con_root;

drop database test_db;
drop user 'u0'@'%';
drop user 'u1'@'%';
set global opt_enable_rds_priv_strategy=off;
