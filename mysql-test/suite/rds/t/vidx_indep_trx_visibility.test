##########################################
# Independent transaction visibility     #
# test for Attachable_trx_rw per-row     #
# commit behavior                        #
##########################################
#
# TEST: vidx_indep_trx_visibility
#
# Verifies that aux table changes are visible to other sessions immediately
# after per-row independent commit, even while the main transaction is open.
#
# Key behaviors tested:
#   - Aux table rows visible to other session before main trx commits
#   - ANN search can find vectors from uncommitted main-table rows
#   - After ROLLBACK, aux orphan nodes remain visible
#   - UPDATE path: invalidate+insert visible independently
#   - DELETE path: soft-delete visible immediately
#   - RR isolation: aux table always commits in RC regardless of outer isolation

--source include/count_sessions.inc

SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;

--echo
--echo ##############################################
--echo # Setup                                      #
--echo ##############################################

CREATE TABLE t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  a INT NOT NULL DEFAULT 0,
  v VECTOR(3),
  VECTOR INDEX vi(v)
) ENGINE = InnoDB;

# Get TABLE_ID for auxiliary table queries
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';

# Insert seed data
INSERT INTO t1(a, v) VALUES (1, VEC_FROMTEXT('[1,2,3]'));
INSERT INTO t1(a, v) VALUES (2, VEC_FROMTEXT('[4,5,6]'));
INSERT INTO t1(a, v) VALUES (3, VEC_FROMTEXT('[7,8,9]'));

# Record baseline aux row count
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_baseline FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
SELECT @aux_baseline AS aux_baseline;

--echo
--echo ##############################################
--echo # 1. INSERT in open trx: aux visible to     #
--echo #    other session immediately               #
--echo ##############################################

--connect (con_a, localhost, root,,test)
SET transaction_isolation = 'READ-COMMITTED';
SET GLOBAL show_vidx_hlindex_tables = ON;
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';

--connect (con_b, localhost, root,,test)
SET transaction_isolation = 'READ-COMMITTED';
SET GLOBAL show_vidx_hlindex_tables = ON;
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';

--echo # Session A: BEGIN and INSERT (don't commit main trx)
--connection con_a
BEGIN;
INSERT INTO t1(a, v) VALUES (10, VEC_FROMTEXT('[10,10,10]'));

--echo # Session B: Check aux table - should see new row (independent commit done)
--connection con_b
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_after FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
--echo # aux_after should be greater than aux_baseline (new node added)
SELECT @aux_after > @aux_baseline AS aux_has_new_row;

--echo # Session B: Main table row NOT visible (trx not committed)
SELECT COUNT(*) AS main_row_visible FROM t1 WHERE a = 10;

--echo # Session A: COMMIT
--connection con_a
COMMIT;

--echo # Session B: Now main table row IS visible
--connection con_b
SELECT COUNT(*) AS main_row_visible FROM t1 WHERE a = 10;

--echo
--echo ##############################################
--echo # 2. ANN query finds vector from             #
--echo #    uncommitted main-table row              #
--echo ##############################################

--echo # Session A: BEGIN + INSERT new vector
--connection con_a
BEGIN;
INSERT INTO t1(a, v) VALUES (20, VEC_FROMTEXT('[99,99,99]'));

--echo # Session B: ANN search for [99,99,99] - aux committed so nearest neighbor found
--connection con_b
--echo # Note: The ANN may find the aux node but main-table row invisible in RC
--echo # This verifies aux table visibility doesn't crash and returns valid results
--sorted_result
SELECT id, a FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[99,99,99]')) LIMIT 3;

--echo # Session A: COMMIT
--connection con_a
COMMIT;

--echo
--echo ##############################################
--echo # 3. ROLLBACK: aux orphan persists           #
--echo ##############################################

--connection con_a
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_before_rollback FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;

BEGIN;
INSERT INTO t1(a, v) VALUES (30, VEC_FROMTEXT('[30,30,30]'));
--echo # Aux table should have new row already
ROLLBACK;

--echo # Main table: row should NOT exist after rollback
SELECT COUNT(*) AS main_row FROM t1 WHERE a = 30;

--echo # Aux table: orphan node still exists (independent commit not rolled back)
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_after_rollback FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
SELECT @aux_after_rollback > @aux_before_rollback AS orphan_exists;

--echo # ANN search still works (orphan tolerated)
--sorted_result
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[30,30,30]')) LIMIT 3;

--echo # Session B verify: can also see orphan in aux table
--connection con_b
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_b FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
SELECT @aux_b = @aux_after_rollback AS session_b_sees_orphan;

--echo
--echo ##############################################
--echo # 4. UPDATE in open trx: invalidate+insert  #
--echo #    both visible independently              #
--echo ##############################################

--connection con_a
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_before_update FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;

BEGIN;
UPDATE t1 SET v = VEC_FROMTEXT('[77,77,77]') WHERE id = 1;

--echo # Session B: aux table should have new node from UPDATE (insert part)
--connection con_b
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_after_update FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
--echo # UPDATE = invalidate old + insert new, so aux count increases
SELECT @aux_after_update > @aux_before_update AS update_aux_visible;

--echo # Session A: COMMIT the UPDATE
--connection con_a
COMMIT;

--echo
--echo ##############################################
--echo # 5. DELETE in open trx: soft-delete visible #
--echo ##############################################

--connection con_a
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_before_delete FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;

BEGIN;
DELETE FROM t1 WHERE id = 2;

--echo # Session B: verify aux table change from DELETE (soft-delete/invalidate)
--connection con_b
--echo # After DELETE, the aux node is invalidated - count may decrease or stay
--echo # (implementation-specific: invalidate marks node, may not delete row immediately)
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_after_delete FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
--echo # Main table: row still visible to B (trx not committed in RC)
SELECT COUNT(*) AS main_row_still_visible FROM t1 WHERE id = 2;

--echo # Session A: COMMIT
--connection con_a
COMMIT;

--echo # Session B: Now main table row is gone
--connection con_b
SELECT COUNT(*) AS main_row_after_commit FROM t1 WHERE id = 2;

--echo
--echo ##############################################
--echo # 6. RR isolation: aux commits in RC         #
--echo #    regardless of outer RR setting          #
--echo ##############################################

--connection con_a
SET transaction_isolation = 'REPEATABLE-READ';

--connection con_b
SET transaction_isolation = 'REPEATABLE-READ';

--echo # Session B: start RR transaction and take snapshot
--connection con_b
BEGIN;
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_rr_snap FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
SELECT COUNT(*) INTO @main_rr_snap FROM t1;

--echo # Session A: INSERT in RR
--connection con_a
INSERT INTO t1(a, v) VALUES (60, VEC_FROMTEXT('[60,60,60]'));

--echo # Session B: still in RR trx - aux table sees new data (aux uses RC internally)
--connection con_b
SET @s = CONCAT('SELECT COUNT(*) INTO @aux_rr_after FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s;
--echo # Aux table visible even in RR (aux always commits independently in RC)
SELECT @aux_rr_after > @aux_rr_snap AS aux_visible_in_rr;

--echo # Main table in RR: new row NOT visible (RR snapshot)
SELECT COUNT(*) AS main_rr_unchanged FROM t1 WHERE a = 60;

COMMIT;

--echo # After commit, main table now visible
SELECT COUNT(*) AS main_after_commit FROM t1 WHERE a = 60;

--echo
--echo ##############################################
--echo # Cleanup                                    #
--echo ##############################################

--connection con_a
SET transaction_isolation = 'READ-COMMITTED';
--disconnect con_a

--connection con_b
SET transaction_isolation = 'READ-COMMITTED';
--disconnect con_b

--connection default
DROP TABLE t1;
SET GLOBAL show_vidx_hlindex_tables = OFF;
SET GLOBAL vidx_disabled = ON;

--source include/wait_until_count_sessions.inc
