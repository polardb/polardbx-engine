##########################################
# hlindex cross-statement persistence    #
# Verifies lock-state transitions, DDL   #
# destruction/rebuild, FLUSH, cross-THD  #
# rebind, multi-stmt txn, and stress.    #
##########################################
--source include/have_debug_sync.inc
--source include/have_binlog_format_mixed_or_row.inc
CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

--echo ########################################
--echo # Scenario 1: DML->SELECT lock state switch
--echo # Verifies store_lock clears LOCK_X between DML and SELECT
--echo ########################################

CREATE TABLE t1 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(5),
  VECTOR INDEX vi(v)
) ENGINE=InnoDB;

--echo # INSERT (F_WRLCK) then immediate ANN SELECT (F_RDLCK)
INSERT INTO t1(v) VALUES (VEC_FROMTEXT('[1,2,3,4,5]'));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT('[5,4,3,2,1]'));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT('[1,1,1,1,1]'));

SELECT id FROM t1 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 2;

--echo # UPDATE (F_WRLCK) then SELECT
UPDATE t1 SET v = VEC_FROMTEXT('[9,9,9,9,9]') WHERE id = 1;

SELECT id FROM t1 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[9,9,9,9,9]')) LIMIT 1;

--echo # DELETE (F_WRLCK) then SELECT
DELETE FROM t1 WHERE id = 2;

SELECT id FROM t1 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,1,1,1,1]')) LIMIT 2;

--echo # Rapid alternation: INSERT-SELECT x3
INSERT INTO t1(v) VALUES (VEC_FROMTEXT('[2,2,2,2,2]'));
SELECT COUNT(*) FROM t1 FORCE INDEX(`vi`)
WHERE VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[2,2,2,2,2]')) IS NOT NULL;

INSERT INTO t1(v) VALUES (VEC_FROMTEXT('[3,3,3,3,3]'));
SELECT COUNT(*) FROM t1 FORCE INDEX(`vi`)
WHERE VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[3,3,3,3,3]')) IS NOT NULL;

INSERT INTO t1(v) VALUES (VEC_FROMTEXT('[4,4,4,4,4]'));
SELECT COUNT(*) FROM t1 FORCE INDEX(`vi`)
WHERE VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[4,4,4,4,4]')) IS NOT NULL;

DROP TABLE t1;

--echo ########################################
--echo # Scenario 2: DDL destroys + rebuilds hlindex
--echo ########################################

CREATE TABLE t2 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(5),
  VECTOR INDEX vi(v)
) ENGINE=InnoDB;

INSERT INTO t2(v) VALUES (VEC_FROMTEXT('[1,2,3,4,5]'));
INSERT INTO t2(v) VALUES (VEC_FROMTEXT('[5,4,3,2,1]'));

--echo # ANN query (establishes cached hlindex)
SELECT id FROM t2 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 1;

--echo # TRUNCATE destroys hlindex via intern_close_table
TRUNCATE TABLE t2;

--echo # Re-insert + query (hlindex_open recreates from scratch)
INSERT INTO t2(v) VALUES (VEC_FROMTEXT('[10,20,30,40,50]'));
INSERT INTO t2(v) VALUES (VEC_FROMTEXT('[50,40,30,20,10]'));

SELECT id FROM t2 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[10,20,30,40,50]')) LIMIT 1;

--echo # DROP + ADD VECTOR INDEX
ALTER TABLE t2 DROP INDEX vi;
SHOW CREATE TABLE t2;

ALTER TABLE t2 ADD VECTOR INDEX vi(v);
SHOW CREATE TABLE t2;

--echo # DML after index rebuild
INSERT INTO t2(v) VALUES (VEC_FROMTEXT('[7,7,7,7,7]'));
SELECT id FROM t2 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[7,7,7,7,7]')) LIMIT 1;

DROP TABLE t2;

--echo ########################################
--echo # Scenario 3: FLUSH TABLES invalidates cached hlindex
--echo ########################################

CREATE TABLE t3 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(5),
  VECTOR INDEX vi(v)
) ENGINE=InnoDB;

INSERT INTO t3(v) VALUES (VEC_FROMTEXT('[1,2,3,4,5]'));
INSERT INTO t3(v) VALUES (VEC_FROMTEXT('[5,4,3,2,1]'));

--echo # Query to cache hlindex
SELECT id FROM t3 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 1;

--echo # FLUSH TABLES - TABLE instances destroyed, hlindex included
FLUSH TABLES;

--echo # Query after flush (new TABLE instance, fresh hlindex_open)
SELECT id FROM t3 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 1;

--echo # DML after flush
INSERT INTO t3(v) VALUES (VEC_FROMTEXT('[9,9,9,9,9]'));

--echo # Single-table flush
FLUSH TABLE t3;

SELECT id FROM t3 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[9,9,9,9,9]')) LIMIT 1;

DROP TABLE t3;

--echo ########################################
--echo # Scenario 4: Cross-THD rebind
--echo ########################################

CREATE TABLE t4 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(5),
  VECTOR INDEX vi(v)
) ENGINE=InnoDB;

--connect (c1, localhost, root,,)
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
INSERT INTO t4(v) VALUES (VEC_FROMTEXT('[1,1,1,1,1]'));
INSERT INTO t4(v) VALUES (VEC_FROMTEXT('[2,2,2,2,2]'));
SELECT id FROM t4 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,1,1,1,1]')) LIMIT 1;
--disconnect c1

--connect (c2, localhost, root,,)
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
--echo # c2 may get the same TABLE instance c1 used (cross-THD rebind)
SELECT id FROM t4 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[2,2,2,2,2]')) LIMIT 1;
UPDATE t4 SET v = VEC_FROMTEXT('[8,8,8,8,8]') WHERE id = 1;
SELECT id FROM t4 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[8,8,8,8,8]')) LIMIT 1;
--disconnect c2

--connect (c3, localhost, root,,)
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
--echo # c3 reuses again
INSERT INTO t4(v) VALUES (VEC_FROMTEXT('[5,5,5,5,5]'));
SELECT id FROM t4 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[5,5,5,5,5]')) LIMIT 1;
--disconnect c3

--connection default
SELECT COUNT(*) FROM t4;
DROP TABLE t4;

--echo ########################################
--echo # Scenario 5: Multi-statement transaction hlindex reuse
--echo ########################################

CREATE TABLE t5 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(5),
  VECTOR INDEX vi(v)
) ENGINE=InnoDB;

--echo # Multiple INSERTs in one txn (hlindex_lock idempotent for same THD)
BEGIN;
INSERT INTO t5(v) VALUES (VEC_FROMTEXT('[1,0,0,0,0]'));
INSERT INTO t5(v) VALUES (VEC_FROMTEXT('[0,1,0,0,0]'));
INSERT INTO t5(v) VALUES (VEC_FROMTEXT('[0,0,1,0,0]'));
--echo # ANN within same txn (switch from F_WRLCK to F_RDLCK mid-txn)
--disable_result_log
SELECT id FROM t5 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,0,0,0,0]')) LIMIT 2;
--enable_result_log
COMMIT;

--echo # Verify committed
SELECT COUNT(*) FROM t5;

--echo # ROLLBACK scenario: hlindex state must be clean afterwards
BEGIN;
INSERT INTO t5(v) VALUES (VEC_FROMTEXT('[99,99,99,99,99]'));
ROLLBACK;

--echo # SELECT after rollback should work without stale state
SELECT id FROM t5 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,0,0,0,0]')) LIMIT 1;

--echo # INSERT after rollback
INSERT INTO t5(v) VALUES (VEC_FROMTEXT('[7,7,7,7,7]'));
SELECT COUNT(*) FROM t5;

DROP TABLE t5;

--echo ########################################
--echo # Scenario 6: Concurrent DDL waits for DML (MDL serialization)
--echo ########################################

CREATE TABLE t6 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(5),
  VECTOR INDEX vi(v)
) ENGINE=InnoDB;

INSERT INTO t6(v) VALUES (VEC_FROMTEXT('[1,2,3,4,5]'));
INSERT INTO t6(v) VALUES (VEC_FROMTEXT('[5,4,3,2,1]'));

--connect (dml_conn, localhost, root,,)
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

--connect (ddl_conn, localhost, root,,)
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

--connection dml_conn
BEGIN;
INSERT INTO t6(v) VALUES (VEC_FROMTEXT('[10,10,10,10,10]'));
--echo # DML holds MDL_SHARED_WRITE on t6

--connection ddl_conn
--echo # DDL needs MDL_EXCLUSIVE - will wait
SET SESSION lock_wait_timeout = 5;
--send ALTER TABLE t6 DROP INDEX vi

--connection dml_conn
--echo # Commit releases MDL, unblocking DDL
COMMIT;

--connection ddl_conn
--reap
SHOW CREATE TABLE t6;

--echo # INSERT without vector index (hlindex destroyed, no crash)
--connection dml_conn
INSERT INTO t6(v) VALUES (VEC_FROMTEXT('[20,20,20,20,20]'));
SELECT COUNT(*) FROM t6;

--disconnect dml_conn
--disconnect ddl_conn
--connection default
DROP TABLE t6;

--echo ########################################
--echo # Scenario 7: Rapid INSERT+SELECT stress (50 iterations)
--echo ########################################

CREATE TABLE t7 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v VECTOR(5),
  VECTOR INDEX vi(v)
) ENGINE=InnoDB;

--disable_query_log
--disable_result_log
let $i = 50;
while ($i)
{
  eval INSERT INTO t7(v) VALUES (VEC_FROMTEXT(CONCAT('[$i,$i,$i,$i,$i]')));
  eval SELECT id FROM t7 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT(CONCAT('[$i,$i,$i,$i,$i]'))) LIMIT 1;
  dec $i;
}
--enable_result_log
--enable_query_log

--echo # Verify all 50 rows present
SELECT COUNT(*) FROM t7;

--echo # Final ANN query
SELECT id FROM t7 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[25,25,25,25,25]')), id LIMIT 3;

DROP TABLE t7;

--echo ########################################
--echo # Scenario 8: Multi-index lock state transitions
--echo # Verifies all hlindex slots are correctly locked/unlocked
--echo ########################################

CREATE TABLE t8 (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  v1 VECTOR(5),
  v2 VECTOR(5),
  VECTOR INDEX vi1(v1),
  VECTOR INDEX vi2(v2)
) ENGINE=InnoDB;

--echo # INSERT locks multiple hlindex slots, then SELECT switches to F_RDLCK
INSERT INTO t8(v1, v2) VALUES (VEC_FROMTEXT('[1,2,3,4,5]'), VEC_FROMTEXT('[5,4,3,2,1]'));
INSERT INTO t8(v1, v2) VALUES (VEC_FROMTEXT('[2,3,4,5,6]'), VEC_FROMTEXT('[6,5,4,3,2]'));
INSERT INTO t8(v1, v2) VALUES (VEC_FROMTEXT('[3,4,5,6,7]'), VEC_FROMTEXT('[7,6,5,4,3]'));

--echo # ANN on v1 (rebinds hlindex slot 0 as F_RDLCK)
SELECT id FROM t8 FORCE INDEX(`vi1`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 1;

--echo # ANN on v2 (rebinds hlindex slot 1 as F_RDLCK)
SELECT id FROM t8 FORCE INDEX(`vi2`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v2, VEC_FROMTEXT('[5,4,3,2,1]')) LIMIT 1;

--echo # Rapid INSERT-SELECT alternation on multi-index table
INSERT INTO t8(v1, v2) VALUES (VEC_FROMTEXT('[4,4,4,4,4]'), VEC_FROMTEXT('[8,8,8,8,8]'));
SELECT id FROM t8 FORCE INDEX(`vi1`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[4,4,4,4,4]')) LIMIT 1;
SELECT id FROM t8 FORCE INDEX(`vi2`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v2, VEC_FROMTEXT('[8,8,8,8,8]')) LIMIT 1;

--echo # FLUSH TABLES invalidates all hlindex slots
FLUSH TABLES;

--echo # Re-query after flush (fresh hlindex_open for both slots)
SELECT id FROM t8 FORCE INDEX(`vi1`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 1;
SELECT id FROM t8 FORCE INDEX(`vi2`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v2, VEC_FROMTEXT('[5,4,3,2,1]')) LIMIT 1;

--echo # TRUNCATE with multi-index
TRUNCATE TABLE t8;
INSERT INTO t8(v1, v2) VALUES (VEC_FROMTEXT('[9,9,9,9,9]'), VEC_FROMTEXT('[1,1,1,1,1]'));
SELECT id FROM t8 FORCE INDEX(`vi1`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[9,9,9,9,9]')) LIMIT 1;
SELECT id FROM t8 FORCE INDEX(`vi2`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v2, VEC_FROMTEXT('[1,1,1,1,1]')) LIMIT 1;

DROP TABLE t8;

--echo ########################################
--echo # Cleanup
--echo ########################################
SET GLOBAL vidx_disabled = ON;
