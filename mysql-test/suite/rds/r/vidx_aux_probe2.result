test.vidx_XXXXX_X	optimize	Error	Table 'test.vidx_XXXXX_X' doesn't exist
test.vidx_XXXXX_X	optimize	status	Operation failed
ANALYZE TABLE test.`vidx_XXXXX_X`;
Table	Op	Msg_type	Msg_text
test.vidx_XXXXX_X	analyze	Error	Table 'test.vidx_XXXXX_X' doesn't exist
test.vidx_XXXXX_X	analyze	status	Operation failed
REPAIR TABLE test.`vidx_XXXXX_X`;
Table	Op	Msg_type	Msg_text
test.vidx_XXXXX_X	repair	Error	Table 'test.vidx_XXXXX_X' doesn't exist
test.vidx_XXXXX_X	repair	status	Operation failed
CHECK TABLE test.`vidx_XXXXX_X`;
Table	Op	Msg_type	Msg_text
test.vidx_XXXXX_X	check	Error	Table 'test.vidx_XXXXX_X' doesn't exist
test.vidx_XXXXX_X	check	status	Operation failed
SET GLOBAL show_vidx_hlindex_tables = ON;
# base OPTIMIZE still ok after OFF probes:
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
SELECT 'survived OFF probe' AS r2;
r2
survived OFF probe
DROP TABLE t1;
SET GLOBAL show_vidx_hlindex_tables = OFF;
