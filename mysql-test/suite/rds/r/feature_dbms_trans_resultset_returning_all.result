call mtr.add_suppression("Unsafe statement written to the binary log");
drop table if exists t1,t2;
CREATE TABLE `t1` (
`id` int NOT NULL AUTO_INCREMENT,
`col1` int NOT NULL DEFAULT '1',
`name` varchar(12) DEFAULT 'tom',
PRIMARY KEY (`id`)
) ENGINE=InnoDB;
CREATE TABLE `t2` (
`id` int NOT NULL AUTO_INCREMENT,
`col1` int NOT NULL DEFAULT '1',
`name` varchar(12) DEFAULT 'tom',
PRIMARY KEY (`id`)
) ENGINE=InnoDB;
insert into t1(col1, name) values(1, 'Tom');
insert into t1(col1, name) values(2, 'Alice');
insert into t2 select * from t1;
call dbms_trans.returning_all("*", "insert into t1(col1, name) values (3, 'tom1')");
returning_before_after	id	col1	name
1	3	3	tom1
call dbms_trans.returning_all("col1", "insert into t1(col1, name) values (4, 'tom2')");
returning_before_after	col1
1	4
call dbms_trans.returning_all("id, col1, name", "insert into t1(col1, name) values (5, 'tom3')");
returning_before_after	id	col1	name
1	5	5	tom3
call dbms_trans.returning("*", "insert into t2(col1, name) values (3, 'tom1')");
id	col1	name
3	3	tom1
call dbms_trans.returning("col1", "insert into t2(col1, name) values (4, 'tom2')");
col1
4
call dbms_trans.returning("id, col1, name", "insert into t2(col1, name) values (5, 'tom3')");
