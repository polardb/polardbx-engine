RESET SLAVE ALL;
SET transaction_isolation = 'READ-COMMITTED';
SET GLOBAL vidx_disabled = OFF;
#
# Test 0a: ALTER TABLE MODIFY COLUMN INVISIBLE should fail
#
CREATE TABLE tmi_t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
);
ALTER TABLE tmi_t1 MODIFY COLUMN v VECTOR(5) INVISIBLE;
ERROR HY000: Incorrect usage of vector index: Only support one visible VECTOR column
DROP TABLE tmi_t1;
#
# Test 0b: DROP INDEX should succeed for vector index
#
CREATE TABLE tmi_t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
);
SHOW INDEX FROM tmi_t1 WHERE Key_name = 'vi';
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
tmi_t1	1	vi	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=5	YES	NULL
DROP INDEX vi ON tmi_t1;
SHOW INDEX FROM tmi_t1 WHERE Key_name = 'vi';
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
DROP TABLE tmi_t1;
#
# Test 0c: ALTER TABLE DROP INDEX should succeed for vector index
#
CREATE TABLE tmi_t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
);
ALTER TABLE tmi_t1 DROP INDEX vi;
SHOW INDEX FROM tmi_t1 WHERE Key_name = 'vi';
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
DROP TABLE tmi_t1;
#
# Test 1: Single-index baseline
#
CREATE TABLE tmi_t0 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
);
INSERT INTO tmi_t0 (v) VALUES (VEC_FROMTEXT('[1,2,3,4,5]'));
INSERT INTO tmi_t0 (v) VALUES (VEC_FROMTEXT('[6,7,8,9,10]'));
SELECT id FROM tmi_t0 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 2;
id
1
2
DROP TABLE tmi_t0;
#
# Test 2: CREATE TABLE with 2 vector indexes on same column
#
CREATE TABLE tmi_t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v),
VECTOR INDEX vi2(v)
);
Warnings:
Warning	1831	Duplicate index 'vi2' defined on the table 'test.tmi_t1'. This is deprecated and will be disallowed in a future release.
INSERT INTO tmi_t1 (v) VALUES (VEC_FROMTEXT('[1,2,3,4,5]'));
INSERT INTO tmi_t1 (v) VALUES (VEC_FROMTEXT('[6,7,8,9,10]'));
# Query uses vector index
SELECT id FROM tmi_t1 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 2;
id
1
2
SHOW CREATE TABLE tmi_t1;
Table	Create Table
tmi_t1	CREATE TABLE `tmi_t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10,
  VECTOR KEY `vi2` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# SHOW INDEX lists both vector indexes
SHOW INDEX FROM tmi_t1 WHERE Index_type = 'VECTOR';
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
tmi_t1	1	vi	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=5	YES	NULL
tmi_t1	1	vi2	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=5	YES	NULL
# VECTOR_INDEXES shows both
SELECT INDEX_NAME, COLUMN_NAME, METRIC_TYPE, M, HLINDEX_TABLE_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'tmi_t1'
ORDER BY INDEX_NAME;
INDEX_NAME	COLUMN_NAME	METRIC_TYPE	M	HLINDEX_TABLE_NAME
vi	v	EUCLIDEAN	6	HLINDEX_TABLE_NAME
vi2	v	EUCLIDEAN	6	HLINDEX_TABLE_NAME
DROP TABLE tmi_t1;
#
# Test 3: Two vector indexes on different columns
#
CREATE TABLE t_multi (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v1 VECTOR(3),
v2 VECTOR(4),
VECTOR INDEX idx_v1(v1),
VECTOR INDEX idx_v2(v2)
);
INSERT INTO t_multi (v1, v2) VALUES (VEC_FROMTEXT('[1,2,3]'), VEC_FROMTEXT('[1,0,0,0]'));
INSERT INTO t_multi (v1, v2) VALUES (VEC_FROMTEXT('[4,5,6]'), VEC_FROMTEXT('[0,1,0,0]'));
INSERT INTO t_multi (v1, v2) VALUES (VEC_FROMTEXT('[7,8,9]'), VEC_FROMTEXT('[0,0,1,0]'));
# Search on v1
SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[1,2,3]')) LIMIT 1;
id
1
# Search on v2
SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v2, VEC_FROMTEXT('[0,0,1,0]')) LIMIT 1;
id
3
SHOW CREATE TABLE t_multi;
Table	Create Table
t_multi	CREATE TABLE `t_multi` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v1` vector(3) DEFAULT NULL,
  `v2` vector(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `idx_v1` (`v1`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10,
  VECTOR KEY `idx_v2` (`v2`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# SHOW INDEX should list both vector indexes
SHOW INDEX FROM t_multi;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_multi	0	PRIMARY	1	id	A	#	NULL	NULL		BTREE			YES	NULL
t_multi	1	idx_v1	1	v1	NULL	#	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=3	YES	NULL
t_multi	1	idx_v2	1	v2	NULL	#	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=4	YES	NULL
# INFORMATION_SCHEMA.VECTOR_INDEXES should return 2 rows
SELECT INDEX_NAME, COLUMN_NAME, METRIC_TYPE, M, HLINDEX_TABLE_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_multi'
ORDER BY INDEX_NAME;
INDEX_NAME	COLUMN_NAME	METRIC_TYPE	M	HLINDEX_TABLE_NAME
idx_v1	v1	EUCLIDEAN	6	HLINDEX_TABLE_NAME
idx_v2	v2	EUCLIDEAN	6	HLINDEX_TABLE_NAME
# EXPLAIN should pick idx_v1 for v1 query
EXPLAIN SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[1,2,3]')) LIMIT 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_multi	NULL	ALL	NULL	NULL	NULL	NULL	X	100.00	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t_multi`.`id` AS `id` from `test`.`t_multi` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t_multi`.`v1`,VEC_FromText('[1,2,3]')) limit 1
# EXPLAIN should pick idx_v2 for v2 query
EXPLAIN SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v2, VEC_FROMTEXT('[0,0,1,0]')) LIMIT 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_multi	NULL	ALL	NULL	NULL	NULL	NULL	X	100.00	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t_multi`.`id` AS `id` from `test`.`t_multi` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t_multi`.`v2`,VEC_FromText('[0,0,1,0]')) limit 1
#
# Test 4: TRUNCATE with multiple vector indexes
#
TRUNCATE TABLE t_multi;
SELECT COUNT(*) AS cnt FROM t_multi;
cnt
0
INSERT INTO t_multi (v1, v2) VALUES (VEC_FROMTEXT('[9,8,7]'), VEC_FROMTEXT('[0,0,0,1]'));
SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[9,8,7]')) LIMIT 1;
id
1
SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v2, VEC_FROMTEXT('[0,0,0,1]')) LIMIT 1;
id
1
# Metadata intact after TRUNCATE
SHOW INDEX FROM t_multi WHERE Index_type = 'VECTOR';
