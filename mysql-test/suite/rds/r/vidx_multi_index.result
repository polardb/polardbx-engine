#
# Test 5: RENAME with multiple vector indexes
#
RENAME TABLE t_multi TO t_renamed;
SELECT id FROM t_renamed ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[9,8,7]')) LIMIT 1;
id
1
# Metadata reflects new table name
SELECT TABLE_NAME, INDEX_NAME, COLUMN_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_renamed'
ORDER BY INDEX_NAME;
TABLE_NAME	INDEX_NAME	COLUMN_NAME
t_renamed	idx_v1	v1
t_renamed	idx_v2	v2
RENAME TABLE t_renamed TO t_multi;
#
# Test 6: UPDATE routes to correct hlindex
#
UPDATE t_multi SET v1 = VEC_FROMTEXT('[0,0,0]') WHERE id = 1;
SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[0,0,0]')) LIMIT 1;
id
1
#
# Test 7: DELETE with multiple indexes
#
DELETE FROM t_multi WHERE id = 1;
SELECT COUNT(*) AS cnt FROM t_multi;
cnt
0
# Search still works on both indexes after DELETE
SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[9,8,7]')) LIMIT 1;
id
SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v2, VEC_FROMTEXT('[0,0,0,1]')) LIMIT 1;
id
#
# Test 8: OPTIMIZE TABLE with multiple indexes
#
OPTIMIZE TABLE t_multi;
Table	Op	Msg_type	Msg_text
test.t_multi	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t_multi	optimize	status	OK
# Both indexes usable after OPTIMIZE
SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[9,8,7]')) LIMIT 1;
id
SELECT id FROM t_multi ORDER BY VEC_DISTANCE_EUCLIDEAN(v2, VEC_FROMTEXT('[0,0,0,1]')) LIMIT 1;
id
SHOW INDEX FROM t_multi WHERE Index_type = 'VECTOR';
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_multi	1	idx_v1	1	v1	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=3	YES	NULL
t_multi	1	idx_v2	1	v2	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=4	YES	NULL
DROP TABLE t_multi;
#
# Test 9: DROP + ADD vector index cycles (multi-index ALTER TABLE)
# Verifies: cascade F_UNLCK releases ALL hlindex slots; metadata and
# query correctness after each DDL step; repeated cycles.
#
CREATE TABLE tmi_da (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v),
VECTOR INDEX vi2(v)
);
Warnings:
Warning	1831	Duplicate index 'vi2' defined on the table 'test.tmi_da'. This is deprecated and will be disallowed in a future release.
INSERT INTO tmi_da (v) VALUES (VEC_FROMTEXT('[1,2,3,4,5]'));
INSERT INTO tmi_da (v) VALUES (VEC_FROMTEXT('[6,7,8,9,10]'));
INSERT INTO tmi_da (v) VALUES (VEC_FROMTEXT('[2,4,6,8,10]'));
# -- Initial state: 2 indexes (vi, vi2)
SHOW INDEX FROM tmi_da WHERE Index_type = 'VECTOR';
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
tmi_da	1	vi	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=5	YES	NULL
tmi_da	1	vi2	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=5	YES	NULL
SELECT INDEX_NAME, COLUMN_NAME, DIMENSION, M, HLINDEX_TABLE_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'tmi_da'
ORDER BY INDEX_NAME;
INDEX_NAME	COLUMN_NAME	DIMENSION	M	HLINDEX_TABLE_NAME
vi	v	5	6	HLINDEX_TABLE_NAME
vi2	v	5	6	HLINDEX_TABLE_NAME
SELECT id FROM tmi_da ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 1;
id
1
# -- Step 1: DROP vi → only vi2 remains
DROP INDEX vi ON tmi_da;
SHOW INDEX FROM tmi_da WHERE Index_type = 'VECTOR';
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
tmi_da	1	vi2	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=5	YES	NULL
SELECT INDEX_NAME, COLUMN_NAME, DIMENSION, M, HLINDEX_TABLE_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'tmi_da'
ORDER BY INDEX_NAME;
INDEX_NAME	COLUMN_NAME	DIMENSION	M	HLINDEX_TABLE_NAME
vi2	v	5	6	HLINDEX_TABLE_NAME
# Search still works via vi2
SELECT id FROM tmi_da ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 1;
id
1
# -- Step 2: ADD vi3 → now vi2 + vi3
ALTER TABLE tmi_da ADD VECTOR INDEX vi3(v);
Warnings:
Warning	1831	Duplicate index 'vi3' defined on the table 'test.tmi_da'. This is deprecated and will be disallowed in a future release.
SHOW INDEX FROM tmi_da WHERE Index_type = 'VECTOR';
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
tmi_da	1	vi2	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=5	YES	NULL
tmi_da	1	vi3	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=5	YES	NULL
SELECT INDEX_NAME, COLUMN_NAME, DIMENSION, M, HLINDEX_TABLE_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'tmi_da'
ORDER BY INDEX_NAME;
INDEX_NAME	COLUMN_NAME	DIMENSION	M	HLINDEX_TABLE_NAME
vi2	v	5	6	HLINDEX_TABLE_NAME
vi3	v	5	6	HLINDEX_TABLE_NAME
# Both indexes serve queries
SELECT id FROM tmi_da ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 1;
id
1
# INSERT after ADD INDEX
INSERT INTO tmi_da (v) VALUES (VEC_FROMTEXT('[3,3,3,3,3]'));
SELECT id FROM tmi_da ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[3,3,3,3,3]')) LIMIT 1;
