#
# Test 10: Key_map boundary for hidden hlindex keys
#
# CREATE TABLE with 31 vector indexes succeeds (1 PK + 31 visible + 31 hidden = 63 keys)
CREATE TABLE t_max (id INT NOT NULL AUTO_INCREMENT PRIMARY KEY, v1 VECTOR(4), VECTOR INDEX vi1(v1), v2 VECTOR(4), VECTOR INDEX vi2(v2), v3 VECTOR(4), VECTOR INDEX vi3(v3), v4 VECTOR(4), VECTOR INDEX vi4(v4), v5 VECTOR(4), VECTOR INDEX vi5(v5), v6 VECTOR(4), VECTOR INDEX vi6(v6), v7 VECTOR(4), VECTOR INDEX vi7(v7), v8 VECTOR(4), VECTOR INDEX vi8(v8), v9 VECTOR(4), VECTOR INDEX vi9(v9), v10 VECTOR(4), VECTOR INDEX vi10(v10), v11 VECTOR(4), VECTOR INDEX vi11(v11), v12 VECTOR(4), VECTOR INDEX vi12(v12), v13 VECTOR(4), VECTOR INDEX vi13(v13), v14 VECTOR(4), VECTOR INDEX vi14(v14), v15 VECTOR(4), VECTOR INDEX vi15(v15), v16 VECTOR(4), VECTOR INDEX vi16(v16), v17 VECTOR(4), VECTOR INDEX vi17(v17), v18 VECTOR(4), VECTOR INDEX vi18(v18), v19 VECTOR(4), VECTOR INDEX vi19(v19), v20 VECTOR(4), VECTOR INDEX vi20(v20), v21 VECTOR(4), VECTOR INDEX vi21(v21), v22 VECTOR(4), VECTOR INDEX vi22(v22), v23 VECTOR(4), VECTOR INDEX vi23(v23), v24 VECTOR(4), VECTOR INDEX vi24(v24), v25 VECTOR(4), VECTOR INDEX vi25(v25), v26 VECTOR(4), VECTOR INDEX vi26(v26), v27 VECTOR(4), VECTOR INDEX vi27(v27), v28 VECTOR(4), VECTOR INDEX vi28(v28), v29 VECTOR(4), VECTOR INDEX vi29(v29), v30 VECTOR(4), VECTOR INDEX vi30(v30), v31 VECTOR(4), VECTOR INDEX vi31(v31)) ENGINE=InnoDB;
# INSERT into table with 31 vector indexes
INSERT INTO t_max (v1, v2, v3) VALUES (VEC_FROMTEXT('[1,2,3,4]'), VEC_FROMTEXT('[5,6,7,8]'), VEC_FROMTEXT('[9,0,1,2]'));
# Search on first vector index
SELECT id FROM t_max ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[1,2,3,4]')) LIMIT 1;
id
1
# Search on last vector index
SELECT id FROM t_max ORDER BY VEC_DISTANCE_EUCLIDEAN(v31, VEC_FROMTEXT('[0,0,0,0]')) LIMIT 1;
id
1
# INFORMATION_SCHEMA should show 31 rows
SELECT COUNT(*) AS vec_index_count
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_max';
vec_index_count
31
DROP TABLE t_max;
