# 17. INFORMATION_SCHEMA.INNODB_COLUMNS for vector column
SELECT 
c.NAME AS COLUMN_NAME,
c.POS,
c.MTYPE,
c.LEN
FROM INFORMATION_SCHEMA.INNODB_COLUMNS c
JOIN INFORMATION_SCHEMA.INNODB_TABLES t ON c.TABLE_ID = t.TABLE_ID
WHERE t.NAME LIKE CONCAT(DATABASE(), '/t1')
ORDER BY c.POS;
COLUMN_NAME	POS	MTYPE	LEN
id	0	6	4
name	1	12	400
v	2	4	20
extra	3	6	4

# 18. Cleanup
DROP TABLE t2;
DROP TABLE t1;

# 19. Multi-index metadata in INFORMATION_SCHEMA
CREATE TABLE t_mi (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v1 VECTOR(5),
v2 VECTOR(3),
VECTOR INDEX vi1(v1) M=16 DISTANCE=euclidean,
VECTOR INDEX vi2(v2) M=8 DISTANCE=cosine
) ENGINE=InnoDB;
INSERT INTO t_mi(v1, v2) VALUES (VEC_FROMTEXT('[1,2,3,4,5]'), VEC_FROMTEXT('[1,0,0]'));
INSERT INTO t_mi(v1, v2) VALUES (VEC_FROMTEXT('[5,4,3,2,1]'), VEC_FROMTEXT('[0,1,0]'));
# 19a. STATISTICS shows both vector indexes
SELECT INDEX_NAME, COLUMN_NAME, INDEX_TYPE
FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_mi' AND INDEX_TYPE = 'VECTOR'
ORDER BY INDEX_NAME;
INDEX_NAME	COLUMN_NAME	INDEX_TYPE
# 19b. INNODB_TABLES shows multiple vidx_ auxiliary tables
SELECT NAME FROM INFORMATION_SCHEMA.INNODB_TABLES
WHERE NAME LIKE CONCAT(DATABASE(), '/vidx_%')
ORDER BY NAME;
NAME
test/vidx_XXXX_0
test/vidx_XXXX_1
# 19c. VECTOR_INDEXES returns correct rows for multi-index table
SELECT INDEX_NAME, COLUMN_NAME, METRIC_TYPE, DIMENSION, HLINDEX_TABLE_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_mi'
ORDER BY INDEX_NAME;
INDEX_NAME	COLUMN_NAME	METRIC_TYPE	DIMENSION	HLINDEX_TABLE_NAME
vi1	v1	EUCLIDEAN	5	HLINDEX_TABLE_NAME
vi2	v2	COSINE	3	HLINDEX_TABLE_NAME
# 19d. SHOW INDEX lists both vector indexes with params
SHOW INDEX FROM t_mi WHERE Index_type = 'VECTOR';
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_mi	1	vi1	1	v1	NULL	NULL	NULL	NULL		VECTOR		M=16, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=5	YES	NULL
t_mi	1	vi2	1	v2	NULL	NULL	NULL	NULL		VECTOR		M=8, DISTANCE=COSINE, EF_CONSTRUCTION=10, DIM=3	YES	NULL
DROP TABLE t_mi;
SET GLOBAL vidx_disabled = ON;
