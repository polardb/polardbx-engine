Warnings:
Note	1003	/* select#1 */ select `test`.`t4`.`id` AS `id`,`test`.`t4`.`v` AS `v` from `test`.`t4` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t4`.`v`,VEC_FromText('[0.5,0.5,0.5,0.5,0.5]')) limit 5
# 14. Multi-index: optimizer picks correct index per column
CREATE TABLE t_mi (
id INT AUTO_INCREMENT PRIMARY KEY,
v1 VECTOR(4),
v2 VECTOR(4),
VECTOR INDEX idx_v1(v1) DISTANCE=euclidean,
VECTOR INDEX idx_v2(v2) DISTANCE=cosine
) ENGINE=InnoDB;
ANALYZE TABLE t_mi;
Table	Op	Msg_type	Msg_text
test.t_mi	analyze	status	OK
# 14a. EXPLAIN on v1 should show idx_v1
EXPLAIN SELECT * FROM t_mi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[0.5,0.5,0.5,0.5]')) LIMIT 5;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_mi	NULL	index	NULL	idx_v1	19	NULL	20	100.00	Using vector index (algo=HNSW; ef_search=20; ef_construction=10; limit=5; metric=EUCLIDEAN)
Warnings:
