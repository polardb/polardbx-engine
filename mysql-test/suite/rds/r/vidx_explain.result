# 13. ef_construction value is accurate in EXPLAIN Extra
CREATE TABLE t4 (
id INT AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi_ec(v) EF_CONSTRUCTION=50
) ENGINE=InnoDB;
ANALYZE TABLE t4;
Table	Op	Msg_type	Msg_text
test.t4	analyze	status	OK
EXPLAIN SELECT * FROM t4 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 5;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
