CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
# 1. Setup: table with EUCLIDEAN vector index
CREATE TABLE t1 (
id INT AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v) m=16 distance=euclidean
) ENGINE=InnoDB;
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
# 2. EXPLAIN shows ef_search, limit, metric
EXPLAIN SELECT * FROM t1 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 5;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	vi	23	NULL	100	100.00	Using vector index (algo=HNSW; ef_search=20; ef_construction=10; limit=5; metric=EUCLIDEAN)
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`v` AS `v` from `test`.`t1` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t1`.`v`,VEC_FromText('[0.5,0.5,0.5,0.5,0.5]')) limit 5
# 3. Different LIMIT values
EXPLAIN SELECT * FROM t1 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 10;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	vi	23	NULL	100	100.00	Using vector index (algo=HNSW; ef_search=20; ef_construction=10; limit=10; metric=EUCLIDEAN)
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`v` AS `v` from `test`.`t1` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t1`.`v`,VEC_FromText('[0.5,0.5,0.5,0.5,0.5]')) limit 10
# 4. Change ef_search and verify it reflects in EXPLAIN
SET vidx_hnsw_ef_search = 50;
EXPLAIN SELECT * FROM t1 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 5;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	vi	23	NULL	100	100.00	Using vector index (algo=HNSW; ef_search=50; ef_construction=10; limit=5; metric=EUCLIDEAN)
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`v` AS `v` from `test`.`t1` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t1`.`v`,VEC_FromText('[0.5,0.5,0.5,0.5,0.5]')) limit 5
SET vidx_hnsw_ef_search = 200;
EXPLAIN SELECT * FROM t1 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 5;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	vi	23	NULL	100	100.00	Using vector index (algo=HNSW; ef_search=200; ef_construction=10; limit=5; metric=EUCLIDEAN)
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`v` AS `v` from `test`.`t1` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t1`.`v`,VEC_FromText('[0.5,0.5,0.5,0.5,0.5]')) limit 5
SET vidx_hnsw_ef_search = 20;
# 5. EXPLAIN FORMAT=JSON shows vector_index info
EXPLAIN FORMAT=JSON SELECT * FROM t1 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 5;
EXPLAIN
{
  "query_block": {
