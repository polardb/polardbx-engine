        "cost_info": {
          "read_cost": "0.25",
          "eval_cost": "10.00",
          "prefix_cost": "10.25",
          "data_read_per_join": "X"
        },
        "used_columns": [
          "id",
          "v"
        ]
      }
    }
  }
}
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`v` AS `v` from `test`.`t1` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t1`.`v`,VEC_FromText('[0.5,0.5,0.5,0.5,0.5]')) limit 5
# 6. EXPLAIN ANALYZE shows nodes_visited
EXPLAIN ANALYZE SELECT * FROM t1 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 5;
EXPLAIN
-> Limit: 5 row(s)  (cost=N rows=N) (actual time=N..N rows=N loops=N)
    -> Index scan on t1 using vi  (cost=N rows=N) (actual time=N..N rows=N loops=N) (vector: algo=HNSW, nodes_visited=N)

# 7. When vector index is NOT used (limit too large), no vector info in Extra
EXPLAIN SELECT * FROM t1 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 100;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	X	100.00	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`v` AS `v` from `test`.`t1` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t1`.`v`,VEC_FromText('[0.5,0.5,0.5,0.5,0.5]')) limit 100
# 8. COSINE metric
CREATE TABLE t2 (
id INT AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi_cos(v) distance=cosine
) ENGINE=InnoDB;
ANALYZE TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	OK
EXPLAIN SELECT * FROM t2 ORDER BY VEC_DISTANCE_COSINE(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 5;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	index	NULL	vi_cos	23	NULL	100	100.00	Using vector index (algo=HNSW; ef_search=20; ef_construction=10; limit=5; metric=COSINE)
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`id` AS `id`,`test`.`t2`.`v` AS `v` from `test`.`t2` order by VEC_DISTANCE_COSINE(`test`.`t2`.`v`,VEC_FromText('[0.5,0.5,0.5,0.5,0.5]')) limit 5
# 9. nodes_visited accuracy: value is non-zero and continuation
#    re-searches are accumulated (full-traversal semantics)
nodes_visited accuracy OK
# 10. Extra coexists with "Using where" when a runtime filter is present
#     and still carries accurate vector params (id + 0 > 5 blocks PK range,
#     so the optimizer keeps the vector index scan plus a Using where filter)
EXPLAIN SELECT * FROM t1 WHERE id + 0 > 5 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 5;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	vi	23	NULL	X	X	Using where; Using vector index (algo=HNSW; ef_search=20; ef_construction=10; limit=5; metric=EUCLIDEAN)
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`v` AS `v` from `test`.`t1` where ((`test`.`t1`.`id` + 0) > 5) order by VEC_DISTANCE_EUCLIDEAN(`test`.`t1`.`v`,VEC_FromText('[0.5,0.5,0.5,0.5,0.5]')) limit 5
