SET vidx_hnsw_ef_search = 50;
EXPLAIN FORMAT=JSON SELECT * FROM t2 ORDER BY VEC_DISTANCE_COSINE(v, VEC_FROMTEXT('[0.5,0.5,0.5,0.5,0.5]')) LIMIT 7;
