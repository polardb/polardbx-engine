CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
DROP TABLE IF EXISTS t1;
#
# 1. Setup: Create table with VECTOR INDEX and insert data
#
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(4),
extra INT DEFAULT 0,
VECTOR INDEX vi(v) m=12 distance=euclidean
) ENGINE=InnoDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Insert deterministic data for later verification
INSERT INTO t1(id, v, extra) VALUES (1, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'), 10);
INSERT INTO t1(id, v, extra) VALUES (2, VEC_FROMTEXT('[0.0, 1.0, 0.0, 0.0]'), 20);
INSERT INTO t1(id, v, extra) VALUES (3, VEC_FROMTEXT('[0.0, 0.0, 1.0, 0.0]'), 30);
INSERT INTO t1(id, v, extra) VALUES (4, VEC_FROMTEXT('[0.0, 0.0, 0.0, 1.0]'), 40);
INSERT INTO t1(id, v, extra) VALUES (5, VEC_FROMTEXT('[1.0, 1.0, 0.0, 0.0]'), 50);
INSERT INTO t1(id, v, extra) VALUES (6, VEC_FROMTEXT('[0.0, 1.0, 1.0, 0.0]'), 60);
INSERT INTO t1(id, v, extra) VALUES (7, VEC_FROMTEXT('[0.0, 0.0, 1.0, 1.0]'), 70);
INSERT INTO t1(id, v, extra) VALUES (8, VEC_FROMTEXT('[1.0, 0.0, 0.0, 1.0]'), 80);
SELECT COUNT(*) AS row_count FROM t1;
row_count
8
# Verify auxiliary tables exist
SELECT COUNT(*) > 0 AS has_vidx_tables FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';
has_vidx_tables
1
# Baseline ANN search: nearest to [1,0,0,0] should be id=1
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
#
# ==========================================================
# 2. OPTIMIZE TABLE with data + search verification
# ==========================================================
# OPTIMIZE TABLE in InnoDB maps to ALTER TABLE ENGINE=InnoDB (table rebuild).
# Risk: auxiliary table data must be rebuilt consistently.
#
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
# 2.1 Verify structure preserved
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=9 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# 2.2 Verify data count preserved
SELECT COUNT(*) AS row_count FROM t1;
row_count
8
# 2.3 Verify auxiliary tables still exist
SELECT COUNT(*) > 0 AS has_vidx_tables FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';
has_vidx_tables
1
# 2.4 Verify VECTOR INDEX metadata in information_schema
SELECT INDEX_NAME, INDEX_TYPE FROM information_schema.STATISTICS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' AND INDEX_NAME = 'vi';
INDEX_NAME	INDEX_TYPE
# 2.5 Verify ANN search still works correctly after OPTIMIZE
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
# 2.6 Verify EXPLAIN still uses vector index scan
EXPLAIN SELECT * FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	8	100.00	Using filesort
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`v` AS `v`,`test`.`t1`.`extra` AS `extra` from `test`.`t1` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t1`.`v`,VEC_FromText('[1.0, 0.0, 0.0, 0.0]')) limit 3
#
# 2.7 OPTIMIZE TABLE after DML (insert + delete + update cycle)
#
DELETE FROM t1 WHERE id IN (3, 5);
UPDATE t1 SET v = VEC_FROMTEXT('[0.5, 0.5, 0.5, 0.5]') WHERE id = 7;
INSERT INTO t1(id, v, extra) VALUES (9, VEC_FROMTEXT('[0.9, 0.1, 0.0, 0.0]'), 90);
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
SELECT COUNT(*) AS row_count FROM t1;
row_count
7
# ANN search after OPTIMIZE post-DML
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
#
# 2.8 Multiple consecutive OPTIMIZE TABLE (stability)
#
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=10 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT COUNT(*) AS row_count FROM t1;
row_count
7
#
# ==========================================================
# 3. REPAIR TABLE
# ==========================================================
# InnoDB does not support REPAIR (returns "note: The storage engine
# for the table doesn't support repair"). Must verify:
# - No error/crash
# - Auxiliary tables unaffected
# - Data intact
#
REPAIR TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	repair	note	The storage engine for the table doesn't support repair
# 3.1 Verify structure preserved
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=10 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# 3.2 Verify data preserved
SELECT COUNT(*) AS row_count FROM t1;
row_count
7
# 3.3 Verify auxiliary tables unaffected
SELECT COUNT(*) > 0 AS has_vidx_tables FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';
has_vidx_tables
1
# 3.4 Verify ANN search still works
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
#
# ==========================================================
# 4. CHECK TABLE
# ==========================================================
# CHECK TABLE validates InnoDB's internal indexes. Must verify:
# - No crash when table has vector index
# - Auxiliary tables not corrupted/misreported
# - Data accessible after CHECK
#
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# 4.1 Verify structure preserved
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=10 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# 4.2 Verify data preserved
SELECT COUNT(*) AS row_count FROM t1;
row_count
7
# 4.3 Verify ANN search still works
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
# 4.4 CHECK TABLE with EXTENDED option
CHECK TABLE t1 EXTENDED;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# 4.5 CHECK TABLE with FOR UPGRADE option
CHECK TABLE t1 FOR UPGRADE;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
#
# ==========================================================
# 5. ANALYZE TABLE
# ==========================================================
# ANALYZE TABLE recalculates index statistics. Must verify:
# - Statistics updated without affecting auxiliary tables
# - Vector index still functional
#
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
# 5.1 Verify structure preserved
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=10 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# 5.2 Verify data preserved
SELECT COUNT(*) AS row_count FROM t1;
row_count
7
# 5.3 Verify auxiliary tables unaffected
SELECT COUNT(*) > 0 AS has_vidx_tables FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';
has_vidx_tables
1
# 5.4 Verify ANN search still works
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
# 5.5 Verify EXPLAIN after ANALYZE (optimizer should pick vector index)
EXPLAIN SELECT * FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
