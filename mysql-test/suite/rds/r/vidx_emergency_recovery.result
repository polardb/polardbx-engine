CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
CALL mtr.add_suppression("\\[ERROR\\].*");
CALL mtr.add_suppression("\\[Warning\\].*");
SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;
SET transaction_isolation = 'READ-COMMITTED';
DROP TABLE IF EXISTS t1;
#
# Setup: Create table with VECTOR INDEX and insert data
#
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v  VECTOR(4),
label VARCHAR(20),
VECTOR INDEX vi (v) M=6 DISTANCE=EUCLIDEAN
) ENGINE=InnoDB;
INSERT INTO t1(id, v, label) VALUES
(1,  VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'), 'A'),
(2,  VEC_FROMTEXT('[0.0, 1.0, 0.0, 0.0]'), 'B'),
(3,  VEC_FROMTEXT('[0.0, 0.0, 1.0, 0.0]'), 'C'),
(4,  VEC_FROMTEXT('[0.0, 0.0, 0.0, 1.0]'), 'D'),
(5,  VEC_FROMTEXT('[1.0, 1.0, 0.0, 0.0]'), 'E'),
(6,  VEC_FROMTEXT('[0.0, 1.0, 1.0, 0.0]'), 'F'),
(7,  VEC_FROMTEXT('[0.0, 0.0, 1.0, 1.0]'), 'G'),
(8,  VEC_FROMTEXT('[1.0, 0.0, 0.0, 1.0]'), 'H');
SELECT COUNT(*) AS base_row_count FROM t1;
base_row_count
8
# Cache TABLE_ID for dynamic auxiliary table name
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
# Verify auxiliary table exists
SELECT COUNT(*) > 0 AS aux_exists
FROM information_schema.INNODB_TABLES
WHERE NAME LIKE CONCAT(DATABASE(), '/vidx_%');
aux_exists
1
# Verify aux table row count matches primary table
SET @s = CONCAT('SELECT COUNT(*) AS aux_initial_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE stmt FROM @s;
EXECUTE stmt;
aux_initial_rows
8
DEALLOCATE PREPARE stmt;
# Baseline ANN search: nearest to [1,0,0,0] -> id=1
SELECT id, label,
VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
id	label	dist
1	A	0
5	E	1
8	H	1
#
# ================================================================
# Scenario 1: DELETE ALL rows from auxiliary table (simulates TRUNCATE)
# ================================================================
# All HNSW graph rows removed; primary table data intact.
# ANN search: no entry point -> 0 rows or graceful error.
# INSERT: may succeed (first node rebuild) or fail.
# Recovery: OPTIMIZE TABLE on primary table.
#
SET @s = CONCAT('DELETE FROM `vidx_', @t1_tid, '_0`');
PREPARE stmt FROM @s;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
FLUSH TABLES t1;
# 1.1 Primary table: readable (full scan, no vector index needed)
# Verify aux table is now empty
SET @s = CONCAT('SELECT COUNT(*) AS aux_after_delete FROM `vidx_', @t1_tid, '_0`');
PREPARE stmt FROM @s;
EXECUTE stmt;
aux_after_delete
0
DEALLOCATE PREPARE stmt;
SELECT COUNT(*) AS primary_rows FROM t1;
primary_rows
8
SELECT id, label FROM t1 ORDER BY id LIMIT 4;
id	label
1	A
2	B
3	C
4	D
