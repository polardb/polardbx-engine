#
# ================================================================
# Scenario 6: Multiple consecutive OPTIMIZE (idempotent rebuild)
# ================================================================
# Delete all aux rows, OPTIMIZE, DML, OPTIMIZE again, OPTIMIZE again.
# Verifies that repeated OPTIMIZE is stable.
#
SET @s = CONCAT('DELETE FROM `vidx_', @t1_tid, '_0`');
PREPARE stmt FROM @s;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
FLUSH TABLES t1;
# First OPTIMIZE
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
SELECT COUNT(*) > 0 AS aux_after_opt1
FROM information_schema.INNODB_TABLES WHERE NAME LIKE CONCAT(DATABASE(), '/vidx_%');
aux_after_opt1
1
# DML after first rebuild
INSERT INTO t1(id, v, label) VALUES (12, VEC_FROMTEXT('[0.3, 0.7, 0.0, 0.0]'), 'I4');
# Use non-deterministic cleanup: delete any rows with id >= 11 that may exist
DELETE FROM t1 WHERE id >= 11 AND id != 12;
UPDATE t1 SET v = VEC_FROMTEXT('[0.97, 0.03, 0.0, 0.0]') WHERE id = 1;
# Second OPTIMIZE: idempotent
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
SELECT COUNT(*) AS rows_after_opt2 FROM t1;
