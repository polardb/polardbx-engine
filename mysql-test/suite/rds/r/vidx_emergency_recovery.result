# Recovery: OPTIMIZE TABLE.
#
SET @s = CONCAT('UPDATE `vidx_', @t1_tid, '_0` SET tref = NULL');
PREPARE stmt FROM @s;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
FLUSH TABLES t1;
# 4.1 Primary table intact
