#
# ================================================================
# Scenario 8: Non-vector DML transactional integrity after corruption
# ================================================================
# After corruption (DELETE ALL + OPTIMIZE restored), verify that:
# 1. Non-vector DML in a transaction is atomic (ROLLBACK works).
# 2. ANN search is NOT affected by rolled-back non-vector DML.
# 3. Further corruption + OPTIMIZE inside transaction round-trip.
#
# Step 1: Normal transactional DML with rollback
BEGIN;
INSERT INTO t1(id, v, label) VALUES (30, VEC_FROMTEXT('[0.1, 0.1, 0.1, 0.1]'), 'TX_INSERT');
UPDATE t1 SET label = 'TX_MOD' WHERE id = 2;
SELECT COUNT(*) AS tx_rows FROM t1;
tx_rows
11
ROLLBACK;
# After rollback: primary table must be back to pre-tx state
SELECT COUNT(*) AS after_rollback_rows FROM t1;
after_rollback_rows
10
SELECT id, label FROM t1 WHERE id = 2;
id	label
2	B
# ANN search unaffected by rollback (aux table consistent)
SELECT id, label,
VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
id	label	dist
1	A_mod	0.04242638616655812
13	I5	0.7615773043252123
12	I4	0.9899494768024272
# Step 2: Corrupt aux outside tx, then run OPTIMIZE to restore,
# then verify that transactions with DML still work correctly.
FLUSH TABLES t1;
SET @s = CONCAT('DELETE FROM `vidx_', @t1_tid, '_0`');
PREPARE stmt FROM @s;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
FLUSH TABLES t1;
# OPTIMIZE first to restore consistent state
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
SELECT COUNT(*) > 0 AS aux_restored
FROM information_schema.INNODB_TABLES
WHERE NAME LIKE CONCAT(DATABASE(), '/vidx_%');
aux_restored
1
# Now verify normal transactional DML works after restore
BEGIN;
UPDATE t1 SET label = 'safe' WHERE id = 3;
COMMIT;
SELECT id, label FROM t1 WHERE id = 3;
id	label
3	safe
# ANN search still correct after transactional DML
SELECT id, label,
VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 3;
id	label	dist
1	A_mod	0.04242638616655812
13	I5	0.7615773043252123
12	I4	0.9899494768024272
#
# ================================================================
# Scenario 9: OPTIMIZE/ANALYZE/REPAIR on aux table is rejected
# ================================================================
# The aux table is exposed by show_vidx_hlindex_tables=ON for direct
# SELECT/CHECK only. Routing it through ALTER-recreate (OPTIMIZE/
# ANALYZE/REPAIR) rotates its se_private_id but leaves the aux name
# tied to the base table's old TABLE_ID; the next base-table OPTIMIZE
# then crashes at vidx_index.cc:249. Reject at statement entry so
# mysqlcheck --all-databases / DBA scripts cannot trigger it.
#
# Coverage:
#   - aux OPTIMIZE / ANALYZE / REPAIR -> ER_NOT_ALLOWED_COMMAND
#   - aux direct ALTER TABLE -> ER_NOT_ALLOWED_COMMAND
#   - aux CHECK still works (read-only, no TABLE_ID rotation)
#   - mixed list (base + aux, either order) rejects the whole stmt
#     and the base table's TABLE_ID stays unchanged
#   - subsequent OPTIMIZE on the base table still succeeds
#
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
SELECT NAME INTO @aux_full
FROM information_schema.INNODB_TABLES WHERE NAME LIKE 'test/vidx_%' LIMIT 1;
# --- 9.1 OPTIMIZE aux -> ER_NOT_ALLOWED_COMMAND ---
OPTIMIZE TABLE test.`vidx_XXXXX_X`;
ERROR 42000: The used command is not allowed with this MySQL version
# --- 9.2 ANALYZE aux -> ER_NOT_ALLOWED_COMMAND ---
ANALYZE TABLE test.`vidx_XXXXX_X`;
ERROR 42000: The used command is not allowed with this MySQL version
# --- 9.3 REPAIR aux -> ER_NOT_ALLOWED_COMMAND ---
REPAIR TABLE test.`vidx_XXXXX_X`;
ERROR 42000: The used command is not allowed with this MySQL version
# --- 9.4 CHECK aux still works (read-only) ---
CHECK TABLE test.`vidx_XXXXX_X`;
Table	Op	Msg_type	Msg_text
test.vidx_XXXXX_X	check	status	OK
# --- 9.5 Mixed list with aux FIRST: whole stmt rejected, base UNCHANGED ---
SELECT TABLE_ID INTO @before FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
OPTIMIZE TABLE test.`vidx_XXXXX_X`, test.t1;
ERROR 42000: The used command is not allowed with this MySQL version
ANALYZE TABLE test.`vidx_XXXXX_X`, test.t1;
ERROR 42000: The used command is not allowed with this MySQL version
SELECT @before = TABLE_ID AS base_tid_unchanged
FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
base_tid_unchanged
1
# --- 9.6 Known limitation: with the aux LAST ("OPTIMIZE base, aux") the
#     per-table admin loop optimizes the base before it reaches the aux,
#     so only the trailing aux entry is rejected (no crash; data stays
#     consistent because the base OPTIMIZE rebuilds the aux).  It is not
#     executed here because rebuilding the aux changes its TABLE_ID and
#     would invalidate the aux name for the checks below.  List the aux
#     FIRST (see 9.5) for whole-statement rejection with the base
#     untouched.
# --- 9.7 Direct ALTER TABLE on aux -> ER_NOT_ALLOWED_COMMAND ---
#     (ALTER ... ENGINE=InnoDB also routes through mysql_alter_table
#      and would rotate the aux TABLE_ID; reject it the same way)
SELECT TABLE_ID INTO @before FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
ALTER TABLE test.`vidx_XXXXX_X` ENGINE=InnoDB;
ERROR 42000: The used command is not allowed with this MySQL version
ALTER TABLE test.`vidx_XXXXX_X` ADD COLUMN dummy INT;
ERROR 42000: The used command is not allowed with this MySQL version
SELECT @before = TABLE_ID AS base_tid_unchanged_after_aux_alter
FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
base_tid_unchanged_after_aux_alter
1
# --- 9.8 Base-table OPTIMIZE still succeeds after the rejected aux ops ---
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
SELECT COUNT(*) > 0 AS aux_after_base_opt
FROM information_schema.INNODB_TABLES WHERE NAME LIKE CONCAT(DATABASE(), '/vidx_%');
aux_after_base_opt
1
#
# ================================================================
# Final summary verification
# ================================================================
#
SELECT COUNT(*) AS final_primary_rows FROM t1;
final_primary_rows
10
SELECT COUNT(*) > 0 AS final_aux_exists
FROM information_schema.INNODB_TABLES
WHERE NAME LIKE CONCAT(DATABASE(), '/vidx_%');
final_aux_exists
1
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `label` varchar(20) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=31 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SET @s = CONCAT('SELECT COUNT(*) AS final_aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE stmt FROM @s;
EXECUTE stmt;
final_aux_rows
10
DEALLOCATE PREPARE stmt;
# Full ANN result from origin
SELECT id, label,
VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[0.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY dist
LIMIT 5;
id	label	dist
12	I4	0.7615773043252123
1	A_mod	0.9704638352167549
13	I5	0.9899494768024272
2	B	1
3	safe	1
#
# Cleanup
#
DROP TABLE t1;
SELECT COUNT(*) AS cleanup_aux_count
FROM information_schema.INNODB_TABLES
WHERE NAME LIKE CONCAT(DATABASE(), '/vidx_%');
cleanup_aux_count
0
SET GLOBAL show_vidx_hlindex_tables = OFF;
SET GLOBAL vidx_disabled = ON;
