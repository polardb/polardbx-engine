#
# ================================================================
# Scenario 3: DELETE PARTIAL rows from auxiliary table
# ================================================================
# Removing a subset of HNSW nodes creates disconnected graph.
# ANN search: degraded accuracy, must not crash.
# Recovery: OPTIMIZE TABLE.
#
# Delete only layer=0 rows (leaf nodes, not entry point).
# Entry point is the node with the highest layer.
SET @s = CONCAT('DELETE FROM `vidx_', @t1_tid, '_0` WHERE layer = 0 LIMIT 4');
PREPARE stmt FROM @s;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
FLUSH TABLES t1;
# 3.1 Primary table intact
SELECT COUNT(*) AS primary_rows FROM t1;
primary_rows
8
