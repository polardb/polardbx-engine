##############################################
# 16. SAVEPOINT + ROLLBACK TO SAVEPOINT      #
#     Primary path: aux committed indep;     #
#     main-table partial rollback tolerated  #
##############################################
[connection master]
BEGIN;
INSERT INTO t1(a, v) VALUES (100, VEC_FROMTEXT("[100,100,100,100,100]"));
SAVEPOINT sp1;
INSERT INTO t1(a, v) VALUES (101, VEC_FROMTEXT("[101,101,101,101,101]"));
# Row a=101 visible inside trx before rollback-to-savepoint
SELECT COUNT(*) FROM t1 WHERE a = 101;
COUNT(*)
1
ROLLBACK TO SAVEPOINT sp1;
# Row a=101 rolled back in main table
SELECT COUNT(*) FROM t1 WHERE a = 101;
COUNT(*)
0
INSERT INTO t1(a, v) VALUES (102, VEC_FROMTEXT("[102,102,102,102,102]"));
COMMIT;
include/rpl_sync.inc
# Master: a=100 and a=102 visible, a=101 gone
[connection master]
SELECT COUNT(*) AS visible FROM t1 WHERE a IN (100, 102);
visible
2
SELECT COUNT(*) AS gone FROM t1 WHERE a = 101;
gone
0
SELECT a FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v,
VEC_FROMTEXT("[100,100,100,100,100]")) LIMIT 3;
a
100
102
3
# Slave: same as master
[connection slave]
SELECT COUNT(*) AS visible FROM t1 WHERE a IN (100, 102);
visible
2
SELECT COUNT(*) AS gone FROM t1 WHERE a = 101;
gone
0

##############################################
# 17. Nested SAVEPOINT: multi-level partial  #
#     rollback; multiple aux orphan rows     #
#     tolerated by ANN search               #
##############################################
[connection master]
BEGIN;
INSERT INTO t1(a, v) VALUES (200, VEC_FROMTEXT("[200,200,200,200,200]"));
SAVEPOINT sp_outer;
INSERT INTO t1(a, v) VALUES (201, VEC_FROMTEXT("[201,201,201,201,201]"));
SAVEPOINT sp_inner;
INSERT INTO t1(a, v) VALUES (202, VEC_FROMTEXT("[202,202,202,202,202]"));
ROLLBACK TO SAVEPOINT sp_inner;
INSERT INTO t1(a, v) VALUES (203, VEC_FROMTEXT("[203,203,203,203,203]"));
ROLLBACK TO SAVEPOINT sp_outer;
INSERT INTO t1(a, v) VALUES (204, VEC_FROMTEXT("[204,204,204,204,204]"));
COMMIT;
include/rpl_sync.inc
# Master: only a=200 and a=204 survive
[connection master]
SELECT a FROM t1 WHERE a BETWEEN 200 AND 204 ORDER BY a;
a
200
204
# ANN search works despite multiple orphan aux rows
SELECT a FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v,
VEC_FROMTEXT("[202,202,202,202,202]")) LIMIT 3;
a
102
200
204
# Slave: same
[connection slave]
SELECT a FROM t1 WHERE a BETWEEN 200 AND 204 ORDER BY a;
a
200
204

##############################################
# 18. Two vector-index tables in same trx   #
#     (tests unlock_hlindex_handlers_bound  #
#      to for multiple tables in one hook   #
#      invocation)                          #
##############################################
[connection master]
CREATE TABLE t2 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
a INT NOT NULL DEFAULT 0,
v VECTOR(3),
VECTOR INDEX vi2(v)
) ENGINE = InnoDB;
BEGIN;
INSERT INTO t1(a, v) VALUES (300, VEC_FROMTEXT("[30,30,30,30,30]"));
INSERT INTO t2(a, v) VALUES (300, VEC_FROMTEXT("[30,30,30]"));
INSERT INTO t1(a, v) VALUES (301, VEC_FROMTEXT("[31,31,31,31,31]"));
INSERT INTO t2(a, v) VALUES (301, VEC_FROMTEXT("[31,31,31]"));
COMMIT;
include/rpl_sync.inc
# Master: t1 has 2 new rows; t2 has 2 rows
[connection master]
SELECT COUNT(*) AS t1_new FROM t1 WHERE a IN (300, 301);
t1_new
2
SELECT COUNT(*) AS t2_rows FROM t2;
t2_rows
2
# Slave: same
[connection slave]
SELECT COUNT(*) AS t1_new FROM t1 WHERE a IN (300, 301);
t1_new
2
SELECT COUNT(*) AS t2_rows FROM t2;
t2_rows
2

##############################################
# 19. REPLACE INTO in explicit transaction  #
#     REPLACE = DELETE + INSERT; both aux   #
#     DMLs go through hlindex_indep_dml     #
##############################################
[connection master]
BEGIN;
INSERT INTO t1(id, a, v) VALUES (9000, 400, VEC_FROMTEXT("[40,40,40,40,40]"));
COMMIT;
BEGIN;
REPLACE INTO t1(id, a, v) VALUES (9000, 401, VEC_FROMTEXT("[41,41,41,41,41]"));
COMMIT;
include/rpl_sync.inc
# Master: id=9000 updated by REPLACE (a=401)
[connection master]
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE id = 9000;
id	a	VEC_TOTEXT(v)
9000	401	[41,41,41,41,41]
# Slave: same
[connection slave]
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE id = 9000;
id	a	VEC_TOTEXT(v)
9000	401	[41,41,41,41,41]

##############################################
# 20. INSERT ... ON DUPLICATE KEY UPDATE    #
#     in explicit transaction               #
##############################################
[connection master]
BEGIN;
INSERT INTO t1(id, a, v) VALUES (9000, 500, VEC_FROMTEXT("[50,50,50,50,50]"))
ON DUPLICATE KEY UPDATE a = 500, v = VEC_FROMTEXT("[50,50,50,50,50]");
COMMIT;
include/rpl_sync.inc
# Master: id=9000 updated by ON DUPLICATE KEY UPDATE (a=500)
[connection master]
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE id = 9000;
id	a	VEC_TOTEXT(v)
9000	500	[50,50,50,50,50]
# Slave: same
[connection slave]
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE id = 9000;
id	a	VEC_TOTEXT(v)
9000	500	[50,50,50,50,50]

##############################################
# 21. Long transaction: Attachable_trx_rw used       #
#     across 10 DML statements in one trx   #
##############################################
[connection master]
BEGIN;
INSERT INTO t1(a, v) VALUES (600, VEC_FROMTEXT("[60,60,60,60,60]"));
INSERT INTO t1(a, v) VALUES (601, VEC_FROMTEXT("[61,61,61,61,61]"));
INSERT INTO t1(a, v) VALUES (602, VEC_FROMTEXT("[62,62,62,62,62]"));
INSERT INTO t1(a, v) VALUES (603, VEC_FROMTEXT("[63,63,63,63,63]"));
INSERT INTO t1(a, v) VALUES (604, VEC_FROMTEXT("[64,64,64,64,64]"));
UPDATE t1 SET v = VEC_FROMTEXT("[69,69,69,69,69]") WHERE a = 600;
UPDATE t1 SET v = VEC_FROMTEXT("[68,68,68,68,68]") WHERE a = 601;
DELETE FROM t1 WHERE a = 602;
INSERT INTO t1(a, v) VALUES (605, VEC_FROMTEXT("[65,65,65,65,65]"));
UPDATE t1 SET v = VEC_FROMTEXT("[67,67,67,67,67]") WHERE a = 603;
COMMIT;
include/rpl_sync.inc
# Master: a=600,601,603,604,605 visible; a=602 gone
[connection master]
SELECT a, VEC_TOTEXT(v) FROM t1 WHERE a BETWEEN 600 AND 605 ORDER BY a;
a	VEC_TOTEXT(v)
600	[69,69,69,69,69]
601	[68,68,68,68,68]
603	[67,67,67,67,67]
604	[64,64,64,64,64]
605	[65,65,65,65,65]
# Slave: same
[connection slave]
SELECT a, VEC_TOTEXT(v) FROM t1 WHERE a BETWEEN 600 AND 605 ORDER BY a;
a	VEC_TOTEXT(v)
600	[69,69,69,69,69]
601	[68,68,68,68,68]
603	[67,67,67,67,67]
604	[64,64,64,64,64]
605	[65,65,65,65,65]

[connection master]
DROP TABLE t2;
include/rpl_sync.inc

##############################################
# 23. DROP TABLE (cleanup path)              #
##############################################
[connection master]
DROP TABLE t1;
include/rpl_sync.inc
# Verify on slave: table should not exist
