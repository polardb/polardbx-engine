2	2	[55,55,55,55,55]
# Verify on slave
[connection slave]
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE a = 2;
id	a	VEC_TOTEXT(v)
2	2	[55,55,55,55,55]

##############################################
# 8. XA DELETE + COMMIT                      #
##############################################
[connection master]
XA START 'xa_del_1';
DELETE FROM t1 WHERE a = 3;
XA END 'xa_del_1';
XA PREPARE 'xa_del_1';
XA COMMIT 'xa_del_1';
include/rpl_sync.inc
# Verify on master
[connection master]
SELECT COUNT(*) FROM t1 WHERE a = 3;
COUNT(*)
0
# Verify on slave
[connection slave]
SELECT COUNT(*) FROM t1 WHERE a = 3;
COUNT(*)
0

##############################################
# 9. XA ROLLBACK after PREPARE               #
#    (base-table rolls back, independent     #
#     aux DML already committed)             #
##############################################
[connection master]
XA START 'xa_rb_1';
INSERT INTO t1(a, v) VALUES (88, VEC_FROMTEXT("[88,88,88,88,88]"));
XA END 'xa_rb_1';
XA PREPARE 'xa_rb_1';
XA ROLLBACK 'xa_rb_1';
include/rpl_sync.inc
# Verify on master: rolled-back row should NOT exist
[connection master]
SELECT COUNT(*) FROM t1 WHERE a = 88;
COUNT(*)
0
# Verify on slave
[connection slave]
SELECT COUNT(*) FROM t1 WHERE a = 88;
COUNT(*)
0

