##############################################
[connection master]
XA START 'xa_upd_1';
UPDATE t1 SET v = VEC_FROMTEXT("[55,55,55,55,55]") WHERE a = 2;
XA END 'xa_upd_1';
XA PREPARE 'xa_upd_1';
XA COMMIT 'xa_upd_1';
include/rpl_sync.inc
