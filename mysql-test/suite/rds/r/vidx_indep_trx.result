CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the master info repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START SLAVE; see the 'START SLAVE Syntax' in the MySQL Manual for more information.
[connection master]
[connection slave]
SET GLOBAL vidx_disabled = OFF;
[connection master]
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

##############################################
# 1. Prepare: create table with vector index #
##############################################
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
a INT NOT NULL DEFAULT 0,
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;

# Insert seed data for HNSW graph
INSERT INTO t1(a, v) VALUES (1, VEC_FROMTEXT("[1,2,3,4,10]"));
INSERT INTO t1(a, v) VALUES (2, VEC_FROMTEXT("[1,2,3,4,9]"));
INSERT INTO t1(a, v) VALUES (3, VEC_FROMTEXT("[1,2,3,4,8]"));
INSERT INTO t1(a, v) VALUES (4, VEC_FROMTEXT("[1,2,3,4,7]"));
INSERT INTO t1(a, v) VALUES (5, VEC_FROMTEXT("[1,2,3,4,6]"));
include/rpl_sync.inc

##############################################
# 2. Explicit BEGIN + COMMIT with vector DML #
##############################################
[connection master]
BEGIN;
INSERT INTO t1(a, v) VALUES (10, VEC_FROMTEXT("[10,10,10,10,10]"));
INSERT INTO t1(a, v) VALUES (11, VEC_FROMTEXT("[11,11,11,11,11]"));
UPDATE t1 SET v = VEC_FROMTEXT("[50,50,50,50,50]") WHERE id = 1;
COMMIT;
include/rpl_sync.inc
# Verify on master
[connection master]
SELECT id, a, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	a	VEC_TOTEXT(v)
1	1	[50,50,50,50,50]
2	2	[1,2,3,4,9]
3	3	[1,2,3,4,8]
4	4	[1,2,3,4,7]
5	5	[1,2,3,4,6]
6	10	[10,10,10,10,10]
7	11	[11,11,11,11,11]
# Verify on slave
[connection slave]
SET transaction_isolation = 'READ-COMMITTED';
SELECT id, a, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	a	VEC_TOTEXT(v)
1	1	[50,50,50,50,50]
2	2	[1,2,3,4,9]
3	3	[1,2,3,4,8]
4	4	[1,2,3,4,7]
5	5	[1,2,3,4,6]
6	10	[10,10,10,10,10]
7	11	[11,11,11,11,11]

##############################################
# 3. Explicit BEGIN + ROLLBACK               #
#    Main-table row gone; orphan in aux      #
#    table proves independent commit.        #
#    ANN search tolerates orphan.            #
##############################################
[connection master]
SELECT COUNT(*) AS cnt_before FROM t1;
cnt_before
7
BEGIN;
INSERT INTO t1(a, v) VALUES (99, VEC_FROMTEXT("[99,99,99,99,99]"));
# Row visible inside own transaction
SELECT COUNT(*) FROM t1 WHERE a = 99;
COUNT(*)
1
ROLLBACK;
# After ROLLBACK: main-table row should NOT exist
SELECT COUNT(*) FROM t1 WHERE a = 99;
COUNT(*)
0
# Total count unchanged
SELECT COUNT(*) AS cnt_after FROM t1;
cnt_after
7
# ANN search must work without crash (aux orphan tolerated)
SELECT id FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[5,5,5,5,5]")) LIMIT 3;
id
3
4
5
include/rpl_sync.inc
# Verify on slave: no orphan row visible
[connection slave]
SELECT COUNT(*) FROM t1 WHERE a = 99;
COUNT(*)
0

##############################################
# 4. Two-session DML: aux table locks         #
#    released independently (no blocking)     #
#    NOTE: deliberately sequential between    #
#    sessions — proves master2 is NOT blocked #
#    by master's open user trx, not a true    #
#    concurrent deadlock test.  Stress and    #
#    deadlock coverage live in                #
#    vidx_neighbor_save_high_conc.test.       #
##############################################
[connection master]
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
# conn master: BEGIN + INSERT (don't commit yet)
[connection master]
BEGIN;
INSERT INTO t1(a, v) VALUES (20, VEC_FROMTEXT("[20,20,20,20,20]"));
# Main-table transaction still open, but aux DML already committed
# conn master2: INSERT should succeed immediately (aux locks released)
INSERT INTO t1(a, v) VALUES (21, VEC_FROMTEXT("[21,21,21,21,21]"));
# conn master: now COMMIT
[connection master]
COMMIT;
# Verify both rows exist on master
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE a IN (20, 21) ORDER BY a;
id	a	VEC_TOTEXT(v)
9	20	[20,20,20,20,20]
10	21	[21,21,21,21,21]
include/rpl_sync.inc
# Verify on slave
[connection slave]
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE a IN (20, 21) ORDER BY a;
id	a	VEC_TOTEXT(v)
9	20	[20,20,20,20,20]
10	21	[21,21,21,21,21]

##############################################
# 5. Implicit commit (DDL during open trx)   #
##############################################
[connection master]
BEGIN;
INSERT INTO t1(a, v) VALUES (30, VEC_FROMTEXT("[30,30,30,30,30]"));
# DDL triggers implicit commit of the above INSERT
CREATE TABLE t2 (x INT) ENGINE = InnoDB;
# INSERT should be committed, per-row Attachable_trx_rw cleaned up
SELECT COUNT(*) FROM t1 WHERE a = 30;
COUNT(*)
1
DROP TABLE t2;
include/rpl_sync.inc
# Verify on slave
[connection slave]
SELECT COUNT(*) FROM t1 WHERE a = 30;
COUNT(*)
1

##############################################
# 6. XA INSERT + COMMIT (two-phase)          #
##############################################
[connection master]
XA START 'xa_ins_1';
INSERT INTO t1(a, v) VALUES (40, VEC_FROMTEXT("[40,40,40,40,40]"));
INSERT INTO t1(a, v) VALUES (41, VEC_FROMTEXT("[41,41,41,41,41]"));
XA END 'xa_ins_1';
XA PREPARE 'xa_ins_1';
XA COMMIT 'xa_ins_1';
include/rpl_sync.inc
# Verify on master
[connection master]
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE a IN (40, 41) ORDER BY a;
id	a	VEC_TOTEXT(v)
12	40	[40,40,40,40,40]
13	41	[41,41,41,41,41]
# Verify on slave
[connection slave]
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE a IN (40, 41) ORDER BY a;
id	a	VEC_TOTEXT(v)
12	40	[40,40,40,40,40]
13	41	[41,41,41,41,41]

