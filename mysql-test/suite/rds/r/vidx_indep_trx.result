XA PREPARE 'xa_seq_2';
XA COMMIT 'xa_seq_2';
XA START 'xa_seq_3';
DELETE FROM t1 WHERE a = 72;
XA END 'xa_seq_3';
XA PREPARE 'xa_seq_3';
XA COMMIT 'xa_seq_3';
