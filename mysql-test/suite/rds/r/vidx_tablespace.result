CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
CALL mtr.add_suppression("Got error 155 when reading table");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
DROP TABLE IF EXISTS t1, t2;
#
# ==========================================================
# 1. Setup: Create table with VECTOR INDEX and insert data
# ==========================================================
#
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(4),
extra INT DEFAULT 0,
VECTOR INDEX vi(v) m=12 distance=euclidean
) ENGINE=InnoDB;
INSERT INTO t1(id, v, extra) VALUES (1, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'), 10);
INSERT INTO t1(id, v, extra) VALUES (2, VEC_FROMTEXT('[0.0, 1.0, 0.0, 0.0]'), 20);
INSERT INTO t1(id, v, extra) VALUES (3, VEC_FROMTEXT('[0.0, 0.0, 1.0, 0.0]'), 30);
INSERT INTO t1(id, v, extra) VALUES (4, VEC_FROMTEXT('[0.0, 0.0, 0.0, 1.0]'), 40);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT COUNT(*) AS row_count FROM t1;
row_count
4
# Verify auxiliary tables exist
SELECT COUNT(*) > 0 AS has_vidx_tables FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';
has_vidx_tables
1
#
# ==========================================================
# 2. ALTER TABLE DISCARD TABLESPACE with VECTOR INDEX
# ==========================================================
# Risk: DISCARD removes the .ibd file but the code path
# (mysql_discard_or_import_tablespace) has NO vidx-specific
# handling. The auxiliary table (vidx_*) may become orphaned.
#
# BUG FOUND: DISCARD TABLESPACE succeeds on tables with vector
# index but does NOT handle the auxiliary tables, leaving them
# orphaned. The main table enters discarded state while vidx_*
# auxiliary tables remain intact.
#
# DISCARD TABLESPACE should be rejected when table has vector index.
# The fix in mysql_discard_or_import_tablespace() prevents orphaned
# auxiliary tables and the server crash on subsequent DROP TABLE.
#
ALTER TABLE t1 DISCARD TABLESPACE;
ERROR 42000: This version of MySQL doesn't yet support 'DISCARD/IMPORT TABLESPACE on a table with vector index'
# Verify table is still intact after rejected DISCARD
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT COUNT(*) AS row_count FROM t1;
row_count
4
# Verify auxiliary tables still exist
SELECT COUNT(*) > 0 AS has_vidx_tables FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';
has_vidx_tables
1
# ANN search should still work
SELECT id, VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
# IMPORT TABLESPACE should also be rejected
ALTER TABLE t1 IMPORT TABLESPACE;
ERROR 42000: This version of MySQL doesn't yet support 'DISCARD/IMPORT TABLESPACE on a table with vector index'
# Verify table is still intact after rejected IMPORT
SELECT COUNT(*) AS row_count FROM t1;
row_count
4
#
# ==========================================================
# 3. ALTER TABLE FORCE with VECTOR INDEX
# ==========================================================
# ALTER TABLE FORCE triggers a table rebuild (same as OPTIMIZE).
# Risk: Same as OPTIMIZE - auxiliary tables must be rebuilt.
#
# Baseline ANN search
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
ALTER TABLE t1 FORCE;
# 3.1 Verify structure preserved
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# 3.2 Verify data count
SELECT COUNT(*) AS row_count FROM t1;
row_count
4
# 3.3 Verify auxiliary tables
SELECT COUNT(*) > 0 AS has_vidx_tables FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';
has_vidx_tables
1
# 3.4 Verify VECTOR INDEX metadata
SELECT INDEX_NAME, INDEX_TYPE FROM information_schema.STATISTICS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' AND INDEX_NAME = 'vi';
INDEX_NAME	INDEX_TYPE
# 3.5 Verify ANN search after FORCE
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
#
# ==========================================================
# 4. ALTER TABLE ALGORITHM=COPY explicit with VECTOR INDEX
# ==========================================================
# Vector index DDL already forces COPY algorithm internally.
# Explicitly specifying ALGORITHM=COPY should work fine.
#
ALTER TABLE t1 ADD COLUMN c1 INT DEFAULT 0, ALGORITHM=COPY;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  `c1` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Verify ANN search after explicit COPY
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
#
# ==========================================================
# 5. ALTER TABLE ALGORITHM=INPLACE with VECTOR INDEX
# ==========================================================
# Vector index forces COPY. Requesting INPLACE should either:
# - Be rejected with error, or
# - Fall back to COPY silently
#
ALTER TABLE t1 ADD COLUMN c2 INT DEFAULT 0, ALGORITHM=INPLACE;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  `c1` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
#
# ==========================================================
# 6. ALTER TABLE ALGORITHM=INSTANT with VECTOR INDEX
# ==========================================================
# INSTANT should not conflict if the operation itself supports
# INSTANT and does not touch the vector index.
#
ALTER TABLE t1 ADD COLUMN c3 INT DEFAULT 0, ALGORITHM=INSTANT;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  `c1` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
#
# ==========================================================
# 7. ALTER TABLE ROW_FORMAT with VECTOR INDEX
# ==========================================================
# Changing ROW_FORMAT triggers a table rebuild.
# Risk: auxiliary tables must survive the rebuild.
#
ALTER TABLE t1 ROW_FORMAT=COMPRESSED;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  `c1` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=COMPRESSED
# Verify ANN search after ROW_FORMAT change
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
# Change back to DYNAMIC
ALTER TABLE t1 ROW_FORMAT=DYNAMIC;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(4) DEFAULT NULL,
  `extra` int DEFAULT '0',
  `c1` int DEFAULT '0',
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=12 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC
# Verify ANN search
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]')) AS dist
FROM t1
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[1.0, 0.0, 0.0, 0.0]'))
LIMIT 2;
# Verify auxiliary tables
SELECT COUNT(*) > 0 AS has_vidx_tables FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';
has_vidx_tables
1
#
# ==========================================================
# 8. Cleanup
# ==========================================================
#
DROP TABLE t1;
# Verify all auxiliary tables cleaned up
SELECT COUNT(*) AS final_vidx_count FROM information_schema.INNODB_TABLES
WHERE NAME LIKE 'test/vidx_%';
final_vidx_count
0
SET GLOBAL vidx_disabled = ON;
