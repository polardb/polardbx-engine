include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the master info repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START SLAVE; see the 'START SLAVE Syntax' in the MySQL Manual for more information.
[connection master]
CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");

# 1. Setup slave
[connection slave]
SET GLOBAL vidx_disabled = OFF;

# 2. Setup master
[connection master]
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

# 3. Create table with vector index on master
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(100),
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(100) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

# 4. Insert data on master
INSERT INTO t1(name, v) VALUES ('vec1', VEC_FROMTEXT("[1,2,3,4,5]"));
INSERT INTO t1(name, v) VALUES ('vec2', VEC_FROMTEXT("[5,4,3,2,1]"));
INSERT INTO t1(name, v) VALUES ('vec3', VEC_FROMTEXT("[1,1,1,1,1]"));
INSERT INTO t1(name, v) VALUES ('vec4', VEC_FROMTEXT("[2,2,2,2,2]"));
INSERT INTO t1(name, v) VALUES ('vec5', VEC_FROMTEXT("[3,3,3,3,3]"));
# Master data
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
2	vec2	[5,4,3,2,1]
3	vec3	[1,1,1,1,1]
4	vec4	[2,2,2,2,2]
5	vec5	[3,3,3,3,3]
# Master ANN query
SELECT id, name, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
5	vec5	[3,3,3,3,3]
4	vec4	[2,2,2,2,2]

# 5. Sync slave and verify
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
# Verify table structure on slave
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(100) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Verify data consistency on slave
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
2	vec2	[5,4,3,2,1]
3	vec3	[1,1,1,1,1]
4	vec4	[2,2,2,2,2]
5	vec5	[3,3,3,3,3]
# Verify EXPLAIN on slave uses vector index
EXPLAIN SELECT id, name, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	vi	23	NULL	5	100.00	Using vector index (algo=HNSW; ef_search=20; ef_construction=10; limit=3; metric=EUCLIDEAN)
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`name` AS `name`,VEC_ToText(`test`.`t1`.`v`) AS `VEC_TOTEXT(v)` from `test`.`t1` FORCE INDEX (`vi`) order by VEC_DISTANCE_EUCLIDEAN(`test`.`t1`.`v`,VEC_FromText('[1,2,3,4,5]')) limit 3
# Verify ANN query on slave
SELECT id, name, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
5	vec5	[3,3,3,3,3]
4	vec4	[2,2,2,2,2]

# 6. Test UPDATE replication
[connection master]
UPDATE t1 SET v = VEC_FROMTEXT("[9,9,9,9,9]") WHERE id = 1;
SELECT id, name, VEC_TOTEXT(v) FROM t1 WHERE id = 1;
id	name	VEC_TOTEXT(v)
1	vec1	[9,9,9,9,9]
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
# Verify update on slave
SELECT id, name, VEC_TOTEXT(v) FROM t1 WHERE id = 1;
id	name	VEC_TOTEXT(v)
1	vec1	[9,9,9,9,9]
# Verify ANN query finds updated vector on slave
SELECT id, name, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[9,9,9,9,9]")) LIMIT 1;
id	name	VEC_TOTEXT(v)
1	vec1	[9,9,9,9,9]

# 7. Test DELETE replication
[connection master]
DELETE FROM t1 WHERE id = 2;
SELECT COUNT(*) FROM t1;
COUNT(*)
4
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
# Verify delete on slave
SELECT COUNT(*) FROM t1;
COUNT(*)
4
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	vec1	[9,9,9,9,9]
3	vec3	[1,1,1,1,1]
4	vec4	[2,2,2,2,2]
5	vec5	[3,3,3,3,3]

# 8. Test transaction replication
[connection master]
BEGIN;
INSERT INTO t1(name, v) VALUES ('vec6', VEC_FROMTEXT("[6,6,6,6,6]"));
INSERT INTO t1(name, v) VALUES ('vec7', VEC_FROMTEXT("[7,7,7,7,7]"));
UPDATE t1 SET v = VEC_FROMTEXT("[8,8,8,8,8]") WHERE id = 3;
COMMIT;
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	vec1	[9,9,9,9,9]
3	vec3	[8,8,8,8,8]
4	vec4	[2,2,2,2,2]
5	vec5	[3,3,3,3,3]
6	vec6	[6,6,6,6,6]
7	vec7	[7,7,7,7,7]
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
# Verify transaction on slave
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	vec1	[9,9,9,9,9]
3	vec3	[8,8,8,8,8]
4	vec4	[2,2,2,2,2]
5	vec5	[3,3,3,3,3]
6	vec6	[6,6,6,6,6]
7	vec7	[7,7,7,7,7]

# 9. Test DDL replication - ALTER TABLE
[connection master]
ALTER TABLE t1 DROP INDEX `vi`;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(100) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=8 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
ALTER TABLE t1 ADD VECTOR INDEX vi2(v) m=16 distance=cosine;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(100) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi2` (`v`) M=16 DISTANCE=COSINE EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=8 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
# Verify DDL on slave
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(100) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi2` (`v`) M=16 DISTANCE=COSINE EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=8 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Verify ANN query with new index on slave.  The probe vector ties
# with every [k,k,k,k,k] row on cosine distance, so the member order
# depends on graph traversal; assert the row count only.
SELECT COUNT(*) AS ann_rows FROM (
SELECT id FROM t1 FORCE INDEX(`vi2`)
ORDER BY VEC_DISTANCE_COSINE(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3
) q;
ann_rows
3

# 10. Test TRUNCATE replication
[connection master]
TRUNCATE TABLE t1;
SELECT COUNT(*) FROM t1;
COUNT(*)
0
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(100) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi2` (`v`) M=16 DISTANCE=COSINE EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
# Verify truncate on slave
SELECT COUNT(*) FROM t1;
COUNT(*)
0
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(100) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi2` (`v`) M=16 DISTANCE=COSINE EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

# 11. Insert after truncate and verify
[connection master]
INSERT INTO t1(name, v) VALUES ('new_vec1', VEC_FROMTEXT("[1,1,1,1,1]"));
INSERT INTO t1(name, v) VALUES ('new_vec2', VEC_FROMTEXT("[2,2,2,2,2]"));
include/sync_slave_sql_with_master.inc [FOR CHANNEL 'test']
[connection slave]
# Verify new data on slave
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	new_vec1	[1,1,1,1,1]
2	new_vec2	[2,2,2,2,2]
SELECT id, name, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi2`) ORDER BY VEC_DISTANCE_COSINE(v, VEC_FROMTEXT("[1,1,1,1,1]")) LIMIT 2;
id	name	VEC_TOTEXT(v)
1	new_vec1	[1,1,1,1,1]
2	new_vec2	[2,2,2,2,2]

# 12. Clean up
SET GLOBAL vidx_disabled = ON;
[connection master]
DROP TABLE t1;
SET GLOBAL vidx_disabled = ON;
include/rpl_sync.inc
include/rpl_end.inc
