CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
# 1. Create table with vector index
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(20),
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE=InnoDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(20) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

# 2. Insert test data
INSERT INTO t1(name, v) VALUES 
('vec1', VEC_FROMTEXT("[1,2,3,4,5]")),
('vec2', VEC_FROMTEXT("[5,4,3,2,1]")),
('vec3', VEC_FROMTEXT("[1,1,1,1,1]")),
('vec4', VEC_FROMTEXT("[2,2,2,2,2]")),
('vec5', VEC_FROMTEXT("[3,3,3,3,3]"));

# 3. Verify data before HANDLER operations
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
2	vec2	[5,4,3,2,1]
3	vec3	[1,1,1,1,1]
4	vec4	[2,2,2,2,2]
5	vec5	[3,3,3,3,3]

# 4. HANDLER OPEN and READ operations
# Open handler on table with vector index
HANDLER t1 OPEN;
# Read first row (vector column will be in binary format)
# Using disable_result_log for binary output
HANDLER t1 READ FIRST;
# Read subsequent rows
HANDLER t1 READ NEXT;
HANDLER t1 READ NEXT;
HANDLER t1 READ NEXT;
HANDLER t1 READ NEXT;
# Try to read beyond last row (should return empty)
HANDLER t1 READ NEXT;
# Close handler
HANDLER t1 CLOSE;

# 5. HANDLER with PRIMARY KEY index
HANDLER t1 OPEN;
# Read using PRIMARY key
HANDLER t1 READ `PRIMARY` FIRST;
HANDLER t1 READ `PRIMARY` NEXT;
HANDLER t1 CLOSE;

# 6. HANDLER READ with specific key value
HANDLER t1 OPEN;
# Read specific row by PRIMARY key
HANDLER t1 READ `PRIMARY` = (3);
HANDLER t1 CLOSE;

# 7. Multiple HANDLER sessions
HANDLER t1 OPEN AS h1;
HANDLER t1 OPEN AS h2;
HANDLER h1 READ FIRST;
HANDLER h2 READ FIRST;
HANDLER h1 READ NEXT;
HANDLER h2 READ NEXT;
HANDLER h1 CLOSE;
HANDLER h2 CLOSE;

# 8. HANDLER with WHERE clause
HANDLER t1 OPEN;
HANDLER t1 READ FIRST WHERE id > 2;
HANDLER t1 READ NEXT WHERE id > 2;
HANDLER t1 CLOSE;

# 9. HANDLER with LIMIT clause
HANDLER t1 OPEN;
HANDLER t1 READ FIRST LIMIT 2;
HANDLER t1 CLOSE;

# 10. Verify table is still accessible after HANDLER operations
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
2	vec2	[5,4,3,2,1]
3	vec3	[1,1,1,1,1]
4	vec4	[2,2,2,2,2]
5	vec5	[3,3,3,3,3]

# 11. ANN query still works after HANDLER operations
SELECT id, name, VEC_TOTEXT(v) 
FROM t1 FORCE INDEX(`vi`)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]"))
LIMIT 3;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
5	vec5	[3,3,3,3,3]
4	vec4	[2,2,2,2,2]

# 12. HANDLER on table without vector index for comparison
CREATE TABLE t2 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(20),
data VARCHAR(100)
) ENGINE=InnoDB;
INSERT INTO t2(name, data) VALUES ('a', 'data1'), ('b', 'data2'), ('c', 'data3');
HANDLER t2 OPEN;
HANDLER t2 READ FIRST;
id	name	data
1	a	data1
HANDLER t2 READ NEXT;
id	name	data
2	b	data2
HANDLER t2 CLOSE;

# 13. HANDLER during concurrent DML (insert data with handler open)
HANDLER t1 OPEN;
# Insert new row while handler is open
INSERT INTO t1(name, v) VALUES ('vec6', VEC_FROMTEXT("[6,6,6,6,6]"));
# Read should see the data
HANDLER t1 READ FIRST;
HANDLER t1 READ NEXT;
HANDLER t1 CLOSE;
# Verify inserted data
SELECT id, name, VEC_TOTEXT(v) FROM t1 WHERE name = 'vec6';
id	name	VEC_TOTEXT(v)
6	vec6	[6,6,6,6,6]

# 14. HANDLER with NULL vector values
INSERT INTO t1(name, v) VALUES ('null_vec', NULL);
HANDLER t1 OPEN;
HANDLER t1 READ `PRIMARY` LAST;
HANDLER t1 CLOSE;

# 15. Cleanup
DROP TABLE t1;
DROP TABLE t2;
SET GLOBAL vidx_disabled = ON;
