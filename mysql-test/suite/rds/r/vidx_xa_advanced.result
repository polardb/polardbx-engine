########################################
# 8. NULL vector then UPDATE          #
#    aux table tracks changes         #
########################################
[connection master]
# Aux count before NULL inserts
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_before_null FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_before_null
11
DEALLOCATE PREPARE s;
XA START 'xa_null';
INSERT INTO t1(a, v) VALUES (600, NULL);
INSERT INTO t1(a, v) VALUES (601, NULL);
XA END 'xa_null';
XA PREPARE 'xa_null';
XA COMMIT 'xa_null';
# After NULL insert: aux count should NOT increase
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_after_null FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_after_null
11
DEALLOCATE PREPARE s;
XA START 'xa_set_vec';
UPDATE t1 SET v = VEC_FROMTEXT("[60,60,60]") WHERE a = 600;
UPDATE t1 SET v = VEC_FROMTEXT("[61,61,61]") WHERE a = 601;
XA END 'xa_set_vec';
XA PREPARE 'xa_set_vec';
XA COMMIT 'xa_set_vec';
include/rpl_sync.inc
# After UPDATE to set vector: aux count should increase
[connection master]
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_after_update FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_after_update
13
DEALLOCATE PREPARE s;
# Slave
[connection slave]
SELECT COUNT(*) AS t1_rows FROM t1;
t1_rows
9
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_after_update FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_after_update
13
DEALLOCATE PREPARE s;

