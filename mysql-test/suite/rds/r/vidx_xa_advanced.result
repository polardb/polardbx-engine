########################################
# 12. ANN search consistency          #
########################################
[connection master]
# ANN on t1 (master)
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[5,5,5]")) LIMIT 5;
id
1
4
5
8
9
# ANN on t2 (master)
SELECT id FROM t2 FORCE INDEX(vi2) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[15,15,15]")) LIMIT 3;
id
1
2
3
# ANN on t1 (slave)
[connection slave]
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[5,5,5]")) LIMIT 5;
id
1
4
5
8
9
# ANN on t2 (slave)
SELECT id FROM t2 FORCE INDEX(vi2) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[15,15,15]")) LIMIT 3;
id
1
2
3

