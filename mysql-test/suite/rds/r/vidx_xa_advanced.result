[connection master]
[connection slave]
SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;
[connection master]
SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;
SET transaction_isolation = 'READ-COMMITTED';
########################################
# Setup: create tables + seed data    #
########################################
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
a INT NOT NULL DEFAULT 0,
v VECTOR(3),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
CREATE TABLE t2 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
label VARCHAR(32) NOT NULL DEFAULT '',
v VECTOR(3),
VECTOR INDEX vi2(v)
) ENGINE = InnoDB;
# Seed data
INSERT INTO t1(a, v) VALUES (1, VEC_FROMTEXT("[1,1,1]"));
INSERT INTO t1(a, v) VALUES (2, VEC_FROMTEXT("[2,2,2]"));
INSERT INTO t1(a, v) VALUES (3, VEC_FROMTEXT("[3,3,3]"));
INSERT INTO t2(label, v) VALUES ('a', VEC_FROMTEXT("[10,10,10]"));
INSERT INTO t2(label, v) VALUES ('b', VEC_FROMTEXT("[20,20,20]"));
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
SELECT TABLE_ID INTO @t2_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t2';
include/rpl_sync.inc
[connection slave]
SELECT TABLE_ID INTO @t1_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t1';
SELECT TABLE_ID INTO @t2_tid FROM information_schema.INNODB_TABLES WHERE NAME = 'test/t2';

########################################
# 1. Verify seed: main + aux tables   #
########################################
[connection master]
# Master
SELECT COUNT(*) AS t1_rows FROM t1;
t1_rows
3
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_rows
3
DEALLOCATE PREPARE s;
SELECT COUNT(*) AS t2_rows FROM t2;
t2_rows
2
SET @s = CONCAT('SELECT COUNT(*) AS t2_aux_rows FROM `vidx_', @t2_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t2_aux_rows
2
DEALLOCATE PREPARE s;
# Slave
[connection slave]
SELECT COUNT(*) AS t1_rows FROM t1;
t1_rows
3
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_rows
3
DEALLOCATE PREPARE s;
SELECT COUNT(*) AS t2_rows FROM t2;
t2_rows
2
SET @s = CONCAT('SELECT COUNT(*) AS t2_aux_rows FROM `vidx_', @t2_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t2_aux_rows
2
DEALLOCATE PREPARE s;

########################################
# 2. XA INSERT - aux count increases  #
########################################
[connection master]
XA START 'xa_ins';
INSERT INTO t1(a, v) VALUES (10, VEC_FROMTEXT("[10,10,10]"));
INSERT INTO t1(a, v) VALUES (11, VEC_FROMTEXT("[11,11,11]"));
XA END 'xa_ins';
XA PREPARE 'xa_ins';
XA COMMIT 'xa_ins';
include/rpl_sync.inc
# Master: main + aux
[connection master]
SELECT COUNT(*) AS t1_rows FROM t1;
t1_rows
5
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_rows
5
DEALLOCATE PREPARE s;
# Slave: main + aux
[connection slave]
SELECT COUNT(*) AS t1_rows FROM t1;
t1_rows
5
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_rows
5
DEALLOCATE PREPARE s;

########################################
# 3. Multi-table XA with aux verify   #
########################################
[connection master]
XA START 'xa_multi';
INSERT INTO t2(label, v) VALUES ('c', VEC_FROMTEXT("[30,30,30]"));
UPDATE t1 SET v = VEC_FROMTEXT("[5,5,5]") WHERE a = 1;
DELETE FROM t1 WHERE a = 2;
XA END 'xa_multi';
XA PREPARE 'xa_multi';
XA COMMIT 'xa_multi';
include/rpl_sync.inc
# Master
[connection master]
SELECT COUNT(*) AS t1_rows FROM t1;
t1_rows
4
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_rows
6
DEALLOCATE PREPARE s;
SELECT COUNT(*) AS t2_rows FROM t2;
t2_rows
3
SET @s = CONCAT('SELECT COUNT(*) AS t2_aux_rows FROM `vidx_', @t2_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t2_aux_rows
3
DEALLOCATE PREPARE s;
# Slave
[connection slave]
SELECT COUNT(*) AS t1_rows FROM t1;
t1_rows
4
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_rows
6
DEALLOCATE PREPARE s;
SELECT COUNT(*) AS t2_rows FROM t2;
t2_rows
3
SET @s = CONCAT('SELECT COUNT(*) AS t2_aux_rows FROM `vidx_', @t2_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t2_aux_rows
3
DEALLOCATE PREPARE s;

########################################
# 4. XA ROLLBACK - aux table UNCHANGED#
########################################
[connection master]
# Record aux count before rollback
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_before FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_before
6
DEALLOCATE PREPARE s;
XA START 'xa_rb';
INSERT INTO t1(a, v) VALUES (99, VEC_FROMTEXT("[99,99,99]"));
DELETE FROM t1 WHERE a = 3;
XA END 'xa_rb';
XA PREPARE 'xa_rb';
XA ROLLBACK 'xa_rb';
include/rpl_sync.inc
# Master: aux count after rollback (must match before)
[connection master]
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_after FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_after
7
DEALLOCATE PREPARE s;
# Rolled-back row must NOT exist
SELECT COUNT(*) AS a99_count FROM t1 WHERE a = 99;
a99_count
0
# Existing row must still exist
SELECT COUNT(*) AS a3_count FROM t1 WHERE a = 3;
a3_count
1
# Slave: verify rollback
[connection slave]
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_after FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_after
7
DEALLOCATE PREPARE s;
SELECT COUNT(*) AS a99_count FROM t1 WHERE a = 99;
a99_count
0
SELECT COUNT(*) AS a3_count FROM t1 WHERE a = 3;
a3_count
1

########################################
# 5. XA ROLLBACK then XA COMMIT      #
#    Verify aux_thd reuse after rb    #
########################################
[connection master]
XA START 'xa_rb2';
INSERT INTO t1(a, v) VALUES (300, VEC_FROMTEXT("[30,30,30]"));
XA END 'xa_rb2';
XA PREPARE 'xa_rb2';
XA ROLLBACK 'xa_rb2';
XA START 'xa_after_rb';
INSERT INTO t1(a, v) VALUES (301, VEC_FROMTEXT("[31,31,31]"));
XA END 'xa_after_rb';
XA PREPARE 'xa_after_rb';
XA COMMIT 'xa_after_rb';
include/rpl_sync.inc
# Master
[connection master]
SELECT COUNT(*) AS a300_count FROM t1 WHERE a = 300;
a300_count
0
SELECT COUNT(*) AS a301_count FROM t1 WHERE a = 301;
a301_count
1
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_rows
9
DEALLOCATE PREPARE s;
# Slave
[connection slave]
SELECT COUNT(*) AS a300_count FROM t1 WHERE a = 300;
a300_count
0
SELECT COUNT(*) AS a301_count FROM t1 WHERE a = 301;
a301_count
1
SET @s = CONCAT('SELECT COUNT(*) AS t1_aux_rows FROM `vidx_', @t1_tid, '_0`');
PREPARE s FROM @s;
EXECUTE s;
t1_aux_rows
9
DEALLOCATE PREPARE s;

