########################################
# 10. XA ROLLBACK then re-INSERT same #
#     id via new XA (DUPP_KEY compat) #
#                                     #
# XA PREPARE commits aux table row;   #
# XA ROLLBACK rolls back main table   #
# but leaves aux table row intact.    #
# Re-inserting the same logical row   #
# in a new XA triggers DUPP_KEY on    #
# aux table - must be tolerated.      #
########################################
[connection master]
# Insert a row, then XA ROLLBACK it
XA START 'xa_rb_reinsert_1';
INSERT INTO t1(id, a, v) VALUES (9001, 91, VEC_FROMTEXT("[91,91,91]"));
XA END 'xa_rb_reinsert_1';
XA PREPARE 'xa_rb_reinsert_1';
XA ROLLBACK 'xa_rb_reinsert_1';
# Re-insert the same id in a new XA and commit
# Aux table already has a row with this tref from the previous
# XA PREPARE; clear_stale_tref_node must handle the conflict.
XA START 'xa_rb_reinsert_2';
INSERT INTO t1(id, a, v) VALUES (9001, 92, VEC_FROMTEXT("[92,92,92]"));
XA END 'xa_rb_reinsert_2';
XA PREPARE 'xa_rb_reinsert_2';
XA COMMIT 'xa_rb_reinsert_2';
include/rpl_sync.inc
# Master: id=9001 must exist with a=92
[connection master]
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE id = 9001;
id	a	VEC_TOTEXT(v)
9001	92	[92,92,92]
# Slave: same
[connection slave]
SELECT id, a, VEC_TOTEXT(v) FROM t1 WHERE id = 9001;
id	a	VEC_TOTEXT(v)
9001	92	[92,92,92]

