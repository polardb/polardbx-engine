INSERT INTO t1(a, v) VALUES (706, VEC_FROMTEXT("[76,76,76]"));
INSERT INTO t1(a, v) VALUES (707, VEC_FROMTEXT("[77,77,77]"));
INSERT INTO t1(a, v) VALUES (708, VEC_FROMTEXT("[78,78,78]"));
INSERT INTO t1(a, v) VALUES (709, VEC_FROMTEXT("[79,79,79]"));
