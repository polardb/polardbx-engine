########################################
# Scenario 40: Multi-index optimizer   #
# selection per ORDER BY column        #
########################################
CREATE TABLE t_mi (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v1 VECTOR(5),
v2 VECTOR(5),
VECTOR INDEX vi1(v1),
VECTOR INDEX vi2(v2) DISTANCE=cosine
) ENGINE=InnoDB;
ANALYZE TABLE t_mi;
