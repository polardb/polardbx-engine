SELECT id FROM (SELECT id, a, v FROM t1 WHERE a > 3) AS d
ORDER BY VEC_DISTANCE_EUCLIDEAN(d.v, VEC_FROMTEXT("[0.5,0.5,0.5,0.5,0.5]")) LIMIT 5;

