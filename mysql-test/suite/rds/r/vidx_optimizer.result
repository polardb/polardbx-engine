CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
DROP TABLE IF EXISTS t1, t2;
########################################
# Preparation: create tables with data #
########################################
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
a INT NOT NULL,
b VARCHAR(32),
v VECTOR(5),
INDEX idx_a(a),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
CREATE TABLE t2 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
t1_id INT NOT NULL,
status VARCHAR(16),
INDEX idx_t1id(t1_id),
INDEX idx_status(status)
) ENGINE = InnoDB;
# Insert 100 rows into t1
# Insert 200 rows into t2 (some matching, some not)
ANALYZE TABLE t1, t2;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK

########################################
# Baseline: simple vector index query  #
########################################
# Expect: type=index (vector index scan)
EXPLAIN SELECT * FROM t1 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[0.5,0.5,0.5,0.5,0.5]")) LIMIT 5;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	vi	23	NULL	100	100.00	Using vector index (algo=HNSW; ef_search=20; ef_construction=10; limit=5; metric=EUCLIDEAN)
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`a` AS `a`,`test`.`t1`.`b` AS `b`,`test`.`t1`.`v` AS `v` from `test`.`t1` order by VEC_DISTANCE_EUCLIDEAN(`test`.`t1`.`v`,VEC_FromText('[0.5,0.5,0.5,0.5,0.5]')) limit 5
SELECT id FROM t1 ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[0.5,0.5,0.5,0.5,0.5]")) LIMIT 5;

########################################
# Scenario 1: Derived table (materialized)
# + ORDER BY VEC_DISTANCE + LIMIT
# Expect: NO vector index (derived table
# is materialized, no vector index on it)
########################################
EXPLAIN SELECT * FROM (SELECT id, a, v FROM t1 WHERE a > 3) AS d
ORDER BY VEC_DISTANCE_EUCLIDEAN(d.v, VEC_FROMTEXT("[0.5,0.5,0.5,0.5,0.5]")) LIMIT 5;
