CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");

# 1. Show all vidx related system variables
SHOW VARIABLES LIKE 'vidx%';
Variable_name	Value
vidx_ddl_threads	4
vidx_default_distance	EUCLIDEAN
vidx_disabled	ON
vidx_force_non_indep	OFF
vidx_hnsw_cache_size	16777216
vidx_hnsw_default_ef_construction	10
vidx_hnsw_default_m	6
vidx_hnsw_ef_search	20
vidx_hnsw_lock_timeout_ms	1000
vidx_use_fast_float	ON

# 2. Test vidx_disabled variable
# Initially vidx_disabled should be ON (default)
SELECT @@GLOBAL.vidx_disabled;
@@GLOBAL.vidx_disabled
1
# Try to create vector index when disabled - should fail
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
ERROR HY000: Creating vector columns or indexes is disabled.
# Enable vidx
SET GLOBAL vidx_disabled = OFF;
SELECT @@GLOBAL.vidx_disabled;
@@GLOBAL.vidx_disabled
0
SET transaction_isolation = 'READ-COMMITTED';
# Now create should succeed
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Insert some data
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[1,2,3,4,5]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[5,4,3,2,1]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[1,1,1,1,1]"));

# 3. Test vidx_disabled=ON with existing table
SET GLOBAL vidx_disabled = ON;
# Query should still work on existing table
SELECT id, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
2	[5,4,3,2,1]
3	[1,1,1,1,1]
# ANN query on existing table
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 2;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
3	[1,1,1,1,1]
# INSERT on existing table should still work
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[2,2,2,2,2]"));
# But creating new vector index should fail
CREATE TABLE t2 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
ERROR HY000: Creating vector columns or indexes is disabled.
# ALTER TABLE ADD VECTOR INDEX should fail
# Note: Creating table with VECTOR column also fails when vidx_disabled=ON
CREATE TABLE t2 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5)
) ENGINE = InnoDB;
ERROR HY000: Creating vector columns or indexes is disabled.
# Re-enable vidx to test ALTER TABLE
SET GLOBAL vidx_disabled = OFF;
CREATE TABLE t2 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5)
) ENGINE = InnoDB;
# Disable vidx again
SET GLOBAL vidx_disabled = ON;
ALTER TABLE t2 ADD VECTOR INDEX vi(v);
ERROR HY000: Creating vector columns or indexes is disabled.
DROP TABLE t2;
# Re-enable vidx
SET GLOBAL vidx_disabled = OFF;

# 4. Test vidx_hnsw_ef_search variable
SELECT @@SESSION.vidx_hnsw_ef_search;
@@SESSION.vidx_hnsw_ef_search
20
# Change ef_search and observe query behavior
SET SESSION vidx_hnsw_ef_search = 50;
SELECT @@SESSION.vidx_hnsw_ef_search;
@@SESSION.vidx_hnsw_ef_search
50
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
4	[2,2,2,2,2]
3	[1,1,1,1,1]
SET SESSION vidx_hnsw_ef_search = 100;
SELECT @@SESSION.vidx_hnsw_ef_search;
@@SESSION.vidx_hnsw_ef_search
100
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
4	[2,2,2,2,2]
3	[1,1,1,1,1]
# Reset to default
SET SESSION vidx_hnsw_ef_search = 20;

# 5. Test vidx_hnsw_cache_size variable (GLOBAL)
SELECT @@GLOBAL.vidx_hnsw_cache_size;
@@GLOBAL.vidx_hnsw_cache_size
16777216
# Modify cache size
SET GLOBAL vidx_hnsw_cache_size = 2097152;
SELECT @@GLOBAL.vidx_hnsw_cache_size;
@@GLOBAL.vidx_hnsw_cache_size
2097152
# Query should still work
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 2;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
4	[2,2,2,2,2]
# Reset to default
SET GLOBAL vidx_hnsw_cache_size = DEFAULT;

# 6. Test vidx_hnsw_default_m variable (SESSION)
SELECT @@SESSION.vidx_hnsw_default_m;
@@SESSION.vidx_hnsw_default_m
6
# Change default M value
SET SESSION vidx_hnsw_default_m = 32;
SELECT @@SESSION.vidx_hnsw_default_m;
@@SESSION.vidx_hnsw_default_m
32
# Create new table - should use new default M
CREATE TABLE t3 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi3(v)
) ENGINE = InnoDB;
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi3` (`v`) M=32 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Reset M and create another table
SET SESSION vidx_hnsw_default_m = 64;
SELECT @@SESSION.vidx_hnsw_default_m;
@@SESSION.vidx_hnsw_default_m
64
CREATE TABLE t4 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi4(v)
) ENGINE = InnoDB;
SHOW CREATE TABLE t4;
Table	Create Table
t4	CREATE TABLE `t4` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi4` (`v`) M=64 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Reset to default
SET SESSION vidx_hnsw_default_m = DEFAULT;

# 7. Test vidx_default_distance variable (SESSION)
SELECT @@SESSION.vidx_default_distance;
@@SESSION.vidx_default_distance
EUCLIDEAN
# Change default distance
SET SESSION vidx_default_distance = 'cosine';
SELECT @@SESSION.vidx_default_distance;
@@SESSION.vidx_default_distance
COSINE
# Create table with default cosine distance
CREATE TABLE t5 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi5(v)
) ENGINE = InnoDB;
SHOW CREATE TABLE t5;
Table	Create Table
t5	CREATE TABLE `t5` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi5` (`v`) M=6 DISTANCE=COSINE EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Reset to euclidean
SET SESSION vidx_default_distance = 'euclidean';
SELECT @@SESSION.vidx_default_distance;
@@SESSION.vidx_default_distance
EUCLIDEAN
CREATE TABLE t6 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi6(v)
) ENGINE = InnoDB;
SHOW CREATE TABLE t6;
Table	Create Table
t6	CREATE TABLE `t6` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi6` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

# 8. Test SESSION vs GLOBAL scope
# vidx_hnsw_ef_search is SESSION scope
# Connection 1: Set session variable
SET SESSION vidx_hnsw_ef_search = 75;
SELECT @@SESSION.vidx_hnsw_ef_search;
@@SESSION.vidx_hnsw_ef_search
75
# Create a new connection to verify isolation
SELECT @@SESSION.vidx_hnsw_ef_search;
@@SESSION.vidx_hnsw_ef_search
20
# Should be default value, not 75
# Original session should still have 75
SELECT @@SESSION.vidx_hnsw_ef_search;
@@SESSION.vidx_hnsw_ef_search
75
# Reset
SET SESSION vidx_hnsw_ef_search = DEFAULT;

# 9. Test variable boundary values
# vidx_hnsw_ef_search range: 1 to max_ef
SET SESSION vidx_hnsw_ef_search = 1;
SELECT @@SESSION.vidx_hnsw_ef_search;
@@SESSION.vidx_hnsw_ef_search
1
# vidx_hnsw_default_m range: 3 to 127
SET SESSION vidx_hnsw_default_m = 3;
SELECT @@SESSION.vidx_hnsw_default_m;
@@SESSION.vidx_hnsw_default_m
3
SET SESSION vidx_hnsw_default_m = 127;
SELECT @@SESSION.vidx_hnsw_default_m;
@@SESSION.vidx_hnsw_default_m
127
SET SESSION vidx_hnsw_default_m = 128;
Warnings:
Warning	1292	Truncated incorrect vidx_hnsw_default_m value: '128'
SELECT @@SESSION.vidx_hnsw_default_m;
@@SESSION.vidx_hnsw_default_m
127
# Reset to defaults
SET SESSION vidx_hnsw_ef_search = DEFAULT;
SET SESSION vidx_hnsw_default_m = DEFAULT;

# 10. Clean up
DROP TABLE t1;
DROP TABLE t3;
DROP TABLE t4;
DROP TABLE t5;
DROP TABLE t6;
SET GLOBAL vidx_disabled = ON;
