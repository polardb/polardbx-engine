CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

# 1. Create table with vector index and insert data
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(100),
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
INSERT INTO t1(name, v) VALUES ('vec1', VEC_FROMTEXT("[1,2,3,4,5]"));
INSERT INTO t1(name, v) VALUES ('vec2', VEC_FROMTEXT("[5,4,3,2,1]"));
INSERT INTO t1(name, v) VALUES ('vec3', VEC_FROMTEXT("[1,1,1,1,1]"));
INSERT INTO t1(name, v) VALUES ('vec4', VEC_FROMTEXT("[2,2,2,2,2]"));
INSERT INTO t1(name, v) VALUES ('vec5', VEC_FROMTEXT("[3,3,3,3,3]"));
# Original data
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
2	vec2	[5,4,3,2,1]
3	vec3	[1,1,1,1,1]
4	vec4	[2,2,2,2,2]
5	vec5	[3,3,3,3,3]
# Original table structure
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(100) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Original ANN query result
SELECT id, name, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
5	vec5	[3,3,3,3,3]
4	vec4	[2,2,2,2,2]

# 2. Dump database using mysqldump

# 3. Drop and recreate database
DROP DATABASE test;
CREATE DATABASE test;
USE test;

# 4. Restore from dump

# 5. Verify restored table structure contains VECTOR INDEX
USE test;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(100) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

# 6. Verify restored data
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
2	vec2	[5,4,3,2,1]
3	vec3	[1,1,1,1,1]
4	vec4	[2,2,2,2,2]
5	vec5	[3,3,3,3,3]

# 7. Verify ANN query works correctly after restore
SELECT id, name, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
5	vec5	[3,3,3,3,3]
4	vec4	[2,2,2,2,2]

# 8. Verify INSERT works after restore
INSERT INTO t1(name, v) VALUES ('vec6', VEC_FROMTEXT("[4,4,4,4,4]"));
SELECT id, name, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	name	VEC_TOTEXT(v)
1	vec1	[1,2,3,4,5]
2	vec2	[5,4,3,2,1]
3	vec3	[1,1,1,1,1]
4	vec4	[2,2,2,2,2]
5	vec5	[3,3,3,3,3]
6	vec6	[4,4,4,4,4]

# 9. Test dump with specific table
DROP TABLE t1;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `name` varchar(100) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=7 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT COUNT(*) FROM t1;
COUNT(*)
6

# 10. Clean up
DROP TABLE t1;

# 11. Multi-index dump and restore
CREATE TABLE t_mi (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v1 VECTOR(4),
v2 VECTOR(4),
VECTOR INDEX vi1(v1) M=16 DISTANCE=euclidean,
VECTOR INDEX vi2(v2) M=8 DISTANCE=cosine
) ENGINE=InnoDB;
INSERT INTO t_mi(v1, v2) VALUES (VEC_FROMTEXT('[1,0,0,0]'), VEC_FROMTEXT('[0,0,0,1]'));
INSERT INTO t_mi(v1, v2) VALUES (VEC_FROMTEXT('[0,1,0,0]'), VEC_FROMTEXT('[0,0,1,0]'));
INSERT INTO t_mi(v1, v2) VALUES (VEC_FROMTEXT('[0,0,1,0]'), VEC_FROMTEXT('[0,1,0,0]'));
# Original structure
SHOW CREATE TABLE t_mi;
Table	Create Table
t_mi	CREATE TABLE `t_mi` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v1` vector(4) DEFAULT NULL,
  `v2` vector(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi1` (`v1`) M=16 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10,
  VECTOR KEY `vi2` (`v2`) M=8 DISTANCE=COSINE EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Original ANN queries
SELECT id FROM t_mi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[1,0,0,0]')) LIMIT 1;
id
1
SELECT id FROM t_mi ORDER BY VEC_DISTANCE_COSINE(v2, VEC_FROMTEXT('[0,0,0,1]')) LIMIT 1;
id
1
# Dump
# Drop and restore
DROP TABLE t_mi;
# Verify restored structure has both VECTOR INDEX
SHOW CREATE TABLE t_mi;
Table	Create Table
t_mi	CREATE TABLE `t_mi` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v1` vector(4) DEFAULT NULL,
  `v2` vector(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi1` (`v1`) M=16 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10,
  VECTOR KEY `vi2` (`v2`) M=8 DISTANCE=COSINE EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Verify ANN queries work on both columns after restore
SELECT id FROM t_mi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[1,0,0,0]')) LIMIT 1;
id
1
SELECT id FROM t_mi ORDER BY VEC_DISTANCE_COSINE(v2, VEC_FROMTEXT('[0,0,0,1]')) LIMIT 1;
id
1
# Verify INSERT works after restore on multi-index table
INSERT INTO t_mi(v1, v2) VALUES (VEC_FROMTEXT('[0,0,0,1]'), VEC_FROMTEXT('[1,0,0,0]'));
SELECT id FROM t_mi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[0,0,0,1]')) LIMIT 1;
id
4
DROP TABLE t_mi;
SET GLOBAL vidx_disabled = ON;
