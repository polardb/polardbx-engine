# 11. Test status variables with transaction
# Record counts before transaction
BEGIN;
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[7,7,7,7,7]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[6,6,6,6,6]"));
COMMIT;
OK: Vidx_insert_count incremented for committed transaction

# 12. Test status variables with rollback
BEGIN;
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[5,5,5,5,5]"));
ROLLBACK;
# Note: Insert count may or may not increment on rollback depending on implementation

# 13. Test decode_* status variables
# Decode stats recorded
SELECT 'Decode statistics captured' AS status;
status
Decode statistics captured

# 14. Test cache_usage status variable
# Cache usage recorded

