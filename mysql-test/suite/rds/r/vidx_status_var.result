CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

# 1. Show all Vidx status variables
SHOW GLOBAL STATUS LIKE 'Vidx_%';
Variable_name	Value
Vidx_acquire_start_hits	#
Vidx_acquire_start_misses	#
Vidx_cache_usage	#
Vidx_ddl_build_error_count	#
Vidx_ddl_build_windows	#
