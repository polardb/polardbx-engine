CREATE DATABASE vidx_ddl_parallel_build;
USE vidx_ddl_parallel_build;
SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;
SET transaction_isolation = 'READ-COMMITTED';
CREATE TABLE t1 (
id INT NOT NULL PRIMARY KEY,
v VECTOR(5)
) ENGINE = InnoDB;
SELECT COUNT(*) AS total_rows, COUNT(v) AS non_null_rows FROM t1;
total_rows	non_null_rows
100	98

############################################
# Phase 1: W=1 serial fallback            #
############################################
SET SESSION vidx_ddl_threads = 1;
ALTER TABLE t1 ADD VECTOR INDEX vi(v);
VERDICT 1 serial-fallback (no parallel batches): PASS
VERDICT 1 live==non-null-base: PASS
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[1,2,3,4,5]')) LIMIT 1;
id
1
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[98,99,100,101,102]')) LIMIT 1;
id
98

############################################
# Phase 2: W=2, tail batch of 1           #
############################################
ALTER TABLE t1 DROP INDEX vi;
SET SESSION vidx_ddl_threads = 2;
ALTER TABLE t1 ADD VECTOR INDEX vi(v);
VERDICT 2 batch-count ceil(97/16)==7: PASS
VERDICT 2 live==non-null-base: PASS
VERDICT 2 full self-probe 98/98: PASS
VERDICT 2 off-sample recall@10 >= 0.90: PASS

############################################
# Phase 3: W=8, single tail-heavy batch   #
############################################
ALTER TABLE t1 DROP INDEX vi;
SET SESSION vidx_ddl_threads = 8;
ALTER TABLE t1 ADD VECTOR INDEX vi(v);
VERDICT 3 batch-count ceil(97/64)==2: PASS
VERDICT 3 live==non-null-base: PASS
VERDICT 3 full self-probe 98/98: PASS
VERDICT 3 off-sample recall@10 >= 0.90: PASS

############################################
# Phase 4: W=4, duplicate vectors         #
############################################
CREATE TABLE t2 (
id INT NOT NULL PRIMARY KEY,
v VECTOR(5)
) ENGINE = InnoDB;
SET SESSION vidx_ddl_threads = 4;
ALTER TABLE t2 ADD VECTOR INDEX vi(v);
VERDICT 4 batch-count ceil(29/32)==1: PASS
VERDICT 4 live==30 duplicates all indexed: PASS
SELECT COUNT(*) AS dup_hits FROM (
SELECT id FROM t2 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[7,7,7,7,7]')) LIMIT 20
) q WHERE q.id <= 20;
dup_hits
20
DROP TABLE t1;
DROP TABLE t2;
DROP TEMPORARY TABLE quality_expected;
DROP TEMPORARY TABLE quality_ann;
SET SESSION vidx_ddl_threads = default;
SET GLOBAL show_vidx_hlindex_tables = default;
SET GLOBAL vidx_disabled = default;
DROP DATABASE IF EXISTS vidx_ddl_parallel_build;
