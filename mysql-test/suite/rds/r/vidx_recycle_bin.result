CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
CALL mtr.add_suppression("Fail to recycle table");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
DROP TABLE IF EXISTS t1, t2, t3;
DROP DATABASE IF EXISTS db_vidx_recycle;
CREATE DATABASE IF NOT EXISTS db_vidx_recycle;
USE db_vidx_recycle;
#
# Scenario 1.1: Vector index table must skip recycle bin and be dropped directly
#
SET GLOBAL recycle_scheduler = OFF;
SET SESSION recycle_bin = ON;
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
content VARCHAR(200),
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `content` varchar(200) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Check auxiliary table exists in information_schema.INNODB_TABLES
SELECT COUNT(*) > 0 AS has_aux_table FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE '%vidx_%' AND NAME LIKE '%db_vidx_recycle%';
has_aux_table
1
#
# Scenario 1.2: DROP TABLE -> table should NOT enter recycle bin
#
DROP TABLE t1;
# Recycle bin should be empty (vector index table rejected)
CALL dbms_recycle.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
# Auxiliary table should also be deleted
SELECT COUNT(*) AS remaining_aux_tables FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE '%vidx_%' AND NAME LIKE '%db_vidx_recycle%';
remaining_aux_tables
0
#
# Scenario 1.3: Recreate table with same name -> no conflict
#
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
content VARCHAR(200),
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `content` varchar(200) DEFAULT NULL,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
#
# Scenario 1.4: Recycle bin OFF, DROP -> auxiliary table directly deleted
#
SET SESSION recycle_bin = OFF;
CREATE TABLE t2 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
# Check auxiliary table exists before DROP
SELECT COUNT(*) > 0 AS has_aux_table FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE '%vidx_%' AND NAME LIKE '%t2%';
has_aux_table
1
DROP TABLE t2;
# Check auxiliary table is deleted after DROP
SELECT COUNT(*) AS remaining_aux_tables FROM information_schema.INNODB_TABLES 
WHERE NAME LIKE '%vidx_%' AND NAME LIKE '%t2%';
remaining_aux_tables
0
#
# Scenario 1.5: DROP and recreate same name table -> verify no interference
#
CREATE TABLE t3 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(5) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi` (`v`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t3;
CREATE TABLE t3 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(8),
VECTOR INDEX vi2(v) m=10
) ENGINE = InnoDB;
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v` vector(8) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi2` (`v`) M=10 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t3;
#
# Scenario 1.6: Non-vector table with recycle bin ON should still enter recycle bin
#
SET SESSION recycle_bin = ON;
CREATE TABLE t_normal (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(100)
) ENGINE = InnoDB;
DROP TABLE t_normal;
# Normal table should appear in recycle bin
CALL dbms_recycle.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
__recycle_bin__	#	db_vidx_recycle	t_normal	#	#
# Cleanup
SET SESSION recycle_bin = OFF;
USE test;
DROP DATABASE db_vidx_recycle;
SET GLOBAL vidx_disabled = ON;
