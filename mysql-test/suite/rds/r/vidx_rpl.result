# 2.5 CAST AS VECTOR / JSON input replicate correctly
[connection master]
CREATE TABLE t_cast (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
INSERT INTO t_cast(v) VALUES (CAST('[1,2,3,4,5]' AS VECTOR(5)));
INSERT INTO t_cast(v) VALUES (CAST(JSON_ARRAY(5,4,3,2,1) AS VECTOR(5)));
INSERT INTO t_cast(v) VALUES (CAST(JSON_ARRAY(1,1,1,1,1) AS VECTOR));
include/rpl_sync.inc
# Master side
SELECT id, VEC_TOTEXT(v) FROM t_cast ORDER BY id;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
2	[5,4,3,2,1]
3	[1,1,1,1,1]
# Slave side (should match master)
[connection slave]
SELECT id, VEC_TOTEXT(v) FROM t_cast ORDER BY id;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
2	[5,4,3,2,1]
3	[1,1,1,1,1]
[connection master]
DROP TABLE t_cast;
include/rpl_sync.inc

# 2.6 Multi-index replication
[connection master]
CREATE TABLE t_mi (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v1 VECTOR(4),
v2 VECTOR(4),
VECTOR INDEX vi1(v1),
VECTOR INDEX vi2(v2) DISTANCE=cosine
) ENGINE=InnoDB;
INSERT INTO t_mi(v1, v2) VALUES (VEC_FROMTEXT('[1,0,0,0]'), VEC_FROMTEXT('[0,0,0,1]'));
INSERT INTO t_mi(v1, v2) VALUES (VEC_FROMTEXT('[0,1,0,0]'), VEC_FROMTEXT('[0,0,1,0]'));
INSERT INTO t_mi(v1, v2) VALUES (VEC_FROMTEXT('[0,0,1,0]'), VEC_FROMTEXT('[0,1,0,0]'));
include/rpl_sync.inc
# Master: verify structure and queries
SHOW CREATE TABLE t_mi;
Table	Create Table
t_mi	CREATE TABLE `t_mi` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v1` vector(4) DEFAULT NULL,
  `v2` vector(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi1` (`v1`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10,
  VECTOR KEY `vi2` (`v2`) M=6 DISTANCE=COSINE EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT id FROM t_mi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[1,0,0,0]')) LIMIT 1;
id
1
SELECT id FROM t_mi ORDER BY VEC_DISTANCE_COSINE(v2, VEC_FROMTEXT('[0,0,0,1]')) LIMIT 1;
id
1
# Slave: verify structure matches
[connection slave]
SHOW CREATE TABLE t_mi;
Table	Create Table
t_mi	CREATE TABLE `t_mi` (
  `id` int NOT NULL AUTO_INCREMENT,
  `v1` vector(4) DEFAULT NULL,
  `v2` vector(4) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `vi1` (`v1`) M=6 DISTANCE=EUCLIDEAN EF_CONSTRUCTION=10,
  VECTOR KEY `vi2` (`v2`) M=6 DISTANCE=COSINE EF_CONSTRUCTION=10
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT id FROM t_mi ORDER BY VEC_DISTANCE_EUCLIDEAN(v1, VEC_FROMTEXT('[1,0,0,0]')) LIMIT 1;
id
1
SELECT id FROM t_mi ORDER BY VEC_DISTANCE_COSINE(v2, VEC_FROMTEXT('[0,0,0,1]')) LIMIT 1;
id
