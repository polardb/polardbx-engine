CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
# 1. Prepare - Create table with vector index
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;

# ========================================
# 2. XA Basic Flow: BEGIN -> INSERT -> END -> PREPARE -> COMMIT
# ========================================
XA START 'xa_basic_1';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[1,2,3,4,5]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[5,4,3,2,1]"));
XA END 'xa_basic_1';
XA PREPARE 'xa_basic_1';
XA COMMIT 'xa_basic_1';
# Verify data after XA COMMIT
SELECT COUNT(*) FROM t1;
COUNT(*)
2
SELECT id, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
2	[5,4,3,2,1]
# Verify ANN query works after XA COMMIT
EXPLAIN SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 5;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	vi	23	NULL	2	100.00	Using vector index (algo=HNSW; ef_search=20; ef_construction=10; limit=2; metric=EUCLIDEAN)
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 5;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
2	[5,4,3,2,1]

# ========================================
# 3. XA Cross-Connection: PREPARE in conn1, COMMIT in default
# ========================================
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
XA START 'xa_cross_conn';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[10,20,30,40,50]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[50,40,30,20,10]"));
XA END 'xa_cross_conn';
XA PREPARE 'xa_cross_conn';
# Disconnect the connection that prepared XA
# Reconnect and commit in default connection
# XA RECOVER should show the prepared transaction
XA RECOVER;
formatID	gtrid_length	bqual_length	data
1	13	0	xa_cross_conn
# Commit the XA transaction from different connection
XA COMMIT 'xa_cross_conn';
# Verify data after cross-connection XA COMMIT
SELECT COUNT(*) FROM t1;
COUNT(*)
4
# Verify ANN query returns correct results (compare with full table scan)
# Full table scan result:
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(PRIMARY) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[10,20,30,40,50]")) LIMIT 3;
id	VEC_TOTEXT(v)
3	[10,20,30,40,50]
4	[50,40,30,20,10]
1	[1,2,3,4,5]
# Vector index scan result:
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[10,20,30,40,50]")) LIMIT 3;
id	VEC_TOTEXT(v)
3	[10,20,30,40,50]
4	[50,40,30,20,10]
1	[1,2,3,4,5]

# ========================================
# 4. XA ROLLBACK after PREPARE
# ========================================
XA START 'xa_rollback_1';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[100,200,300,400,500]"));
XA END 'xa_rollback_1';
XA PREPARE 'xa_rollback_1';
# Record count before rollback
SELECT COUNT(*) FROM t1;
COUNT(*)
4
XA ROLLBACK 'xa_rollback_1';
# Record count after rollback - should be same as before INSERT
SELECT COUNT(*) FROM t1;
COUNT(*)
4
# Verify the rolled back data is not visible in ANN query
SELECT id FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[100,200,300,400,500]")) LIMIT 1;

# ========================================
# 5. XA PREPARE then ANN query (verify cache state)
# ========================================
XA START 'xa_cache_test';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[1.1,2.1,3.1,4.1,5.1]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[1.2,2.2,3.2,4.2,5.2]"));
XA END 'xa_cache_test';
XA PREPARE 'xa_cache_test';
# ANN query during XA PREPARE state (data should not be visible yet)
# The prepared but not committed data should not appear in query results
SELECT COUNT(*) FROM t1;
COUNT(*)
4
XA COMMIT 'xa_cache_test';
# After commit, data should be visible
SELECT COUNT(*) FROM t1;
COUNT(*)
6

# ========================================
# 6. XA COMMIT - Verify vector index integrity
# ========================================
# Compare FORCE INDEX(vi) ANN query vs FORCE INDEX(PRIMARY) full scan
# Both should return the same nearest neighbors
# Insert more data for comprehensive comparison
XA START 'xa_integrity';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[2,3,4,5,6]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[3,4,5,6,7]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[4,5,6,7,8]"));
XA END 'xa_integrity';
XA PREPARE 'xa_integrity';
XA COMMIT 'xa_integrity';
# Query vector: [2.5,3.5,4.5,5.5,6.5]
# Full table scan (ground truth):
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[2.5,3.5,4.5,5.5,6.5]")) AS dist 
FROM t1 FORCE INDEX(PRIMARY) 
ORDER BY dist LIMIT 5;
id	VEC_TOTEXT(v)	dist
8	[2,3,4,5,6]	1.118033988749895
9	[3,4,5,6,7]	1.118033988749895
7	[1.2,2.2,3.2,4.2,5.2]	2.9068884773737684
6	[1.1,2.1,3.1,4.1,5.1]	3.130495328435752
1	[1,2,3,4,5]	3.3541019662496847
# Vector index scan:
SELECT id, VEC_TOTEXT(v), VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[2.5,3.5,4.5,5.5,6.5]")) AS dist 
FROM t1 FORCE INDEX(`vi`) 
ORDER BY dist LIMIT 5;
id	VEC_TOTEXT(v)	dist
9	[3,4,5,6,7]	1.118033988749895
8	[2,3,4,5,6]	1.118033988749895
7	[1.2,2.2,3.2,4.2,5.2]	2.9068884773737684
6	[1.1,2.1,3.1,4.1,5.1]	3.130495328435752
10	[4,5,6,7,8]	3.3541019662496847

# ========================================
# 7. Multiple XA transactions (sequential, to avoid lock contention)
# ========================================
# First XA transaction
XA START 'xa_multi_1';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[11,12,13,14,15]"));
XA END 'xa_multi_1';
XA PREPARE 'xa_multi_1';
XA COMMIT 'xa_multi_1';
# Second XA transaction (different connection)
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
XA START 'xa_multi_2';
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[21,22,23,24,25]"));
XA END 'xa_multi_2';
XA PREPARE 'xa_multi_2';
XA COMMIT 'xa_multi_2';
# Verify both transactions committed
SELECT COUNT(*) FROM t1;
COUNT(*)
11

# ========================================
# 8. XA with UPDATE operation
# ========================================
XA START 'xa_update';
UPDATE t1 SET v = VEC_FROMTEXT("[99,99,99,99,99]") WHERE id = 1;
XA END 'xa_update';
XA PREPARE 'xa_update';
XA COMMIT 'xa_update';
# Verify update
SELECT id, VEC_TOTEXT(v) FROM t1 WHERE id = 1;
id	VEC_TOTEXT(v)
1	[99,99,99,99,99]
# Verify ANN query reflects the update
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[99,99,99,99,99]")) LIMIT 1;
id	VEC_TOTEXT(v)
1	[99,99,99,99,99]

# ========================================
# 9. XA with DELETE operation
# ========================================
# Get current count
SELECT COUNT(*) FROM t1;
COUNT(*)
11
XA START 'xa_delete';
DELETE FROM t1 WHERE id = 2;
XA END 'xa_delete';
XA PREPARE 'xa_delete';
XA COMMIT 'xa_delete';
# Verify delete
SELECT COUNT(*) FROM t1;
COUNT(*)
10

# ========================================
# 10. Clean up
# ========================================
DROP TABLE t1;
SET GLOBAL vidx_disabled = ON;
