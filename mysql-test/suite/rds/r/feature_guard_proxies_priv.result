CALL mtr.add_suppression("Wrong password supplied");
######## SETUP ########
SET GLOBAL opt_enable_rds_priv_strategy = ON;
SET GLOBAL maintain_user_list = 'aurora';
CREATE USER 'aurora'@'%' IDENTIFIED BY 'aurorapass';
GRANT ALL PRIVILEGES ON *.* TO 'aurora'@'%' WITH GRANT OPTION;
CREATE USER 'lintong'@'%' IDENTIFIED BY 'lintongpass';
GRANT SELECT, INSERT, UPDATE, DELETE, RELOAD, CREATE USER
ON *.* TO 'lintong'@'%' WITH GRANT OPTION;
CREATE USER 'proxy_esc'@'%' IDENTIFIED WITH test_plugin_server AS 'aurora';
CREATE USER 'ptarget'@'%' IDENTIFIED BY 'x';
CREATE USER 'padmin'@'%'  IDENTIFIED BY 'x';
CREATE USER 'pgrantee'@'%' IDENTIFIED BY 'x';
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','benign','%','harmless',0,'root@localhost');
FLUSH PRIVILEGES;

######## P: positive control - empty-wildcard escalation is real ########
# root (SUPER, exempt) plants the empty-Proxied_user row the attacker is
# otherwise blocked from creating (group A). This proves the chain:
# proxy login -> identity becomes aurora -> aurora (SUPER) escalates a victim.
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','proxy_esc','%','',0,'root@localhost');
FLUSH PRIVILEGES;
CREATE USER 'victim'@'%' IDENTIFIED BY 'x';
SELECT Super_priv FROM mysql.user WHERE user='victim';
Super_priv
N
# empty Proxied_user wildcard maps proxy_esc -> aurora
SELECT CURRENT_USER();
CURRENT_USER()
aurora@%
# as aurora (SUPER) the guard is exempt -> escalation succeeds
UPDATE mysql.user SET Super_priv='Y' WHERE user='victim';
FLUSH PRIVILEGES;
# victim is escalated (attack works when the row is present)
SELECT Super_priv FROM mysql.user WHERE user='victim';
Super_priv
Y
DELETE FROM mysql.proxies_priv WHERE User='proxy_esc';
DROP USER 'victim'@'%';
FLUSH PRIVILEGES;

######## A: attacker's direct proxies_priv DML is fully blocked ########
# A1 INSERT Proxied_user='aurora' (reserved) -> blocked
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','proxy_esc','%','aurora',0,'lintong@%');
ERROR HY000: Rerserved user or privileges can't be modified
# A2 INSERT Proxied_user='' (empty wildcard) -> blocked  [#85237119]
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','proxy_esc','%','',0,'lintong@%');
ERROR HY000: Rerserved user or privileges can't be modified
# A3 INSERT Proxied_user='%' (wildcard) -> blocked
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','proxy_esc','%','%',0,'lintong@%');
ERROR HY000: Rerserved user or privileges can't be modified
# A4 INSERT Proxied_user='Aurora' (mixed-case evasion) -> blocked
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','proxy_esc','%','Aurora',0,'lintong@%');
ERROR HY000: Rerserved user or privileges can't be modified
# A5 INSERT Proxied_user='harmless' (non-reserved) -> blocked (full-block)
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','proxy_esc','%','harmless',0,'lintong@%');
ERROR HY000: Rerserved user or privileges can't be modified
# A6 INSERT ... SELECT cannot smuggle a wildcard row -> blocked
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
SELECT '%','proxy_esc','%','',0,'lintong@%';
ERROR HY000: Rerserved user or privileges can't be modified
# A7 REPLACE -> blocked
REPLACE INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','proxy_esc','%','',0,'lintong@%');
ERROR HY000: Rerserved user or privileges can't be modified
# A8 UPDATE existing row -> Proxied_user='' (create wildcard) -> blocked
UPDATE mysql.proxies_priv SET Proxied_user='' WHERE User='benign';
ERROR HY000: Rerserved user or privileges can't be modified
# A9 UPDATE non-Proxied_user field on a benign row -> blocked (direct DML)
UPDATE mysql.proxies_priv SET With_grant=1 WHERE User='benign';
ERROR HY000: Rerserved user or privileges can't be modified
# A10 DELETE a benign (non-reserved) row -> blocked (direct DML)
DELETE FROM mysql.proxies_priv WHERE User='benign';
ERROR HY000: Rerserved user or privileges can't be modified
# A11 nothing was planted by the attacker
SELECT COUNT(*) AS attacker_rows FROM mysql.proxies_priv WHERE User='proxy_esc';
attacker_rows
0
# A12 SUPER is exempt: root may INSERT/UPDATE/DELETE proxies_priv freely
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','root_made','%','',0,'root@localhost');
UPDATE mysql.proxies_priv SET Proxied_user='aurora' WHERE User='root_made';
DELETE FROM mysql.proxies_priv WHERE User='root_made';

######## B: NO false positive - internal ACL management still works ########
# B1 non-SUPER GRANT PROXY (delegated WITH GRANT OPTION) -> allowed
#    (replace_proxies_priv_table -> ha_write_row, bypasses guard_record)
GRANT PROXY ON 'ptarget'@'%' TO 'padmin'@'%' WITH GRANT OPTION;
GRANT PROXY ON 'ptarget'@'%' TO 'pgrantee'@'%';
# B2 non-SUPER REVOKE PROXY -> allowed
REVOKE PROXY ON 'ptarget'@'%' FROM 'pgrantee'@'%';
# B3 non-SUPER DROP USER owning a (non-protected) proxy row -> allowed
#    (modify_grant_table -> guard_record(DELETE) with SQLCOM_DROP_USER,
#     not direct DML -> selective reserved-name check -> allowed)
CREATE USER 'dropme'@'%' IDENTIFIED BY 'x';
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','dropme','%','harmless',0,'root@localhost');
FLUSH PRIVILEGES;
DROP USER 'dropme'@'%';
# cleanup DELETE succeeded (row gone)
SELECT COUNT(*) AS dropme_rows FROM mysql.proxies_priv WHERE User='dropme';
dropme_rows
0
# B4 non-SUPER RENAME USER owning a (non-protected) proxy row -> allowed
#    (modify_grant_table -> guard_record(UPDATE) with SQLCOM_RENAME_USER)
CREATE USER 'renameme'@'%' IDENTIFIED BY 'x';
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','renameme','%','harmless',0,'root@localhost');
FLUSH PRIVILEGES;
RENAME USER 'renameme'@'%' TO 'renamed'@'%';
# rename rewrote the row (User=renamed)
SELECT COUNT(*) AS renamed_rows FROM mysql.proxies_priv
WHERE User='renamed' AND Proxied_user='harmless';
renamed_rows
1
# B5 non-SUPER DROP USER cleaning MULTIPLE (non-protected) proxy rows -> allowed
CREATE USER 'multi'@'%' IDENTIFIED BY 'x';
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','multi','h1','t1',0,'root@localhost'),
('%','multi','h2','t2',0,'root@localhost');
FLUSH PRIVILEGES;
DROP USER 'multi'@'%';
# every row for 'multi' was cleaned (guard_delete selective, not full-block)
SELECT COUNT(*) AS multi_rows FROM mysql.proxies_priv WHERE User='multi';
multi_rows
0
# B6 non-SUPER ALTER USER of an account owning a proxy row -> allowed
#    (ALTER USER does search-only handle_grant_data; never hits guard_record)
CREATE USER 'altme'@'%' IDENTIFIED BY 'x';
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','altme','%','harmless',0,'root@localhost');
FLUSH PRIVILEGES;
ALTER USER 'altme'@'%' IDENTIFIED BY 'y';
# the proxy row is untouched by ALTER USER
SELECT COUNT(*) AS altme_rows FROM mysql.proxies_priv WHERE User='altme';
altme_rows
1
DROP USER 'altme'@'%';
FLUSH PRIVILEGES;

######## C: end-to-end - attacker can never become aurora ########
# attacker cannot plant any proxies_priv row (group A), so proxy login
# (authenticated_as=aurora, but no matching proxy grant) is denied.
ERROR 28000: Access denied for user 'proxy_esc'@'localhost' (using password: YES)
SELECT Super_priv FROM mysql.user WHERE user='lintong';
Super_priv
N

######## E: guard disabled -> direct DML allowed again ########
SET GLOBAL opt_enable_rds_priv_strategy = OFF;
INSERT INTO mysql.proxies_priv (Host,User,Proxied_host,Proxied_user,With_grant,Grantor)
VALUES ('%','proxy_esc','%','',0,'lintong@%');
DELETE FROM mysql.proxies_priv WHERE User='proxy_esc';
SET GLOBAL opt_enable_rds_priv_strategy = ON;

######## CLEANUP ########
DELETE FROM mysql.proxies_priv WHERE User='benign';
DROP USER 'aurora'@'%','lintong'@'%','proxy_esc'@'%',
'ptarget'@'%','padmin'@'%','pgrantee'@'%','renamed'@'%';
SET GLOBAL maintain_user_list = '';
SET GLOBAL opt_enable_rds_priv_strategy = OFF;
FLUSH PRIVILEGES;
