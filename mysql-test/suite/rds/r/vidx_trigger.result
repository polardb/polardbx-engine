CALL mtr.add_suppression("Unsafe statement written to the binary log using statement format since BINLOG_FORMAT = STATEMENT");
SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';

# 1. Create tables with vector index and log table
CREATE TABLE t1 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi(v)
) ENGINE = InnoDB;
CREATE TABLE t2 (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
v VECTOR(5),
VECTOR INDEX vi2(v)
) ENGINE = InnoDB;
CREATE TABLE t_log (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
action_type VARCHAR(50),
action_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
details VARCHAR(255)
) ENGINE = InnoDB;

# 2. Create BEFORE INSERT trigger - log the action
CREATE TRIGGER tr_before_insert BEFORE INSERT ON t1
FOR EACH ROW
BEGIN
INSERT INTO t_log(action_type, details) VALUES ('BEFORE_INSERT', 'Inserting into t1');
END|

# 3. Create AFTER INSERT trigger - insert into another vector table
CREATE TRIGGER tr_after_insert AFTER INSERT ON t1
FOR EACH ROW
BEGIN
INSERT INTO t_log(action_type, details) VALUES ('AFTER_INSERT', 'Inserted into t1');
INSERT INTO t2(v) VALUES (NEW.v);
END|

# 4. Create BEFORE UPDATE trigger - log the update
CREATE TRIGGER tr_before_update BEFORE UPDATE ON t1
FOR EACH ROW
BEGIN
INSERT INTO t_log(action_type, details) VALUES ('BEFORE_UPDATE', 'Updating t1');
END|

# 5. Create AFTER UPDATE trigger
CREATE TRIGGER tr_after_update AFTER UPDATE ON t1
FOR EACH ROW
BEGIN
INSERT INTO t_log(action_type, details) VALUES ('AFTER_UPDATE', 'Updated t1');
END|

# 6. Create BEFORE DELETE trigger
CREATE TRIGGER tr_before_delete BEFORE DELETE ON t1
FOR EACH ROW
BEGIN
INSERT INTO t_log(action_type, details) VALUES ('BEFORE_DELETE', 'Deleting from t1');
END|

# 7. Create AFTER DELETE trigger
CREATE TRIGGER tr_after_delete AFTER DELETE ON t1
FOR EACH ROW
BEGIN
INSERT INTO t_log(action_type, details) VALUES ('AFTER_DELETE', 'Deleted from t1');
END|

# 8. Test INSERT with triggers
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[1,2,3,4,5]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[5,4,3,2,1]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[1,1,1,1,1]"));
# Check log table
SELECT action_type, details FROM t_log ORDER BY id;
action_type	details
BEFORE_INSERT	Inserting into t1
AFTER_INSERT	Inserted into t1
BEFORE_INSERT	Inserting into t1
AFTER_INSERT	Inserted into t1
BEFORE_INSERT	Inserting into t1
AFTER_INSERT	Inserted into t1
# Check t1 data
SELECT id, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
2	[5,4,3,2,1]
3	[1,1,1,1,1]
# Check t2 data (populated by trigger)
SELECT id, VEC_TOTEXT(v) FROM t2 ORDER BY id;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
2	[5,4,3,2,1]
3	[1,1,1,1,1]

# 9. Verify vector index integrity after trigger operations
# ANN query on t1
EXPLAIN SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	vi	23	NULL	3	100.00	Using vector index (algo=HNSW; ef_search=20; ef_construction=10; limit=3; metric=EUCLIDEAN)
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
3	[1,1,1,1,1]
2	[5,4,3,2,1]
# ANN query on t2
EXPLAIN SELECT id, VEC_TOTEXT(v) FROM t2 FORCE INDEX(`vi2`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	index	NULL	vi2	23	NULL	3	100.00	Using vector index (algo=HNSW; ef_search=20; ef_construction=10; limit=3; metric=EUCLIDEAN)
SELECT id, VEC_TOTEXT(v) FROM t2 FORCE INDEX(`vi2`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[1,2,3,4,5]")) LIMIT 3;
id	VEC_TOTEXT(v)
1	[1,2,3,4,5]
3	[1,1,1,1,1]
2	[5,4,3,2,1]

# 10. Test UPDATE with triggers
UPDATE t1 SET v = VEC_FROMTEXT("[9,9,9,9,9]") WHERE id = 1;
# Check log after update
SELECT action_type, details FROM t_log WHERE action_type LIKE '%UPDATE%' ORDER BY id;
action_type	details
BEFORE_UPDATE	Updating t1
AFTER_UPDATE	Updated t1
# Verify updated data
SELECT id, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	VEC_TOTEXT(v)
1	[9,9,9,9,9]
2	[5,4,3,2,1]
3	[1,1,1,1,1]
# Verify ANN query after update
SELECT id, VEC_TOTEXT(v) FROM t1 FORCE INDEX(`vi`) ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT("[9,9,9,9,9]")) LIMIT 1;
id	VEC_TOTEXT(v)
1	[9,9,9,9,9]

# 11. Test DELETE with triggers
DELETE FROM t1 WHERE id = 2;
# Check log after delete
SELECT action_type, details FROM t_log WHERE action_type LIKE '%DELETE%' ORDER BY id;
action_type	details
BEFORE_DELETE	Deleting from t1
AFTER_DELETE	Deleted from t1
# Verify remaining data
SELECT id, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	VEC_TOTEXT(v)
1	[9,9,9,9,9]
3	[1,1,1,1,1]

# 12. Test trigger with NULL vector
INSERT INTO t1(v) VALUES (NULL);
SELECT id, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	VEC_TOTEXT(v)
1	[9,9,9,9,9]
3	[1,1,1,1,1]
4	NULL

# 13. Test multiple inserts in transaction with triggers
BEGIN;
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[2,2,2,2,2]"));
INSERT INTO t1(v) VALUES (VEC_FROMTEXT("[3,3,3,3,3]"));
COMMIT;
SELECT COUNT(*) FROM t_log WHERE action_type = 'AFTER_INSERT';
COUNT(*)
6
SELECT id, VEC_TOTEXT(v) FROM t1 ORDER BY id;
id	VEC_TOTEXT(v)
1	[9,9,9,9,9]
3	[1,1,1,1,1]
4	NULL
5	[2,2,2,2,2]
6	[3,3,3,3,3]

# 14. Clean up
DROP TRIGGER tr_before_insert;
DROP TRIGGER tr_after_insert;
DROP TRIGGER tr_before_update;
DROP TRIGGER tr_after_update;
DROP TRIGGER tr_before_delete;
DROP TRIGGER tr_after_delete;
DROP TABLE t1;
DROP TABLE t2;
DROP TABLE t_log;
SET GLOBAL vidx_disabled = ON;
