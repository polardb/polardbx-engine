########################################
# Scenario 15: PREPARE/EXECUTE SHOW INDEX across DDL
# Risk: Prepared statement cache not reflecting DD changes
########################################
CREATE TABLE t_prep (
id INT PRIMARY KEY,
name VARCHAR(20),
v VECTOR(3),
INDEX idx_name(name),
VECTOR INDEX vi_prep(v)
) ENGINE=InnoDB;
# PREPARE before DDL
PREPARE stmt_show FROM 'SHOW INDEX FROM t_prep';
PREPARE stmt_vi FROM 'SELECT INDEX_NAME, DIMENSION FROM INFORMATION_SCHEMA.VECTOR_INDEXES WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = ?';
SET @tbl = 't_prep';
EXECUTE stmt_show;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_prep	0	PRIMARY	1	id	A	1	NULL	NULL		BTREE			YES	NULL
t_prep	1	vi_prep	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=3	YES	NULL
t_prep	1	idx_name	1	name	A	1	NULL	NULL	YES	BTREE			YES	NULL
EXECUTE stmt_vi USING @tbl;
INDEX_NAME	DIMENSION
vi_prep	3
# DDL: drop vector index
ALTER TABLE t_prep DROP INDEX vi_prep;
# EXECUTE after DDL — should reflect new state (no vector row)
EXECUTE stmt_show;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_prep	0	PRIMARY	1	id	A	1	NULL	NULL		BTREE			YES	NULL
t_prep	1	idx_name	1	name	A	1	NULL	NULL	YES	BTREE			YES	NULL
EXECUTE stmt_vi USING @tbl;
INDEX_NAME	DIMENSION
# DDL: recreate vector index
ALTER TABLE t_prep ADD VECTOR INDEX vi_prep2(v) distance=cosine;
# EXECUTE again — should show new vector index
EXECUTE stmt_show;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_prep	0	PRIMARY	1	id	A	1	NULL	NULL		BTREE			YES	NULL
t_prep	1	vi_prep2	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=COSINE, EF_CONSTRUCTION=10, DIM=3	YES	NULL
t_prep	1	idx_name	1	name	A	1	NULL	NULL	YES	BTREE			YES	NULL
EXECUTE stmt_vi USING @tbl;
INDEX_NAME	DIMENSION
vi_prep2	3
DEALLOCATE PREPARE stmt_show;
DEALLOCATE PREPARE stmt_vi;
DROP TABLE t_prep;
########################################
# Scenario 16: vidx_disabled toggle mid-session
# Risk: VECTOR_INDEXES branch behavior during feature flag flip
########################################
CREATE TABLE t_toggle (
id INT PRIMARY KEY,
v VECTOR(3),
VECTOR INDEX vi_tog(v)
) ENGINE=InnoDB;
# With vidx_disabled=OFF — should see vector index
SET GLOBAL vidx_disabled = OFF;
SHOW INDEX FROM t_toggle;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_toggle	0	PRIMARY	1	id	A	1	NULL	NULL		BTREE			YES	NULL
t_toggle	1	vi_tog	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=3	YES	NULL
SELECT INDEX_NAME FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_toggle';
INDEX_NAME
vi_tog
# Toggle to ON mid-session
SET GLOBAL vidx_disabled = ON;
SET GLOBAL vidx_disabled = ON;
# With vidx_disabled=ON — SHOW INDEX behavior
SHOW INDEX FROM t_toggle;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_toggle	0	PRIMARY	1	id	A	1	NULL	NULL		BTREE			YES	NULL
t_toggle	1	vi_tog	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=3	YES	NULL
# VECTOR_INDEXES should still reflect DD state (view is metadata, not runtime)
SELECT INDEX_NAME FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_toggle';
INDEX_NAME
vi_tog
SET GLOBAL vidx_disabled = OFF;
DROP TABLE t_toggle;
