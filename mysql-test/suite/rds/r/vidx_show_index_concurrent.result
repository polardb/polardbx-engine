# Scenario 4: SHOW INDEX racing with CREATE INDEX
# Risk: New VECTOR index appears mid-query in UNION ALL
########################################
CREATE TABLE t_add_idx (
id INT PRIMARY KEY AUTO_INCREMENT,
v VECTOR(4)
) ENGINE=InnoDB;
INSERT INTO t_add_idx(v) VALUES (VEC_FROMTEXT('[1,2,3,4]'));
INSERT INTO t_add_idx(v) VALUES (VEC_FROMTEXT('[5,6,7,8]'));
# SHOW INDEX before CREATE VECTOR INDEX
SHOW INDEX FROM t_add_idx;
