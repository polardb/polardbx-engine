########################################
# Scenario 2: SHOW INDEX while DML is in-flight
# Risk: DD read racing with aux table modification
########################################
BEGIN;
INSERT INTO t_main(name, v) VALUES ('inflight_1', VEC_FROMTEXT('[99,99,99,99]'));
INSERT INTO t_main(name, v) VALUES ('inflight_2', VEC_FROMTEXT('[88,88,88,88]'));
# SHOW INDEX while con1 has uncommitted DML
SHOW INDEX FROM t_main;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_main	0	PRIMARY	1	id	A	2	NULL	NULL		BTREE			YES	NULL
t_main	1	vi_main	1	v	NULL	NULL	NULL	NULL		VECTOR		M=16, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=4	YES	NULL
t_main	1	idx_name	1	name	A	2	NULL	NULL	YES	BTREE			YES	NULL
# VECTOR_INDEXES query while con1 has uncommitted DML
SELECT TABLE_NAME, INDEX_NAME, COLUMN_NAME, METRIC_TYPE, DIMENSION, M
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_main';
TABLE_NAME	INDEX_NAME	COLUMN_NAME	METRIC_TYPE	DIMENSION	M
t_main	vi_main	v	EUCLIDEAN	4	16
COMMIT;
# SHOW INDEX after commit — should be identical structure
SHOW INDEX FROM t_main;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_main	0	PRIMARY	1	id	A	2	NULL	NULL		BTREE			YES	NULL
t_main	1	vi_main	1	v	NULL	NULL	NULL	NULL		VECTOR		M=16, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=4	YES	NULL
t_main	1	idx_name	1	name	A	2	NULL	NULL	YES	BTREE			YES	NULL
# Data integrity check
SELECT COUNT(*) AS row_count FROM t_main;
row_count
22
########################################
# Scenario 3: SHOW INDEX racing with DROP INDEX
# Risk: VECTOR_INDEXES branch returns empty mid-drop, UNION ALL still correct
########################################
# SHOW INDEX before DROP
SHOW INDEX FROM t_main;
