########################################
# Scenario 9: Cross-database concurrent VECTOR_INDEXES queries
# Risk: Concurrent DD reads across schemas
########################################
CREATE DATABASE IF NOT EXISTS vidx_db_a;
CREATE DATABASE IF NOT EXISTS vidx_db_b;
USE vidx_db_a;
SET GLOBAL vidx_disabled = OFF;
CREATE TABLE t_a (id INT PRIMARY KEY, v VECTOR(3), VECTOR INDEX vi_a(v)) ENGINE=InnoDB;
USE vidx_db_b;
SET GLOBAL vidx_disabled = OFF;
CREATE TABLE t_b (id INT PRIMARY KEY, v VECTOR(5), VECTOR INDEX vi_b(v) distance=cosine) ENGINE=InnoDB;
# Cross-database VECTOR_INDEXES full scan
SELECT TABLE_SCHEMA, TABLE_NAME, INDEX_NAME, DIMENSION, METRIC_TYPE
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA IN ('vidx_db_a', 'vidx_db_b')
ORDER BY TABLE_SCHEMA, TABLE_NAME;
TABLE_SCHEMA	TABLE_NAME	INDEX_NAME	DIMENSION	METRIC_TYPE
vidx_db_a	t_a	vi_a	3	EUCLIDEAN
vidx_db_b	t_b	vi_b	5	COSINE
USE vidx_db_a;
SHOW INDEX FROM t_a;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_a	0	PRIMARY	1	id	A	1	NULL	NULL		BTREE			YES	NULL
t_a	1	vi_a	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=3	YES	NULL
USE vidx_db_b;
SHOW INDEX FROM t_b;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_b	0	PRIMARY	1	id	A	1	NULL	NULL		BTREE			YES	NULL
t_b	1	vi_b	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=COSINE, EF_CONSTRUCTION=10, DIM=5	YES	NULL
USE test;
USE test;
USE test;
USE test;
USE test;
DROP DATABASE vidx_db_a;
DROP DATABASE vidx_db_b;
