t_main	0	PRIMARY	1	id	A	2	NULL	NULL		BTREE			YES	NULL
t_main	1	vi_main	1	v	NULL	NULL	NULL	NULL		VECTOR		M=16, DISTANCE=EUCLIDEAN, EF_CONSTRUCTION=10, DIM=4	YES	NULL
t_main	1	idx_name	1	name	A	2	NULL	NULL	YES	BTREE			YES	NULL
# VECTOR_INDEXES interleaved with ANN
SELECT INDEX_NAME, DIMENSION, M FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_main';
INDEX_NAME	DIMENSION	M
vi_main	4	16
SELECT id FROM t_main FORCE INDEX(vi_main)
ORDER BY VEC_DISTANCE_EUCLIDEAN(v, VEC_FROMTEXT('[305,305,305,305]')) LIMIT 3;
SELECT INDEX_NAME, DIMENSION, M FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_main';
INDEX_NAME	DIMENSION	M
vi_main	4	16
########################################
# Scenario 11: SHOW INDEX with optimizer_switch variations
