# No crash after 50 rapid iterations - pass
########################################
# Scenario 13: Table with ONLY vector index (no btree)
# Risk: SHOW_STATISTICS branch returns empty, only VECTOR_INDEXES has rows
########################################
CREATE TABLE t_vec_only (
id INT NOT NULL,
v VECTOR(4),
VECTOR INDEX vi_only(v) distance=euclidean
) ENGINE=InnoDB;
