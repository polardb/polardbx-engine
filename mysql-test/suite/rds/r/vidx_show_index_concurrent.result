t_add_idx	0	PRIMARY	1	id	A	1	NULL	NULL		BTREE			YES	NULL
ALTER TABLE t_add_idx ADD VECTOR INDEX vi_new(v) distance=cosine;
# SHOW INDEX after CREATE — must show VECTOR row
SHOW INDEX FROM t_add_idx;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
t_add_idx	0	PRIMARY	1	id	A	1	NULL	NULL		BTREE			YES	NULL
t_add_idx	1	vi_new	1	v	NULL	NULL	NULL	NULL		VECTOR		M=6, DISTANCE=COSINE, EF_CONSTRUCTION=10, DIM=4	YES	NULL
SELECT TABLE_NAME, INDEX_NAME, METRIC_TYPE FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_add_idx';
TABLE_NAME	INDEX_NAME	METRIC_TYPE
t_add_idx	vi_new	COSINE
DROP TABLE t_add_idx;
