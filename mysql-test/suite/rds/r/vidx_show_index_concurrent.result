# Cleanup many tables
########################################
# Scenario 18: HLINDEX_TABLE_NAME deep coverage
# Verify: naming convention, DDL consistency, TRUNCATE survival
########################################
# 18.1 Naming convention: HLINDEX_TABLE_NAME matches vidx_*_0 pattern
SELECT TABLE_NAME, INDEX_NAME, HLINDEX_TABLE_NAME,
HLINDEX_TABLE_NAME LIKE 'vidx_%\\_0' AS name_matches_pattern
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE()
ORDER BY TABLE_NAME;
TABLE_NAME	INDEX_NAME	HLINDEX_TABLE_NAME	name_matches_pattern
t_cos	vi_cos	vidx_XXXX_N	1
t_main	vi_main	vidx_XXXX_N	1
# 18.2 Capture HLINDEX_TABLE_NAME before DDL
SELECT @saved_hlidx := HLINDEX_TABLE_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_cos';
@saved_hlidx := HLINDEX_TABLE_NAME
vidx_XXXX_N
# 18.3 DROP + CREATE vector index: HLINDEX_TABLE_NAME should change
# (new se_private_id => new aux table name)
ALTER TABLE t_cos DROP INDEX vi_cos;
ALTER TABLE t_cos ADD VECTOR INDEX vi_cos_new(v) distance=cosine;
SELECT TABLE_NAME, INDEX_NAME, HLINDEX_TABLE_NAME,
HLINDEX_TABLE_NAME = @saved_hlidx AS same_as_before
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_cos';
TABLE_NAME	INDEX_NAME	HLINDEX_TABLE_NAME	same_as_before
t_cos	vi_cos_new	vidx_XXXX_N	0
# 18.4 TRUNCATE: HLINDEX_TABLE_NAME changes (TRUNCATE drops+recreates aux table, new se_private_id)
SELECT @hlidx_before_trunc := HLINDEX_TABLE_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_main';
@hlidx_before_trunc := HLINDEX_TABLE_NAME
vidx_XXXX_N
TRUNCATE TABLE t_main;
SELECT TABLE_NAME, INDEX_NAME, HLINDEX_TABLE_NAME,
HLINDEX_TABLE_NAME = @hlidx_before_trunc AS same_after_trunc
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_main';
TABLE_NAME	INDEX_NAME	HLINDEX_TABLE_NAME	same_after_trunc
t_main	vi_main	vidx_XXXX_N	0
# 18.5 RENAME TABLE: HLINDEX_TABLE_NAME unchanged (aux table not renamed)
CREATE TABLE t_hlidx_ren (
id INT PRIMARY KEY, v VECTOR(3), VECTOR INDEX vi_hr(v)
) ENGINE=InnoDB;
SELECT @hlidx_ren := HLINDEX_TABLE_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_hlidx_ren';
@hlidx_ren := HLINDEX_TABLE_NAME
vidx_XXXX_N
RENAME TABLE t_hlidx_ren TO t_hlidx_ren2;
SELECT TABLE_NAME, INDEX_NAME, HLINDEX_TABLE_NAME,
HLINDEX_TABLE_NAME = @hlidx_ren AS same_after_rename
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't_hlidx_ren2';
TABLE_NAME	INDEX_NAME	HLINDEX_TABLE_NAME	same_after_rename
t_hlidx_ren2	vi_hr	vidx_XXXX_N	1
DROP TABLE t_hlidx_ren2;
# 18.6 Recreate t_cos vector index to original for other scenario consistency
ALTER TABLE t_cos DROP INDEX vi_cos_new;
ALTER TABLE t_cos ADD VECTOR INDEX vi_cos(v) distance=cosine;
########################################
# Cleanup
########################################
DROP TABLE t_cos;
DROP TABLE t_main;
SET GLOBAL vidx_disabled = ON;
