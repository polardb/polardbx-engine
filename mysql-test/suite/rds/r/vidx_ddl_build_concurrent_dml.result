CREATE DATABASE vidx_ddl_build_concurrent_dml;
USE vidx_ddl_build_concurrent_dml;
SET GLOBAL vidx_disabled = OFF;
SET GLOBAL show_vidx_hlindex_tables = ON;
SET transaction_isolation = 'READ-COMMITTED';
CREATE TABLE t1 (
id INT NOT NULL PRIMARY KEY,
v VECTOR(5)
) ENGINE = InnoDB;
SET SESSION vidx_ddl_threads = 4;
USE vidx_ddl_build_concurrent_dml;
USE vidx_ddl_build_concurrent_dml;
USE vidx_ddl_build_concurrent_dml;

############################################
# Phase A/B: read passes, write queues     #
# while the build is parked                #
############################################
SET DEBUG_SYNC = 'vidx_ddl_direct_build_start SIGNAL build_reached WAIT_FOR build_go';
ALTER TABLE t1 ADD VECTOR INDEX vi(v);
SET DEBUG_SYNC = 'now WAIT_FOR build_reached';
# Phase A: the COPY ALTER lets concurrent readers through
SELECT COUNT(*) AS rows_visible_during_build FROM t1;
rows_visible_during_build
40
INSERT INTO t1 VALUES (41, VEC_FROMTEXT('[41,42,43,44,45]'));
# Phase B: the INSERT must wait for the ALTER's metadata lock
VERDICT B concurrent INSERT blocks on the build: PASS
SET DEBUG_SYNC = 'now SIGNAL build_go';
SET DEBUG_SYNC = 'RESET';
# The queued row must be in the graph the ALTER just built
VERDICT B live==41 (40 copied + 1 queued): PASS
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[41,42,43,44,45]')) LIMIT 1;
id
41

############################################
# Phase C: ANN read and a second ALTER     #
# against a parked build                   #
############################################
SET DEBUG_SYNC = 'vidx_ddl_direct_build_start SIGNAL build2_reached WAIT_FOR build2_go';
ALTER TABLE t1 ADD VECTOR INDEX vi2(v) M=8;
SET DEBUG_SYNC = 'now WAIT_FOR build2_reached';
# The existing graph still answers while the next one is being built
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[20,21,22,23,24]')) LIMIT 1;
id
20
ALTER TABLE t1 ADD VECTOR INDEX vi3(v);
VERDICT C second ALTER queues behind the build: PASS
SET DEBUG_SYNC = 'now SIGNAL build2_go';
Warnings:
Warning	1831	Duplicate index 'vi2' defined on the table 'vidx_ddl_build_concurrent_dml.t1'. This is deprecated and will be disallowed in a future release.
SET DEBUG_SYNC = 'RESET';
Warnings:
Warning	1831	Duplicate index 'vi3' defined on the table 'vidx_ddl_build_concurrent_dml.t1'. This is deprecated and will be disallowed in a future release.
SELECT INDEX_NAME, COLUMN_NAME, DIMENSION, M, HLINDEX_TABLE_NAME
FROM INFORMATION_SCHEMA.VECTOR_INDEXES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 't1'
ORDER BY INDEX_NAME;
INDEX_NAME	COLUMN_NAME	DIMENSION	M	HLINDEX_TABLE_NAME
vi	v	5	6	HLINDEX_TABLE_NAME
vi2	v	5	8	HLINDEX_TABLE_NAME
vi3	v	5	6	HLINDEX_TABLE_NAME
# The last ALTER rebuilt all three slots: each must hold every row
VERDICT C all three slots live==base: PASS
SELECT id FROM t1 FORCE INDEX(vi2) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[20,21,22,23,24]')) LIMIT 1;
id
20
SELECT id FROM t1 FORCE INDEX(vi3) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[20,21,22,23,24]')) LIMIT 1;
id
20

############################################
# Phase D: DML after the concurrent window #
############################################
INSERT INTO t1 VALUES (42, VEC_FROMTEXT('[42,43,44,45,46]'));
UPDATE t1 SET v = VEC_FROMTEXT('[70,71,72,73,74]') WHERE id = 1;
DELETE FROM t1 WHERE id = 2;
SELECT COUNT(*) AS base_rows FROM t1;
base_rows
41
VERDICT D all slots track the base table after DML: PASS
# The moved vector must be found at its new position, not the old one
SELECT id FROM t1 FORCE INDEX(vi) ORDER BY VEC_DISTANCE(v, VEC_FROMTEXT('[70,71,72,73,74]')) LIMIT 1;
id
1
DROP TABLE t1;
SET GLOBAL show_vidx_hlindex_tables = default;
SET GLOBAL vidx_disabled = default;
DROP DATABASE IF EXISTS vidx_ddl_build_concurrent_dml;
