############
# Test all situations when update records had dropped columns, in order to
# validate the bugfix which mysqld server crash if convert instant dropped
# column to blob.
############
--let $MYSQLD_TMPDIR=`SELECT @@tmpdir`
--let $CHECKSUM_FILE=$MYSQLD_TMPDIR/checksum.txt

--echo ############
--echo # Prepare t1 to be the matched basic.
CREATE TABLE `t1` (
  `id` bigint NOT NULL AUTO_INCREMENT PRIMARY KEY,
  `c1` longtext DEFAULT NULL,
  `c2` longtext DEFAULT NULL,
  `c3` longtext DEFAULT NULL
) ENGINE=InnoDB ROW_FORMAT=REDUNDANT;

--exec cat /dev/null > $CHECKSUM_FILE

--echo
--echo ############
--echo # ROW_FORMAT REDUNDANT
# It's exactly REDUNDANT now.

--source include/bugfix_crash_if_convert_instant_dropped_column_to_blob_low.inc

--exec echo "$CHECKSUM" | sed 's/t2/REDUNDANT/' >> $CHECKSUM_FILE

--echo
--echo ############
--echo # ROW_FORMAT COMPACT
ALTER TABLE `t1` ROW_FORMAT=COMPACT;

--source include/bugfix_crash_if_convert_instant_dropped_column_to_blob_low.inc

--exec echo "$CHECKSUM" | sed 's/t2/COMPACT/' >> $CHECKSUM_FILE

--echo
--echo ############
--echo # ROW_FORMAT DYNAMIC
ALTER TABLE `t1` ROW_FORMAT=DYNAMIC;

--source include/bugfix_crash_if_convert_instant_dropped_column_to_blob_low.inc

--exec echo "$CHECKSUM" | sed 's/t2/DYNAMIC/' >> $CHECKSUM_FILE

--echo
--echo ############
--echo # ROW_FORMAT COMPRESSED: instant drop is not supported.

--echo
--echo ############
--echo # Build same datas in the basic table t1
INSERT INTO `t1` (id, `c1`, `c2`) VALUES
  (1, repeat('x', 8000), NULL),
  (2, repeat('x', 8000), NULL),
  (3, repeat('x', 8000), repeat('x', 7000)),
  (4, repeat('x', 8000), repeat('x', 7000)),
  (5, 'x', NULL),
  (6, 'x', NULL),
  (7, NULL, NULL),
  (8, NULL, NULL);

ALTER TABLE `t1` DROP COLUMN `c1`, ALGORITHM=COPY;

UPDATE `t1` SET `c2`=repeat('y', 7000), `c3`=repeat('y', 6000) where id = 1 or id = 3 or id = 5 or id = 7;
UPDATE `t1` SET `c2`=repeat('y', 7000) where id = 2 or id = 4 or id = 6 or id = 8;

--let $CHECKSUM=`CHECKSUM TABLE t1`
--exec echo "$CHECKSUM" | sed 's/t1/base/' >> $CHECKSUM_FILE

--echo
--echo ############
--echo # Check all tables' checksum
CREATE TABLE `table_checksum` (
	`table_name` VARCHAR(20) NOT NULL PRIMARY KEY,
	`checksum_int` BIGINT NOT NULL
);

--disable_query_log
SET GLOBAL local_infile=ON;
--exec $MYSQL -e "LOAD DATA LOCAL INFILE '$CHECKSUM_FILE' INTO TABLE test.table_checksum FIELDS TERMINATED BY '\t' LINES TERMINATED BY '\n'"
SET GLOBAL local_infile=OFF;
--enable_query_log

--echo # 4 expected
SELECT COUNT(*) FROM `table_checksum`;
--echo # 1 expected
SELECT COUNT(DISTINCT checksum_int) FROM `table_checksum`;

--echo
--echo ############
--echo # CLEAR
DROP TABLE `t1`;
DROP TABLE `t2`;
DROP TABLE `table_checksum`;
