###########################################################################
#                                                                         #
# Variable Name: forbid_execute_dml_all                                   #
# Scope: GLOBAL, SESSION                                                  #
# Access Type: Dynamic                                                    #
# Data Type: BOOLEAN                                                      #
# Default Value: FALSE                                                    #
#                                                                         #
# Description: Test Cases for system variable "forbid_execute_dml_all"    #
#              that blocks UPDATE/DELETE without WHERE clause or with      #
#              tautological WHERE clause (e.g. WHERE 1=1, WHERE TRUE).    #
#                                                                         #
###########################################################################

--echo
--echo # ========== Setup ==========
--echo

CREATE TABLE t1 (id INT PRIMARY KEY, val VARCHAR(20));
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');

CREATE TABLE t2 (id INT PRIMARY KEY, val VARCHAR(20));
INSERT INTO t2 VALUES (1, 'x'), (2, 'y'), (3, 'z');

CREATE USER 'maintain_user'@'localhost';
GRANT ALL ON *.* TO 'maintain_user'@'localhost';

CREATE USER 'normal_user'@'localhost';
GRANT ALL ON *.* TO 'normal_user'@'localhost';

CREATE USER 'dml_allow_user'@'localhost';
GRANT ALL ON *.* TO 'dml_allow_user'@'localhost';

--echo
--echo # ========== 1. Default value check ==========
--echo

SELECT @@GLOBAL.forbid_execute_dml_all;
SELECT @@SESSION.forbid_execute_dml_all;
SELECT @@GLOBAL.polarx_specific_user_list;

--echo
--echo # ========== 2. Enable and test blocking ==========
--echo

SET SESSION forbid_execute_dml_all = TRUE;

--echo
--echo # --- 2.1 DELETE without WHERE: should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
DELETE FROM t1;
SELECT COUNT(*) FROM t1;

--echo
--echo # --- 2.2 UPDATE without WHERE: should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
UPDATE t1 SET val = 'blocked';
SELECT * FROM t1 WHERE id = 1;

--echo
--echo # --- 2.3 DELETE WHERE 1=1: should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
DELETE FROM t1 WHERE 1=1;
SELECT COUNT(*) FROM t1;

--echo
--echo # --- 2.4 UPDATE WHERE 1=1: should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
UPDATE t1 SET val = 'blocked' WHERE 1=1;

--echo
--echo # --- 2.5 DELETE WHERE TRUE: should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
DELETE FROM t1 WHERE TRUE;

--echo
--echo # --- 2.6 UPDATE WHERE TRUE: should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
UPDATE t1 SET val = 'blocked' WHERE TRUE;

--echo
--echo # --- 2.7 DELETE WHERE 1: should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
DELETE FROM t1 WHERE 1;

--echo
--echo # --- 2.8 DELETE WHERE 'a'='a': should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
DELETE FROM t1 WHERE 'a'='a';

--echo
--echo # ========== 3. Statements that should NOT be blocked ==========
--echo

--echo
--echo # --- 3.1 DELETE with column condition: should pass ---
DELETE FROM t1 WHERE id = 5;
SELECT COUNT(*) FROM t1;

--echo
--echo # --- 3.2 UPDATE with column condition: should pass ---
UPDATE t1 SET val = 'updated' WHERE id = 1;
SELECT * FROM t1 WHERE id = 1;

--echo
--echo # --- 3.3 DELETE with non-indexed column condition: should pass ---
DELETE FROM t1 WHERE val = 'b';
SELECT COUNT(*) FROM t1;

--echo
--echo # --- 3.4 DELETE WHERE 1=2 (always false): should pass ---
DELETE FROM t1 WHERE 1=2;
SELECT COUNT(*) FROM t1;

--echo
--echo # --- 3.5 DELETE WHERE FALSE: should pass ---
DELETE FROM t1 WHERE FALSE;
SELECT COUNT(*) FROM t1;

--echo
--echo # --- 3.6 UPDATE with combined condition (1=1 AND col): should pass ---
UPDATE t1 SET val = 'combined' WHERE 1=1 AND id = 3;
SELECT * FROM t1 WHERE id = 3;

--echo
--echo # --- 3.7 SELECT without WHERE: should pass (not UPDATE/DELETE) ---
SELECT * FROM t1;

--echo
--echo # --- 3.8 INSERT: should pass ---
INSERT INTO t1 VALUES (6, 'new');
SELECT COUNT(*) FROM t1;

--echo
--echo # --- 3.9 EXPLAIN DELETE without WHERE: should pass ---
--replace_column 4 # 7 # 8 # 9 # 10 # 11 #
EXPLAIN DELETE FROM t1;

--echo
--echo # ========== 4. Multi-table DML ==========
--echo

--echo
--echo # --- 4.1 Multi-table DELETE with JOIN ON: should pass ---
--echo # INNER JOIN ON condition is merged into where_cond by optimizer,
--echo # so where_cond is not NULL and not tautological.
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id;

--echo
--echo # Re-insert deleted rows for further tests
INSERT INTO t1 VALUES (1, 'a'), (2, 'b'), (3, 'c');

--echo
--echo # --- 4.2 Multi-table UPDATE with JOIN ON: should pass ---
UPDATE t1 JOIN t2 ON t1.id = t2.id SET t1.val = t2.val;

--echo
--echo # --- 4.3 Multi-table DELETE with real WHERE: should pass ---
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id WHERE t1.id = 1;
SELECT COUNT(*) FROM t1;

--echo
--echo # --- 4.4 Multi-table DELETE with CROSS JOIN, no WHERE: should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
DELETE t1 FROM t1, t2;

--echo
--echo # --- 4.5 Multi-table UPDATE with CROSS JOIN, no WHERE: should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
UPDATE t1, t2 SET t1.val = 'cross';

--echo
--echo # --- 4.6 Multi-table DELETE with CROSS JOIN WHERE 1=1: should be blocked ---
--error ER_HIGH_RISK_SQL_BLOCKED
DELETE t1 FROM t1, t2 WHERE 1=1;

--echo
--echo # ========== 5. Prepared statements ==========
--echo

--echo
--echo # Ensure data exists for prepared statement tests
SELECT COUNT(*) FROM t1;

--echo
--echo # --- 5.1 Prepared DELETE without WHERE: should be blocked ---
PREPARE stmt FROM 'DELETE FROM t1';
--error ER_HIGH_RISK_SQL_BLOCKED
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

--echo
--echo # --- 5.2 Prepared DELETE WHERE 1=1: should be blocked ---
PREPARE stmt FROM 'DELETE FROM t1 WHERE 1=1';
--error ER_HIGH_RISK_SQL_BLOCKED
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

--echo
--echo # --- 5.3 Prepared DELETE with real WHERE: should pass ---
PREPARE stmt FROM 'DELETE FROM t1 WHERE id = ?';
SET @id_val = 6;
EXECUTE stmt USING @id_val;
DEALLOCATE PREPARE stmt;
SELECT COUNT(*) FROM t1;

--echo
--echo # ========== 6. SET_VAR hint bypass ==========
--echo

--echo
--echo # --- 6.1 Hint bypass for DELETE without WHERE ---
--echo # Should pass with SET_VAR hint
SELECT /*+ SET_VAR(forbid_execute_dml_all=OFF) */ 1;
DELETE /*+ SET_VAR(forbid_execute_dml_all=OFF) */ FROM t2;
SELECT COUNT(*) FROM t2;

--echo
--echo # Re-insert data for further tests
INSERT INTO t2 VALUES (1, 'x'), (2, 'y'), (3, 'z');

--echo
--echo # --- 6.2 Hint bypass for UPDATE without WHERE ---
UPDATE /*+ SET_VAR(forbid_execute_dml_all=OFF) */ t2 SET val = 'hint';
SELECT * FROM t2;

--echo
--echo # ========== 7. Session isolation ==========
--echo

--echo # Connection default has forbid_execute_dml_all = TRUE
SELECT @@SESSION.forbid_execute_dml_all;

connect (con1, localhost, root,,);
--echo # --- 7.1 New connection should inherit global default (FALSE) ---
connection con1;
SELECT @@SESSION.forbid_execute_dml_all;

--echo # DELETE without WHERE should work on con1
DELETE FROM t2;
SELECT COUNT(*) FROM t2;

--echo # Re-insert data
INSERT INTO t2 VALUES (1, 'x'), (2, 'y');

disconnect con1;
connection default;

--echo
--echo # ========== 8. GLOBAL scope ==========
--echo

SET GLOBAL forbid_execute_dml_all = TRUE;

connect (con2, localhost, root,,);
connection con2;
--echo # --- 8.1 New connection should inherit GLOBAL = TRUE ---
SELECT @@SESSION.forbid_execute_dml_all;

--error ER_HIGH_RISK_SQL_BLOCKED
DELETE FROM t2;

--echo # --- 8.2 Session override should work ---
SET SESSION forbid_execute_dml_all = FALSE;
DELETE FROM t2;
SELECT COUNT(*) FROM t2;

disconnect con2;
connection default;

--echo
--echo # ========== 9. Whitelist (maintain_user_list) bypass ==========
--echo

SET GLOBAL forbid_execute_dml_all = TRUE;

--echo # Re-insert data for whitelist tests
INSERT INTO t2 VALUES (1, 'x'), (2, 'y'), (3, 'z');

--echo
--echo # --- 9.1 Normal user should be blocked ---
connect (con_normal, localhost, normal_user,,);
connection con_normal;
SELECT @@SESSION.forbid_execute_dml_all;

--error ER_HIGH_RISK_SQL_BLOCKED
DELETE FROM t2;

--error ER_HIGH_RISK_SQL_BLOCKED
UPDATE t2 SET val = 'blocked';

--error ER_HIGH_RISK_SQL_BLOCKED
DELETE FROM t2 WHERE 1=1;

--error ER_HIGH_RISK_SQL_BLOCKED
UPDATE t2 SET val = 'blocked' WHERE TRUE;

SELECT COUNT(*) FROM t2;
disconnect con_normal;
connection default;

--echo
--echo # --- 9.2 Startup user-list match should set session guard OFF ---
connect (con_dml_allow, localhost, dml_allow_user,,);
connection con_dml_allow;
SELECT @@SESSION.forbid_execute_dml_all;

--echo # DELETE without WHERE: startup user-list user should pass
DELETE FROM t2;
SELECT COUNT(*) FROM t2;

--echo # Session override should still work after startup default override
INSERT INTO t2 VALUES (1, 'x'), (2, 'y'), (3, 'z');
SET SESSION forbid_execute_dml_all = TRUE;
--error ER_HIGH_RISK_SQL_BLOCKED
DELETE FROM t2;

disconnect con_dml_allow;
connection default;

--echo
--echo # --- 9.3 Startup user-list option should be read only ---
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET GLOBAL polarx_specific_user_list = 'normal_user';

--echo
--echo # --- 9.4 Maintain user (whitelist) should NOT be blocked ---
connect (con_maintain, localhost, maintain_user,,);
connection con_maintain;
SELECT @@SESSION.forbid_execute_dml_all;

--echo # DELETE without WHERE: maintain user should pass
DELETE FROM t2;
SELECT COUNT(*) FROM t2;

--echo # Re-insert data
INSERT INTO t2 VALUES (1, 'x'), (2, 'y'), (3, 'z');

--echo # UPDATE without WHERE: maintain user should pass
UPDATE t2 SET val = 'maintain_updated';
SELECT * FROM t2;

--echo # DELETE WHERE 1=1: maintain user should pass
DELETE FROM t2 WHERE 1=1;
SELECT COUNT(*) FROM t2;

--echo # Re-insert data
INSERT INTO t2 VALUES (1, 'x'), (2, 'y');

--echo # UPDATE WHERE TRUE: maintain user should pass
UPDATE t2 SET val = 'maintain_true' WHERE TRUE;
SELECT * FROM t2;

disconnect con_maintain;
connection default;

--echo
--echo # --- 9.5 Dynamically add user to whitelist ---
SET GLOBAL maintain_user_list = 'maintain_user,normal_user';

connect (con_normal2, localhost, normal_user,,);
connection con_normal2;

--echo # normal_user is now in whitelist, should NOT be blocked
DELETE FROM t2;
SELECT COUNT(*) FROM t2;

disconnect con_normal2;
connection default;

--echo # Restore maintain_user_list
SET GLOBAL maintain_user_list = 'maintain_user';

SET GLOBAL forbid_execute_dml_all = FALSE;

--echo
--echo # ========== 10. Disable and verify no blocking ==========
--echo

SET SESSION forbid_execute_dml_all = FALSE;

INSERT INTO t2 VALUES (1, 'x'), (2, 'y'), (3, 'z');

--echo # --- 10.1 DELETE without WHERE should work now ---
DELETE FROM t2;
SELECT COUNT(*) FROM t2;

--echo # --- 10.2 UPDATE without WHERE should work now ---
INSERT INTO t1 VALUES (10, 'test');
UPDATE t1 SET val = 'all_updated';
SELECT DISTINCT val FROM t1;

--echo
--echo # ========== Cleanup ==========
--echo

DROP TABLE t1;
DROP TABLE t2;
DROP USER 'maintain_user'@'localhost';
DROP USER 'normal_user'@'localhost';
DROP USER 'dml_allow_user'@'localhost';
SET GLOBAL maintain_user_list = 'maintain_user';
SET GLOBAL forbid_execute_dml_all = FALSE;
SET SESSION forbid_execute_dml_all = FALSE;
