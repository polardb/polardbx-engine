# Use default setting for mysqld processes
!include include/default_mysqld.cnf
!include include/default_client.cnf

[mysqld]
log_bin=                    master-bin
relay_log=                  server-relay-log
master_info_repository=     TABLE
relay_log_info_repository=  TABLE
gtid_mode=ON
enforce_gtid_consistency=ON
binlog_row_image=FULL
binlog_format=ROW
consensus_log_level=2
log_error_verbosity=3
enable_consensus=1

#opt
performance_schema=0
performance_point_iostat_volume_size=0

mysqlx=0
enable_polarx_rpc=0
enable_changeset=0
changeset_threads=0

server_max_threads=1K

innodb_buffer_pool_instances=1
innodb_buffer_pool_size=16M
innodb_log_file_size=8M
innodb_log_buffer_size=256K
myisam_sort_buffer_size=4K
innodb_sort_buffer_size=16K
innodb_ddl_buffer_size=16K
innodb_change_buffering=NONE
innodb_thread_concurrency=2
innodb_ddl_threads=1
innodb_parallel_read_threads=1
innodb_purge_threads=1
innodb_page_cleaners=1
innodb_read_io_threads=1
innodb_write_io_threads=1
innodb_tcn_cache_level=NONE

tmp_table_size=2M
max_heap_table_size=1M
sort_buffer_size=1K
join_buffer_size=1K
read_buffer_size=16K
key_buffer_size=1K
table_open_cache=96
table_open_cache_instances=1

event_scheduler=0

rds_audit_log_enabled=0
rds_audit_log_buffer_size=128
rds_audit_flush_thread_enabled=0

enable_consensus=0

#thread_stack=16K
error_log_ring_buffer_size=5K

max_connections=512
max_prepared_stmt_count=5000
binlog_cache_size=8192
binlog_stmt_cache_size=8192
binlog_row_image=MINIMAL


#innodb_log_recent_written_size=8K
#innodb_log_recent_closed_size=16K
#key_cache_block_size=512
#innodb_max_undo_log_size=10M

