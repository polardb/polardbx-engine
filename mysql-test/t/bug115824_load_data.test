
SHOW VARIABLES LIKE "load_data_var_inherit_charset";

CREATE TABLE `assp_sis_payres_imp` (
  `AUTO_INC` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '自增列',
  `D_NAME` varchar(210) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL,
  PRIMARY KEY (`AUTO_INC`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

LET $MYSQLD_DATADIR= `SELECT @@datadir`;

--copy_file $MYSQLTEST_VARDIR/std_data/bug115824_gb18030.txt $MYSQLD_DATADIR/test/bug115824_gb18030.txt

# LOAD DATA LOCAL INFILE '/flash5/zanye.zjy/polarx_8032_raft.bak/mysql-test/var/load_data/TEST_GB18030_bak.txt' IGNORE INTO TABLE assp_sis_payres_imp_bak CHARACTER SET GB18030 IGNORE 0 LINES  (@row) SET `D_NAME` = CONVERT(UNHEX(HEX(@row)) USING GB18030);

SET GLOBAL load_data_var_inherit_charset = 0;
SET @row = _utf8mb4'';
LOAD DATA INFILE 'bug115824_gb18030.txt' IGNORE INTO TABLE assp_sis_payres_imp CHARACTER SET GB18030 IGNORE 0 LINES  (@row) SET `D_NAME` = CONVERT(UNHEX(HEX(@row)) USING GB18030);
SELECT * FROM assp_sis_payres_imp;
TRUNCATE TABLE assp_sis_payres_imp;

SET GLOBAL load_data_var_inherit_charset = 1;
SET @row = _utf8mb4'';
LOAD DATA INFILE 'bug115824_gb18030.txt' IGNORE INTO TABLE assp_sis_payres_imp CHARACTER SET GB18030 IGNORE 0 LINES  (@row) SET `D_NAME` = CONVERT(UNHEX(HEX(@row)) USING GB18030);
SELECT * FROM assp_sis_payres_imp;
TRUNCATE TABLE assp_sis_payres_imp;


SET GLOBAL load_data_var_inherit_charset = 0;
--exec $MYSQL --database=test --local-infile=1 -e "SET @row = _utf8mb4''; LOAD DATA INFILE  '$MYSQLTEST_VARDIR/std_data/bug115824_gb18030.txt' IGNORE INTO TABLE assp_sis_payres_imp CHARACTER SET GB18030 IGNORE 0 LINES  (@row) SET D_NAME = CONVERT(UNHEX(HEX(@row)) USING GB18030)"
SELECT * FROM assp_sis_payres_imp;
TRUNCATE TABLE assp_sis_payres_imp;

SET GLOBAL load_data_var_inherit_charset = 1;
--exec $MYSQL --database=test --local-infile=1 -e "SET @row = _utf8mb4''; LOAD DATA INFILE  '$MYSQLTEST_VARDIR/std_data/bug115824_gb18030.txt' IGNORE INTO TABLE assp_sis_payres_imp CHARACTER SET GB18030 IGNORE 0 LINES  (@row) SET D_NAME = CONVERT(UNHEX(HEX(@row)) USING GB18030)"
SELECT * FROM assp_sis_payres_imp;
TRUNCATE TABLE assp_sis_payres_imp;

DROP TABLE assp_sis_payres_imp;

SET GLOBAL load_data_var_inherit_charset = default;
