set pushdown_range_limit=true;
--disable_warnings
drop table if exists sbtest1;
--enable_warnings
CREATE TABLE `sbtest1` (
`id` int NOT NULL,
`k` int NOT NULL DEFAULT '0',
`k2` int DEFAULT NULL,
`c` char(60) NULL DEFAULT '',
PRIMARY KEY (`id`),
KEY `k_1` (`k`,`k2`)
);

insert into sbtest1 values (1, 110, 111, 'abc1');
insert into sbtest1 values (2, 110, 112, 'def1');
insert into sbtest1 values (3, 110, 113, 'ghi1');
insert into sbtest1 values (4, 111, 110, 'abc2');
insert into sbtest1 values (5, 111, 111, 'def2');
insert into sbtest1 values (6, 111, 111, 'ghi2');
insert into sbtest1 values (7, 111, 112, 'abc3');
insert into sbtest1 values (8, 114, 110, 'def3');
insert into sbtest1 values (9, 115, 112, 'ghi3');
insert into sbtest1 values (10, 116, 112, 'ghi4');
insert into sbtest1 values (100, 111, 110, 'ghi4');
insert into sbtest1 values (1000, 112, 110, 'ghi4');
insert into sbtest1 values (10000, 111, 110, 'abc5');
insert into sbtest1 values (10001, 112, 112, 'def5');
insert into sbtest1 values (10002, 114, 113, 'ghi5');

explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 = 112 order by id limit 3;
select id from sbtest1 where k in (110, 111, 112) and k2 = 112 order by id limit 3;

explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 in (111, 112, 113) order by id limit 3, 4;
select id from sbtest1 where k in (110, 111, 112) and k2 in (111, 112, 113) order by id limit 3, 4;

explain format=tree select id from sbtest1 where k = 111 and k2 in (110, 111, 112) and id > 3 order by id limit 2, 10;
select id from sbtest1 where k = 111 and k2 in (110, 111, 112) and id > 3 order by id limit 2, 10;

# pushdown limit into a subquery
explain format=tree select * from ( select id from sbtest1 where k = 111 and k2 in (110, 111, 112) and id > 3 order by id limit 2, 10) a where a.id < 100;
select * from ( select id from sbtest1 where k = 111 and k2 in (110, 111, 112) and id > 3 order by id limit 2, 10) a where a.id < 100;

--echo # does not support join
explain format=tree select a.id from sbtest1 a force index(k_1) join (select * from sbtest1 where id > 0) b ON a.k=b.k and a.k2=b.k2 where a.k = 111 and a.k2 in (110, 111, 112) and a.id > 3 order by a.id limit 8, 5;

--echo # does not support backwards scan
explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 = 112 order by id desc limit 3;

# cannot push for this NEAR_MIN range, since k2 is not determined in the range
explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 > 112 order by id limit 3;

# can push for this NEAR_MIN range
explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 > 112 order by k2, id limit 3;

--echo # cannot pushdown limit when it is not equal range
explain format=tree select id from sbtest1 where k in (110, 111, 112) and k2 between 112 and 120 order by id limit 3;

drop table sbtest1;

--disable_warnings
drop table if exists sbtest2;
--enable_warnings
CREATE TABLE `sbtest2` (
`id1` int NOT NULL,
`id2` int NOT NULL,
`k1` int NOT NULL DEFAULT '0',
`k2` int DEFAULT NULL,
`k3` int DEFAULT NULL,
`k4` int DEFAULT NULL,
`k5` int DEFAULT NULL,
`k6` int DEFAULT NULL,
`k7` int DEFAULT NULL,
`k8` int DEFAULT NULL,
`k9` int DEFAULT NULL,
`k10` int DEFAULT NULL,
`k11` int DEFAULT NULL,
`k12` int DEFAULT NULL,
`k13` int DEFAULT NULL,
`k14` int DEFAULT NULL,
`k15` int DEFAULT NULL,
`k16` int DEFAULT NULL,
`k17` int DEFAULT NULL,
`c` char(60) NULL DEFAULT '',
PRIMARY KEY (`id1`,`id2`),
UNIQUE KEY `uk` (`k1`, `id1`, `k17`),
KEY `key1` (`k1`, `k2`, `id1`,`k3`),
KEY `key2` (`k1`, `k2`, `k3`, `k4`, `k5`, `k6`, `k7`, `k8`, `k9`, `k10`, `k11`, `k12`, `k13`, `k14`, `k15`)
);

