--echo # Too long table alias name


create database long_alias_db;
create table long_alias_db.t(c1 int auto_increment primary key, c2 blob);
insert into long_alias_db.t (c1, c2) values(1, repeat('#', 10));

insert into long_alias_db.t (c2) values(repeat('#', 10000));
insert into long_alias_db.t (c2) values(repeat('#', 10000));

--error ER_TOO_LONG_IDENT
explain select c1+c1 from (
(select c1 from long_alias_db.t order by c1 asc limit 1)
union all 
(select c1 from long_alias_db.t order by c1 desc limit 1 )
)  as `()` ;

select c1+c1 from (
(select c1 from long_alias_db.t order by c1 asc limit 1)
union all 
(select c1 from long_alias_db.t order by c1 desc limit 1 )
)  as `()` ;
show warnings;


explain select c1+c1 from (
(select c1 from long_alias_db.t order by c1 asc limit 1)
union all 
(select c1 from long_alias_db.t order by c1 desc limit 1 )
)  as `(123)` ;
show warnings;

drop database long_alias_db;

